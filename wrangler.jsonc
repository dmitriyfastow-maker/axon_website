{
  "name": "vaxo-site",
  "account_id": "939511076f702306710cfbf6174adc54",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "vaxogroup.com", "custom_domain": true },
    { "pattern": "www.vaxogroup.com", "custom_domain": true }
  ],
  "ai": { "binding": "AI", "remote": true },
  "workers_dev": false,
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    { "binding": "LEADS", "database_name": "vaxo-leads", "database_id": "288e62a1-690b-4f45-89c9-d0bcb24f76bb", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "FILES", "id": "bda12dd981fc432cb4d5e820960d963d" }],
  "vars": { "LEAD_EMAIL_FROM": "Vaxo <hello@vaxogroup.com>" }
}
