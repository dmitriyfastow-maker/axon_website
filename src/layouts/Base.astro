---
import '../styles/fonts.css';
import '../styles/global.css';
import InstallApp from '../components/InstallApp.astro';
import VaxChat from '../components/VaxChat.astro';
import { HTML_LANG, LANGS, OG_LOCALE, getDict, langPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page path for canonical/hreflang; omit for pages that must not be indexed. */
  path?: string;
  noindex?: boolean;
  /** Language versions of this page for hreflang; omit on the home pages. */
  alts?: Partial<Record<Lang, string>>;
  /** Hide the Vax chat (owner pages). */
  noChat?: boolean;
}

const { lang, title, description, path, noindex = false, alts, noChat = false } = Astro.props;
const altLinks = LANGS.filter((l) => !alts || alts[l]).map((l) => ({ l, href: alts?.[l] ?? langPath(l) }));
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const ogImage = abs(`/og-${lang}.png`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vaxo',
  description,
  url: abs(langPath(lang)),
  image: ogImage,
  areaServed: ['Ukraine', 'Europe', 'United States', 'United Kingdom', 'United Arab Emirates', 'Canada'],
  sameAs: ['https://www.instagram.com/vaxo_group/', 'https://www.tiktok.com/@vaxo_group', 'https://www.youtube.com/@vaxo_group', 'https://www.threads.net/@vaxo_group', 'https://www.linkedin.com/company/145357235/'],
};
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Icon = Decision 20, logo 1, icon A: VAXO. on a black tile -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Vaxo" />
    <meta name="theme-color" content="#f8f9fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0c0a" media="(prefers-color-scheme: dark)" />
    {
      path && (
        <>
          <link rel="canonical" href={abs(path)} />
          {altLinks.map(({ l, href }) => <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(href)} />)}
          <link rel="alternate" hreflang="x-default" href={abs(altLinks[0].href)} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vaxo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {path && <meta property="og:url" content={abs(path)} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {path && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Apply the saved or system theme before first paint to avoid a flash.
      (function () {
        var t = null;
        try { t = localStorage.getItem('axon_theme2'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var r = document.documentElement;
        r.setAttribute('data-theme', t);
        r.classList.add('js');
      })();
    </script>
    <slot name="head" />
    <script is:inline>
      // Partner links: ?ref=CODE. First touch wins and is kept for life (localStorage + 400-day cookie).
      (function () {
        try {
          // Client invite links (c_…) count for 60 days; after that a new link may win.
          var held = localStorage.getItem('vaxo_ref');
          if (held && /^c_/.test(held) && Date.now() - Number(localStorage.getItem('vaxo_ref_at') || 0) > 5184e6) {
            localStorage.removeItem('vaxo_ref'); localStorage.removeItem('vaxo_ref_at');
            document.cookie = 'vaxo_ref=; max-age=0; path=/';
          }
          var r = new URLSearchParams(location.search).get('ref');
          if (r && /^[A-Za-z0-9_-]{1,64}$/.test(r) && !localStorage.getItem('vaxo_ref')) {
            localStorage.setItem('vaxo_ref', r);
            localStorage.setItem('vaxo_ref_at', String(Date.now()));
            document.cookie = 'vaxo_ref=' + r + '; max-age=' + (/^c_/.test(r) ? 5184000 : 34560000) + '; path=/; samesite=lax';
          }
          // Friend promo code: ?code=CODE (latest wins).
          var c = new URLSearchParams(location.search).get('code');
          if (c && /^[A-Za-z0-9_-]{2,20}$/.test(c)) localStorage.setItem('vaxo_code', c.toUpperCase());
          if (!localStorage.getItem('vaxo_ref')) {
            var m = document.cookie.match(/(?:^|; )vaxo_ref=([A-Za-z0-9_-]{1,64})/);
            if (m) { localStorage.setItem('vaxo_ref', m[1]); if (!localStorage.getItem('vaxo_ref_at')) localStorage.setItem('vaxo_ref_at', String(Date.now())); }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ L: lang }}>
      // Decision 57 v2: whoever came by an invite link sees their gift on every page for 30 days (closable).
      (function () {
        try {
          var r = localStorage.getItem('vaxo_ref'), at = Number(localStorage.getItem('vaxo_ref_at') || 0);
          if (!r || !at || Date.now() - at > 3456e7 || localStorage.getItem('vaxo_gift_x')) return;
          var c = /^c_/.test(r);
          var T = { ru: ['🎁 Вы пришли по приглашению: +20% объёма на весь первый оплаченный тариф — месяц или год, и набор всех 12 шаблонов ($67) бесплатно', ' · по ссылке партнёра при оплате сразу за 3–12 месяцев +20% действует первый месяц', 'Закрыть'], ua: ['🎁 Ви прийшли за запрошенням: +20% обсягу на весь перший оплачений тариф — місяць чи рік, і набір усіх 12 шаблонів ($67) безкоштовно', ' · за посиланням партнера при оплаті одразу за 3–12 місяців +20% діє перший місяць', 'Закрити'], en: ['🎁 You came by an invite: +20% work volume for the whole first paid plan, a month or a year, plus all 12 templates ($67) free', ' · by a partner’s link, on a 3–12 month prepay the +20% covers the first month', 'Close'] }[L] || null;
          if (!T) return;
          var b = document.createElement('div'); b.className = 'vxgift'; b.setAttribute('role', 'status');
          var t = document.createElement('span'); t.textContent = T[0] + (c ? '' : T[1]); b.appendChild(t);
          var x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', T[2]);
          x.onclick = function () { try { localStorage.setItem('vaxo_gift_x', '1'); } catch (e) {} b.remove(); }; b.appendChild(x);
          document.body.appendChild(b);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      .vxgift { position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 90; display: flex; gap: 10px; align-items: center; max-width: min(92vw, 640px); background: #16161a; color: #fff; border: 1px solid #e8b04a; border-radius: 999px; padding: 9px 10px 9px 16px; font: 500 14px/1.35 system-ui, sans-serif; box-shadow: 0 10px 30px rgba(0,0,0,.3); }
      .vxgift button { flex: none; width: 28px; height: 28px; border-radius: 50%; border: 0; background: rgba(255,255,255,.12); color: #fff; font-size: 16px; cursor: pointer; }
      @media (max-width: 600px) { .vxgift { border-radius: 14px; bottom: 80px; } }
    </style>
    {!noChat && <VaxChat lang={lang} />}
    <InstallApp lang={lang as 'en' | 'ru' | 'ua'} />
    <script type="application/json" id="vax-jokes" set:html={JSON.stringify(getDict(lang).vax.poke)} />
    <script type="application/json" id="vax-hint" set:html={JSON.stringify(getDict(lang).vax.hint)} />
    <script>
      // Theme toggle, mobile menu, language memory, contact form and accordions — on every page.
      import '../scripts/main';
      import { startTracking } from '../scripts/track';
      if (!location.pathname.startsWith('/admin') && !location.pathname.startsWith('/fin')) startTracking();
    </script>
  </body>
</html>
