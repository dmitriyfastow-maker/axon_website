---
// Partner cabinet: sign up / log in, then tabs — Home (next step, checklist, rates, achievements),
// Links (unlimited tracking links), Academy (lessons with prompts), AI prompts, Team, Payouts & rules.
import Base from '../../layouts/Base.astro';
import PromptCard from '../../components/PromptCard.astro';
import { RATES } from '../../data/partners';
import { CATEGORIES, OFFERS, PROMPTS, TOOLS } from '../../data/ai-toolkit';
import { CHECKLIST, LESSONS } from '../../data/academy';

const r = RATES;
const byId = (id: string) => PROMPTS.find((p) => p.id === id)!;
const tabs = [
  ['home', '🏠', 'Home'],
  ['links', '🔗', 'Links'],
  ['academy', '🎓', 'Academy'],
  ['prompts', '🤖', 'AI prompts'],
  ['team', '👥', 'Team'],
  ['rules', '💸', 'Payouts & rules'],
];
const rates = [
  [`${r.agencyOwn}%`, 'Agency services', `client you found · ${r.agencyGiven}% for a lead we give you`],
  [`+${r.agencyRenewal}%`, 'Every renewal', 'and monthly payment, for life'],
  [`${r.products}%`, 'Our templates', '$9 – $67 per sale'],
  [`${r.offers}%`, 'Partner offers', 'of the payout we receive (soon)'],
  [`+${r.team}%`, 'Your team', 'of their earnings, paid by us on top'],
];
const offerSelect = OFFERS.map((o) => ({ id: o.id, name: o.name }));
---

<Base lang="en" title="Vaxo Partners — your cabinet" description="Earn with Vaxo: services, templates and partner offers. Your links, stats, training, AI prompts and team in one place." path="/partner/" noindex>
  <main class="wrap" data-offers={JSON.stringify(OFFERS)} data-checklist={JSON.stringify(CHECKLIST)}>
    <div class="topbar">
      <a href="/partners/" class="logo">VAXO<span>.</span> <small>Partners</small></a>
      <div class="row tight" data-view="cabinet" hidden><span class="mut small" data-email></span><button type="button" class="ghost" data-logout>Log out</button></div>
    </div>

    <section data-view="auth" hidden>
      <div class="auth">
        <div>
          <h1>Earn with Vaxo</h1>
          <p class="mut">Recommend AI services and templates for small businesses. We do the work, you get the commission — every week.</p>
          <ul class="ticks">
            <li><b>{r.agencyOwn}%</b> on services, <b>{r.products}%</b> on templates — from the first sale</li>
            <li>Free academy and ready AI prompts — no experience needed</li>
            <li>Clients stay yours for life, weekly payouts</li>
          </ul>
          <a href="/partners/" class="mut small">How the program works →</a>
        </div>
        <div>
          <div class="tabs">
            <button type="button" data-tab="register" aria-pressed="true">Create account</button>
            <button type="button" data-tab="login" aria-pressed="false">Log in</button>
          </div>
          <form data-form="register" class="card">
            <label>Name<input name="name" required maxlength="80" autocomplete="name" /></label>
            <label>Email<input name="email" type="email" required autocomplete="email" /></label>
            <label>Password (8+ characters)<input name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
            <label class="check"><input type="checkbox" name="adult" required /> I am 18 or older</label>
            <label class="check"><input type="checkbox" name="rules" required /> I accept the <a href="#rules">partner rules</a></label>
            <button type="submit" class="cta">Create account</button>
            <p class="err" data-err hidden></p>
          </form>
          <form data-form="login" class="card" hidden>
            <label>Email<input name="email" type="email" required autocomplete="email" /></label>
            <label>Password<input name="password" type="password" required autocomplete="current-password" /></label>
            <button type="submit" class="cta">Log in</button>
            <p class="err" data-err hidden></p>
          </form>
        </div>
      </div>
    </section>

    <section data-view="cabinet" hidden>
      <nav class="tabbar" aria-label="Cabinet">
        {tabs.map(([id, icon, name]) => <button type="button" data-go={id}><span>{icon}</span> {name}</button>)}
      </nav>

      <!-- HOME -->
      <div data-panel="home">
        <div class="hello">
          <div>
            <h1>Hi, <span data-name></span> 👋</h1>
            <p class="mut">Here is everything you need today.</p>
          </div>
        </div>

        <div class="next card">
          <span class="eyebrow-s">Your next step</span>
          <h2 data-next-text>…</h2>
          <button type="button" class="cta" data-next-go>Do it now →</button>
        </div>

        <div class="mylink card">
          <div><span class="eyebrow-s">Your main link</span><code data-main-link></code></div>
          <div class="row tight"><button type="button" class="cta" data-copy-main>Copy</button><button type="button" class="ghost" data-share-main>Share</button></div>
        </div>

        <div class="stats">
          <div class="card"><b data-total="clicks">0</b><span>clicks</span></div>
          <div class="card"><b data-total="leads">0</b><span>client requests</span></div>
          <div class="card"><b data-total="sales">0</b><span>paid sales</span></div>
          <div class="card"><b data-total="team">0</b><span>partners in your team</span></div>
        </div>

        <div class="grid2">
          <div class="card">
            <div class="ch-head"><h2>Start here</h2><span class="mut small" data-check-count></span></div>
            <div class="bar"><i data-check-bar></i></div>
            <ol class="checklist" data-checklist-box>
              {CHECKLIST.map((c) => (
                <li data-check={c.id}>
                  <label><input type="checkbox" /> <span>{c.text}</span></label>
                  <button type="button" class="ghost sm" data-go={c.tab} data-lesson={c.lesson}>Open</button>
                </li>
              ))}
            </ol>
          </div>
          <div class="card">
            <h2>Your rates</h2>
            <p class="mut small">Full rates from your first sale. No levels, no waiting.</p>
            <div class="rates">
              {rates.map(([n, h, x]) => <div><b>{n}</b><span><strong>{h}</strong> {x}</span></div>)}
            </div>
          </div>
        </div>

        <h2>Achievements</h2>
        <div class="badges" data-badges></div>

        <div class="soon card">
          <span class="pill">Soon</span>
          <span class="gift">🎁</span>
          <div><h3>Prize draws for active partners</h3><p class="mut small">Regular draws and challenges with prizes. Keep posting — you will take part from the first one.</p></div>
        </div>
      </div>

      <!-- LINKS -->
      <div data-panel="links" hidden>
        <h1>My links</h1>
        <p class="mut">Make a separate link for every place you post (TikTok, Instagram, a group, a video) — then you see what brings clients. Unlimited links, turn any off at any time.</p>
        <form data-form="link" class="card linkform">
          <label>Where will you post it?<input name="name" placeholder="e.g. TikTok, Instagram bio, Facebook group" maxlength="60" /></label>
          <label>Where does it lead?
            <select name="target">
              {OFFERS.map((o) => <option value={o.target}>{o.name}</option>)}
              <option value="/">Main page</option>
            </select>
          </label>
          <button type="submit" class="cta">+ Create link</button>
        </form>
        <div class="table"><table>
          <thead><tr><th>Name</th><th>Link (click to copy)</th><th>Clicks</th><th>Requests</th><th></th></tr></thead>
          <tbody data-links></tbody>
        </table></div>
        <p class="mut small">💡 After 7 days look at the numbers: the place with the most requests is where to post more.</p>
      </div>

      <!-- ACADEMY -->
      <div data-panel="academy" hidden>
        <h1>Academy</h1>
        <p class="mut">Short lessons, in order. Each one has the free way to start and the maximum way for faster results — plus ready prompts with your link inside.</p>
        <div class="offerpick card"><label>I promote:<select data-offer>{offerSelect.map((o) => <option value={o.id}>{o.name}</option>)}</select></label></div>
        <div class="lessons">
          {LESSONS.map((l, i) => (
            <details class="lesson card" data-lesson-box={l.id} open={i === 0}>
              <summary>
                <span class="lic">{l.icon}</span>
                <span class="lt"><b>{i}. {l.title}</b><small>{l.time} · {l.goal}</small></span>
              </summary>
              <ol class="lsteps">{l.steps.map((s) => <li>{s}</li>)}</ol>
              {l.tip && <p class="tip">⚠️ {l.tip}</p>}
              <div class="ways">
                <div class="way"><b>Free way</b><p>{l.free}</p></div>
                <div class="way max"><b>Maximum way</b><p>{l.max}</p></div>
              </div>
              {l.prompts.length > 0 && (
                <div class="lprompts">
                  <b class="small">Prompts for this lesson</b>
                  {l.prompts.map((id) => <PromptCard prompt={byId(id)} />)}
                </div>
              )}
            </details>
          ))}
        </div>
      </div>

      <!-- PROMPTS -->
      <div data-panel="prompts" hidden>
        <h1>AI prompts</h1>
        <p class="mut">Pick what you promote — every prompt fills in the offer and your link. Open in one click: <b>Claude</b> (our pick — the strongest for writing), ChatGPT or Gemini. All have free plans. Replace the parts in [brackets].</p>
        <div class="offerpick card"><label>I promote:<select data-offer>{offerSelect.map((o) => <option value={o.id}>{o.name}</option>)}</select></label></div>
        <div class="chips" data-cats>
          <button type="button" data-cat="all" aria-pressed="true">All</button>
          {CATEGORIES.map((c) => <button type="button" data-cat={c.id} aria-pressed="false">{c.name}</button>)}
        </div>
        <div class="plist">{PROMPTS.map((p) => <PromptCard prompt={p} />)}</div>
        <h2>Best tools for each task</h2>
        <div class="table"><table class="tools">
          <thead><tr><th>Task</th><th>Free — to start</th><th>Maximum — when you grow</th></tr></thead>
          <tbody>{TOOLS.map((t) => <tr><td><b>{t.task}</b></td><td>{t.free}</td><td>{t.paid}</td></tr>)}</tbody>
        </table></div>
        <p class="mut small">Gemini opens empty — the prompt is copied, just paste it (Ctrl/Cmd + V).</p>
      </div>

      <!-- TEAM -->
      <div data-panel="team" hidden>
        <h1>Your team</h1>
        <div class="grid2">
          <div class="card">
            <div class="teamnum"><b data-total="team2">0</b><span>partners in your team</span></div>
            <p class="mut">Invite people with this link. When they earn, you get <b>+{r.team}%</b> on top — we pay it, they lose nothing. Only for real sales, never for the invite itself.</p>
            <code data-invite></code>
            <div class="row tight"><button type="button" class="cta" data-copy-invite>Copy invite link</button><button type="button" class="ghost" data-share-invite>Share</button></div>
          </div>
          <div class="card">
            <h2>How to invite</h2>
            <ol class="lsteps">
              <li>Invite friends and followers who make content or want extra income.</li>
              <li>Be honest: free to join, earnings depend only on real sales.</li>
              <li>Help them start: the Academy is already in their cabinet.</li>
            </ol>
          </div>
        </div>
        <PromptCard prompt={byId('invite')} open />
      </div>

      <!-- RULES -->
      <div data-panel="rules" hidden>
        <h1>Payouts & rules</h1>
        <div class="grid2">
          <div class="card"><h3>💸 Payouts</h3><p class="mut">Every week, for money we have received and held for {r.holdDays} days (refund protection). Main method: crypto (USDT). Sales appear in your cabinet once the client has paid.</p></div>
          <div class="card"><h3>🔒 Your clients</h3><p class="mut">The first link a client clicks is saved for good. If they come back and buy months later, it still counts for you.</p></div>
        </div>
      </div>
    </section>

    <section id="rules" class="rules">
      <h2>Partner rules</h2>
      <ol>
        <li>18+ only.</li>
        <li>Honest promotion: no spam, no mass emails to strangers, no fake income promises, no fake reviews, no bots or paid clicks.</li>
        <li>Follow each offer's own rules, shown next to its link.</li>
        <li>Don't take our clients or advertisers around us.</li>
        <li>Weekly payouts for money we have received and held for {r.holdDays} days (refund protection).</li>
        <li>Breaking the rules means the account is switched off and those sales are not paid.</li>
      </ol>
    </section>
  </main>
</Base>

<script>
  type Link = { id: number; slug: string; name: string; target: string; active: number; clicks: number; leads: number };
  type Offer = { id: string; target: string; text: string };
  type Check = { id: string; text: string; tab: string; lesson?: string };
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const $$ = <T extends Element = HTMLElement>(sel: string) => [...document.querySelectorAll<T>(sel)];
  const root = $('main.wrap');
  const offers = JSON.parse(root.dataset.offers!) as Offer[];
  const checklist = JSON.parse(root.dataset.checklist!) as Check[];
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
  };
  const api = (path: string, body?: unknown) =>
    fetch(`/api/partner/${path}`, body === undefined ? {} : { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

  let view: 'auth' | 'cabinet' = 'auth';
  const show = (v: 'auth' | 'cabinet') => {
    view = v;
    $$('[data-view]').forEach((el) => (el.hidden = el.dataset.view !== v));
    if (v === 'cabinet') go((location.hash.slice(1) || 'home') as string, undefined, false);
    else $('#rules').hidden = false;
  };

  // ---- tabs ----
  const PANELS = ['home', 'links', 'academy', 'prompts', 'team', 'rules'];
  function go(tab: string, lesson?: string, scroll = true) {
    if (!PANELS.includes(tab)) tab = 'home';
    $$('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== tab));
    $$('.tabbar [data-go]').forEach((b) => b.setAttribute('aria-current', String(b.dataset.go === tab)));
    $('.tabbar [aria-current="true"]').scrollIntoView({ block: 'nearest', inline: 'center' });
    $('#rules').hidden = tab !== 'rules';
    history.replaceState(null, '', tab === 'home' ? location.pathname + location.search : `#${tab}`);
    if (lesson) {
      const box = $<HTMLDetailsElement>(`[data-lesson-box="${lesson}"]`);
      box.open = true;
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  addEventListener('hashchange', () => view === 'cabinet' && go(location.hash.slice(1)));
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-go]');
    if (b) go(b.dataset.go!, b.dataset.lesson || undefined);
  });

  // ---- prompts ----
  let mainLink = location.origin;
  let inviteLink = location.origin + '/partners/';
  let offerId = store.get('vaxo_offer') ?? 'start';
  const OPEN: Record<string, (q: string) => string> = {
    claude: (q) => `https://claude.ai/new?q=${encodeURIComponent(q)}`,
    chatgpt: (q) => `https://chatgpt.com/?q=${encodeURIComponent(q)}`,
    gemini: () => 'https://gemini.google.com/app',
  };
  function renderPrompts() {
    const offer = offers.find((o) => o.id === offerId) ?? offers[0];
    $$<HTMLSelectElement>('[data-offer]').forEach((s) => (s.value = offer.id));
    $$('[data-prompt]').forEach((box) => {
      const pre = box.querySelector<HTMLElement>('pre')!;
      const link = box.dataset.cat === 'team' ? inviteLink : mainLink;
      const offerText = box.dataset.cat === 'team' ? offers.find((o) => o.id === 'partners')!.text : offer.text;
      pre.textContent = pre.dataset.tpl!.replaceAll('{offer}', offerText).replaceAll('{link}', link);
      box.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) => (a.href = OPEN[a.dataset.open!](pre.textContent!)));
    });
  }
  $$<HTMLSelectElement>('[data-offer]').forEach((s) =>
    s.addEventListener('change', () => {
      offerId = s.value;
      store.set('vaxo_offer', offerId);
      renderPrompts();
    }),
  );
  $$('[data-prompt]').forEach((box) => {
    const text = () => box.querySelector('pre')!.textContent ?? '';
    box.querySelector('[data-open="gemini"]')!.addEventListener('click', () => navigator.clipboard?.writeText(text()));
    const copy = box.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.addEventListener('click', () => navigator.clipboard?.writeText(text()).then(() => flash(copy, 'Copied ✓')));
  });
  $$<HTMLButtonElement>('[data-cat]').forEach((b) =>
    b.addEventListener('click', () => {
      $$('[data-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      $$('.plist [data-prompt]').forEach((p) => (p.hidden = b.dataset.cat !== 'all' && p.dataset.cat !== b.dataset.cat));
    }),
  );

  // ---- helpers ----
  function flash(el: HTMLElement, text: string) {
    const old = el.textContent;
    el.textContent = text;
    setTimeout(() => (el.textContent = old), 1500);
  }
  function share(url: string, btn: HTMLElement) {
    if (navigator.share) navigator.share({ url }).catch(() => {});
    else navigator.clipboard?.writeText(url).then(() => flash(btn, 'Copied ✓'));
  }
  function cell(text: string): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    return td;
  }

  // ---- checklist (saved in this browser) ----
  let code = '';
  let auto: Record<string, boolean> = {};
  const checkKey = () => `vaxo_check_${code}`;
  const doneSet = () => new Set<string>(JSON.parse(store.get(checkKey()) ?? '[]'));
  function renderChecklist() {
    const done = doneSet();
    for (const [k, v] of Object.entries(auto)) if (v) done.add(k);
    let n = 0;
    $$('[data-check]').forEach((li) => {
      const on = done.has(li.dataset.check!);
      if (on) n++;
      li.classList.toggle('done', on);
      li.querySelector<HTMLInputElement>('input')!.checked = on;
    });
    $('[data-check-count]').textContent = `${n} of ${checklist.length}`;
    $('[data-check-bar]').style.width = `${Math.max(4, (n / checklist.length) * 100)}%`;
    const next = checklist.find((c) => !done.has(c.id));
    const btn = $('[data-next-go]');
    if (next) {
      $('[data-next-text]').textContent = next.text;
      btn.hidden = false;
      btn.dataset.go = next.tab;
      if (next.lesson) btn.dataset.lesson = next.lesson;
      else delete btn.dataset.lesson;
    } else {
      $('[data-next-text]').textContent = 'All set! Keep posting every day — make your next video batch.';
      btn.dataset.go = 'academy';
      btn.dataset.lesson = 'video';
    }
  }
  $$('[data-check]').forEach((li) =>
    li.querySelector('input')!.addEventListener('change', (e) => {
      const done = doneSet();
      if ((e.target as HTMLInputElement).checked) done.add(li.dataset.check!);
      else done.delete(li.dataset.check!);
      store.set(checkKey(), JSON.stringify([...done]));
      renderChecklist();
    }),
  );

  function renderBadges(list: [string, string, string, number, number][]) {
    $('[data-badges]').replaceChildren(
      ...list.map(([icon, name, hint, have, goal]) => {
        const done = have >= goal;
        const d = document.createElement('div');
        d.className = `badge${done ? ' done' : ''}`;
        const i = document.createElement('span');
        i.className = 'icon';
        i.textContent = icon;
        const b = document.createElement('b');
        b.textContent = name;
        const s = document.createElement('small');
        s.textContent = done ? '✓ Done' : goal > 1 ? `${hint} · ${Math.max(0, have)}/${goal}` : hint;
        d.append(i, b, s);
        return d;
      }),
    );
  }

  // ---- data ----
  async function load() {
    const res = await api('me');
    if (!res.ok) return show('auth');
    const data = (await res.json()) as { partner: { name: string; code: string; email?: string }; links: Link[]; team: number; sales?: number };
    code = data.partner.code;
    $('[data-name]').textContent = data.partner.name;
    $('[data-email]').textContent = data.partner.email ?? '';
    const clicks = data.links.reduce((n, l) => n + l.clicks, 0);
    const leads = data.links.reduce((n, l) => n + l.leads, 0);
    const sales = data.sales ?? 0;
    $('[data-total="clicks"]').textContent = String(clicks);
    $('[data-total="leads"]').textContent = String(leads);
    $('[data-total="sales"]').textContent = String(sales);
    $('[data-total="team"]').textContent = String(data.team);
    $('[data-total="team2"]').textContent = String(data.team);
    inviteLink = `${location.origin}/partner/?invite=${data.partner.code}`;
    $('[data-invite]').textContent = inviteLink;
    const active = data.links.find((l) => l.active);
    mainLink = active ? `${location.origin}/r/${active.slug}` : location.origin;
    $('[data-main-link]').textContent = mainLink.replace(/^https?:\/\//, '');

    auto = { link: data.links.length > 1, invite: data.team > 0 };
    renderChecklist();
    renderBadges([
      ['🔗', 'Own link', 'Make a link of your own', data.links.length - 1, 1],
      ['👆', 'First click', 'Someone opened your link', clicks, 1],
      ['🔥', 'Hot link', '100 clicks', clicks, 100],
      ['📩', 'First request', 'A client left a request', leads, 1],
      ['🚀', 'Request machine', '10 requests', leads, 10],
      ['💰', 'First sale', 'A client paid', sales, 1],
      ['👥', 'Team player', 'First partner in your team', data.team, 1],
      ['🏆', 'Team leader', '5 partners in your team', data.team, 5],
    ]);
    renderPrompts();

    $('[data-links]').replaceChildren(
      ...data.links.map((l) => {
        const tr = document.createElement('tr');
        if (!l.active) tr.className = 'off';
        const url = `${location.origin}/r/${l.slug}`;
        const linkTd = document.createElement('td');
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'ghost';
        copy.textContent = url.replace(/^https?:\/\//, '');
        copy.title = 'Copy';
        copy.onclick = () => navigator.clipboard?.writeText(url).then(() => flash(copy, 'Copied ✓'));
        linkTd.append(copy);
        const actTd = document.createElement('td');
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'ghost';
        toggle.textContent = l.active ? 'Turn off' : 'Turn on';
        toggle.onclick = async () => {
          await api(`links/${l.id}/toggle`, {});
          load();
        };
        actTd.append(toggle);
        tr.append(cell(l.name), linkTd, cell(String(l.clicks)), cell(String(l.leads)), actTd);
        return tr;
      }),
    );
    if (view !== 'cabinet') show('cabinet');
  }

  // ---- auth ----
  $$<HTMLButtonElement>('[data-tab]').forEach((b) =>
    b.addEventListener('click', () => {
      $$('[data-tab]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      $('[data-form="register"]').hidden = b.dataset.tab !== 'register';
      $('[data-form="login"]').hidden = b.dataset.tab !== 'login';
    }),
  );
  const params = new URLSearchParams(location.search);
  const invite = params.get('invite') ?? '';
  if (params.get('tab') === 'login') $<HTMLButtonElement>('[data-tab="login"]').click();

  for (const kind of ['register', 'login'] as const) {
    const form = $<HTMLFormElement>(`[data-form="${kind}"]`);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const body: Record<string, unknown> = Object.fromEntries(fd.entries());
      if (kind === 'register') Object.assign(body, { adult: fd.has('adult'), rules: fd.has('rules'), invite });
      const err = form.querySelector<HTMLElement>('[data-err]')!;
      const res = await api(kind, body);
      if (res.ok) return load();
      const out = (await res.json().catch(() => ({}))) as { reason?: string };
      err.textContent =
        kind === 'login' ? 'Wrong email or password.' : out.reason === 'exists' ? 'This email already has an account — log in instead.' : 'Please check the fields and both boxes.';
      err.hidden = false;
    });
  }

  $<HTMLFormElement>('[data-form="link"]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    await api('links', Object.fromEntries(new FormData(form).entries()));
    form.reset();
    load();
  });

  $('[data-logout]').addEventListener('click', async () => {
    await api('logout', {});
    show('auth');
  });
  $('[data-copy-main]').addEventListener('click', (e) => navigator.clipboard?.writeText(mainLink).then(() => flash(e.currentTarget as HTMLElement, 'Copied ✓')));
  $('[data-share-main]').addEventListener('click', (e) => share(mainLink, e.currentTarget as HTMLElement));
  $('[data-copy-invite]').addEventListener('click', (e) => navigator.clipboard?.writeText(inviteLink).then(() => flash(e.currentTarget as HTMLElement, 'Copied ✓')));
  $('[data-share-invite]').addEventListener('click', (e) => share(inviteLink, e.currentTarget as HTMLElement));

  renderPrompts();
  load();
</script>

