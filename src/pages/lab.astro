---
// Vaxo Lab (/lab/, Decision 24): the paid tier of the INSIDERS Discord. English only — the community is international.
// Card payment through the existing mono invoices (worker/lab.ts); the Discord role is given by hand after payment.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, langPath } from '../i18n';

const lang = 'en';
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/lab/' };

const gets = [
  ['Real briefs every week', 'Each week a real small-business problem from our market research: a clinic without online booking, a café losing reviews, a shop with no follow-up. You solve it with AI; the best work gets a written review from the Vaxo team.'],
  ['First call on paid tasks', 'When Vaxo client projects need extra hands (design, video, research, outreach, no-code builds), Lab members get the offer first. Paid per task, agreed up front. No task is promised — they come when clients do.'],
  ['The Vaxo AI playbook', 'The prompts, templates and workflows we use ourselves to build sites, chats and content — updated weekly in #lab-playbook.'],
  ['Monthly profile review', 'Send your Upwork, Fiverr, LinkedIn or portfolio once a month and get a written teardown: what to cut, what to add, how to price.'],
  ['Answers within 24 hours', 'A private #lab channel. Ask anything about AI tools, clients or pricing — you get an answer within a day.'],
];
const faq = [
  ['Is this a get-rich course?', 'No. Nobody here promises income. Lab is practice on real problems, honest feedback and a fair chance at paid tasks.'],
  ['Who can join?', 'Only people 18 or older. If you are younger, you are still welcome in the free part of INSIDERS.'],
  ['How do I pay?', 'By card, Apple Pay or Google Pay on the monobank payment page. The price is in US dollars; your bank shows it in hryvnia at the day’s rate.'],
  ['Does it renew by itself?', 'No. You pay for one month at a time, nothing is charged automatically. We remind you in Discord before the month ends.'],
  ['Refunds?', 'If Lab is not for you, write to us within 14 days of payment and we return the money.'],
];
---

<Base lang={lang} title="Vaxo Lab — practice AI work on real business problems" description="The paid tier of the INSIDERS community: weekly real briefs, first call on paid tasks, the Vaxo AI playbook, monthly profile review. 18+." path="/lab/" alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="lab">
    <section class="hero">
      <p class="eyebrow">INSIDERS · Vaxo Lab</p>
      <h1>Learn AI work on real business problems.</h1>
      <p class="sub">A small paid room inside the INSIDERS Discord. Real briefs every week, honest feedback from the Vaxo studio, and the first call when our client projects need extra hands.</p>
      <div class="price"><b data-price>$5</b><span>/ month</span><s data-regular hidden>$9</s></div>
      <p class="seats" data-seats>Founding price for the first 50 members — it stays while you stay.</p>
      <a class="btn" href="#join">Join Vaxo Lab →</a>
    </section>

    <section class="gets">
      <h2>What you get</h2>
      <ol>
        {gets.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </section>

    <section class="join" id="join">
      <h2>Join</h2>
      <form data-lab>
        <label>Your name<input name="name" required maxlength="80" autocomplete="name" /></label>
        <label>Discord username<input name="discord" required maxlength="40" placeholder="e.g. alex_builds" /></label>
        <label>Email (for the receipt)<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
        <label class="chk"><input type="checkbox" name="adult" required /> I am 18 or older</label>
        <button class="btn" type="submit">Pay <span data-price>$5</span> and join →</button>
        <p class="msg" data-msg role="status"></p>
        <p class="fine">After payment we give you the Lab role in Discord within a few hours (usually much faster). Payment is processed by monobank; Vaxo is a registered Ukrainian business (FOP). <a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a></p>
      </form>
    </section>

    <section class="faq">
      <h2>Questions</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  const $ = (s: string) => document.querySelectorAll<HTMLElement>(s);
  fetch('/api/lab').then((r) => r.json()).then((d) => {
    if (!d?.ok) return;
    $('[data-price]').forEach((e) => (e.textContent = `$${d.price}`));
    const reg = document.querySelector<HTMLElement>('[data-regular]');
    if (reg && d.founding) reg.hidden = false;
    const seats = document.querySelector<HTMLElement>('[data-seats]');
    if (seats) seats.textContent = d.founding ? `Founding price for the first 50 members — ${d.seatsLeft} seats left. It stays while you stay.` : 'Regular price.';
  }).catch(() => {});

  const form = document.querySelector<HTMLFormElement>('[data-lab]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const f = new FormData(form);
    btn.disabled = true; msg.textContent = 'Opening the payment page…';
    try {
      const r = await fetch('/api/lab', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        name: f.get('name'), discord: f.get('discord'), email: f.get('email'), adult: f.get('adult') === 'on',
        src: (window as unknown as { vxSrc?: () => string }).vxSrc?.(),
      }) });
      const d = await r.json();
      if (d?.url) { location.href = d.url; return; }
      msg.textContent = d?.error === 'card_off' ? 'Card payment is paused right now. Please try again later.' : 'Not sent. Check the fields and try again.';
    } catch { msg.textContent = 'No connection. Please try again.'; }
    btn.disabled = false;
  });
</script>

<style>
  .lab { max-width: 760px; margin: 0 auto; padding: 48px 16px 80px; }
  .eyebrow { color: var(--accText); font-weight: 600; margin: 0 0 12px; }
  h1 { font-size: clamp(32px, 6vw, 52px); line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 16px; }
  .sub { font-size: 18px; color: var(--mut); line-height: 1.5; margin: 0 0 24px; }
  .price { display: flex; align-items: baseline; gap: 8px; }
  .price b { font-size: 48px; letter-spacing: -0.03em; }
  .price span { color: var(--mut); }
  .price s { color: var(--mut); font-size: 20px; }
  .seats { color: var(--mut); margin: 4px 0 20px; }
  .btn { display: inline-block; background: var(--acc); color: var(--dark-ink); border: 0; border-radius: 999px; padding: 14px 22px; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  .btn:disabled { opacity: 0.6; cursor: wait; }
  section { margin-top: 56px; }
  .hero { margin-top: 0; }
  h2 { font-size: 28px; letter-spacing: -0.02em; margin: 0 0 20px; }
  .gets ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; counter-reset: g; }
  .gets li { border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px 18px 60px; position: relative; counter-increment: g; }
  .gets li::before { content: counter(g); position: absolute; left: 20px; top: 18px; width: 26px; height: 26px; border-radius: 50%; background: var(--acc); color: var(--dark-ink); font-weight: 700; display: grid; place-items: center; font-size: 14px; }
  .gets h3 { margin: 0 0 6px; font-size: 18px; }
  .gets p { margin: 0; color: var(--mut); line-height: 1.5; }
  form { display: grid; gap: 14px; border: 1px solid var(--line); border-radius: 22px; padding: 22px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: 15px; }
  input:not([type=checkbox]) { font: inherit; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--ink); }
  .chk { display: flex; align-items: center; gap: 10px; font-weight: 500; }
  .chk input { width: 20px; height: 20px; accent-color: var(--acc); }
  .msg { margin: 0; min-height: 1.4em; color: var(--accText); }
  .fine { margin: 0; color: var(--mut); font-size: 13px; line-height: 1.5; }
  .fine a { color: inherit; }
  details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  summary { font-weight: 600; cursor: pointer; }
  details p { color: var(--mut); line-height: 1.5; margin: 10px 0 0; }
</style>
