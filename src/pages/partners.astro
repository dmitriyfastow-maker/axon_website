---
// Partner program landing: what partners promote, how it works, payouts, rules → sign up / log in at /partner/.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict } from '../i18n';

const lang = 'en';
const t = getDict(lang);

const directions = [
  {
    tag: '01',
    name: 'Agency services',
    price: 'from $149',
    what: 'Business automation, websites and AI chatbots. Starter packages at $149, $199 and $249 — and bigger custom projects when the client grows.',
  },
  {
    tag: '02',
    name: 'Our digital products',
    price: '$9 – $67',
    what: '12 ready-made templates and guides for small businesses: AI prompts, client tracker, pricing calculator, review kit and more. Easy first purchase.',
  },
  {
    tag: '03',
    name: 'Partner offers',
    price: 'coming soon',
    what: 'Selected offers from other companies, checked by us. Each one shows its own rules next to its link.',
  },
];

const steps = [
  ['Sign up', 'Free, takes a minute. 18+ only.'],
  ['Make your links', 'As many as you want — one for every channel, video or audience, so you see what works.'],
  ['Share honestly', 'Post, film, recommend. We give you free training and ready prompts.'],
  ['Get paid weekly', 'For real sales. Clicks, leads and your team are visible in the cabinet.'],
];

const perks = [
  ['Clients stay yours', 'The first link a client clicks is saved for good. If they come back and buy months later, it still counts for you.'],
  ['Unlimited tracking links', 'Separate stats for every link. Turn any link off and make a new one at any time.'],
  ['Free training', 'Learn to make short videos with free AI tools, plus copy-and-paste prompts for posts.'],
  ['Build a team', 'Invite other partners and earn a share of your team’s real sales — never for the invite itself.'],
];

const faq = [
  ['Does it cost anything?', 'No. Signing up and using the cabinet is free.'],
  ['Do I need experience?', 'No. The training section shows step by step how to make content and where to post it.'],
  ['How much will I earn?', 'Your commission is shown in the cabinet for each offer. We make no income promises: what you earn depends only on real sales you bring.'],
  ['When and how do I get paid?', 'Every week, for money we have received and held for 7 days (refund protection). Crypto (USDT) is our main payout method.'],
  ['Where can I promote?', 'Anywhere, honestly: social media, video, blogs, communities, your own clients. No spam, no fake reviews, no paid clicks.'],
];
---

<Base lang={lang} title="Vaxo Partners — earn by recommending AI for business" description="Join the Vaxo partner program: promote AI automation, websites, chatbots and digital templates for small businesses. Unlimited tracking links, lifetime clients, weekly payouts." path="/partners/">
  <Header lang={lang} t={t} home="/" />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">Partner program</div>
        <h1>Earn by recommending AI that businesses actually need.</h1>
        <p class="sub">Share our services and products with your audience. Get paid for every real sale — weekly.</p>
        <div class="ctas">
          <a class="btn" href="/partner/">Become a partner →</a>
          <a class="btn ghost" href="/partner/?tab=login">Log in</a>
        </div>
      </div>
    </section>

    <section>
      <div class="in">
        <h2>What you can promote</h2>
        <div class="grid three">
          {directions.map((d) => (
            <article class="card">
              <div class="tag">{d.tag}</div>
              <h3>{d.name}</h3>
              <div class="price">{d.price}</div>
              <p>{d.what}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="in">
        <h2>How it works</h2>
        <ol class="steps">
          {steps.map(([h, p]) => (
            <li class="card"><h3>{h}</h3><p>{p}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section>
      <div class="in">
        <h2>Why partners choose Vaxo</h2>
        <div class="grid two">
          {perks.map(([h, p]) => (
            <article class="card"><h3>{h}</h3><p>{p}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="in">
        <h2>Questions</h2>
        <div class="faq">
          {faq.map(([q, a]) => (
            <details class="card"><summary>{q}</summary><p>{a}</p></details>
          ))}
        </div>
        <p class="rules">18+ only. Honest promotion only. <a href="/partner/#rules">Read the full partner rules</a>.</p>
      </div>
    </section>

    <section class="final">
      <div class="in">
        <div class="box">
          <div>
            <h2>Ready to start?</h2>
            <p>Create your free account and get your first link in a minute.</p>
          </div>
          <div class="ctas">
            <a class="btn" href="/partner/">Create account →</a>
            <a class="btn ghost" href="/partner/?tab=login">Log in</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} home="/" />
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  section { padding: 32px 0; }
  .hero { padding: 120px 0 40px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 20ch; }
  h2 { font-size: clamp(26px, 4vw, 36px); letter-spacing: -0.01em; margin: 0 0 20px; }
  h3 { font-size: 20px; margin: 0 0 6px; }
  .sub { color: var(--mut); font-size: 19px; max-width: 60ch; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 24px; border-radius: 999px; text-decoration: none; white-space: nowrap; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  .grid { display: grid; gap: 16px; }
  .three { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .two { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .card p { color: var(--mut); margin: 0; }
  .tag { font-family: var(--mono); font-size: 13px; color: var(--mut); margin-bottom: 12px; }
  .price { font-size: 22px; font-weight: 700; color: var(--accText); margin-bottom: 10px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); counter-reset: s; }
  .steps li { counter-increment: s; }
  .steps li::before { content: counter(s); display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; background: var(--acc); color: var(--dark-ink); font-weight: 700; margin-bottom: 14px; }
  .faq { display: grid; gap: 10px; }
  .faq summary { font-weight: 600; font-size: 18px; cursor: pointer; }
  .faq p { margin-top: 10px; }
  .rules { color: var(--mut); margin: 20px 0 0; }
  .rules a { color: var(--accText); }
  .final { padding-bottom: 80px; }
  .box { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 28px; }
  .box p { color: var(--mut); margin: 0; }
  .box .ctas { margin-top: 0; }
</style>
