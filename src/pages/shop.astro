---
// Shop: ready-made templates and guides for small businesses (sold via Gumroad).
// Set `url` to the Gumroad link once the store is registered; empty = "Coming soon".
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict } from '../i18n';

const lang = 'en';
const t = getDict(lang);

const products = [
  {
    slug: 'ai-prompt-pack',
    name: 'AI Prompt Pack for Small Business',
    price: '$12',
    format: 'PDF · 13 pages',
    what: '100 copy-and-paste prompts for ChatGPT, Claude and Gemini: marketing, sales, customer replies, planning.',
    url: '',
  },
  {
    slug: 'lead-tracker',
    name: 'Lead & Client Tracker',
    price: '$9',
    format: 'Excel / Google Sheets',
    what: 'A simple CRM spreadsheet: every inquiry, its status and next step, with a summary of where clients come from.',
    url: '',
  },
  {
    slug: 'message-templates',
    name: '50 Customer Message Templates',
    price: '$9',
    format: 'PDF · 11 pages',
    what: 'Ready texts for inquiries, bookings, quotes, reminders, reviews and complaints. For SMS, WhatsApp, DMs and email.',
    url: '',
  },
  {
    slug: 'marketing-workbook',
    name: '90-Day Marketing Plan Workbook',
    price: '$12',
    format: 'Printable PDF',
    what: 'A fill-in plan to get more customers in the next 90 days — no marketing degree needed.',
    url: '',
  },
  {
    slug: 'faq-builder',
    name: 'AI Chatbot FAQ Builder',
    price: '$12',
    format: 'PDF · 16 pages',
    what: 'Write everything your AI assistant needs to answer customers correctly — prices, rules, examples — in one afternoon.',
    url: '',
  },
  {
    slug: 'pricing-calculator',
    name: 'Service Pricing & Quote Calculator',
    price: '$12',
    format: 'Excel · Google Sheets',
    what: 'Find what one hour of your work really costs, the right price for every service — and turn it into a client quote.',
    url: '',
  },
  {
    slug: 'content-calendar',
    name: 'Social Media Content Calendar',
    price: '$9',
    format: 'Excel · Google Sheets',
    what: 'Plan a year of posts in one afternoon: 12-month plan with key dates, 52-week planner, 60 post ideas and a dashboard.',
    url: '',
  },
  {
    slug: 'weekly-kpi',
    name: 'Weekly Planner & KPI Tracker',
    price: '$9',
    format: 'Excel · Google Sheets',
    what: '15 minutes every Monday: weekly scorecard, task list, 10 review questions and a dashboard with trends and quarters.',
    url: '',
  },
];
const bundle = { name: 'All 8 in one bundle', price: '$49', old: '$84', url: '' };
---

<Base lang={lang} title="Vaxo — Templates and guides for small businesses" description="Ready-made templates for small businesses: AI prompts, client tracker, message templates, a 90-day marketing plan, an AI chatbot FAQ builder, a pricing calculator, a social media content calendar and a weekly KPI tracker." path="/shop/">
  <Header lang={lang} t={t} home="/" />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">Shop</div>
        <h1>Do it yourself, with ready-made templates.</h1>
        <p class="sub">Simple tools we use with our own clients. Instant download, from $9. Want us to set it up for you? See <a href="/start/">starter packages</a>.</p>
      </div>
    </section>

    <section class="list">
      <div class="in grid">
        {products.map((p) => (
          <article class="card">
            <img src={`/shop/${p.slug}.jpg`} alt={p.name} width="800" height="450" loading="lazy" />
            <div class="body">
              <h2>{p.name}</h2>
              <div class="fmt">{p.format}</div>
              <p>{p.what}</p>
              <div class="buy">
                <span class="price">{p.price}</span>
                {p.url
                  ? <a class="btn" href={p.url} target="_blank" rel="noopener">Buy now →</a>
                  : <span class="btn off">Coming soon</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bundle">
      <div class="in">
        <div class="box">
          <div>
            <div class="eyebrow">Best value</div>
            <h2>{bundle.name}</h2>
            <p>Every template above in one download.</p>
          </div>
          <div class="buy">
            <span class="price">{bundle.price} <s>{bundle.old}</s></span>
            {bundle.url
              ? <a class="btn" href={bundle.url} target="_blank" rel="noopener">Get the bundle →</a>
              : <span class="btn off">Coming soon</span>}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} home="/" />
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .hero { padding: 120px 0 40px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 18ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 60ch; margin: 0; }
  .sub a { color: var(--accText); }
  .list { padding: 24px 0 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
  .card img { width: 100%; height: auto; display: block; border-bottom: 1px solid var(--line); }
  .body { padding: 20px 24px 24px; display: flex; flex-direction: column; flex: 1; }
  .card h2 { font-size: 20px; margin: 0 0 4px; }
  .fmt { font-family: var(--mono); font-size: 13px; color: var(--mut); margin-bottom: 10px; }
  .card p { color: var(--mut); margin: 0 0 16px; flex: 1; }
  .buy { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .price { font-size: 28px; font-weight: 700; color: var(--accText); }
  .price s { font-size: 16px; font-weight: 400; color: var(--mut); }
  .btn { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 12px 20px; border-radius: 999px; text-decoration: none; white-space: nowrap; }
  .btn.off { background: transparent; color: var(--mut); border: 1px solid var(--line); cursor: default; }
  .bundle { padding: 0 0 80px; }
  .box { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .box h2 { font-size: 26px; margin: 8px 0 4px; }
  .box p { color: var(--mut); margin: 0; }
</style>
