---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { getDict, langPath } from '../i18n';

const lang = 'en';
const t = getDict(lang);
---

<Base lang={lang} title="Vaxo — not an answer, a result: Vax does it for you" description="Write a task in your own words. Vax sees it through: a working site with booking and payments, a CRM, an AI consultant that answers your customers, plans and calculations. Free, no sign-up." path={langPath(lang)}>
  <script is:inline slot="head">
    // Return visitors who picked UA/RU land on their language.
    try {
      var l = localStorage.getItem('axon_lang');
      if (l === 'ua' || l === 'ru') location.replace('/' + l + '/' + location.hash);
    } catch (e) {}
  </script>
  <Landing lang={lang} />
</Base>
