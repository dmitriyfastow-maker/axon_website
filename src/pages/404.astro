---
import Base from '../layouts/Base.astro';
import VaxSays from '../components/VaxSays.astro';
import { getDict, LANGS, langPath } from '../i18n';

const t = getDict('en');
const labels = { en: 'English', ua: 'Українська', ru: 'Русский' };
---

<Base lang="en" title="Vaxo — Page not found" description={t.sub} noindex>
  <main class="nf">
    <a href="/" class="logo">VAXO<span>.</span></a>
    <div class="eyebrow">◆ 404</div>
    <h1 data-h>Page not found</h1>
    <p data-p>This page doesn’t exist. Tell Vax what you were looking for, or go to the homepage.</p>
    <VaxSays text={t.vax.notFound} pose="lost" />
    <nav>
      <a href="/app/" class="btn main" data-app>Open Workspace</a>
      {LANGS.map((l) => <a href={langPath(l)} class="btn" data-l={l}>{labels[l]}</a>)}
    </nav>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    max-width: 720px;
    margin: 0 auto;
    padding: 48px clamp(20px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .logo {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .logo span {
    color: var(--acc);
  }
  h1 {
    margin: 0;
    font-size: clamp(50px, 7vw, 100px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--mut);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .btn {
    border: 1px solid var(--line);
    background: var(--surf);
    padding: 16px 26px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
  }
  .btn.main {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--dark-ink);
  }
</style>

<script>
  const D: Record<string, [string, string, string, string]> = {
    ua: ['Сторінку не знайдено', 'Такої сторінки не існує. Опишіть, що шукали, — Vax допоможе, або перейдіть на головну.', 'Навіть єноти іноді губляться. Ходімо додому.', 'Відкрити Workspace'],
    ru: ['Страница не найдена', 'Такой страницы нет. Опишите, что искали, — Vax поможет, или перейдите на главную.', 'Даже еноты иногда теряются. Пойдёмте домой.', 'Открыть Workspace'],
  };
  const l = (navigator.language || 'en').slice(0, 2).replace('uk', 'ua');
  const lang = location.pathname.startsWith('/ua/') ? 'ua' : location.pathname.startsWith('/ru/') ? 'ru' : D[l] ? l : 'en';
  const d = D[lang];
  if (d) {
    document.documentElement.lang = lang === 'ua' ? 'uk' : lang;
    document.querySelector('[data-h]')!.textContent = d[0];
    document.querySelector('[data-p]')!.textContent = d[1];
    const b = document.querySelector('.nf .vax-bubble'); if (b) b.textContent = d[2];
    const a = document.querySelector<HTMLAnchorElement>('[data-app]')!; a.textContent = d[3]; a.href = '/' + lang + '/app/';
    document.title = 'Vaxo — ' + d[0];
  }
  // Language of this visitor goes first among the homepage links.
  const cur = document.querySelector('[data-l="' + lang + '"]');
  if (cur) document.querySelector('[data-app]')!.after(cur);
</script>
