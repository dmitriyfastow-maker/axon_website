---
import Base from '../layouts/Base.astro';
import VaxSays from '../components/VaxSays.astro';
import { getDict, LANGS, langPath } from '../i18n';

const t = getDict('en');
const labels = { en: 'English', ua: 'Українська', ru: 'Русский' };
---

<Base lang="en" title="Vaxo — Page not found" description={t.sub} noindex>
  <main class="nf">
    <a href="/" class="logo">VAXO<span>.</span></a>
    <div class="eyebrow">◆ 404</div>
    <h1 data-h>Page not found</h1>
    <p data-p>The page you are looking for doesn’t exist. Choose a language to go to the homepage.</p>
    <VaxSays text={t.vax.notFound} pose="lost" />
    <nav>
      {LANGS.map((l) => <a href={langPath(l)} class="btn">{labels[l]}</a>)}
    </nav>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    max-width: 720px;
    margin: 0 auto;
    padding: 48px clamp(20px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .logo {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .logo span {
    color: var(--acc);
  }
  h1 {
    margin: 0;
    font-size: clamp(50px, 7vw, 100px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--mut);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .btn {
    border: 1px solid var(--line);
    background: var(--surf);
    padding: 16px 26px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
  }
  .btn:first-child {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--dark-ink);
  }
</style>

<script>
  const D: Record<string, [string, string]> = {
    ua: ['Сторінку не знайдено', 'Такої сторінки не існує. Оберіть мову, щоб перейти на головну.'],
    ru: ['Страница не найдена', 'Такой страницы нет. Выберите язык, чтобы перейти на главную.'],
  };
  const l = (navigator.language || 'en').slice(0, 2).replace('uk', 'ua');
  const d = D[location.pathname.startsWith('/ua/') ? 'ua' : location.pathname.startsWith('/ru/') ? 'ru' : l];
  if (d) { document.querySelector('[data-h]')!.textContent = d[0]; document.querySelector('[data-p]')!.textContent = d[1]; document.title = 'Vaxo — ' + d[0]; }
</script>
