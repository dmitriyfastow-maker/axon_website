---
// Starter packages: a low-risk first step for small businesses (Decision 03).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getDict } from '../i18n';

const lang = 'en';
const t = getDict(lang);

const packages = [
  {
    name: 'AI chat assistant',
    price: '$249',
    what: 'A chatbot on your website that answers common questions 24/7 and collects contact details of new customers.',
    get: ['Trained on your services, prices and FAQ', 'Leads sent to your email or Telegram', 'Works on any website'],
  },
  {
    name: 'One-page website',
    price: '$199',
    what: 'A clean, fast page that explains what you do and turns visitors into inquiries.',
    get: ['Mobile-first design', 'Contact form and click-to-call', 'Basic Google setup'],
  },
  {
    name: 'One automation',
    price: '$149',
    what: 'One routine task done for you automatically, so no request gets lost.',
    get: ['Website requests into a sheet or CRM', 'Instant notifications to your phone', 'Auto-reply to every new lead'],
  },
];

const steps = [
  { n: '01', title: 'Try it', price: '$149 – $249', text: 'One starter package, delivered within 7 days. One round of edits included.' },
  { n: '02', title: 'Grow', price: 'from $800', text: 'Full website, lead funnel or ads. The starter price is credited if you continue within 30 days.' },
  { n: '03', title: 'Keep it running', price: '$50 – $200 / mo', text: 'Support, updates and a monthly report. You focus on clients, we keep the system working.' },
];
---

<Base lang={lang} title="Vaxo — Starter packages for small businesses" description="Start small: an AI chat assistant, a one-page website or one automation, delivered within 7 days." path="/start/">
  <Header lang={lang} t={t} home="/" />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">Starter packages</div>
        <h1>Start small. See the result in 7 days.</h1>
        <p class="sub">Not ready for a big project? Pick one small thing that brings you customers now. If you like the result, we grow it step by step.</p>
        <a href="#contact" class="cta">Pick a package →</a>
      </div>
    </section>

    <section class="packs" id="packages">
      <div class="in grid">
        {packages.map((p) => (
          <article class="card">
            <h2>{p.name}</h2>
            <div class="price">{p.price}<span> one-time</span></div>
            <p>{p.what}</p>
            <ul>{p.get.map((g) => <li>{g}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="road">
      <div class="in">
        <div class="eyebrow">Your growth plan</div>
        <h2 class="h2">The starter package is step one, not the whole story</h2>
        <ol>
          {steps.map((s) => (
            <li>
              <span class="n">{s.n}</span>
              <div><strong>{s.title}</strong> <span class="p">{s.price}</span><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Contact t={t} lang={lang} />
  </main>
  <Footer t={t} home="/" />
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .hero { padding: 120px 0 56px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 16ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 56ch; margin: 0 0 28px; }
  .cta { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 22px; border-radius: 999px; text-decoration: none; }
  .packs { padding: 24px 0 64px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .card h2 { font-size: 22px; margin: 0 0 8px; }
  .price { font-size: 32px; font-weight: 700; color: var(--accText); margin-bottom: 12px; }
  .price span { font-size: 14px; font-weight: 400; color: var(--mut); }
  .card p { color: var(--mut); margin: 0 0 12px; }
  .card ul { margin: 0; padding-left: 18px; }
  .card li { margin: 6px 0; }
  .road { padding: 24px 0 80px; }
  .road ol { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .road li { display: flex; gap: 16px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px 24px; }
  .road .n { font-family: var(--mono); color: var(--accText); font-weight: 600; }
  .road .p { color: var(--accText); margin-left: 8px; }
  .road p { color: var(--mut); margin: 6px 0 0; }
</style>
