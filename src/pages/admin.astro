    const list = (rows: R[], k: string) => rows.length ? el('ol', { class: 'rank' }, ...rows.map((r) => el('li', {}, el('span', {}, String(r[k])), el('b', {}, String(r.n))))) : el('p', { class: 'mut' }, 'Пока нет данных.');
