          offer.cut && el('button', { class: 'ghost', type: 'button', title: offer.cut.scope, onclick: async () => { if (confirm(`Урезанный вариант за ${offer.cut.price}: ${offer.cut.scope}`)) { await api(`/lead/${id}/offer`, { choice: 'c' }); await load(); openLead(id); } } }, 'Урезанный вариант'),
          el('button', { class: 'ghost', type: 'button', onclick: async () => { const c = prompt('Ваша цена (например, $250):'); if (c) { await api(`/lead/${id}/offer`, { accept: false, counter: c }); await load(); openLead(id); } } }, 'Своя цена'),
          el('button', { class: 'ghost', type: 'button', onclick: async () => { if (confirm('Отказать? Vax вежливо предложит меньший шаг.')) { await api(`/lead/${id}/offer`, { accept: false }); await load(); openLead(id); } } }, 'Отказать')),
