---
// Owner dashboard: every lead (with the partner who brought it) and every partner's numbers.
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="Vaxo — owner" description="Owner dashboard" path="/admin/" noindex>
  <main class="wrap">
    <h1>Vaxo — owner</h1>
    <form data-login class="row" hidden>
      <input type="password" name="token" placeholder="Admin key" autocomplete="off" />
      <button class="cta">Open</button>
    </form>
    <div data-data hidden>
      <p class="row"><b data-count="leads"></b>&nbsp;leads · <b data-count="partners"></b>&nbsp;partners <button type="button" class="ghost" data-out>Lock</button></p>
      <h2>Leads</h2>
      <div class="table"><table><thead><tr><th>Date</th><th>Name</th><th>Contact</th><th>Interest</th><th>Partner</th><th>Country</th><th>Message</th></tr></thead><tbody data-leads></tbody></table></div>
      <h2>Partners</h2>
      <div class="table"><table><thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Invited by</th><th>Links</th><th>Clicks</th><th>Leads</th><th>Team</th></tr></thead><tbody data-partners></tbody></table></div>
    </div>
  </main>
</Base>

<script>
  const KEY = 'vaxo_admin';
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const row = (cells: unknown[]) => {
    const tr = document.createElement('tr');
    for (const c of cells) {
      const td = document.createElement('td');
      td.textContent = c == null ? '' : String(c);
      tr.append(td);
    }
    return tr;
  };
  async function load() {
    let token = '';
    try { token = sessionStorage.getItem(KEY) ?? ''; } catch {}
    if (!token) return ($('[data-login]').hidden = false);
    const res = await fetch('/api/admin', { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) {
      try { sessionStorage.removeItem(KEY); } catch {}
      return ($('[data-login]').hidden = false);
    }
    type R = Record<string, unknown>;
    const d = (await res.json()) as { leads: R[]; partners: R[] };
    $('[data-count="leads"]').textContent = String(d.leads.length);
    $('[data-count="partners"]').textContent = String(d.partners.length);
    $('[data-leads]').replaceChildren(...d.leads.map((l) => row([l.created_at, l.name, l.contact, l.interest, l.partner_name ?? (l.ref ? `link ${l.ref}` : '—'), l.country, l.message])));
    $('[data-partners]').replaceChildren(...d.partners.map((p) => row([p.name, p.email, p.created_at, p.invited_by ?? '—', p.links, p.clicks, p.leads, p.team])));
    $('[data-login]').hidden = true;
    $('[data-data]').hidden = false;
  }
  $<HTMLFormElement>('[data-login]').addEventListener('submit', (e) => {
    e.preventDefault();
    const v = new FormData(e.currentTarget as HTMLFormElement).get('token');
    try { sessionStorage.setItem(KEY, String(v ?? '')); } catch {}
    load();
  });
  $('[data-out]').addEventListener('click', () => {
    try { sessionStorage.removeItem(KEY); } catch {}
    location.reload();
  });
  load();
</script>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 24px 16px 80px; }
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  input { font: inherit; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--surf); color: var(--ink); min-width: 0; flex: 1 1 240px; max-width: 420px; }
  .cta { background: var(--acc); color: var(--dark-ink); font-weight: 600; border: 0; border-radius: 999px; padding: 10px 18px; cursor: pointer; }
  .ghost { background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; padding: 6px 12px; cursor: pointer; margin-left: 8px; }
  .table { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  td:last-child { max-width: 320px; }
  th { color: var(--mut); font-weight: 500; }
</style>
