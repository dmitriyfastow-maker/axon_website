  const pill = (k: string, n: number) => { const p = $(`[data-n="${k}"]`); p.hidden = !n; p.textContent = String(n); };

  // ---- visual picture of the company: funnel, sources, who leads clients, money by month ----
  const PAL = ['#E0A84F', '#5B8DEF', '#3FB68B', '#E46F6F', '#A77BE0', '#4FB8C9', '#9AA0A6'];
  const NS = 'http://www.w3.org/2000/svg';
  const svgEl = (tag: string, attrs: R) => { const e = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v)); return e; };
  function donut(title: string, parts: [string, number][]) {
    const total = parts.reduce((a, [, n]) => a + n, 0);
    const svg = svgEl('svg', { viewBox: '0 0 120 120', width: 120, height: 120, role: 'img', 'aria-label': title });
    let a0 = -Math.PI / 2;
    parts.forEach(([, n], i) => {
      if (!n) return;
      const a1 = a0 + (n / total) * Math.PI * 2 - (n === total ? 0.0001 : 0);
      const big = a1 - a0 > Math.PI ? 1 : 0;
      const p = (a: number, rr: number) => `${60 + rr * Math.cos(a)} ${60 + rr * Math.sin(a)}`;
      svg.append(svgEl('path', { d: `M${p(a0, 54)}A54 54 0 ${big} 1 ${p(a1, 54)}L${p(a1, 32)}A32 32 0 ${big} 0 ${p(a0, 32)}Z`, fill: PAL[i % PAL.length] }));
      a0 = a1;
    });
    const tx = svgEl('text', { x: 60, y: 66, 'text-anchor': 'middle', 'font-size': 18, 'font-weight': 700, fill: 'currentColor' });
    tx.textContent = String(total);
    svg.append(tx);
    return el('div', { class: 'pcard' }, el('b', {}, title),
      el('div', { class: 'prow' }, total ? svg : el('p', { class: 'mut' }, 'пока нет данных'),
        el('ul', { class: 'legend' }, ...parts.filter(([, n]) => n).map(([k, n], i) => el('li', {}, el('i', { style: `background:${PAL[parts.findIndex((x) => x[0] === k) % PAL.length]}` }), `${k} — ${n}`)))));
  }
  function funnel(title: string, steps: [string, number][]) {
    const max = Math.max(1, ...steps.map(([, n]) => n));
    return el('div', { class: 'pcard wide' }, el('b', {}, title), ...steps.map(([k, n], i) => {
      const prev = i ? steps[i - 1][1] : 0;
      return el('div', { class: 'pfrow' }, el('span', { class: 'pfl' }, k),
        el('span', { class: 'pfbar' }, el('span', { style: `width:${Math.max(2, (n / max) * 100)}%;background:${PAL[i % PAL.length]}` })),
        el('span', { class: 'pfn' }, `${n}${i && prev ? ` · ${Math.round((n / prev) * 100)}%` : ''}`));
    }));
  }
  function bars(title: string, rows: [string, number][]) {
    const max = Math.max(1, ...rows.map(([, n]) => n));
    return el('div', { class: 'pcard wide' }, el('b', {}, title), el('div', { class: 'vbars' }, ...rows.map(([k, n]) =>
      el('div', { class: 'vb' }, el('small', {}, n ? usd(n) : ''), el('span', { style: `height:${(n / max) * 100}%` }), el('small', {}, k)))));
  }
  function renderPicture() {
    const L = (data.leads as R[]).filter((l) => l.status !== 'archived');
    const clients = L.filter((l) => !['collab', 'gift'].includes(l.status));
    const src = (l: R) => l.status === 'gift' ? 'Подарки' : l.mode === 'telegram' ? 'Telegram' : l.mode === 'email' ? 'Почта' : l.mode === 'collab' ? 'Сотрудничество' : l.partner_name ? 'Партнёры' : (l.message || '').startsWith('[Vax chat]') ? 'Чат на сайте' : 'Форма на сайте';
    const srcNames = ['Форма на сайте', 'Чат на сайте', 'Партнёры', 'Telegram', 'Почта', 'Сотрудничество', 'Подарки'];
    const months: [string, number][] = [];
    const now = new Date();
    for (let i = 5; i >= 0; i--) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
      const won = clients.filter((l) => l.status === 'won' && String(l.updated_at || l.created_at).slice(0, 7) === key).reduce((a, l) => a + (l.value_usd || 0), 0);
      const ren = ((data.payouts || []) as R[]).filter((p) => String(p.kind).startsWith('renewal') && String(p.created_at).slice(0, 7) === key).reduce((a, p) => a + (p.base_usd || 0), 0);
      months.push([d.toLocaleString('ru', { month: 'short' }), won + ren]);
    }
    $('[data-pic]').replaceChildren(
      funnel('Воронка клиентов', [
        ['Обратились', clients.length],
        ['Идёт разговор', clients.filter((l) => l.msgs > 0).length],
        ['Предложение', clients.filter((l) => ['proposal', 'won'].includes(l.status)).length],
        ['Оплатили', clients.filter((l) => l.status === 'won').length],
      ]),
      donut('Откуда приходят', srcNames.map((k) => [k, L.filter((l) => src(l) === k).length] as [string, number])),
      donut('Кто ведёт клиентов', [
        ['ИИ сам', clients.filter((l) => l.ai !== 'paused' && !l.closer_id && !l.human).length],
        ['ИИ + менеджер', clients.filter((l) => l.ai !== 'paused' && l.closer_id).length],
        ['Только человек', clients.filter((l) => l.ai === 'paused').length],
        ['Ждут человека', clients.filter((l) => l.human && !l.closer_id).length],
      ]),
      bars('Деньги по месяцам (новые сделки + продления)', months),
    );
  }

