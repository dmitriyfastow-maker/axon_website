    ];
    $('[data-kpis]').replaceChildren(...tiles.map(([t, v, h]) => el('div', { class: 'kpi' }, el('small', {}, t), el('b', {}, String(v)), el('span', {}, h))));
    const due = (data.payouts as R[]).filter((p) => p.status === 'due');
    const todo: [number, string, string, () => void][] = [
      [by((l) => l.status === 'new'), 'Новые заявки — проверьте профиль и нажмите «Опубликовать»', '📋', () => { filter = 'new'; renderLeads(); show('leads'); }],
      [by(waitingReply), 'Клиенты ждут ответа', '💬', () => show('chats')],
      [by((l) => ACTIVE.includes(l.status) && left(l.due_at) === 'просрочено'), 'Просрочен этап у менеджера', '⏰', () => { filter = 'work'; renderLeads(); show('leads'); }],
      [by((l) => l.status === 'open'), 'Заявки ждут менеджера (никто не взял)', '🙋', () => { filter = 'open'; renderLeads(); show('leads'); }],
      [data.partners.filter((p: R) => p.closer === 'applied').length, 'Анкеты менеджеров на проверке', '📝', () => show('team')],
      [due.length, `Выплаты партнёрам к оплате: ${usd(due.reduce((a, p) => a + p.amount_usd, 0))}`, '💸', () => show('pay')],
    ];
    const active = todo.filter(([n]) => n > 0);
    $('[data-todo]').replaceChildren(...(active.length ? active.map(([n, t, i, go]) => el('button', { type: 'button', class: 'todo-i', onclick: go }, el('span', { class: 'ico' }, i), el('b', {}, String(n)), el('span', {}, t), el('span', { class: 'go' }, '→'))) :
      [el('p', { class: 'ok' }, '✅ Всё под контролем — срочных дел нет.')]));
    pill('today', active.reduce((a, [n]) => a + n, 0));
