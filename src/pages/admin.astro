      el('div', { class: 'two' }, field(`Правок использовано (из ${l.revisions_total ?? (l.promo ? 5 : 2)})`, 'revisions_used', String(l.revisions_used ?? 0)), field('Кругов правок всего (пусто = 2, своим 5)', 'revisions_total', l.revisions_total ?? '')),
