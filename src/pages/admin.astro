      $('[data-gosrc]').replaceChildren((U.go as R[] || []).length ? el('ol', { class: 'rank' }, ...(U.go as R[]).map((x) => el('li', {}, el('span', {}, 'vaxogroup.com' + x.s), el('b', {}, String(x.n))))) : el('p', { class: 'mut' }, 'Переходов пока нет. Ссылки: /go/vaxo (Instagram Дмитрия → сайт), /go/insiders (→ Discord), /go/vaxo-yt, /go/vaxo-tt, /go/vaxo-discord.'));
      $('[data-uxpages]').replaceChildren(...((U.pages as R[]).length ? (U.pages as R[]).map((x) => el('tr', {}, ...[x.p, x.visits, `${x.depth ?? '—'}%`, `${x.bottom ?? 0}%`, x.secs ?? '—', x.clicks].map((c) => el('td', {}, String(c))))) : [el('tr', {}, el('td', { colspan: '6', class: 'empty' }, 'Пока нет данных — копятся с 29.10.'))]));
