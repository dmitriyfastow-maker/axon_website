---
// Owner HQ: everything in one place — what needs attention today, client chats, leads, team, payouts,
// the cartoon pipeline, every link and decision, and how the whole system works. Data comes only from /api/admin (key).
import Base from '../layouts/Base.astro';
---

<Base lang="ru" title="Vaxo CRM" description="Owner HQ" path="/admin/" noindex noChat>
  <main class="adm">
    <header class="top">
      <h1>Vaxo <span>· CRM</span> <small class="mut" data-who></small></h1>
      <div class="top-r" data-on hidden>
        <button type="button" class="ghost" data-reload>Обновить</button>
        <button type="button" class="ghost" data-out>Выйти</button>
      </div>
    </header>
    <div class="login" data-loginbox hidden>
      <p>Vaxo CRM: заявки, клиенты, деньги, партнёры, соцсети и Claude — в одном месте.</p>
      <form data-mail class="login">
        <b>Войти по почте</b>
        <input type="email" name="email" placeholder="Ваш email" autocomplete="email" required />
        <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6 цифр из письма" hidden />
        <button class="cta" type="submit" data-mail-btn>Получить код</button>
        <small class="mut" data-mail-msg></small>
        <div class="mut" data-mail-more hidden>
          <button type="button" class="ghost" data-mail-again disabled>Отправить ещё раз</button>
          <button type="button" class="ghost" data-mail-change>Другая почта</button>
        </div>
      </form>
      <details><summary class="mut">Войти ключом владельца</summary>
        <form data-login class="login">
          <input type="password" name="token" placeholder="Ключ владельца" autocomplete="current-password" />
          <button class="cta">Открыть</button>
        </form>
      </details>
    </div>
    <div data-app hidden>
      <nav class="tabs" aria-label="Разделы">
        <button type="button" data-view="today" aria-pressed="true">📊 Обзор <span class="pill" data-n="today" hidden></span></button>
        <button type="button" data-view="outbox" aria-pressed="false">✅ Ждёт вашего «да» и рассылки <span class="pill" data-n="outbox" hidden></span></button>
        <button type="button" data-view="chats" aria-pressed="false">💬 Клиенты <span class="pill" data-n="chats" hidden></span></button>
        <button type="button" data-view="claude" aria-pressed="false">🧠 Claude <span class="pill" data-n="claude" hidden></span></button>
        <button type="button" data-view="fin" aria-pressed="false">💰 Деньги</button>
        <button type="button" class="more" data-more aria-expanded="false">Ещё ▾</button>
        <span class="sec">
        <button type="button" data-view="plan" aria-pressed="false">🔮 Планы и прогноз</button>
        <button type="button" data-view="social" aria-pressed="false">📣 Соцсети</button>
        <button type="button" data-view="work" aria-pressed="false">📋 Вся работа Claude</button>
        <button type="button" data-view="stats" aria-pressed="false">📊 Аналитика</button>
        <button type="button" data-view="leads" aria-pressed="false">📋 Все заявки</button>
        <button type="button" data-view="team" aria-pressed="false">👥 Партнёры <span class="pill" data-n="team" hidden></span></button>
        <button type="button" data-view="pay" aria-pressed="false">💸 Выплаты <span class="pill" data-n="pay" hidden></span></button>
        <button type="button" data-view="cartoon" aria-pressed="false">🎬 Мультик</button>
        <button type="button" data-view="auto" aria-pressed="false">🤖 Автопилот</button>
        <button type="button" data-view="links" aria-pressed="false">🔗 Все ссылки</button>
        <button type="button" data-view="access" aria-pressed="false" hidden>🔐 Доступы</button>
        <button type="button" data-view="help" aria-pressed="false">❓ Как это работает</button>
        </span>
      </nav>

      <section data-panel="today">
        <form class="say" data-say>
          <textarea name="text" rows="1" placeholder="Скажите Claude, что сделать или изменить — например: «сделай 3 ролика про кофейни» или «перестань писать партнёрам по выходным»"></textarea>
          <button class="cta">Отправить Claude</button>
        </form>
        <small class="mut" data-say-msg></small>
        <section class="assist">
          <h2>✦ Ваш ИИ-помощник <small class="mut" data-assist-who></small></h2>
          <div class="tips" data-tips></div>
          <form class="say" data-ask><textarea name="q" rows="1" placeholder="Спросите помощника — например: «что сделать сегодня, чтобы быстрее получить первую оплату?»"></textarea><button class="cta">Спросить</button></form>
          <div class="assist-a" data-ask-a hidden></div>
        </section>
        <h2>💰 Путь клиента: от заявки до денег</h2>
        <div class="pipe" data-pipe></div>
        <h2>Все процессы</h2>
        <div class="procs" data-procs></div>
        <div class="digest" data-digest hidden><h2>☀️ Сводка дня от автопилота</h2><pre data-digest-text></pre><small class="mut" data-digest-at></small></div>
        <h2>Последние переписки <button type="button" class="ghost sm" data-go-chats>Все переписки →</button></h2>
        <div class="inbox" data-recent></div>
        <h2>Требует внимания</h2>
        <div class="todo" data-todo></div>
        <details class="tmore"><summary>Подробнее: цифры, картина компании, мой последний отчёт</summary>
        <div class="kpis" data-kpis></div>
        <h2>Картина компании</h2>
        <div class="pic" data-pic></div>
        <div class="cols">
          <div><h2>Ждёт ваших действий</h2><ul class="tasks" data-tasks></ul></div>
          <div><h2>Последний отчёт Claude</h2><pre class="report" data-report></pre></div>
        </div>
        </details>
      </section>

      <section data-panel="stats" hidden>
        <p class="hint">Последние 30 дней. Посещения считаются без cookies и без личных данных.</p>
        <h2>Воронка</h2>
        <div class="funnel" data-funnel></div>
        <div class="cols">
          <div><h2>Посещения по дням</h2><div class="bars" data-bars></div></div>
          <div><h2>Откуда приходят</h2><div data-sources></div></div>
          <div><h2>Страны</h2><div data-countries></div></div>
          <div><h2>Популярные страницы</h2><div data-pages></div></div>
        </div>
        <h2>Откуда приходят заявки</h2>
        <p class="hint">Первый источник каждого человека: метка ссылки (utm_source), другой сайт или прямой заход. Ссылки с метками — во вкладке «Ссылки».</p>
        <div data-leadsrc></div>
        <h2>Переходы по коротким ссылкам (vaxogroup.com/go/…)</h2>
        <div data-gosrc></div>
        <h2>Поведение на сайте</h2>
        <p class="hint">Своя аналитика без cookies (как Яндекс Метрика / Clarity): докуда листают, сколько сидят, на что жмут. «Мёртвый клик» — жмут на то, что не кнопка (думают, что кликабельно). «Злой клик» — 3+ раза подряд в одно место (что-то не работает). Боты и дата-центры не считаются.</p>
        <div class="table"><table><thead><tr><th>Страница</th><th>Визиты</th><th>Долистали, в среднем</th><th>До конца</th><th>Время, сек</th><th>Клики</th></tr></thead><tbody data-uxpages></tbody></table></div>
        <div class="cols">
          <div><h2>На что жмут</h2><div data-uxclicks></div></div>
          <div><h2>Мёртвые клики (слепые зоны)</h2><div data-uxdead></div></div>
          <div><h2>Злые клики</h2><div data-uxrage></div></div>
        </div>
        <h2>Менеджеры — рейтинг</h2>
        <p class="hint">Автоматическая оценка: победы минус пропущенные сроки и замечания контроля качества. Если вы ставите оценку вручную — главная ваша.</p>
        <div class="table"><table><thead><tr><th>Менеджер</th><th>Взял</th><th>Клиенты</th><th>Выручка</th><th>Пропуски</th><th>Замечания</th><th>Авто-оценка</th></tr></thead><tbody data-mgr></tbody></table></div>
      </section>

      <section data-panel="auto" hidden class="help">
        <p class="hint">Автопилот делает работу за вас. Каждую часть можно выключить — тогда это решение будет ждать вас в «Сегодня».</p>
        <div class="toggles" data-toggles></div>
        <div class="btns"><button type="button" class="cta" data-digest-now>Сделать сводку сейчас</button></div>
        <h2>Прошлые сводки</h2>
        <div data-digests></div>
        <h2>📣 Уведомить клиентов об изменении условий</h2>
        <form class="card" data-notice>
          <p class="mut">Письмо и сообщение в чате всем, у кого есть кабинет или активный заказ. Дата — не раньше чем через 14 дней (так требует оферта). Сначала «Проверить» — покажет, сколько людей получит.</p>
          <textarea name="en" rows="3" required placeholder="Что меняется — по-английски (обязательно)"></textarea>
          <textarea name="ru" rows="3" placeholder="По-русски (необязательно, иначе — английский)"></textarea>
          <textarea name="ua" rows="3" placeholder="Українською (необовʼязково)"></textarea>
          <div class="two"><input name="effective" type="date" required /><button class="ghost" type="submit" value="dry">Проверить</button><button class="cta" type="submit" value="send">Отправить</button></div>
          <p class="mut" data-notice-msg></p>
        </form>
        <h2>Что автопилот делает сам</h2>
        <ul>
          <li><b>Каждая заявка:</b> ИИ пишет профиль клиента, ставит оценку 1–10, отсеивает спам и сразу отдаёт заявку менеджерам.</li>
          <li><b>Анкеты менеджеров:</b> ИИ проверяет английский и ответ клиенту. 7+ из 10 и C1/C2 — одобрен сразу; 4 и ниже — получает совет и может подать снова; середина — ждёт вас.</li>
          <li><b>Защита клиентов:</b> сообщение менеджера с телефоном, почтой, мессенджером или реквизитами не уходит клиенту — менеджер получает предупреждение.</li>
          <li><b>Контроль качества каждый час:</b> ИИ читает новые сообщения менеджеров (грубость, неверные цены, обещания, увод клиента). Три замечания — менеджер на паузе.</li>
          <li><b>Сводка по каждому клиенту:</b> что нужно, настроение, следующий шаг, риск — обновляется каждый час.</li>
          <li><b>Сроки:</b> просрочил — клиент уходит другому менеджеру. Клиент ждёт ответа больше суток — вам сообщение.</li>
          <li><b>Утром в 08:00</b> — одна сводка дня в Telegram: главное, цифры, проблемы и что сделать.</li>
        </ul>
      </section>

      <section data-panel="claude" hidden>
        <p class="hint">Ваш чат со мной (Claude). Вопрос — ответ сразу. Задача («Сделай…», «Добавь…», «Исправь…») — уходит в очередь, я беру её в работу и пишу сюда результат. Мои идеи и вопросы к вам тоже приходят сюда (и в Telegram) с кнопками «Да / Нет / Обсудить».</p>
        <div class="oc" data-oc></div>
        <form class="oc-in" data-oc-form>
          <textarea rows="2" placeholder="Напишите вопрос или задачу… (Enter — отправить)" data-oc-text></textarea>
          <button type="button" class="ghost oc-mic" data-oc-clip aria-label="Прикрепить файлы" title="Прикрепить файлы"></button>
          <button type="button" class="ghost oc-mic" data-oc-mic aria-label="Голосовой ввод"></button>
          <button class="cta">Отправить</button>
        </form>
        <label class="mut small"><input type="checkbox" data-oc-task /> Это задача для Claude (если не начинается со «Сделай…»)</label>
      </section>

      <section data-panel="outbox" hidden>
        <p class="hint">Одно место для всех ваших решений и всего, что уходит наружу. Вверху — что ждёт вашего «да»: нажмите «✅ Да» (я отправлю или опубликую и перенесу в «Отправлено»), «❌ Нет» или «✏️ Поправить» (напишите, что изменить). Ниже — что уже ушло, что Vax сам пишет клиентам и мои вопросы вам.</p>
        <div class="obx-sum" data-obx-sum></div>
        <div data-obx></div>
      </section>
      <section data-panel="social" hidden>
        <p class="hint">Все соцсети в одном месте: что я выложил, кому ответил, кто ждёт вас. Любую карточку можно прокомментировать (придёт мне задачей), а поручение — написать прямо здесь.</p>
        <form class="say" data-soc-say><textarea name="text" rows="1" placeholder="Поручение по соцсетям — например: «в Discord ответь Farah, что…» или «в Instagram выложи сторис про…»"></textarea><button class="cta">Отправить Claude</button></form>
        <small class="mut" data-soc-msg></small>
        <div class="soc-nets" data-soc-nets></div>
        <h2>Последние действия</h2>
        <div class="work" data-soc-feed></div>
      </section>
      <section data-panel="work" hidden>
        <p class="hint">Всё, что я сделал, — как отчёт сотрудника: найденные клиенты и готовые сообщения им, черновики сайтов (можно открыть), ролики, документы, списки партнёров, изменения сайта. «Ждёт вашего да» — то, что уйдёт наружу только после вашего решения. Комментарий к любой карточке приходит мне задачей.</p>
        <div class="wf" data-wf></div>
        <div class="work" data-work></div>
      </section>
      <section data-panel="chats" hidden>
        <p class="hint">Все переписки с клиентами: Vax (ИИ), менеджеры и вы. «Ждёт ответа» — последним написал клиент. Нажмите на любой чат — откроется переписка, где можно прочитать и ответить от имени Vaxo.</p>
        <div class="inbox" data-inbox></div>
      </section>

      <section data-panel="leads" hidden>
        <div class="bar">
          <div class="chips" data-filters></div>
          <input type="search" placeholder="Поиск: имя, контакт, текст" data-search />
        </div>
        <div class="table"><table><thead><tr><th>#</th><th>Дата</th><th>Этап</th><th>ИИ</th><th>Клиент</th><th>Что нужно</th><th>Бюджет</th><th>Менеджер</th><th>Срок</th><th>Откуда</th></tr></thead><tbody data-leads></tbody></table></div>
      </section>

      <section data-panel="team" hidden>
        <p class="hint">Менеджеры клиентов — партнёры с хорошим английским, которых вы одобрили. Они видят только своих клиентов и описания новых заявок. Оценка 1–5 после каждого клиента: от неё зависит, сколько клиентов менеджер ведёт одновременно (2 → 3 → 5). Два пропущенных срока за 30 дней — автоматическая пауза.</p>
        <h2>Менеджеры и анкеты</h2>
        <div data-closers></div>
        <h2>Все партнёры</h2>
        <div class="table"><table><thead><tr><th>Имя</th><th>Email</th><th>С</th><th>Пригласил</th><th>Ссылки</th><th>Клики</th><th>Заявки</th><th>Команда</th><th>Менеджер</th></tr></thead><tbody data-partners></tbody></table></div>
      </section>

      <section data-panel="pay" hidden>
        <p class="hint">Начисления появляются сами, когда клиент отмечен «Выиграна» с суммой: менеджеру — 20%, партнёру, чья ссылка привела клиента, — 30%. Выплатите и нажмите «Выплачено» — партнёр сразу увидит это у себя.</p>
        <div class="kpis" data-pay-kpis></div>
        <div class="table"><table><thead><tr><th>Партнёр</th><th>Клиент</th><th>За что</th><th>Сделка</th><th>%</th><th>К выплате</th><th>Статус</th><th></th></tr></thead><tbody data-pay></tbody></table></div>
      </section>

      <section data-panel="fin" hidden>
        <p class="hint">Все деньги компании: что пришло, что ушло, налоги ФОП 3 группы и лимит. Подруга с ФОП видит то же на vaxogroup.com/fin/ по своему коду (все деньги, клиенты и переписки — только смотреть) и может спросить помощника в любое время.</p>
        <div class="card fopc"><b>👩‍💼 Чат с ФОП</b> <small class="mut">Её вопросы и ответы помощника. Что решаете только вы — придёт в Telegram; ответ отсюда она увидит у себя.</small><div class="oc" data-fopc></div><form class="oc-in" data-fopc-form><textarea rows="2" placeholder="Ответить ей от вашего имени…" data-fopc-text></textarea><button type="button" class="ghost oc-mic" data-fopc-mic aria-label="Голосовой ввод"></button><button class="cta">Ответить</button></form></div>
        <div class="card" data-invoices></div>
        <div class="fin-forms" data-fin-forms></div>
        <div data-fin></div>
      </section>

      <section data-panel="cartoon" hidden>
        <p class="hint">Серии про енота Vax: что готово, что дальше. Видео и превью лежат у вас на Mac в папке «Завод (VAXO) → Мультик». Публикация — после создания аккаунтов TikTok / Instagram / YouTube.</p>
        <div class="eps" data-eps></div>
      </section>

      <section data-panel="links" hidden>
        <div class="linkgrid" data-links></div>
        <h2>Решения (документы с вариантами и галочками)</h2>
        <ul class="decisions" data-decisions></ul>
      </section>

      <section data-panel="plan" hidden>
        <p class="hint">Здесь Claude показывает, что делает сейчас, что дальше и почему — и прогноз по реальным цифрам. Не согласны с чем-то — нажмите «Поправить», это уйдёт Claude задачей.</p>
        <div data-plan></div>
        <h2>Прогноз на основе цифр</h2>
        <div class="kpis" data-fc></div>
        <p class="mut" data-fc-how></p>
      </section>

      <section data-panel="access" hidden>
        <p class="hint">Пригласите человека: он входит по своей почте (пароль не нужен) и видит только отмеченные разделы. «Только просмотр» — без кнопок изменения.</p>
        <form class="card" data-invite>
          <div class="two"><input name="email" type="email" placeholder="Email" required /><input name="name" placeholder="Имя" /></div>
          <select name="role" data-role></select>
          <div class="secs" data-secs></div>
          <label><input type="checkbox" name="ro" /> Только просмотр</label>
          <button class="cta">Пригласить / сохранить</button>
          <small class="mut" data-invite-msg></small>
        </form>
        <h2>У кого есть доступ</h2>
        <div data-staff></div>
      </section>

      <section data-panel="help" hidden class="help">
        <h2>Кто что видит</h2>
        <div class="table"><table><thead><tr><th>Кто</th><th>Где</th><th>Видит</th><th>Может</th></tr></thead><tbody>
          <tr><td><b>Вы</b></td><td>vaxogroup.com/admin/ (ключ)</td><td>Всё: заявки, все чаты, партнёров, выплаты, мультик, ссылки</td><td>Публиковать и назначать заявки, писать клиентам, одобрять менеджеров, отмечать выплаты</td></tr>
          <tr><td><b>Менеджер клиентов</b> (одобренный партнёр)</td><td>Кабинет → «Клиенты агентства»</td><td>Только своих клиентов и описания новых заявок</td><td>Брать клиентов, переписываться от имени Vaxo с подписью «Имя · Account Manager», назначать созвоны, вести этапы</td></tr>
          <tr><td><b>Партнёр</b></td><td>Кабинет партнёра</td><td>Свои ссылки, клики, заявки, команду, начисления</td><td>Делиться ссылками, учиться, подать анкету менеджера</td></tr>
          <tr><td><b>Клиент</b></td><td>Личный чат проекта (ссылка после заявки)</td><td>Свой проект: этап, менеджера, переписку</td><td>Писать менеджеру в любое время</td></tr>
          <tr><td><b>Vax (ИИ)</b></td><td>Чат на сайте</td><td>Вопросы посетителей</td><td>Отвечать, советовать услугу, принимать заявки</td></tr>
        </tbody></table></div>
        <h2>Путь клиента</h2>
        <ol>
          <li><b>Заявка</b> — с сайта, из чата Vax или по ссылке партнёра. ИИ сам пишет профиль клиента, клиент сразу получает ссылку на свой чат проекта.</li>
          <li><b>Публикация</b> — вы нажимаете «Опубликовать» (или повторный клиент сам уходит своему менеджеру). Менеджеры видят только описание, без контактов.</li>
          <li><b>Менеджер берёт клиента</b> — получает контакты и готовое первое сообщение. Первый ответ — за 24 часа.</li>
          <li><b>Общение</b> — только в чате проекта, вы видите каждое сообщение. Клиент ждёт ответа больше 24 часов — вам сообщение в Telegram.</li>
          <li><b>Предложение и оплата</b> — договор и счёт от Vaxo, клиент платит только Vaxo.</li>
          <li><b>Клиент</b> — менеджер ведёт его дальше: поддержка, созвоны, новые заказы. Начисления партнёрам появляются сами.</li>
        </ol>
        <h2>Что работает само, без вас</h2>
        <ul>
          <li>Каждый час — проверка сроков: просроченные клиенты возвращаются в общий список, нарушители уходят на паузу.</li>
          <li>Telegram-сообщения: новая заявка, анкета менеджера, клиент ждёт ответа, сделка выиграна или проиграна.</li>
          <li>ИИ-профиль каждого нового клиента, ИИ-чат Vax на сайте 24/7.</li>
        </ul>
      </section>
    </div>

    <div class="drawer" data-drawer hidden>
      <div class="sheet" role="dialog" aria-label="Клиент">
        <button type="button" class="x" data-close aria-label="Закрыть">×</button>
        <div data-detail></div>
      </div>
    </div>
  </main>
</Base>

<script>
  import { renderFinance, FIN_CSS } from '../scripts/finance-view';
  import { attachMic, MIC_SVG } from '../scripts/voice';
  import { composer, grow } from '../scripts/compose';
  import { attachFiles, linkify } from '../scripts/attach';
  type R = Record<string, any>;
  const KEY = 'vaxo_admin';
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<T>(s));
  const ST: Record<string, [string, string]> = {
    new: ['Новая', 'b'], open: ['Ждёт менеджера', 'y'], claimed: ['Взята', 'p'], contacted: ['На связи', 'p'], meeting: ['Созвон был', 'p'],
    proposal: ['Предложение', 'p'], won: ['Клиент ✓', 'g'], lost: ['Проиграна', 'r'], archived: ['Архив', 'n'], collab: ['Сотрудничество', 'b'], gift: ['Подарок (ожидание)', 'b'], test: ['🧪 Тест', 'b'],
  };
  const CL: Record<string, string> = { none: '—', applied: 'Анкета', approved: 'Менеджер', paused: 'Пауза' };
  const ACTIVE = ['claimed', 'contacted', 'meeting', 'proposal'];
  let token = '';
  let data: R = { leads: [], partners: [], stats: [], payouts: [], hq: {} };
  let filter = 'active';
  try { token = sessionStorage.getItem(KEY) ?? localStorage.getItem(KEY) ?? ''; } catch {}

  const api = async (path: string, body?: unknown) => {
    const r = await fetch('/api/admin' + path, {
      method: body ? 'POST' : 'GET',
      headers: { Authorization: `Bearer ${token}`, ...(body ? { 'Content-Type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    if (r.status === 401) { logout(); throw new Error('auth'); }
    return r.json();
  };
  const rich = (text: string) => { const d = document.createElement('div'); d.innerHTML = linkify(String(text ?? '')); return d; };
  const el = (tag: string, attrs: R = {}, ...kids: (Node | string | null | undefined | false)[]) => {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === 'class') e.className = v; else if (k.startsWith('on')) (e as any)[k] = v; else if (v != null && v !== false) e.setAttribute(k, String(v));
    }
    for (const k of kids) if (k != null && k !== false) e.append(k);
    return e;
  };
  const badge = (s: string) => el('span', { class: 'st st-' + (ST[s]?.[1] ?? 'n') }, ST[s]?.[0] ?? s);
  const ts = (iso?: string) => (iso ? Date.parse(iso.replace(' ', 'T') + 'Z') : 0);
  const when = (iso?: string) => (iso ? new Date(ts(iso)).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '');
  const left = (iso?: string) => {
    if (!iso) return '';
    const h = Math.round((ts(iso) - Date.now()) / 36e5);
    return h < 0 ? 'просрочено' : h < 24 ? `${h} ч` : `${Math.round(h / 24)} дн`;
  };
  const usd = (n: number) => '$' + Number(n || 0).toLocaleString('en-US');
  const waitingReply = (l: R) => l.last_sender === 'client' && Date.now() - ts(l.last_at) > 2 * 36e5;
  const show = (view: string) => $<HTMLButtonElement>(`[data-view="${view}"]`).click();

  function logout() {
    try { sessionStorage.removeItem(KEY); localStorage.removeItem(KEY); } catch {}
    token = '';
    $('[data-app]').hidden = true; $('[data-on]').hidden = true; $('[data-loginbox]').hidden = false;
  }

  let me: R = { sections: [] };
  // What this person may see: tabs outside their sections are hidden (the server checks it too).
  async function loadMe() {
    const r = await api('/me').catch(() => null);
    if (!r?.ok) return;
    me = r.me;
    $('[data-who]').textContent = me.role === 'owner' ? '' : `· ${me.name} (${me.role_name})`;
    $$<HTMLButtonElement>('[data-view]').forEach((b) => { const v = b.dataset.view!; b.hidden = v !== 'help' && !(me.sections as string[]).includes(v === 'access' ? 'access' : v === 'outbox' || v === 'social' ? 'work' : v); });
    if ((me.sections as string[]).includes('access')) loadAccess();
  }

  const PROC_LIGHT = (bad: boolean, warn: boolean) => (bad ? 'r' : warn ? 'y' : 'g');
  async function loadAssist() {
    const r = await api('/assist').catch(() => null);
    if (!r?.ok) return;
    $('[data-assist-who]').textContent = me.name ? `· для ${me.role === 'owner' ? 'владельца' : me.name}` : '';
    $('[data-tips]').replaceChildren(...(r.tips as R[]).map((t) => el('button', { type: 'button', class: 'tip', onclick: () => show(t.view) }, el('span', {}, t.icon), el('p', {}, t.text), el('b', {}, 'Открыть →'))));
  }
  $('[data-ask]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement; const q = (f.q as HTMLTextAreaElement).value.trim(); if (!q) return;
    const a = $('[data-ask-a]'); a.hidden = false; a.textContent = 'Думаю…';
    const r = await api('/assist', { q }).catch(() => null);
    a.textContent = r?.text || 'ИИ сейчас занят — попробуйте через минуту.';
  });

  async function loadPulse() {
    const p = await api('/pulse').catch(() => null);
    if (!p?.ok) return;
    const L = p.leads || {}, M = p.money || {}, P = p.partners || {}, S = p.site || {}, W = p.work || {}, C = p.claude || {}, A = p.auto || {};
    const uah = (n: number) => Math.round(n || 0).toLocaleString('ru-RU') + ' ₴';
    const cards: [string, string, string, string[], string, string][] = [
      ['🎯', 'Продажи', `${L.fresh || 0} новых`, [`${L.talking || 0} в переговорах`, `${L.proposal || 0} с предложением`, `${L.week || 0} заявок за 7 дней`], PROC_LIGHT(false, (L.fresh || 0) > 0), 'leads'],
      ['🛠', 'Проекты в работе', `${L.in_work || 0}`, [`средний прогресс ${L.progress ?? 0}%`, `${L.late || 0} просрочено`, `${L.human || 0} ждут человека`], PROC_LIGHT((L.late || 0) > 0, (L.human || 0) > 0), 'chats'],
      ['💰', 'Деньги', uah(M.month_uah), [`за год ${uah(M.year_uah)}`, `${M.open_inv || 0} неоплаченных счетов`, `${M.payouts_due || 0} выплат партнёрам`], PROC_LIGHT(false, (M.payouts_due || 0) > 0), 'fin'],
      ['🤝', 'Партнёры', `${P.total || 0}`, [`${P.closers || 0} менеджеров`, `${P.applied || 0} анкет ждут`], PROC_LIGHT(false, (P.applied || 0) > 0), 'team'],
      ['🌐', 'Сайт', `${S.views7 || 0} визитов`, [`за 7 дней`, `${S.chats7 || 0} чатов с Vax`], PROC_LIGHT(false, false), 'stats'],
      ['🎬', 'Соцсети и мультик', `${W.videos_waiting || 0} на «да»`, [`${W.videos_out || 0} роликов вышло`, `Instagram · TikTok · YouTube · Threads`], PROC_LIGHT(false, (W.videos_waiting || 0) > 0), 'work'],
      ['🧠', 'Claude', `${W.today || 0} работ за сутки`, [`${W.waiting || 0} ждут вашего «да»`, `${C.tasks || 0} ваших задач в очереди`, `${C.questions || 0} вопросов к вам`], PROC_LIGHT(false, (W.waiting || 0) + (C.questions || 0) > 0), 'claude'],
      ['🤖', 'Автопилот', `${A.on || 0} из ${A.total || 0} вкл.`, [A.price_owner ? 'цены решаете вы (до ФОП)' : 'цены по прайсу'], PROC_LIGHT(false, false), 'auto'],
    ];
    $('[data-procs]').replaceChildren(...cards.filter((c) => (me.sections as string[]).includes(c[5])).map(([i, t, big, lines, light, go]) =>
      el('button', { type: 'button', class: 'proc l-' + light, onclick: () => show(go) }, el('div', { class: 'ph' }, el('span', {}, i), el('b', {}, t), el('i', { class: 'dot' })), el('strong', {}, big), ...lines.map((x) => el('small', {}, x)))));
  }

  async function loadPlan() {
    const d = await api('/plan').catch(() => null);
    if (!d?.ok) return;
    const P = d.plan as R | null, F = d.forecast as R;
    const fix = (topic: string) => el('button', { type: 'button', class: 'ghost sm', onclick: () => { show('today'); const t = $<HTMLTextAreaElement>('[data-say] textarea'); t.value = `По плану «${topic}»: `; t.focus(); t.dispatchEvent(new Event('input')); } }, 'Поправить');
    const block = (title: string, items: string[] | undefined, cls = '') => items?.length ? el('div', { class: 'card plan ' + cls }, el('div', { class: 'ph' }, el('b', {}, title), fix(title)), el('ul', {}, ...items.map((x) => el('li', {}, x)))) : '';
    $('[data-plan]').replaceChildren(...(P ? [
      P.goal ? el('div', { class: 'card plan goal' }, el('small', { class: 'mut' }, 'Главная цель'), el('b', {}, P.goal), P.min ? el('small', { class: 'mut' }, 'Минимум: ' + P.min) : '') : '',
      el('div', { class: 'plan-grid' }, block('Сценарии: максимум / база / минимум', P.scenarios, 'goal'), block('Делаю сейчас', P.now), block('Дальше по шагам', P.next), block('Почему так', P.why, 'why'), block('Discord INSIDERS', P.discord), block('Свой продукт (следующий этап)', P.product), block('На что опираюсь (рынок и цифры)', P.basis), block('Что вижу в мире и трендах', P.watch), block('Риски и что я с ними делаю', P.risks, 'risk')),
      el('p', { class: 'mut' }, `Обновлено: ${P.updated || '—'}`),
    ] : [el('p', { class: 'mut' }, 'План ещё не загружен — Claude обновит его в ближайшей рабочей сессии.')]));
    const uah = (n: number) => Math.round(n || 0).toLocaleString('ru-RU') + ' ₴';
    const tiles: [string, string, string][] = [
      ['Заявки за месяц', String(F.leads_month), `за 3 месяца ~${F.leads_quarter}`],
      ['Новые клиенты за месяц', String(F.won_month), `конверсия ${F.conv}% из заявки`],
      ['Выручка к концу месяца', uah(F.revenue_month_end), `за последние 30 дней ${uah(F.revenue_30)}`],
      ['Визиты сайта за месяц', String(F.views_month), `за прошлые 30 дней ${F.views30}`],
    ];
    $('[data-fc]').replaceChildren(...tiles.map(([t, v, h]) => el('div', { class: 'kpi' }, el('small', {}, t), el('b', {}, v), el('span', {}, h))));
    $('[data-fc-how]').textContent = F.how;
  }

  async function loadAccess() {
    const d = await api('/staff').catch(() => null);
    if (!d?.ok) return;
    const roleSel = $<HTMLSelectElement>('[data-role]');
    if (!roleSel.options.length) {
      roleSel.replaceChildren(...Object.entries(d.roles as R).filter(([k]) => k !== 'owner').map(([k, r]) => el('option', { value: k }, (r as R).name)));
      const paint = () => { const secs = (d.roles[roleSel.value] as R).sections as string[]; $$<HTMLInputElement>('[data-secs] input').forEach((c) => (c.checked = secs.includes(c.value))); };
      $('[data-secs]').replaceChildren(...(d.sections as string[]).map((s) => el('label', {}, el('input', { type: 'checkbox', name: 'sec', value: s }), ' ', d.names[s] || s)));
      roleSel.onchange = paint; roleSel.value = 'manager'; paint();
      $<HTMLFormElement>('[data-invite]').onsubmit = async (e) => {
        e.preventDefault();
        const f = e.currentTarget as HTMLFormElement; const fd = new FormData(f);
        const r = await api('/staff', { email: fd.get('email'), name: fd.get('name'), role: fd.get('role'), sections: fd.getAll('sec'), write: !fd.get('ro') });
        $('[data-invite-msg]').textContent = r.ok ? `✅ Готово. ${d.mail ? 'Приглашение ушло на почту.' : 'Почта не подключена — передайте ссылку vaxogroup.com/admin/ сами.'}` : 'Не получилось: проверьте email.';
        if (r.ok) { f.reset(); roleSel.value = 'manager'; paint(); loadAccess(); }
      };
    }
    const rows = d.staff as R[];
    $('[data-staff]').replaceChildren(...(rows.length ? rows.map((s) => el('div', { class: 'card staff' + (s.active ? '' : ' off') },
      el('b', {}, s.name || s.email), ' ', el('span', { class: 'mut' }, s.email), ' · ', (d.roles[s.role] as R)?.name || s.role, s.can_write ? '' : ' · только просмотр',
      el('div', { class: 'mut' }, (JSON.parse(s.sections || '[]') as string[]).map((x) => d.names[x] || x).join(', ') || '—', s.last_login ? ` · входил ${when(s.last_login)}` : ' · ещё не входил'),
      el('button', { type: 'button', class: 'ghost sm', onclick: async () => { const to = prompt(`Новая почта для входа вместо ${s.email}:`, s.email); if (!to || to === s.email) return; const r = await api(`/staff/${s.id}/email`, { email: to }); alert(r.ok ? 'Готово: следующий код придёт на новую почту.' : 'Не получилось: адрес неверный или уже занят.'); loadAccess(); } }, 'Изменить почту'),
      s.active && s.role !== 'owner' ? el('button', { type: 'button', class: 'ghost sm', onclick: async () => { if (confirm(`Закрыть доступ для ${s.email}?`)) { await api(`/staff/${s.id}/off`, {}); loadAccess(); } } }, 'Закрыть доступ') : '')) :
      [el('p', { class: 'mut' }, 'Пока только вы.')]));
  }

  async function load() {
    if (!token) return logout();
    try { data = await api(''); } catch { return; }
    loadMe().then(loadAssist); loadPulse(); loadPlan();
    $('[data-loginbox]').hidden = true; $('[data-app]').hidden = false; $('[data-on]').hidden = false;
    loadOutbox();
    renderToday(); renderInbox(); renderLeads(); renderTeam(); renderPay(); renderCartoon(); renderLinks();
    loadAuto(); loadStats(); loadFin(); loadClaude(); loadWork(); loadSocial();
  }

  async function loadClaude() {
    const d = await api('/claude').catch(() => null);
    if (!d?.ok) return;
    const box = $('[data-oc]');
    const open = (d.messages as R[]).filter((m) => m.sender === 'claude' && m.status === 'open').length;
    const pillEl = document.querySelector<HTMLElement>('[data-n="claude"]'); if (pillEl) { pillEl.textContent = String(open); pillEl.hidden = !open; }
    box.replaceChildren(...(d.messages.length ? (d.messages as R[]).map((m) => {
      const who = m.sender === 'owner' ? 'Вы' : m.sender === 'claude' ? (m.kind === 'idea' ? '💡 Claude — идея' : m.kind === 'question' ? '❓ Claude — вопрос' : 'Claude') : 'Помощник (ИИ)';
      const ask = m.sender === 'claude' && (m.kind === 'idea' || m.kind === 'question') && m.status === 'open';
      const act = (a: string) => async () => { const note = a === 'discuss' ? prompt('Что обсудить? (можно пусто)') ?? '' : ''; await api(`/claude/${m.id}/${a}`, { note }); loadClaude(); };
      return el('div', { class: 'ocm ' + (m.sender === 'owner' ? 'me' : 'them') + (m.kind === 'task' && m.sender === 'owner' ? ' task' : '') },
        el('small', {}, `${who}${m.kind === 'task' && m.sender === 'owner' ? (m.status === 'open' ? ' · задача в очереди' : ' · задача выполнена') : ''} · ${when(m.at)}`),
        rich(m.text),
        ask && el('div', { class: 'btns' }, el('button', { class: 'cta sm', type: 'button', onclick: act('yes') }, 'Да'), el('button', { class: 'ghost sm', type: 'button', onclick: act('no') }, 'Нет'), el('button', { class: 'ghost sm', type: 'button', onclick: act('discuss') }, 'Обсудить')));
    }) : [el('p', { class: 'mut' }, 'Пока пусто. Спросите что угодно о компании или дайте задачу — например: «Сделай пост для Instagram про подарки».')]));
    box.scrollTop = box.scrollHeight;
  }
  (() => {
    const f = document.querySelector<HTMLFormElement>('[data-oc-form]'); if (!f) return;
    const ta = $<HTMLTextAreaElement>('[data-oc-text]');
    const mic = $<HTMLButtonElement>('[data-oc-mic]'); mic.innerHTML = MIC_SVG; attachMic(mic, ta, () => 'ru'); attachFiles($<HTMLButtonElement>('[data-oc-clip]'), ta, () => 'ru', f);
    f.onsubmit = async (e) => { e.preventDefault(); const text = ta.value.trim(); if (!text) return; ta.value = ''; const task = $<HTMLInputElement>('[data-oc-task]').checked; $<HTMLInputElement>('[data-oc-task]').checked = false; await api('/claude', { text, task }); loadClaude(); };
    composer(ta, () => f.requestSubmit());
  })();
  document.querySelector('[data-go-chats]')?.addEventListener('click', () => show('chats'));
  const finStyle = document.createElement('style'); finStyle.textContent = FIN_CSS; document.head.append(finStyle);
  const WK: R = { clients: ['🎯', 'Клиенты'], partners: ['🤝', 'Партнёры'], draft: ['🖥', 'Черновики сайтов'], video: ['🎬', 'Ролики'], doc: ['📄', 'Документы'], site: ['🛠', 'Сайт и Штаб'], research: ['🔎', 'Исследования'], outreach: ['✉️', 'Рассылки'], social: ['📣', 'Соцсети'] };
  const WS: R = { ready: ['готово', 'g'], waiting: ['ждёт вашего «да»', 'y'], approved: ['одобрено — отправляю', 'p'], sent: ['отправлено', 'b'], rejected: ['забраковано', 'r'], done: ['закрыто', 'n'] };
  let workFilter = '';
  async function loadWork() {
    const d = await api('/work').catch(() => null);
    if (!d?.ok) return;
    const items = d.items as R[];
    const counts: R = {}; for (const i of items) counts[i.kind] = (counts[i.kind] || 0) + 1;
    const waiting = items.filter((i) => i.status === 'waiting').length;
    $('[data-wf]').replaceChildren(
      el('button', { type: 'button', class: 'chip' + (workFilter === '' ? ' on' : ''), onclick: () => { workFilter = ''; loadWork(); } }, `Всё · ${items.length}`),
      waiting > 0 ? el('button', { type: 'button', class: 'chip warn' + (workFilter === 'waiting' ? ' on' : ''), onclick: () => { workFilter = 'waiting'; loadWork(); } }, `Ждёт вашего «да» · ${waiting}`) : '',
      ...Object.entries(WK).filter(([k]) => counts[k]).map(([k, [ic, t]]) => el('button', { type: 'button', class: 'chip' + (workFilter === k ? ' on' : ''), onclick: () => { workFilter = k; loadWork(); } }, `${ic} ${t} · ${counts[k]}`)));
    const shown = items.filter((i) => !workFilter || i.kind === workFilter || (workFilter === 'waiting' && i.status === 'waiting'));
    $('[data-work]').replaceChildren(...shown.map((i) => {
      const [ic, kt] = WK[i.kind] || ['•', i.kind];
      const [st, sc] = WS[i.status] || [i.status, 'n'];
      const f = String(i.file || '');
      const media = /\.(mp4|webm|mov)$/i.test(f) ? el('video', { src: f, controls: true, preload: 'none', playsinline: true })
        : /\.(png|jpe?g|webp|gif)$/i.test(f) ? el('img', { src: f, loading: 'lazy', alt: '' })
        : /\/p\/[a-f0-9]{20}/.test(f) ? (() => { const box = el('div', { class: 'pv' }); const btn = el('button', { type: 'button', class: 'ghost sm', onclick: () => { box.replaceChildren(el('iframe', { src: f, loading: 'lazy', title: i.title })); } }, '👁 Показать сайт здесь'); return el('div', {}, btn, ' ', el('a', { href: f, target: '_blank', class: 'ghost sm' }, '↗ Открыть в новой вкладке'), box); })()
        : null;
      const note = el('textarea', { rows: '1', placeholder: 'Комментарий или решение (придёт мне задачей)…' }, '') as HTMLTextAreaElement;
      const sel = el('select', {}, ...Object.entries(WS).map(([k, [t]]) => el('option', { value: k, selected: k === i.status }, t))) as HTMLSelectElement;
      return el('article', { class: 'wcard' },
        el('div', { class: 'wh' }, el('span', { class: 'wk' }, `${ic} ${kt}`), el('span', { class: 'st st-' + sc }, st), el('small', { class: 'mut' }, when(i.at))),
        el('h3', {}, i.title),
        media,
        i.body && el('details', { open: i.body.length < 500 }, el('summary', {}, 'Подробно'), rich(i.body)),
        i.link && el('a', { href: i.link, target: '_blank', rel: 'noopener', class: 'ghost sm' }, '↗ Открыть'),
        i.note && el('p', { class: 'mut' }, `Ваш комментарий: ${i.note}`),
