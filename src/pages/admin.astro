      el('button', { class: 'ghost', type: 'button', onclick: () => set({ ai: l.ai === 'paused' ? 'on' : 'paused' }) }, l.ai === 'paused' ? 'Включить ИИ' : 'Поставить ИИ на паузу'),
      el('button', { class: 'ghost', type: 'button', onclick: async () => {
        const v = prompt('Сколько пришло? Например: 300 USD, 250 EUR или 9000 UAH');
        const m = v?.trim().match(/^([\d.,\s]+)\s*(usd|\$|eur|€|uah|грн|₴)?$/i);
        if (!m) return;
        const c = /eur|€/i.test(m[2] || '') ? 'EUR' : /uah|грн|₴/i.test(m[2] || '') ? 'UAH' : 'USD';
        const part = l.status === 'won' ? 'final' : 'prepay';
        const r = await api('/finance/payment', { lead_id: id, amount: Number(m[1].replace(/[\s,]/g, '')), currency: c, part });
        alert(r.ok ? `Записано в «Финансы» (${part === 'prepay' ? 'предоплата' : 'остаток'}). Vax поблагодарит клиента.` : 'Не записалось.');
        loadFin(); openLead(id);
      } }, '💰 Деньги пришли'),
      l.human && String(l.human).startsWith('Цена клиента') ? el('div', { class: 'offer' }, el('p', {}, el('b', {}, '💰 Нужно ваше решение: '), l.human),
        el('div', { class: 'btns' },
          el('button', { class: 'cta', type: 'button', onclick: async () => { if (confirm('Принять цену клиента? Vax сообщит ему.')) { await api(`/lead/${id}/offer`, { accept: true }); await load(); openLead(id); } } }, 'Принять цену'),
