---
// The client's private project chat: vaxogroup.com/room/?t=<room>. Language follows the client's request.
import Base from '../layouts/Base.astro';
const T = {
  en: { confirm: '✅ All correct — start the work', confirmNote: 'By confirming you accept the brief as our contract and the Terms, and ask us to start right away.', revs: 'Revisions: {u} of {t}', cab: 'My cabinet: all projects, payments and bonuses →', briefOk: 'Brief confirmed {d} — this is our contract', tg: 'Continue in Telegram', h: 'Your project with Vaxo', collabH: 'Your collaboration with Vaxo', progress: 'Project progress',  giftH: 'Your cartoon gift', giftHello: 'Hi {name}! This is your chat about the cartoon gift. Vax will ask a couple of details here.',  collabHello: 'Hi {name}! This is your private chat with Vaxo about your proposal.', role: 'Account Manager, Vaxo', steps: ['Request received', 'Your task', 'Proposal', 'In progress', 'Review', 'Delivered'], ai: 'Vax · AI manager', aiSub: 'Replies in seconds, 24/7 · a human joins for calls', stage: { work: 'Your project is in progress', review: 'Ready for your review — see the link above', revisions: 'Applying your revisions', delivered: 'Project delivered' }, until: 'expected by', typing: 'Vax is typing…', mgrWait: 'Your manager is being assigned', reply: 'Replies within 24 hours', mgr: 'Your manager', wait: 'Your personal manager will join this chat within 24 hours.', ph: 'Write a message…', send: 'Send', save: 'Save this page — it is your private project chat. Everything about your project stays here.', copy: 'Copy link', copied: 'Copied', team: 'Vaxo team', human: 'a real person', you: 'You', call: 'Call', bad: 'This chat link is not valid. Write to us at vaxogroup.com.', err: 'Not sent. Try again.', live: 'You are now talking to a Vaxo manager', liveTeam: 'You are now talking to the Vaxo team', mic: 'Voice input', hello: 'Hi {name}! This is your project chat. Write your questions here at any time — a manager replies within 24 hours.' },
  ru: { confirm: '✅ Всё верно — начинайте работу', confirmNote: 'Подтверждая, вы принимаете бриф как наш договор и Условия и просите начать сразу.', revs: 'Правки: {u} из {t}', cab: 'Мой кабинет: все проекты, оплаты и бонусы →', briefOk: 'Бриф подтверждён {d} — это наш договор', tg: 'Продолжить в Telegram', h: 'Ваш проект с Vaxo', collabH: 'Сотрудничество с Vaxo', progress: 'Готовность проекта',  giftH: 'Ваш мультик в подарок', giftHello: 'Здравствуйте, {name}! Это чат о вашем мультике в подарок. Vax уточнит здесь пару деталей.',  collabHello: 'Здравствуйте, {name}! Это ваш личный чат с Vaxo по вашему предложению.', role: 'Account Manager, Vaxo', steps: ['Заявка получена', 'Ваша задача', 'Предложение', 'В работе', 'Проверка', 'Сдано'], ai: 'Vax · ИИ-менеджер', aiSub: 'Отвечает за секунды, 24/7 · человек подключается на созвон', stage: { work: 'Проект в работе', review: 'Готово к проверке — ссылка выше', revisions: 'Вносим ваши правки', delivered: 'Проект сдан' }, until: 'ожидаемая дата', typing: 'Vax печатает…', mgrWait: 'Назначаем вашего менеджера', reply: 'Отвечает в течение 24 часов', mgr: 'Ваш менеджер', wait: 'Личный менеджер подключится к этому чату в течение 24 часов.', ph: 'Напишите сообщение…', send: 'Отправить', save: 'Сохраните эту страницу — это личный чат вашего проекта. Всё о проекте остаётся здесь.', copy: 'Скопировать ссылку', copied: 'Скопировано', team: 'Команда Vaxo', human: 'живой человек', you: 'Вы', call: 'Созвон', bad: 'Ссылка на чат неверная. Напишите нам на vaxogroup.com.', err: 'Не отправилось. Попробуйте ещё раз.', live: 'Сейчас с вами общается менеджер Vaxo', liveTeam: 'Сейчас с вами общается команда Vaxo', mic: 'Голосовой ввод', hello: 'Здравствуйте, {name}! Это чат вашего проекта. Пишите сюда вопросы в любое время — менеджер отвечает в течение 24 часов.' },
  ua: { confirm: '✅ Усе вірно — починайте роботу', confirmNote: 'Підтверджуючи, ви приймаєте бриф як наш договір і Умови та просите почати одразу.', revs: 'Правки: {u} з {t}', cab: 'Мій кабінет: усі проєкти, оплати й бонуси →', briefOk: 'Бриф підтверджено {d} — це наш договір', tg: 'Продовжити в Telegram', h: 'Ваш проєкт з Vaxo', collabH: 'Співпраця з Vaxo', progress: 'Готовність проєкту',  giftH: 'Ваш мультик у подарунок', giftHello: 'Вітаємо, {name}! Це чат про ваш мультик у подарунок. Vax уточнить тут кілька деталей.',  collabHello: 'Вітаємо, {name}! Це ваш особистий чат з Vaxo щодо вашої пропозиції.', role: 'Account Manager, Vaxo', steps: ['Заявку отримано', 'Ваше завдання', 'Пропозиція', 'В роботі', 'Перевірка', 'Здано'], ai: 'Vax · ШІ-менеджер', aiSub: 'Відповідає за секунди, 24/7 · людина підключається на дзвінок', stage: { work: 'Проєкт у роботі', review: 'Готово до перевірки — посилання вище', revisions: 'Вносимо ваші правки', delivered: 'Проєкт здано' }, until: 'очікувана дата', typing: 'Vax друкує…', mgrWait: 'Призначаємо вашого менеджера', reply: 'Відповідає протягом 24 годин', mgr: 'Ваш менеджер', wait: 'Особистий менеджер приєднається до цього чату протягом 24 годин.', ph: 'Напишіть повідомлення…', send: 'Надіслати', save: 'Збережіть цю сторінку — це особистий чат вашого проєкту. Усе про проєкт залишається тут.', copy: 'Скопіювати посилання', copied: 'Скопійовано', team: 'Команда Vaxo', human: 'жива людина', you: 'Ви', call: 'Дзвінок', bad: 'Посилання на чат неправильне. Напишіть нам на vaxogroup.com.', err: 'Не надіслано. Спробуйте ще раз.', live: 'Зараз з вами спілкується менеджер Vaxo', liveTeam: 'Зараз з вами спілкується команда Vaxo', mic: 'Голосове введення', hello: 'Вітаємо, {name}! Це чат вашого проєкту. Пишіть сюди питання будь-коли — менеджер відповідає протягом 24 годин.' },
};
---

<Base lang="en" title="Vaxo — your project chat" description="Your private project chat with Vaxo." noindex noChat>
  <main class="room">
    <header>
      <a href="/" class="logo">VAXO<span>.</span></a>
      <div class="who" data-who></div>
    </header>
    <h1 data-h></h1>
    <ol class="steps" data-steps></ol>
    <div class="prog" data-prog hidden><div><span data-prog-l></span><b data-prog-n></b></div><i><u data-prog-bar></u></i></div>
    <ul class="meta" data-meta></ul>
    <div class="mcard" data-mcard></div>
    <section class="box">
      <div class="log" data-log aria-live="polite"></div>
      <div class="live" data-live hidden></div>
      <form data-form><button type="button" class="mic clip" data-clip aria-label="Attach files"></button><textarea name="t" rows="2" maxlength="4000"></textarea><button type="button" class="mic" data-mic aria-label="Voice input"></button><button type="submit" aria-label="Send">➤</button></form>
    </section>
    <p class="save"><span data-save></span> <button type="button" data-copy></button> <a class="tg" data-tg hidden target="_blank" rel="noopener"></a></p>
    <p class="save"><a class="cab" data-cab href="/me/"></a></p>
    <p class="save"><a href="/terms/" target="_blank" data-terms>Terms &amp; refunds</a> · <a href="/privacy/" target="_blank" data-privacy>Privacy</a></p>
  </main>
  <script type="application/json" id="room-t" set:html={JSON.stringify(T)} />
  <script>
    import { attachMic, MIC_SVG } from '../scripts/voice';
    import { attachFiles, linkify } from '../scripts/attach';
    type R = Record<string, any>;
    const ALL = JSON.parse(document.getElementById('room-t')!.textContent || '{}');
    const token = new URLSearchParams(location.search).get('t') || '';
    const $ = <E extends Element = HTMLElement>(s: string) => document.querySelector<E>(s)!;
    let T = ALL.en;
    let lang = 'en';
    let count = -1;
    let last: R | undefined;
    const when = (iso: string) => new Date(iso.replace(' ', 'T') + 'Z').toLocaleString(undefined, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
    const bubble = (m: R, d: R) => {
      const me = m.sender === 'client';
      const el = document.createElement('div');
      const sm = typeof m.text === 'string' && m.sender === 'system' ? m.text.match(/^stage:(\w+)(?::(\d{4}-\d{2}-\d{2}))?$/) : null;
      if (sm) {
        el.className = 'm stage';
        el.textContent = `${T.stage[sm[1]] || sm[1]}${sm[2] ? ` · ${T.until} ${new Date(sm[2]).toLocaleDateString()}` : ''}`;
        return el;
      }
      el.className = 'm ' + (me ? 'me' : 'them') + (m.kind === 'call' ? ' call' : '');
      const who = document.createElement('small');
      who.textContent = `${me ? T.you : m.sender === 'ai' ? T.ai : m.partner_name ? m.partner_name + ' · ' + T.role : m.sender === 'owner' ? T.team + ' · ' + T.human : T.team}${m.kind === 'call' ? ' · ' + T.call : ''} · ${when(m.at)}`;
      const body = document.createElement('div');
      body.innerHTML = linkify(m.text);
      if (d.briefPending && m.id === d.briefPending) {
        const ok = document.createElement('button');
        ok.type = 'button'; ok.className = 'confirm'; ok.textContent = T.confirm;
        ok.onclick = async () => { ok.disabled = true; const r = await fetch(`/api/room/${token}?confirm=${m.id}`, { method: 'POST' }); if (r.ok) { count = -1; await load(true); } else ok.disabled = false; };
        const cn = document.createElement('small'); cn.className = 'cnote'; cn.textContent = T.confirmNote;
        body.append(ok, cn);
      }
      el.append(who, body);
      return el;
    };
    async function load(scroll = false) {
      const r = await fetch(`/api/room/${token}`).catch(() => null);
      if (!r || !r.ok) { $('[data-h]').textContent = T.bad; $('.box').hidden = true; return; }
      const d = await r.json();
      T = ALL[d.lang] || ALL.en;
      document.documentElement.lang = d.lang === 'ua' ? 'uk' : d.lang;
      $('[data-h]').textContent = d.status === 'collab' ? T.collabH : d.status === 'gift' ? T.giftH : T.h;
      $('[data-steps]').hidden = d.status === 'collab' || d.status === 'gift';
      const tg = $<HTMLAnchorElement>('[data-tg]');
      if (d.tg) { tg.href = d.tg; tg.textContent = T.tg; tg.hidden = false; }
      $('[data-who]').textContent = '';
      const stage = d.status === 'won' ? ({ work: 3, qa: 3, review: 4, revisions: 4, delivered: 5 } as Record<string, number>)[d.stage] ?? 3 : d.status === 'proposal' ? 2 : d.messages.some((m: R) => m.sender !== 'client') ? 1 : 0;
      $('[data-steps]').replaceChildren(...T.steps.map((s: string, i: number) => {
        const li = document.createElement('li');
        li.className = i < stage ? 'done' : i === stage ? 'now' : '';
        li.textContent = s;
        return li;
      }));
      const pr = $('[data-prog]');
      pr.hidden = d.progress == null || d.status !== 'won';
      if (!pr.hidden) { $('[data-prog-l]').textContent = T.progress; $('[data-prog-n]').textContent = `${d.progress}%`; $('[data-prog-bar]').style.width = `${d.progress}%`; }
      const meta = $('[data-meta]');
      meta.replaceChildren();
      const add = (txt: string) => { const li = document.createElement('li'); li.textContent = txt; meta.append(li); };
      if (d.status === 'won' && d.revisions) add('✏️ ' + T.revs.replace('{u}', d.revisions.used).replace('{t}', d.revisions.total));
      if (d.briefConfirmedAt) add('✅ ' + T.briefOk.replace('{d}', new Date(d.briefConfirmedAt.replace(' ', 'T') + 'Z').toLocaleDateString()));
      const cab = $<HTMLAnchorElement>('[data-cab]'); cab.textContent = T.cab; cab.href = `${d.lang === 'en' ? '' : '/' + d.lang}/me/?t=${token}`;
      const card = $('[data-mcard]');
      card.replaceChildren();
      const av = document.createElement('span');
      av.className = 'av';
      av.textContent = d.ai || !d.manager ? 'V' : d.manager[0].toUpperCase();
      const info = document.createElement('div');
      const b = document.createElement('b');
      b.textContent = d.ai ? T.ai + (d.manager ? ` + ${d.manager}` : '') : d.manager ? `${d.manager} · ${T.role}` : T.mgrWait;
      const sm = document.createElement('small');
      sm.textContent = d.ai ? T.aiSub : d.manager ? `${T.mgr} · ${T.reply}` : T.reply;
      info.append(b, sm);
      card.append(av, info);
      $<HTMLTextAreaElement>('textarea').placeholder = T.ph;
      $('[data-save]').textContent = T.save;
      const tl = document.querySelector<HTMLAnchorElement>('[data-terms]'); if (tl) { tl.href = d.lang === 'en' ? '/terms/' : `/${d.lang}/terms/`; tl.textContent = d.lang === 'ru' ? 'Условия и возвраты' : d.lang === 'ua' ? 'Умови та повернення' : 'Terms & refunds'; } const pl = document.querySelector<HTMLAnchorElement>('[data-privacy]'); if (pl) { pl.href = d.lang === 'en' ? '/privacy/' : `/${d.lang}/privacy/`; pl.textContent = d.lang === 'ru' ? 'Конфиденциальность' : d.lang === 'ua' ? 'Конфіденційність' : 'Privacy'; }
      $('[data-copy]').textContent = T.copy;
      // A human is talking (manager or team wrote in the last 30 minutes): a clear banner with their name.
      const lastHuman = [...d.messages].reverse().find((m: R) => m.sender === 'owner' || String(m.sender).startsWith('partner:'));
      const live = $('[data-live]');
      live.hidden = !lastHuman || Date.now() - Date.parse(lastHuman.at.replace(' ', 'T') + 'Z') > 30 * 60000;
      if (!live.hidden) live.textContent = lastHuman.partner_name ? `${T.live} — ${lastHuman.partner_name}` : T.liveTeam;
      $('[data-mic]').setAttribute('aria-label', T.mic);
      lang = d.lang;
      last = d.messages[d.messages.length - 1];
      if (d.messages.length === count) return;
      count = d.messages.length;
      const log = $('[data-log]');
      const intro = { sender: 'system', kind: 'text', text: d.status === 'collab' ? T.collabHello.replace('{name}', d.name) : d.status === 'gift' ? T.giftHello.replace('{name}', d.name) : d.ai ? T.hello.replace('{name}', d.name).split(/ — | – /)[0] + '.' : T.hello.replace('{name}', d.name) + (d.manager ? '' : '\n' + T.wait), at: new Date().toISOString().slice(0, 19).replace('T', ' ') };
      log.replaceChildren(bubble(intro, d), ...d.messages.map((m: R) => bubble(m, d)));
      log.scrollTop = log.scrollHeight;
    }
    $<HTMLFormElement>('[data-form]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const ta = $<HTMLTextAreaElement>('textarea');
      const text = ta.value.trim();
      if (!text) return;
      const r = await fetch(`/api/room/${token}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text }) });
      if (!r.ok) return alert(T.err);
      ta.value = '';
      await load(true);
      // Vax answers in a few seconds: poll faster until the reply arrives.
      const log = $('[data-log]');
      const dots = document.createElement('div');
      dots.className = 'm them typing';
      dots.textContent = T.typing;
      log.append(dots);
      log.scrollTop = log.scrollHeight;
      for (let i = 0; i < 12 && last?.sender === 'client'; i++) { await new Promise((ok) => setTimeout(ok, 2500)); await load(true); }
      dots.remove();
    });
    $<HTMLTextAreaElement>('textarea').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); $<HTMLFormElement>('[data-form]').requestSubmit(); }
    });
    $('[data-copy]').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); $('[data-copy]').textContent = T.copied; } catch {}
    });
    const mic = $<HTMLButtonElement>('[data-mic]');
    mic.innerHTML = MIC_SVG;
    attachMic(mic, $<HTMLTextAreaElement>('textarea'), () => lang);
    attachFiles($<HTMLButtonElement>('[data-clip]'), $<HTMLTextAreaElement>('textarea'), () => lang, $('.box'));
    load(true);
    setInterval(() => { if (!document.hidden) load(); }, 15000);
  </script>
</Base>

<style is:global>
  .room { max-width: 720px; margin: 0 auto; padding: 18px 16px 40px; font-family: var(--font); color: var(--ink); }
  .room header { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .room .logo { font-weight: 800; font-size: 22px; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; }
  .room .logo span { color: var(--acc); }
  .room .who { color: var(--mut); font-size: 14px; }
  .room h1 { font-size: clamp(24px, 5vw, 34px); margin: 18px 0 12px; }
  .room .steps { list-style: none; padding: 0; margin: 0 0 14px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; counter-reset: s; }
  .room .steps li { counter-increment: s; font-size: 12px; color: var(--mut); border-top: 4px solid var(--line); padding-top: 6px; }
  .room .steps li::before { content: counter(s) '. '; font-weight: 700; }
  .room .steps li.done { border-color: var(--acc); color: var(--ink); }
  .room .steps li.now { border-color: var(--accText); color: var(--ink); font-weight: 700; }
  .room .prog { margin: 0 0 12px; } .room .prog div { display: flex; justify-content: space-between; font-size: 14px; color: var(--mut); margin-bottom: 6px; } .room .prog b { color: var(--ink); }
  .room .prog i { display: block; height: 10px; background: var(--line); border-radius: 99px; overflow: hidden; } .room .prog u { display: block; height: 100%; background: var(--acc); border-radius: 99px; text-decoration: none; transition: width 0.4s; }
  .room .mcard { display: flex; gap: 12px; align-items: center; background: var(--surf); border: 1px solid var(--line); border-radius: 14px; padding: 10px 14px; margin-bottom: 12px; }
  .room .mcard .av { width: 42px; height: 42px; border-radius: 50%; background: var(--acc); color: var(--dark-ink); display: grid; place-items: center; font-weight: 800; font-size: 18px; flex: none; }
  .room .mcard div { display: flex; flex-direction: column; } .room .mcard small { color: var(--mut); }
  .room .box { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; height: min(640px, 72dvh); }
  .room .log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--bg); }
  .room .m { max-width: 82%; padding: 9px 12px; border-radius: 16px; font-size: 15px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; display: flex; flex-direction: column; gap: 3px; }
  .room .m small { font-size: 11px; color: var(--mut); }
  .room .m.them { align-self: flex-start; background: var(--surf); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  .room .m.me { align-self: flex-end; background: var(--acc); color: var(--dark-ink); border-bottom-right-radius: 4px; }
  .room .m.me small { color: rgba(0, 0, 0, 0.55); }
  .room .m.call { border: 2px solid var(--acc); }
  .room .save .tg { margin-left: 8px; color: #229ed9; font-weight: 600; text-decoration: none; }
  .room .m.stage { align-self: center; max-width: 100%; background: none; border: 1px dashed var(--line); color: var(--mut); font-size: 13px; text-align: center; }
  .room .m.typing { color: var(--mut); font-style: italic; }
  @media (max-width: 520px) { .room .steps { grid-template-columns: repeat(3, 1fr); } }
  .room .m a { color: inherit; text-decoration: underline; }
  .room form { display: flex; gap: 8px; padding: 10px; border-top: 1px solid var(--line); }
  .room textarea { flex: 1; resize: none; border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 12px; padding: 10px 12px; font: 16px var(--font); }
  .room .live { padding: 7px 14px; background: var(--acc); color: var(--dark-ink); font-size: 13px; font-weight: 700; text-align: center; }
  .room form .mic { background: var(--bg); color: var(--ink); border: 1px solid var(--line); display: grid; place-items: center; }
  .room form .mic.rec { background: var(--error, #e5484d); color: #fff; border-color: transparent; animation: micpulse 1.2s ease-in-out infinite; }
  .room form .mic.busy { opacity: 0.5; }
  .room .confirm { display: block; margin-top: 10px; border: 0; background: var(--acc); color: var(--dark-ink); font: 700 15px var(--font); padding: 11px 14px; border-radius: 12px; cursor: pointer; width: 100%; }
  .room .confirm:disabled { opacity: .6; } .room .cnote { display: block; margin-top: 6px; font-size: 12px; color: var(--mut); }
  .room .meta { list-style: none; padding: 0; margin: 6px 0; display: flex; gap: 6px 16px; flex-wrap: wrap; font-size: 14px; color: var(--mut); } .room .meta:empty { display: none; }
  .room .cab { font-weight: 700; color: var(--accText); }
  .room .box.drop { outline: 3px dashed var(--acc); outline-offset: -3px; }
  .room .file { font-weight: 600; } .room .file.img img { display: block; max-width: 240px; max-height: 240px; border-radius: 10px; margin-top: 4px; }
  @keyframes micpulse { 50% { opacity: 0.6; } }
  .room form button { border: 0; background: var(--acc); color: var(--dark-ink); width: 48px; border-radius: 12px; font-size: 18px; cursor: pointer; }
  .room .save { color: var(--mut); font-size: 14px; }
  .room .save a:not(.tg) { color: var(--mut); }
  .room .save button { background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; padding: 4px 10px; cursor: pointer; margin-left: 6px; }
</style>
