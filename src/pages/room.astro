---
// The client's private project chat: vaxogroup.com/room/?t=<room>. Language follows the client's request.
import Base from '../layouts/Base.astro';
const T = {
  en: { h: 'Your project with Vaxo', mgr: 'Your manager', wait: 'Your personal manager will join this chat within 24 hours.', ph: 'Write a message…', send: 'Send', save: 'Save this page — it is your private project chat. Everything about your project stays here.', copy: 'Copy link', copied: 'Copied', team: 'Vaxo team', you: 'You', call: 'Call', bad: 'This chat link is not valid. Write to us at vaxogroup.com.', err: 'Not sent. Try again.', hello: 'Hi {name}! This is your project chat. Write your questions here at any time — a manager replies within 24 hours.' },
  ru: { h: 'Ваш проект с Vaxo', mgr: 'Ваш менеджер', wait: 'Личный менеджер подключится к этому чату в течение 24 часов.', ph: 'Напишите сообщение…', send: 'Отправить', save: 'Сохраните эту страницу — это личный чат вашего проекта. Всё о проекте остаётся здесь.', copy: 'Скопировать ссылку', copied: 'Скопировано', team: 'Команда Vaxo', you: 'Вы', call: 'Созвон', bad: 'Ссылка на чат неверная. Напишите нам на vaxogroup.com.', err: 'Не отправилось. Попробуйте ещё раз.', hello: 'Здравствуйте, {name}! Это чат вашего проекта. Пишите сюда вопросы в любое время — менеджер отвечает в течение 24 часов.' },
  ua: { h: 'Ваш проєкт з Vaxo', mgr: 'Ваш менеджер', wait: 'Особистий менеджер приєднається до цього чату протягом 24 годин.', ph: 'Напишіть повідомлення…', send: 'Надіслати', save: 'Збережіть цю сторінку — це особистий чат вашого проєкту. Усе про проєкт залишається тут.', copy: 'Скопіювати посилання', copied: 'Скопійовано', team: 'Команда Vaxo', you: 'Ви', call: 'Дзвінок', bad: 'Посилання на чат неправильне. Напишіть нам на vaxogroup.com.', err: 'Не надіслано. Спробуйте ще раз.', hello: 'Вітаємо, {name}! Це чат вашого проєкту. Пишіть сюди питання будь-коли — менеджер відповідає протягом 24 годин.' },
};
---

<Base lang="en" title="Vaxo — your project chat" description="Your private project chat with Vaxo." noindex noChat>
  <main class="room">
    <header>
      <a href="/" class="logo">VAXO<span>.</span></a>
      <div class="who" data-who></div>
    </header>
    <h1 data-h></h1>
    <section class="box">
      <div class="log" data-log aria-live="polite"></div>
      <form data-form><textarea name="t" rows="2" maxlength="2000"></textarea><button type="submit" aria-label="Send">➤</button></form>
    </section>
    <p class="save"><span data-save></span> <button type="button" data-copy></button></p>
  </main>
  <script type="application/json" id="room-t" set:html={JSON.stringify(T)} />
  <script>
    type R = Record<string, any>;
    const ALL = JSON.parse(document.getElementById('room-t')!.textContent || '{}');
    const token = new URLSearchParams(location.search).get('t') || '';
    const $ = <E extends Element = HTMLElement>(s: string) => document.querySelector<E>(s)!;
    let T = ALL.en;
    let count = -1;
    const when = (iso: string) => new Date(iso.replace(' ', 'T') + 'Z').toLocaleString(undefined, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
    const bubble = (m: R, d: R) => {
      const me = m.sender === 'client';
      const el = document.createElement('div');
      el.className = 'm ' + (me ? 'me' : 'them') + (m.kind === 'call' ? ' call' : '');
      const who = document.createElement('small');
      who.textContent = `${me ? T.you : m.partner_name || T.team}${m.kind === 'call' ? ' · ' + T.call : ''} · ${when(m.at)}`;
      const body = document.createElement('div');
      body.textContent = m.text;
      // Links in messages (call links, files) are clickable.
      body.innerHTML = body.innerHTML.replace(/https?:\/\/[^\s<]+/g, (u) => `<a href="${u}" target="_blank" rel="noopener nofollow">${u}</a>`);
      el.append(who, body);
      return el;
    };
    async function load(scroll = false) {
      const r = await fetch(`/api/room/${token}`).catch(() => null);
      if (!r || !r.ok) { $('[data-h]').textContent = T.bad; $('.box').hidden = true; return; }
      const d = await r.json();
      T = ALL[d.lang] || ALL.en;
      document.documentElement.lang = d.lang === 'ua' ? 'uk' : d.lang;
      $('[data-h]').textContent = T.h;
      $('[data-who]').textContent = d.manager ? `${T.mgr}: ${d.manager}` : '';
      $<HTMLTextAreaElement>('textarea').placeholder = T.ph;
      $('[data-save]').textContent = T.save;
      $('[data-copy]').textContent = T.copy;
      if (d.messages.length === count) return;
      count = d.messages.length;
      const log = $('[data-log]');
      const intro = { sender: 'system', kind: 'text', text: T.hello.replace('{name}', d.name) + (d.manager ? '' : '\n' + T.wait), at: new Date().toISOString().slice(0, 19).replace('T', ' ') };
      log.replaceChildren(bubble(intro, d), ...d.messages.map((m: R) => bubble(m, d)));
      log.scrollTop = log.scrollHeight;
    }
    $<HTMLFormElement>('[data-form]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const ta = $<HTMLTextAreaElement>('textarea');
      const text = ta.value.trim();
      if (!text) return;
      const r = await fetch(`/api/room/${token}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text }) });
      if (!r.ok) return alert(T.err);
      ta.value = '';
      load(true);
    });
    $<HTMLTextAreaElement>('textarea').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); $<HTMLFormElement>('[data-form]').requestSubmit(); }
    });
    $('[data-copy]').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); $('[data-copy]').textContent = T.copied; } catch {}
    });
    load(true);
    setInterval(() => { if (!document.hidden) load(); }, 15000);
  </script>
</Base>

<style is:global>
  .room { max-width: 720px; margin: 0 auto; padding: 18px 16px 40px; font-family: var(--font); color: var(--ink); }
  .room header { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .room .logo { font-weight: 800; font-size: 22px; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; }
  .room .logo span { color: var(--acc); }
  .room .who { color: var(--mut); font-size: 14px; }
  .room h1 { font-size: clamp(24px, 5vw, 34px); margin: 18px 0 12px; }
  .room .box { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; height: min(640px, 72dvh); }
  .room .log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--bg); }
  .room .m { max-width: 82%; padding: 9px 12px; border-radius: 16px; font-size: 15px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; display: flex; flex-direction: column; gap: 3px; }
  .room .m small { font-size: 11px; color: var(--mut); }
  .room .m.them { align-self: flex-start; background: var(--surf); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  .room .m.me { align-self: flex-end; background: var(--acc); color: var(--dark-ink); border-bottom-right-radius: 4px; }
  .room .m.me small { color: rgba(0, 0, 0, 0.55); }
  .room .m.call { border: 2px solid var(--acc); }
  .room .m a { color: inherit; text-decoration: underline; }
  .room form { display: flex; gap: 8px; padding: 10px; border-top: 1px solid var(--line); }
  .room textarea { flex: 1; resize: none; border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 12px; padding: 10px 12px; font: 16px var(--font); }
  .room form button { border: 0; background: var(--acc); color: var(--dark-ink); width: 48px; border-radius: 12px; font-size: 18px; cursor: pointer; }
  .room .save { color: var(--mut); font-size: 14px; }
  .room .save button { background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; padding: 4px 10px; cursor: pointer; margin-left: 6px; }
</style>
