---
// Chat instead of forms (Decision 16): a Vax chat right on the page. The first message starts the project chat
// (/api/intake), no name or contact needed to begin; Vax asks for them when the talk has substance. The chat is
// remembered in this browser, so a returning visitor continues the same conversation.
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind: 'request' | 'collab' | 'gift';
  chips?: string[];
  topics?: { v: string; label: string }[]; // collab: who they are (sets interest)
  title?: string;
}
const { lang, kind, chips = [], topics = [], title } = Astro.props;
const T = {
  en: { hello: { request: "Hi! I'm Vax 🦝 Tell me in your own words what you want to build or improve — I'll answer right away and suggest options. No forms.", collab: "Hi! I'm Vax 🦝 Tell me who you are and what you'd like to do together — I'll answer right away.", gift: "Hi! I'm Vax 🦝 Who is the gift for and what's the occasion? I'll help you make it special." }, ph: 'Type, attach 📎 or tap the mic 🎤…', send: 'Send', mic: 'Voice input', clip: 'Attach files', typing: 'Vax is typing…', full: 'Open the full project chat →', tg: 'Continue in Telegram', err: 'Not sent. Try again.', who: 'Vax · AI manager · replies in seconds', note: '🔒 Only you and the Vaxo team see this chat. Close the page anytime — it will be here when you come back. 📎 Files and 🎤 voice work too.', restart: 'Start a new conversation', form: '📝 Prefer a short form instead' },
  ru: { hello: { request: 'Привет! Я Vax 🦝 Расскажите своими словами, что хотите сделать или улучшить, — отвечу сразу и предложу варианты. Без анкет.', collab: 'Привет! Я Vax 🦝 Расскажите, кто вы и что хотите сделать вместе, — отвечу сразу.', gift: 'Привет! Я Vax 🦝 Кому подарок и по какому поводу? Помогу сделать его особенным.' }, ph: 'Напишите, прикрепите 📎 или скажите 🎤…', send: 'Отправить', mic: 'Голосовой ввод', clip: 'Прикрепить файлы', typing: 'Vax печатает…', full: 'Открыть полный чат проекта →', tg: 'Продолжить в Telegram', err: 'Не отправилось. Попробуйте ещё раз.', who: 'Vax · ИИ-менеджер · отвечает за секунды', note: '🔒 Переписку видите только вы и команда Vaxo. Можно закрыть страницу — разговор дождётся вас. 📎 Файлы и 🎤 голос тоже можно.', restart: 'Начать новый разговор', form: '📝 Удобнее заполнить короткую форму' },
  ua: { hello: { request: 'Привіт! Я Vax 🦝 Розкажіть своїми словами, що хочете зробити чи покращити, — відповім одразу й запропоную варіанти. Без анкет.', collab: 'Привіт! Я Vax 🦝 Розкажіть, хто ви і що хочете зробити разом, — відповім одразу.', gift: 'Привіт! Я Vax 🦝 Кому подарунок і з якої нагоди? Допоможу зробити його особливим.' }, ph: 'Напишіть, прикріпіть 📎 або скажіть 🎤…', send: 'Надіслати', mic: 'Голосове введення', clip: 'Прикріпити файли', typing: 'Vax друкує…', full: 'Відкрити повний чат проєкту →', tg: 'Продовжити в Telegram', err: 'Не надіслано. Спробуйте ще раз.', who: 'Vax · ШІ-менеджер · відповідає за секунди', note: '🔒 Листування бачите лише ви й команда Vaxo. Можна закрити сторінку — розмова дочекається вас. 📎 Файли та 🎤 голос теж можна.', restart: 'Почати нову розмову', form: '📝 Зручніше заповнити коротку форму' },
}[lang];
---

<div class="pchat" data-pchat data-kind={kind} data-lang={lang} data-t={JSON.stringify({ ...T, hello: T.hello[kind] })}>
  <div class="pc-head"><img src="/mascot/vax-happy.webp" alt="" width="40" height="40" /><div><b>{title || 'Vax'}</b><small>{T.who}</small></div></div>
  {topics.length > 0 && <div class="pc-topics" role="group">{topics.map((x) => <button type="button" data-topic={x.v} aria-pressed="false">{x.label}</button>)}</div>}
  <div class="pc-log" data-pc-log aria-live="polite"></div>
  <div class="pc-chips" data-pc-chips>{chips.map((c) => <button type="button">{c}</button>)}</div>
  <form class="pc-in" data-pc-form>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
    <div class="pc-box">
      <button type="button" class="pc-clip" data-pc-clip aria-label={T.clip} title={T.clip}></button>
      <textarea rows="1" maxlength="4000" placeholder={T.ph} aria-label={T.ph} data-pc-text></textarea>
      <button type="button" class="pc-mic" data-pc-mic aria-label={T.mic}></button>
    </div>
    <button type="submit" class="pc-send" aria-label={T.send}>➤</button>
  </form>
  <div class="pc-foot"><small>{T.note}</small> <a href="#" data-pc-full hidden>{T.full}</a> <a href="#" data-pc-tg hidden target="_blank" rel="noopener">{T.tg}</a> <button type="button" class="pc-link" data-pc-restart hidden>{T.restart}</button> </div>
  <button type="button" class="pc-formbtn" data-pc-form-toggle hidden>{T.form}</button>
</div>

<script>
  import { attachMic, MIC_SVG } from '../scripts/voice';
  import { composer } from '../scripts/compose';
  import { attachFiles, linkify } from '../scripts/attach';
  type R = Record<string, any>;
  document.querySelectorAll<HTMLElement>('[data-pchat]').forEach((root) => {
    const T = JSON.parse(root.dataset.t || '{}');
    const kind = root.dataset.kind!, lang = root.dataset.lang!;
    const KEY = `vaxo_room_${kind}`;
    const started = Date.now();
    const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
    const log = $('[data-pc-log]'), ta = $<HTMLTextAreaElement>('[data-pc-text]'), chips = $('[data-pc-chips]');
    const get = (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } };
    const put = (k: string, v: string) => { try { v ? localStorage.setItem(k, v) : localStorage.removeItem(k); } catch {} };
    let room = get(KEY), count = -1, topic = '';
    // A page can show its old form as a fallback (the toggle appears only if a form is linked).
    const formSel = root.closest('[data-chat-host]')?.querySelector<HTMLElement>('[data-chat-fallback]');
    if (formSel) { const b = $('[data-pc-form-toggle]'); b.hidden = false; b.onclick = () => { formSel.hidden = !formSel.hidden; if (!formSel.hidden) formSel.scrollIntoView({ behavior: 'smooth', block: 'start' }); }; }
    root.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) => b.onclick = () => {
      topic = b.dataset.topic!; root.querySelectorAll('[data-topic]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); ta.focus();
    });
    const bubble = (who: string, text: string) => {
      const d = document.createElement('div');
      d.className = 'pc-m ' + who;
      d.innerHTML = linkify(text);
      return d;
    };
    const intro = () => bubble('vax', T.hello);
    async function load(scroll = true) {
      if (!room) { log.replaceChildren(intro()); return null; }
      const r = await fetch(`/api/room/${room}`).catch(() => null);
      if (!r || !r.ok) { room = ''; put(KEY, ''); log.replaceChildren(intro()); return null; }
      const d: R = await r.json();
      const full = $<HTMLAnchorElement>('[data-pc-full]'); full.href = `/room/?t=${room}`; full.hidden = false;
      const tg = $<HTMLAnchorElement>('[data-pc-tg]'); if (d.tg) { tg.href = d.tg; tg.hidden = false; }
      $('[data-pc-restart]').hidden = false;
      chips.hidden = true;
      const msgs = (d.messages as R[]).filter((m) => m.sender !== 'system' || !/^stage:/.test(m.text));
      if (msgs.length !== count) {
        count = msgs.length;
        log.replaceChildren(intro(), ...msgs.map((m) => bubble(m.sender === 'client' ? 'me' : 'vax', m.text)));
        if (scroll) log.scrollTop = log.scrollHeight;
      }
      return msgs[msgs.length - 1];
    }
    async function send(text: string) {
      text = text.trim();
      if (!text) return;
      log.append(bubble('me', text));
      const dots = bubble('vax wait', T.typing); log.append(dots); log.scrollTop = log.scrollHeight;
      chips.hidden = true;
      let ok = false;
      if (!room) {
        let promo = '', ref = '';
        try { promo = localStorage.getItem('vaxo_code') || ''; ref = localStorage.getItem('vaxo_ref') || ''; } catch {}
        const r = await fetch('/api/intake', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kind, text, lang, interest: topic, promo, ref, page: location.pathname, startedAt: started, website: $<HTMLInputElement>('.hp').value }) }).catch(() => null);
        const d = r && r.ok ? await r.json() : null;
        if (d?.room) { room = d.room; put(KEY, room); ok = true; navigator.sendBeacon?.('/api/ev', new Blob([JSON.stringify({ k: 'chat_start', p: location.pathname })], { type: 'application/json' })); }
      } else {
        const r = await fetch(`/api/room/${room}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text }) }).catch(() => null);
        ok = !!r?.ok;
      }
      if (!ok) { dots.textContent = T.err; return; }
      // Vax answers in a few seconds: poll until the reply arrives.
      for (let i = 0; i < 16; i++) {
        await new Promise((r) => setTimeout(r, 2500));
        const last = await load(false);
        if (last && last.sender !== 'client') break;
        if (!dots.isConnected) log.append(dots);
      }
      dots.remove();
      log.scrollTop = log.scrollHeight;
    }
    $<HTMLFormElement>('[data-pc-form]').onsubmit = (e) => { e.preventDefault(); const v = ta.value; ta.value = ''; send(v); };
    composer(ta, () => $<HTMLFormElement>('[data-pc-form]').requestSubmit());
    chips.querySelectorAll('button').forEach((b) => b.onclick = () => send(b.textContent || ''));
    const mic = $<HTMLButtonElement>('[data-pc-mic]'); mic.innerHTML = MIC_SVG; attachMic(mic, ta, () => lang);
    attachFiles($<HTMLButtonElement>('[data-pc-clip]'), ta, () => lang, root);
    $('[data-pc-restart]').onclick = () => { room = ''; count = -1; put(KEY, ''); chips.hidden = false; $('[data-pc-full]').hidden = true; $('[data-pc-tg]').hidden = true; $('[data-pc-restart]').hidden = true; load(); };
    // Cards with data-pick (collab types, gift tiers) choose the topic or start the message.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('[data-pick]') as HTMLElement | null;
      if (!a || !root.isConnected) return;
      const tb = root.querySelector<HTMLButtonElement>(`[data-topic="${a.dataset.pick}"]`);
      if (tb) tb.click(); else if (!ta.value) ta.value = (a.querySelector('b,h3')?.textContent || '').trim() + ' — ';
      setTimeout(() => ta.focus(), 400);
    });
    // Other parts of the page can start the chat: <a data-start-chat="text">.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('[data-start-chat]') as HTMLElement | null;
      if (!a || !root.isConnected) return;
      e.preventDefault(); root.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (a.dataset.startChat) ta.value = a.dataset.startChat; setTimeout(() => ta.focus(), 400);
    });
    load();
    setInterval(() => { if (room && !document.hidden) load(); }, 20000);
  });
</script>

<style>
  .pchat { display: flex; flex-direction: column; background: var(--surf); color: var(--ink); border: 2px solid var(--acc); box-shadow: 0 18px 50px rgba(0,0,0,.18); border-radius: 22px; overflow: hidden; min-height: 460px; height: min(620px, 78dvh); text-align: left; }
  .pc-head { display: flex; gap: 10px; align-items: center; padding: 12px 14px; background: var(--deep); color: var(--deepInk); }
  .pc-head img { width: 40px; height: 40px; border-radius: 50%; background: var(--acc); object-fit: contain; }
  .pc-head div { display: flex; flex-direction: column; line-height: 1.25; } .pc-head small { color: var(--deepMut); font-size: 12px; }
  .pc-topics { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 12px 0; }
  .pc-topics button, .pc-chips button { border: 1px solid var(--accText); color: var(--accText); background: transparent; border-radius: 999px; padding: 6px 11px; font: 600 13px var(--font); cursor: pointer; }
  .pc-topics button[aria-pressed='true'] { background: var(--acc); color: var(--dark-ink); border-color: var(--acc); }
  .pc-log { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 8px; background: var(--bg); }
  .pc-m { max-width: 86%; padding: 9px 12px; border-radius: 16px; font-size: 15px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
  .pc-m.vax { align-self: flex-start; background: var(--surf); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  .pc-m.me { align-self: flex-end; background: var(--acc); color: var(--dark-ink); border-bottom-right-radius: 4px; }
  .pc-m.wait { color: var(--mut); font-style: italic; }
  .pc-m a { color: inherit; text-decoration: underline; }
  .pc-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 12px; background: var(--bg); }
  .pc-chips[hidden], .pc-chips:empty { display: none; }
  /* Like Telegram: one rounded field with 📎 and 🎤 inside, a round ➤ outside; buttons keep their size and sit at the
     bottom while the text grows up to ~6 lines. */
  .pc-in { display: flex; align-items: flex-end; gap: 8px; padding: 10px; border-top: 1px solid var(--line); background: var(--surf); }
  .pc-box { flex: 1; min-width: 0; display: flex; align-items: flex-end; gap: 2px; border: 1px solid var(--line); background: var(--bg); border-radius: 22px; padding: 2px 4px; }
  .pc-box:focus-within { border-color: var(--acc); }
  .pc-box textarea { flex: 1; min-width: 0; resize: none; border: 0; outline: 0; background: transparent; color: var(--ink); padding: 10px 4px; font: 16px/1.35 var(--font); max-height: 160px; }
  .pc-box button { flex: none; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: var(--mut); cursor: pointer; display: grid; place-items: center; }
  .pc-box button:hover { color: var(--ink); }
  .pc-send { flex: none; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--acc); color: var(--dark-ink); font-size: 18px; cursor: pointer; display: grid; place-items: center; }
  .pc-clip.busy { opacity: 0.5; }
  .pchat.drop { outline: 3px dashed var(--acc); outline-offset: -3px; }
  .pc-m .file { display: inline-block; font-weight: 600; } .pc-m .file.img img { display: block; max-width: 220px; max-height: 220px; border-radius: 10px; margin-top: 4px; }
  .pc-formbtn { margin: 0 14px 14px; padding: 11px 14px; border: 1.5px solid var(--ink); border-radius: 12px; background: var(--bg); color: var(--ink); font: 600 14px var(--font); cursor: pointer; }
  .pc-formbtn:hover { background: var(--acc); color: var(--dark-ink); border-color: var(--acc); } .pc-formbtn[hidden] { display: none; }
  .pc-box .pc-mic.rec { background: var(--error, #e5484d); color: #fff; } .pc-mic.busy { opacity: 0.5; }
  .pc-foot { padding: 8px 14px 12px; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; background: var(--surf); }
  .pc-foot small { color: var(--mut); font-size: 12px; flex-basis: 100%; }
  .pc-foot a, .pc-link { color: var(--accText); font: 600 13px var(--font); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
</style>
