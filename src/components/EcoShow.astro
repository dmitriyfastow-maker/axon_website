      ['crm', 'Заявки и CRM', 'Каждая заявка и запись — сразу в доске и на почте. Приглашайте сотрудников с нужными правами.', 'Подключи CRM для заявок с сайта'],
      ['bot', 'ИИ-консультант 24/7', 'Отвечает посетителям по вашим ценам и правилам. Оставленный контакт — уже заявка.', 'Настрой ИИ-консультанта на моём сайте'],
      ['par', 'Партнёрская программа', 'Личная ссылка каждому партнёру. Переходы и заявки считаются сами.', 'Сделай партнёрскую программу для моего бизнеса'],
      ['vid', 'Контент и ролики', 'Контент-план, посты и сценарии — сразу. Монтаж и ИИ-ролики из ваших материалов Vax делает в фоне, результат приходит в чат.', 'Сделай контент-план и сценарии роликов на месяц для моего бизнеса'],
      ['auto', 'Автоматизация рутины', 'Vax связывает сайт, CRM, мессенджеры и напоминания, и рутина делается сама — без вас и без ошибок.', 'Помоги автоматизировать работу с клиентами в моём бизнесе'],
      ['app', 'Приложение для клиентов', 'Своё приложение на телефоне клиента: запись, бонусы, напоминания.', 'Сделай приложение для клиентов моего бизнеса'],
    ],
    try: 'Попробовать', live: 'Открыть живой пример',
    bk: { svc: ['Стрижка', 'Борода', 'Комплекс'], days: [['Пн', '10'], ['Вт', '11'], ['Ср', '12'], ['Чт', '13'], ['Пт', '14']], times: ['10:00', '11:00', '13:00', '15:00', '16:00', '18:00'], go: 'Записаться на 15:00', toast: 'Новая запись · Ср 12, 15:00 → CRM' },
    crm: { cols: ['Новые', 'В работе', 'Оплачено'], cards: [['Ирина', 'Запись · Ср 15:00'], ['Олег', 'Чат-бот · цена'], ['Марта', 'Форма · сайт'], ['Денис', 'Партнёр · ref']], new: ['Анна', 'Instagram · запись'] },
    bot: { q: 'Сколько стоит стрижка с бородой?', a: 'Комплекс — 750 грн, 1 час 15 минут. Ближайшее окно сегодня в 18:00 — записать вас?', who: 'ИИ-консультант · онлайн' },
    life: { q: 'Вот договор аренды. На что обратить внимание?', a: 'Три важных места: штраф за досрочный выезд (п. 4.2), рост цены раз в полгода (п. 3.5) и ремонт за ваш счёт (п. 6.1). Подготовить правки для арендодателя?', who: 'Vax · разбор файла' },
    par: { link: 'vaxogroup.com/s/…?ref=anna', rows: [['Анна', 'переходы', 'заявки'], ['Макс', 'переходы', 'заявки']] },
    vid: { plan: 'Контент-план · ноябрь', items: ['Пн · Рилс «до/после»', 'Ср · Карусель «5 стрижек сезона»', 'Пт · Сторис-опрос', 'Вс · Рилс за кадром'], badge: 'Монтаж — в фоне, в чат' },
    auto: { flow: [["10:02", "Клиент оставил заявку на сайте"], ["10:02", "Заявка уже в CRM, менеджеру — задача"], ["10:02", "Вам сообщение в Telegram"], ["за 2 часа", "Клиенту напоминание о визите"], ["через день", "Просьба оставить отзыв"]], note: "Всё это происходит само. Вы только видите результат." },
  },
  ua: {
    tag: 'Що ви отримаєте', h: 'Одне слово — і у вас працює все', p: 'Напишіть, чим займаєтеся. Vax сам продумає, що потрібно, щоб стати першим у ніші, і за хвилину збере все разом: сайт, запис, CRM для вашої команди, ШІ-консультанта й партнерів.',
    words: ['Барбершоп', 'Стоматологія', 'Кавʼярня', 'Фітнес-студія', 'Онлайн-школа'],
    parts: ['Сайт із фото', 'Онлайн-запис', 'Заявки в CRM', 'ШІ-консультант', 'Партнери'],
    go: 'Зібрати своє за хвилину', all: 'Усі роботи',
    tabs: [
      ['life', 'Особисті завдання й файли', 'Розібрати договір, спланувати відпустку, порахувати бюджет, написати листа. Файли й фото Vax читає сам.', 'Розбери мій документ і скажи, на що звернути увагу'],
      ['site', 'Сайт рівня студії', 'Дизайн під нішу, фото, тексти й SEO. Правите прямо на сторінці.', 'Збери сайт для мого бізнесу'],
      ['book', 'Онлайн-запис', 'Клієнт сам бачить вільні вікна й записується. Без дзвінків і перенесень.', 'Збери сайт з онлайн-записом для барбершопу'],
      ['crm', 'Заявки і CRM', 'Кожна заявка й запис — одразу в дошці й на пошті. Запрошуйте співробітників з потрібними правами.', 'Підключи CRM для заявок із сайту'],
      ['bot', 'ШІ-консультант 24/7', 'Відповідає відвідувачам за вашими цінами й правилами. Залишений контакт — уже заявка.', 'Налаштуй ШІ-консультанта на моєму сайті'],
      ['par', 'Партнерська програма', 'Особисте посилання кожному партнеру. Переходи й заявки рахуються самі.', 'Зроби партнерську програму для мого бізнесу'],
      ['vid', 'Контент і ролики', 'Контент-план, пости й сценарії — одразу. Монтаж і ШІ-ролики з ваших матеріалів Vax робить у фоні, результат приходить у чат.', 'Зроби контент-план і сценарії роликів на місяць для мого бізнесу'],
      ['auto', 'Автоматизація рутини', 'Vax звʼязує сайт, CRM, месенджери й нагадування, і рутина робиться сама — без вас і без помилок.', 'Допоможи автоматизувати роботу з клієнтами в моєму бізнесі'],
      ['app', 'Застосунок для клієнтів', 'Свій застосунок на телефоні клієнта: запис, бонуси, нагадування.', 'Зроби застосунок для клієнтів мого бізнесу'],
    ],
    try: 'Спробувати', live: 'Відкрити живий приклад',
    bk: { svc: ['Стрижка', 'Борода', 'Комплекс'], days: [['Пн', '10'], ['Вт', '11'], ['Ср', '12'], ['Чт', '13'], ['Пт', '14']], times: ['10:00', '11:00', '13:00', '15:00', '16:00', '18:00'], go: 'Записатися на 15:00', toast: 'Новий запис · Ср 12, 15:00 → CRM' },
    crm: { cols: ['Нові', 'В роботі', 'Оплачено'], cards: [['Ірина', 'Запис · Ср 15:00'], ['Олег', 'Чат-бот · ціна'], ['Марта', 'Форма · сайт'], ['Денис', 'Партнер · ref']], new: ['Анна', 'Instagram · запис'] },
    bot: { q: 'Скільки коштує стрижка з бородою?', a: 'Комплекс — 750 грн, 1 година 15 хвилин. Найближче вікно сьогодні о 18:00 — записати вас?', who: 'ШІ-консультант · онлайн' },
    life: { q: 'Ось договір оренди. На що звернути увагу?', a: 'Три важливі місця: штраф за дострокове виселення (п. 4.2), зростання ціни раз на пів року (п. 3.5) і ремонт вашим коштом (п. 6.1). Підготувати правки для орендодавця?', who: 'Vax · розбір файлу' },
    par: { link: 'vaxogroup.com/s/…?ref=anna', rows: [['Анна', 'переходи', 'заявки'], ['Макс', 'переходи', 'заявки']] },
    vid: { plan: 'Контент-план · листопад', items: ['Пн · Рілс «до/після»', 'Ср · Карусель «5 стрижок сезону»', 'Пт · Сторіс-опитування', 'Нд · Рілс за кадром'], badge: 'Монтаж — у фоні, в чат' },
    auto: { flow: [["10:02", "Клієнт залишив заявку на сайті"], ["10:02", "Заявка вже в CRM, менеджеру — завдання"], ["10:02", "Вам повідомлення в Telegram"], ["за 2 години", "Клієнту нагадування про візит"], ["через день", "Прохання залишити відгук"]], note: "Усе це відбувається само. Ви лише бачите результат." },
  },
  en: {
    tag: 'What you get', h: 'One word, and everything works for you', p: 'Say what you do. Vax works out what it takes to lead your niche and puts it all together in a minute: the site, booking, a CRM for your team, an AI consultant and partners.',
    words: ['Barbershop', 'Dental clinic', 'Coffee shop', 'Fitness studio', 'Online school'],
    parts: ['Site with photos', 'Online booking', 'Requests in CRM', 'AI consultant', 'Partners'],
    go: 'Build yours in a minute', all: 'All works',
    tabs: [
      ['life', 'Personal tasks and files', 'Review a contract, plan a trip, work out a budget, write a letter. Vax reads files and photos itself.', 'Review my document and tell me what to watch out for'],
      ['site', 'A studio-level site', 'Design for your niche, photos, copy and SEO. Edit right on the page.', 'Build a site for my business'],
      ['book', 'Online booking', 'Clients see the free times and book themselves. No calls, no rescheduling.', 'Build a site with online booking for a barbershop'],
      ['crm', 'Requests and CRM', 'Every request and booking lands on your board and in your email. Invite your staff with the right access.', 'Set up a CRM for requests from my site'],
      ['bot', 'AI consultant 24/7', 'Answers visitors from your prices and rules. A contact left in the chat is a request.', 'Set up an AI consultant on my site'],
      ['par', 'Partner programme', 'A personal link for every partner. Visits and requests count themselves.', 'Make a partner programme for my business'],
      ['vid', 'Content and videos', 'A content plan, posts and scripts at once. Editing and AI videos from your materials Vax makes in the background, and the result arrives in the chat.', 'Make a content plan and video scripts for a month for my business'],
      ['auto', 'Routine on autopilot', 'Vax links your site, CRM, messengers and reminders, so the routine runs by itself, without you and without mistakes.', 'Help me automate work with clients in my business'],
      ['app', 'An app for your clients', 'Your own app on the client\'s phone: booking, bonuses, reminders.', 'Make an app for the clients of my business'],
    ],
    try: 'Try it', live: 'Open a live example',
    bk: { svc: ['Haircut', 'Beard', 'Full set'], days: [['Mon', '10'], ['Tue', '11'], ['Wed', '12'], ['Thu', '13'], ['Fri', '14']], times: ['10:00', '11:00', '13:00', '15:00', '16:00', '18:00'], go: 'Book for 15:00', toast: 'New booking · Wed 12, 15:00 → CRM' },
    crm: { cols: ['New', 'In work', 'Paid'], cards: [['Irina', 'Booking · Wed 15:00'], ['Oleg', 'Chat bot · price'], ['Marta', 'Form · site'], ['Denis', 'Partner · ref']], new: ['Anna', 'Instagram · booking'] },
    bot: { q: 'How much is a haircut with a beard trim?', a: 'The full set is $35, 1 hour 15 minutes. The next free time is today at 18:00 — shall I book you?', who: 'AI consultant · online' },
    life: { q: 'Here is my rental contract. What should I watch out for?', a: 'Three key points: the fee for leaving early (4.2), the price rising every six months (3.5) and repairs at your cost (6.1). Shall I draft changes for the landlord?', who: 'Vax · file review' },
    par: { link: 'vaxogroup.com/s/…?ref=anna', rows: [['Anna', 'visits', 'requests'], ['Max', 'visits', 'requests']] },
    vid: { plan: 'Content plan · November', items: ['Mon · Reel "before/after"', 'Wed · Carousel "5 cuts of the season"', 'Fri · Story poll', 'Sun · Behind the scenes reel'], badge: 'Editing: in the background' },
    auto: { flow: [["10:02", "A client leaves a request on the site"], ["10:02", "It is in the CRM, with a task for the manager"], ["10:02", "You get a Telegram message"], ["2 h before", "The client gets a visit reminder"], ["next day", "A request to leave a review"]], note: "All of this happens by itself. You only see the result." },
  },
}[lang];
const T = TX!;
const WORKS: [string, string, string][] = [
  ['flagship', `flagship-${L3}.webp`, 'Ember'], ['eco-shop', `eco-shop-${L3}.webp`, 'Ostra'], ['eco-clinic', `eco-clinic-${L3}.webp`, 'Aurelia'],
  ['shop-2026', `shop-2026-${L3}.webp`, 'Kettle & Leaf'], ['personal-brand', `personal-brand-${L3}.webp`, 'Mila Hart'], ['client-app', `client-app-${L3}.webp`, 'Aurora'],
  ['coach', 'coach.webp', 'Maya Reed'], ['skincare', 'skincare.webp', 'Lumen'], ['dental', 'dental.webp', 'Dental'],
];
const LIVE: Record<string, string> = { site: 'flagship', book: 'eco-clinic', crm: 'crm', bot: 'ai-assistant', par: 'eco-partners', vid: 'marketing', auto: 'eco-crm', app: 'client-app' };
const ICO: Record<string, string> = {
  site: 'M3 5h18v14H3zM3 9h18', book: 'M4 6h16v14H4zM4 10h16M8 3v5M16 3v5', crm: 'M4 4h5v16H4zM10 4h5v10h-5zM16 4h4v7h-4z',
  bot: 'M5 6h14v10H9l-4 4zM9 11h.01M15 11h.01', par: 'M10 13a4 4 0 0 0 6 .5l3-3a4 4 0 0 0-5.7-5.7L12 6m2 5a4 4 0 0 0-6-.5l-3 3a4 4 0 0 0 5.7 5.7L12 18',
  vid: 'M3 6h13v12H3zM16 10l5-3v10l-5-3', auto: 'M4 12h4l2-5 4 10 2-5h4',
  app: 'M8 3h8v18H8zM11 18h2', life: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h6M9 16h4',
};
---

<section class="sec eco" id="eco" data-eco>
  <div class="w">
    <p class="tag">{T.tag}</p>
    <h2>{T.h}</h2>
    <p class="ps">{T.p}</p>

    <div class="one" aria-hidden="true">
      <div class="type"><span class="cur" data-type data-words={JSON.stringify(T.words)}>{T.words[0]}</span><i></i></div>
      <span class="arr">→</span>
      <div class="parts">{T.parts.map((x) => <span data-part><b>✓</b>{x}</span>)}</div>
    </div>

    <div class="board">
      <div class="tabs" role="tablist">
        {T.tabs.map(([k, h, d], i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} class:list={[{ on: i === 0 }]}>
            <span class="ic"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={ICO[k]} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="tx"><b>{h}</b><small>{d}</small></span>
            <u><i></i></u>
          </button>
        ))}
      </div>
      <div class="stage">
        {T.tabs.map(([k, h, d, q], i) => (
          <div class:list={['pane', k, { on: i === 0 }]} data-pane={i} role="tabpanel">
            <a class="vis" href={LIVE[k] ? `/examples/${LIVE[k]}/?lang=${lang}` : app(q)} target={LIVE[k] ? '_blank' : undefined} rel={LIVE[k] ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
              {k === 'site' && (
                <div class="gal">{WORKS.map(([, img, n], j) => <figure class:list={[{ on: j === 0 }]}><img src={`/examples/thumbs/${img}`} alt="" loading="lazy" width="640" height="400" /><figcaption>{n}</figcaption></figure>)}</div>
              )}
              {k === 'book' && (
                <div class="bkm">
                  <div class="row">{T.bk.svc.map((s, j) => <span class:list={['c', { on: j === 2 }]}>{s}</span>)}</div>
                  <div class="row">{T.bk.days.map(([w, d], j) => <span class:list={['c d', { on: j === 2 }]}>{w}<small>{d}</small></span>)}</div>
                  <div class="slots">{T.bk.times.map((t, j) => <span class:list={['c', { pick: j === 3, off: j === 1 }]}>{t}</span>)}</div>
                  <span class="cta">{T.bk.go}</span>
                  <span class="toast">{T.bk.toast}</span>
                </div>
              )}
              {k === 'crm' && (
                <div class="kb">
                  {T.crm.cols.map((c, j) => <div class="col"><b>{c}</b>{j === 0 && <div class="card nw"><i></i><span><b>{T.crm.new[0]}</b><small>{T.crm.new[1]}</small></span></div>}{T.crm.cards.filter((_, n) => n % 3 === j).map(([a, b]) => <div class="card"><i></i><span><b>{a}</b><small>{b}</small></span></div>)}</div>)}
                </div>
              )}
              {k === 'bot' && (
                <div class="chatm">
                  <div class="hd"><span class="av"></span><span><b>Vax</b><small>{T.bot.who}</small></span></div>
                  <p class="u">{T.bot.q}</p>
                  <p class="dots"><i></i><i></i><i></i></p>
                  <p class="a">{T.bot.a}</p>
                </div>
              )}
              {k === 'par' && (
                <div class="shot">
                  <figure><img src={`/examples/thumbs/eco-partners-${L3}.webp`} alt="" loading="lazy" width="640" height="400" /></figure>
                  <div class="parm over">
                    <div class="lnk">{T.par.link}</div>
                    {T.par.rows.map(([n, v, l], j) => <div class="pr"><b>{n}</b><span><em data-count={j ? 61 : 148}>0</em> {v}</span><span><em data-count={j ? 7 : 19}>0</em> {l}</span></div>)}
                  </div>
                </div>
              )}
              {k === 'app' && (
                <div class="shot"><figure><img src={`/examples/thumbs/client-app-${L3}.webp`} alt="" loading="lazy" width="640" height="400" /></figure></div>
              )}
              {k === 'life' && (
                <div class="chatm">
                  <div class="hd"><span class="av"></span><span><b>Vax</b><small>{T.life.who}</small></span></div>
                  <p class="u">📎 {T.life.q}</p>
                  <p class="dots"><i></i><i></i><i></i></p>
                  <p class="a">{T.life.a}</p>
                </div>
              )}
              {k === 'vid' && (
                <div class="vidm">
                  <div class="reel"><span class="pl">▶</span><i></i><i></i><i></i></div>
                  <div class="plan"><b>{T.vid.plan}</b>{T.vid.items.map((x) => <span>{x}</span>)}<em>{T.vid.badge}</em></div>
                </div>
              )}
              {k === 'auto' && (
                <div class="tl">
                  {T.auto.flow.map(([t, x], j) => <div class="st" style={`--d:${j * 0.6}s`}><em>{t}</em><i>✓</i><span>{x}</span></div>)}
                  <small>{T.auto.note}</small>
                </div>
              )}
            </a>
            <div class="foot">
              <div><b>{h}</b><p>{d}</p></div>
              <div class="acts"><a class="go" href={app(q)}>{T.try} →</a>{LIVE[k] && <a class="lv" href={`/examples/${LIVE[k]}/?lang=${lang}`} target="_blank" rel="noopener">{T.live} ↗</a>}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="end"><a class="big" href={P('/app/')}>{T.go} →</a><a class="all" href={P('/examples/')}>{T.all}</a></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-eco]').forEach((root) => {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 1) The word types itself, and the parts of the system light up after it.
    const cur = root.querySelector<HTMLElement>('[data-type]')!, words: string[] = JSON.parse(cur.dataset.words || '[]');
    const parts = [...root.querySelectorAll<HTMLElement>('[data-part]')];
    let wi = 0;
    const play = async () => {
      const w = words[wi % words.length]; wi++;
      parts.forEach((p) => p.classList.remove('lit'));
      if (!calm) for (let n = 1; n <= w.length; n++) { cur.textContent = w.slice(0, n); await new Promise((r) => setTimeout(r, 70)); }
      else cur.textContent = w;
      for (const p of parts) { await new Promise((r) => setTimeout(r, calm ? 0 : 260)); p.classList.add('lit'); }
      setTimeout(play, 2600);
    };
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.3 });
    io.observe(root);
    // 2) Tabs with a live stage; they move on by themselves until the visitor takes over.
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')], panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    let at = 0, auto = !calm, hold = false, t0 = performance.now();
    const DUR = 6500;
    const show = (i: number) => {
      at = i; t0 = performance.now();
      tabs.forEach((b, j) => { b.classList.toggle('on', j === i); b.setAttribute('aria-selected', String(j === i)); b.style.setProperty('--p', '0'); });
      panes.forEach((p, j) => { p.classList.toggle('on', j === i); if (j === i) { p.classList.remove('run'); void p.offsetWidth; p.classList.add('run'); } });
      panes[i].querySelectorAll<HTMLElement>('[data-count]').forEach((e) => { const end = +e.dataset.count!; let n = 0; const st = setInterval(() => { n = Math.min(end, n + Math.ceil(end / 24)); e.textContent = String(n); if (n >= end) clearInterval(st); }, 40); });
    };
    tabs.forEach((b, i) => (b.onclick = () => { auto = false; show(i); }));
    root.querySelector('.board')!.addEventListener('mouseenter', () => (hold = true));
    root.querySelector('.board')!.addEventListener('mouseleave', () => { hold = false; t0 = performance.now(); });
    // The site tab flips through real works.
    const figs = [...root.querySelectorAll<HTMLElement>('.gal figure')]; let fi = 0;
    setInterval(() => { if (!panes[0].classList.contains('on') || calm) return; figs[fi].classList.remove('on'); fi = (fi + 1) % figs.length; figs[fi].classList.add('on'); }, 1600);
    const tick = (now: number) => {
      if (auto && !hold) {
        const p = Math.min(1, (now - t0) / DUR);
        tabs[at].style.setProperty('--p', String(p));
        if (p >= 1) show((at + 1) % tabs.length);
      }
      requestAnimationFrame(tick);
    };
    show(0); requestAnimationFrame(tick);
  });
</script>

