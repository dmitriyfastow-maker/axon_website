---
// Home: one section instead of "Inside Vaxo" + "The level Vaxo builds at" (Decision 47, Dmitry 08.11).
// On top, the promise played out: a business name types itself and the parts of its system light up one by one.
// Below, everything Vaxo does as tabs with a live stage each (auto-advancing, pauses on hover): a studio-level site
// (real works), online booking, CRM, the AI consultant, partners, content and videos, automation. Production tasks
// (video editing, AI videos, integrations) are said honestly: Vax prepares the brief at once, the Vaxo team makes it.
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const P = (p: string) => (lang === 'en' ? p : `/${lang}${p}`);
const L3 = lang;
const app = (q: string) => `${P('/app/')}#q=${encodeURIComponent(q)}`;

const TX = {
  ru: {
    tag: 'Что вы получите', h: 'Одно слово — и у вас работает всё', p: 'Напишите, чем занимаетесь. Vax сам продумает, что нужно, чтобы стать первым в нише, и за минуту соберёт всё вместе: сайт, запись, CRM для вашей команды, ИИ-консультанта и партнёров.',
    words: ['Барбершоп', 'Стоматология', 'Кофейня', 'Фитнес-студия', 'Онлайн-школа'],
    parts: ['Сайт с фото', 'Онлайн-запись', 'Заявки в CRM', 'ИИ-консультант', 'Партнёры'],
    go: 'Собрать своё за минуту', all: 'Все работы',
    tabs: [
