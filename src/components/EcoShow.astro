  app: 'M8 3h8v18H8zM11 18h2', life: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h6M9 16h4',
};
---

<section class="sec eco" id="eco" data-eco>
  <div class="w">
    <p class="tag">{T.tag}</p>
    <h2>{T.h}</h2>
    <p class="ps">{T.p}</p>

    <div class="one" aria-hidden="true">
      <div class="type"><span class="cur" data-type data-words={JSON.stringify(T.words)}>{T.words[0]}</span><i></i></div>
      <span class="arr">→</span>
      <div class="parts">{T.parts.map((x) => <span data-part><b>✓</b>{x}</span>)}</div>
    </div>

    <div class="board">
      <div class="tabs" role="tablist">
        {T.tabs.map(([k, h, d], i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i} class:list={[{ on: i === 0 }]}>
            <span class="ic"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={ICO[k]} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="tx"><b>{h}</b><small>{d}</small></span>
            <u><i></i></u>
          </button>
        ))}
      </div>
      <div class="stage">
        {T.tabs.map(([k, h, d, q], i) => (
          <div class:list={['pane', k, { on: i === 0 }]} data-pane={i} role="tabpanel">
            <div class="vis" data-vis>
            <a class="sl on" data-slug={LIVE[k] || ''} href={LIVE[k] ? `/examples/${LIVE[k]}/?lang=${lang}` : app(q)} target={LIVE[k] ? '_blank' : undefined} rel={LIVE[k] ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
              {k === 'site' && (
                <div class="gal">{WORKS.map(([, img, n], j) => <figure class:list={[{ on: j === 0 }]}><img src={`/examples/thumbs/${img}`} alt="" loading="lazy" width="640" height="400" /><figcaption>{n}</figcaption></figure>)}</div>
              )}
              {k === 'book' && (
                <div class="bkm">
                  <div class="row">{T.bk.svc.map((s, j) => <span class:list={['c', { on: j === 2 }]}>{s}</span>)}</div>
                  <div class="row">{T.bk.days.map(([w, d], j) => <span class:list={['c d', { on: j === 2 }]}>{w}<small>{d}</small></span>)}</div>
                  <div class="slots">{T.bk.times.map((t, j) => <span class:list={['c', { pick: j === 3, off: j === 1 }]}>{t}</span>)}</div>
                  <span class="cta">{T.bk.go}</span>
                  <span class="toast">{T.bk.toast}</span>
                </div>
              )}
              {k === 'crm' && (
                <div class="kb">
                  {T.crm.cols.map((c, j) => <div class="col"><b>{c}</b>{j === 0 && <div class="card nw"><i></i><span><b>{T.crm.new[0]}</b><small>{T.crm.new[1]}</small></span></div>}{T.crm.cards.filter((_, n) => n % 3 === j).map(([a, b]) => <div class="card"><i></i><span><b>{a}</b><small>{b}</small></span></div>)}</div>)}
                </div>
              )}
              {k === 'bot' && (
                <div class="chatm">
                  <div class="hd"><span class="av"></span><span><b>Vax</b><small>{T.bot.who}</small></span></div>
                  <p class="u">{T.bot.q}</p>
                  <p class="dots"><i></i><i></i><i></i></p>
                  <p class="a">{T.bot.a}</p>
                </div>
              )}
              {k === 'par' && (
                <div class="parm">
                  <div class="lnk">{T.par.link}</div>
                  {T.par.rows.map(([n, v, l], j) => <div class="pr"><b>{n}</b><span><em data-count={j ? 61 : 148}>0</em> {v}</span><span><em data-count={j ? 7 : 19}>0</em> {l}</span></div>)}
                </div>
              )}
              {k === 'app' && (
                <div class="store">
                  <div class="top"><span class="ico">A</span><span><b>{T.store.name}</b><small>{T.store.sub}</small><em>{T.store.rate}</em></span><span class="get">{T.store.get}</span></div>
                  <div class="scr">{[1, 2, 3].map((j) => <img src={`/examples/thumbs/app-scr${j}-${L3}.webp`} alt="" loading="lazy" width="260" height="533" />)}</div>
                  <div class="badges"><span> App Store</span><span>▶ Google Play</span></div>
                  <small>{T.store.note}</small>
                </div>
              )}
              {k === 'life' && (
                <div class="chatm">
                  <div class="hd"><span class="av"></span><span><b>Vax</b><small>{T.life.who}</small></span></div>
                  <p class="u">📎 {T.life.q}</p>
                  <p class="dots"><i></i><i></i><i></i></p>
                  <p class="a">{T.life.a}</p>
                </div>
              )}
              {k === 'vid' && (
                <div class="vidm">
                  <div class="reel"><span class="pl">▶</span><i></i><i></i><i></i></div>
                  <div class="plan"><b>{T.vid.plan}</b>{T.vid.items.map((x) => <span>{x}</span>)}<em>{T.vid.badge}</em></div>
                </div>
              )}
              {k === 'auto' && (
                <div class="ag">
                  <svg viewBox="0 0 700 400" role="img" aria-label={T.tabs.find((x) => x[0] === 'auto')![1]}>
                    {T.ag.src.map((_, j) => <path id={`agi${j}`} class="ln" d={`M130 ${70 + j * 87} C 230 ${70 + j * 87}, 250 200, 300 200`} />)}
                    {T.ag.out.map((_, j) => <path id={`ago${j}`} class="ln" d={`M380 200 C 430 200, 440 ${40 + j * 64}, 520 ${40 + j * 64}`} />)}
                    {T.ag.src.map((_, j) => <circle class="dot" r="5"><animateMotion dur="2.4s" begin={`${j * 0.6}s`} repeatCount="indefinite"><mpath href={`#agi${j}`} /></animateMotion></circle>)}
                    {T.ag.out.map((_, j) => <circle class="dot o" r="5"><animateMotion dur="2.4s" begin={`${1.2 + j * 0.4}s`} repeatCount="indefinite"><mpath href={`#ago${j}`} /></animateMotion></circle>)}
                    {T.ag.src.map((x, j) => <g><rect class="nd" x="10" y={48 + j * 87} width="120" height="44" rx="12" /><text x="70" y={76 + j * 87}>{x}</text></g>)}
                    <circle class="hub" cx="340" cy="200" r="44" /><text class="hubt" x="340" y="207">Vax</text>
                    {T.ag.out.map((x, j) => <g><rect class="nd o" x="520" y={20 + j * 64} width="178" height="40" rx="12" /><text class="ot" x="534" y={45 + j * 64}>✓ {x}</text></g>)}
                  </svg>
                  <div class="log">{T.ag.log.map((x, j) => <span style={`--d:${0.8 + j * 0.9}s`}>{x}</span>)}<b>{T.ag.saved}</b></div>
                </div>
              )}
            </a>
            {k === 'life' && T.lifeMore.map((c) => (
              <div class="sl"><div class="chatm">
                <div class="hd"><span class="av"></span><span><b>Vax</b><small>{c.who}</small></span></div>
                <p class="u">{c.q}</p><p class="a show">{c.a}</p>
              </div></div>
            ))}
            {k === 'auto' && (
              <div class="sl"><div class="tl">
                {T.auto.flow.map(([t, x], j) => <div class="st" style={`--d:${j * 0.3}s`}><em>{t}</em><i>✓</i><span>{x}</span></div>)}
                <small>{T.auto.note}</small>
              </div></div>
            )}
            {(MORE[k] || []).map(([slug, img, n]) => (
              <a class="sl" data-slug={slug} href={`/examples/${slug}/?lang=${lang}`} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <div class="shot"><figure><img src={`/examples/thumbs/${img}`} alt="" loading="lazy" width="640" height="400" /><figcaption>{n} ↗</figcaption></figure></div>
              </a>
            ))}
            <div class="sdots" data-sdots></div>
            </div>
            <div class="foot">
              <div><b>{h}</b><p>{d}</p></div>
              <div class="acts"><a class="go" href={app(q)}>{T.try} →</a>{LIVE[k] && <a class="lv" data-lv data-base={P('/examples/')} data-k={k} href={`${P('/examples/')}?cat=${k}&ex=${LIVE[k]}`}>{T.live} ↗</a>}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <p class="only">ⓘ {T.only}</p>
    <div class="end"><a class="big" href={P('/app/')}>{T.go} →</a><a class="all" href={P('/examples/')}>{T.all}</a></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-eco]').forEach((root) => {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 1) The word types itself, and the parts of the system light up after it.
    const cur = root.querySelector<HTMLElement>('[data-type]')!, words: string[] = JSON.parse(cur.dataset.words || '[]');
    const parts = [...root.querySelectorAll<HTMLElement>('[data-part]')];
    let wi = 0;
    const play = async () => {
      const w = words[wi % words.length]; wi++;
      parts.forEach((p) => p.classList.remove('lit'));
      if (!calm) for (let n = 1; n <= w.length; n++) { cur.textContent = w.slice(0, n); await new Promise((r) => setTimeout(r, 70)); }
      else cur.textContent = w;
      for (const p of parts) { await new Promise((r) => setTimeout(r, calm ? 0 : 260)); p.classList.add('lit'); }
      setTimeout(play, 2600);
    };
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.3 });
    io.observe(root);
    // 2) Tabs with a live stage; they move on by themselves until the visitor takes over.
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')], panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    let at = 0, auto = !calm, hold = false, t0 = performance.now();
    const SLIDE = 3600;
    const decks = panes.map((p) => {
      const sl = [...p.querySelectorAll<HTMLElement>('.sl')], dots = p.querySelector<HTMLElement>('[data-sdots]')!, lv = p.querySelector<HTMLAnchorElement>('[data-lv]');
      const d = { sl, i: 0, t: 0, go: (n: number) => {
        d.i = (n + sl.length) % sl.length; d.t = performance.now();
        sl.forEach((x, j) => x.classList.toggle('on', j === d.i));
        [...dots.children].forEach((x, j) => x.classList.toggle('on', j === d.i));
        const slug = sl[d.i].dataset.slug;
        if (lv && slug) lv.href = `${lv.dataset.base}?cat=${lv.dataset.k}&ex=${slug}`;
      } };
      if (sl.length > 1) sl.forEach((_, j) => { const b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', String(j + 1)); b.onclick = () => { auto = false; d.go(j); }; dots.append(b); });
      d.go(0);
      return d;
    });
    const durOf = (i: number) => Math.max(6500, decks[i].sl.length * SLIDE);
    const show = (i: number) => {
      at = i; t0 = performance.now();
      tabs.forEach((b, j) => { b.classList.toggle('on', j === i); b.setAttribute('aria-selected', String(j === i)); b.style.setProperty('--p', '0'); });
      panes.forEach((p, j) => { p.classList.toggle('on', j === i); if (j === i) { p.classList.remove('run'); void p.offsetWidth; p.classList.add('run'); } });
      decks[i].go(0);
      panes[i].querySelectorAll<HTMLElement>('[data-count]').forEach((e) => { const end = +e.dataset.count!; let n = 0; const st = setInterval(() => { n = Math.min(end, n + Math.ceil(end / 24)); e.textContent = String(n); if (n >= end) clearInterval(st); }, 40); });
    };
    tabs.forEach((b, i) => (b.onclick = () => { auto = false; show(i); }));
    root.querySelector('.board')!.addEventListener('mouseenter', () => (hold = true));
    root.querySelector('.board')!.addEventListener('mouseleave', () => { hold = false; t0 = performance.now(); });
    // The site tab flips through real works.
    const figs = [...root.querySelectorAll<HTMLElement>('.gal figure')]; let fi = 0;
    setInterval(() => { if (!panes[0].classList.contains('on') || calm) return; figs[fi].classList.remove('on'); fi = (fi + 1) % figs.length; figs[fi].classList.add('on'); }, 1600);
    const tick = (now: number) => {
      if (auto && !hold) {
        const p = Math.min(1, (now - t0) / durOf(at));
        tabs[at].style.setProperty('--p', String(p));
        if (p >= 1) show((at + 1) % tabs.length);
      }
      // the slides of the open tab move on by themselves (also after the visitor picked a tab), and pause on hover
      const d = decks[at];
      if (!calm && !hold && d.sl.length > 1 && now - d.t > SLIDE) d.go(d.i + 1);
      requestAnimationFrame(tick);
    };
    show(0); requestAnimationFrame(tick);
  });
</script>

<style>
  /* The home page's base styles are scoped to Home.astro, so this section carries its own copy. */
  .eco { padding: clamp(72px, 10vw, 130px) 0; background: var(--bg); scroll-margin-top: 56px; color: var(--ink); }
  .eco .w { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
  .eco h2 { font-weight: 600; font-size: clamp(34px, 5.2vw, 68px); line-height: 1.03; letter-spacing: -0.035em; margin: 0; max-width: 18ch; }
  .eco .ps { margin-top: 14px; color: var(--mut); max-width: 620px; }
  .eco .tag { color: var(--accText); font-weight: 700; letter-spacing: .16em; text-transform: uppercase; font-size: 12.5px; margin: 0 0 12px; }
  .one { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin: 34px 0 30px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 20px; background: var(--surf); }
  .one .type { display: flex; align-items: center; min-width: 210px; padding: 12px 18px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line2); font-size: 18px; font-weight: 600; }
  .one .type i { width: 2px; height: 22px; background: var(--accText); margin-left: 3px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .one .arr { color: var(--mut); font-size: 22px; }
  .one .parts { display: flex; gap: 8px; flex-wrap: wrap; }
  .one .parts span { display: inline-flex; gap: 7px; align-items: center; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--mut); font-size: 14.5px; transition: all .3s; }
  .one .parts b { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; background: var(--line); color: transparent; transition: all .3s; }
  .one .parts span.lit { color: var(--ink); border-color: color-mix(in srgb, var(--accText) 60%, transparent); background: color-mix(in srgb, var(--accText) 10%, transparent); }
  .one .parts span.lit b { background: var(--accText); color: var(--bg); }

  .board { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: 18px; align-items: stretch; }
  .tabs { display: grid; gap: 6px; align-content: start; }
  .tabs button { position: relative; display: flex; gap: 12px; align-items: flex-start; text-align: left; padding: 13px 14px; border: 1px solid transparent; border-radius: 16px; background: transparent; color: var(--ink); cursor: pointer; font: inherit; overflow: hidden; }
  .tabs button:hover { background: var(--surf); }
  .tabs button.on { background: var(--surf); border-color: var(--line2); }
  .tabs .ic { flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--surf2); color: var(--mut); }
  .tabs button.on .ic { background: var(--accText); color: var(--bg); }
  .tabs .tx b { display: block; font-size: 16px; }
  .tabs .tx small { display: none; color: var(--mut); font-size: 13.5px; line-height: 1.45; margin-top: 3px; }
  .tabs button.on .tx small { display: block; }
  .tabs u { position: absolute; left: 14px; right: 14px; bottom: 6px; height: 2px; background: transparent; text-decoration: none; }
  .tabs button.on u { background: var(--line); }
  .tabs u i { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--accText); }

  .stage { position: relative; min-height: 610px; border: 1px solid var(--line2); border-radius: 24px; background: radial-gradient(800px 400px at 80% -10%, color-mix(in srgb, var(--accText) 14%, transparent), transparent), var(--surf); overflow: hidden; }
  .pane { position: absolute; inset: 0; display: grid; grid-template-rows: 1fr auto; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .45s, transform .45s, visibility .45s; }
  .pane.on { opacity: 1; visibility: visible; transform: none; }
  .vis { position: relative; display: grid; color: inherit; text-decoration: none; cursor: pointer; place-items: center; padding: 26px; overflow: hidden; }
  .foot { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 18px 22px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 40%, transparent); flex-wrap: wrap; }
  .foot b { font-size: 17px; }
  .foot p { margin: 2px 0 0; color: var(--mut); font-size: 14px; max-width: 52ch; }
  .foot .acts { display: flex; gap: 10px; flex-wrap: wrap; }
  .foot .go { background: var(--accText); color: var(--bg); font-weight: 700; padding: 11px 18px; border-radius: 999px; text-decoration: none; white-space: nowrap; }
  .foot .lv { color: var(--ink); border: 1px solid var(--line2); padding: 10px 16px; border-radius: 999px; text-decoration: none; white-space: nowrap; }

  /* site: real works flipping */
  .gal { position: relative; width: min(100%, 640px); aspect-ratio: 16/10; }
  .gal figure { position: absolute; inset: 0; margin: 0; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,.4); opacity: 0; transform: scale(.96) translateY(10px); transition: opacity .7s, transform .7s; }
  .gal figure.on { opacity: 1; transform: none; }
  .gal img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .gal figcaption { position: absolute; left: 12px; bottom: 12px; background: rgba(0,0,0,.65); color: #fff; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; }

  /* booking */
  .bkm { position: relative; width: min(100%, 460px); display: grid; gap: 12px; padding: 22px; border-radius: 18px; background: var(--bg); border: 1px solid var(--line2); box-shadow: 0 30px 60px rgba(0,0,0,.35); }
  .bkm .row, .bkm .slots { display: flex; gap: 8px; flex-wrap: wrap; }
  .bkm .slots { display: grid; grid-template-columns: repeat(3, 1fr); }
  .bkm .c { padding: 9px 12px; border: 1px solid var(--line2); border-radius: 999px; font-size: 14px; font-weight: 600; text-align: center; }
  .bkm .c.d { border-radius: 12px; min-width: 56px; } .bkm .c small { display: block; font-weight: 400; color: var(--mut); }
  .bkm .c.on { background: var(--accText); color: var(--bg); border-color: var(--accText); } .bkm .c.on small { color: inherit; opacity: .8; }
  .bkm .c.off { opacity: .3; text-decoration: line-through; }
  .bkm .cta { text-align: center; padding: 13px; border-radius: 12px; background: var(--accText); color: var(--bg); font-weight: 700; opacity: .35; }
  .bkm .toast { position: absolute; left: 50%; bottom: -18px; transform: translate(-50%, 10px); white-space: nowrap; background: #16a34a; color: #fff; padding: 9px 14px; border-radius: 999px; font-size: 13px; font-weight: 700; opacity: 0; box-shadow: 0 10px 30px rgba(0,0,0,.3); }
  .pane.run .bkm .c.pick { animation: pick .5s 1.1s forwards; }
  .pane.run .bkm .cta { animation: lit .4s 1.7s forwards; }
  .pane.run .bkm .toast { animation: toast .5s 2.6s forwards; }
  @keyframes pick { to { background: var(--accText); color: var(--bg); border-color: var(--accText); transform: scale(1.06); } }
  @keyframes lit { to { opacity: 1; } }
  @keyframes toast { to { opacity: 1; transform: translate(-50%, 0); } }

  /* crm */
  .kb { width: min(100%, 620px); display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .kb .col { display: grid; gap: 8px; align-content: start; padding: 12px; border-radius: 14px; background: var(--bg); border: 1px solid var(--line); min-height: 250px; }
  .kb .col > b { font-size: 13px; color: var(--mut); }
  .kb .card { display: flex; gap: 9px; align-items: center; padding: 10px; border-radius: 10px; background: var(--surf2); border: 1px solid var(--line); }
  .kb .card i { flex: none; width: 26px; height: 26px; border-radius: 50%; background: color-mix(in srgb, var(--accText) 45%, var(--surf2)); }
  .kb .card b { display: block; font-size: 13.5px; } .kb .card small { display: block; font-size: 12px; color: var(--mut); }
  .kb .card.nw { border-color: var(--accText); opacity: 0; transform: translateY(-18px); }
  .pane.run .kb .card.nw { animation: drop .55s .9s cubic-bezier(.2,.9,.3,1.3) forwards; }
  @keyframes drop { to { opacity: 1; transform: none; } }

  /* AI consultant */
  .chatm { width: min(100%, 400px); border-radius: 18px; overflow: hidden; background: var(--bg); border: 1px solid var(--line2); box-shadow: 0 30px 60px rgba(0,0,0,.35); display: grid; gap: 10px; padding-bottom: 16px; }
  .chatm .hd { display: flex; gap: 10px; align-items: center; padding: 12px 14px; background: var(--accText); color: var(--bg); }
  .chatm .av { width: 34px; height: 34px; border-radius: 50%; background: url('/mascot/vax-happy.webp') center/cover, rgba(255,255,255,.3); position: relative; }
  .chatm .av:after { content: ''; position: absolute; right: 0; bottom: 0; width: 10px; height: 10px; border-radius: 50%; background: #22c55e; border: 2px solid var(--accText); }
  .chatm .hd small { display: block; font-size: 12px; opacity: .85; }
  .chatm p { margin: 0 14px; padding: 10px 13px; border-radius: 14px; font-size: 14.5px; max-width: 80%; }
  .chatm .u { justify-self: end; background: var(--surf2); }
  .chatm .a { background: color-mix(in srgb, var(--accText) 14%, var(--bg)); border: 1px solid var(--line); opacity: 0; }
