---
import type { Dict } from '../i18n';

interface Props { t: Dict }
const { t } = Astro.props;
---

<section class="session">
  <div class="box">
    <div class="copy">
      <div class="eyebrow">{t.stepZero}</div>
      <h2>{t.sessTitle}</h2>
      <p>{t.sessSub}</p>
      <div class="foot">
        <a href="#contact" class="cta">{t.cta1}</a>
        <span class="note">◆ {t.sessNote}</span>
      </div>
    </div>
    <ol>
      {
        t.sessItems.map((x, i) => (
          <li>
            <span class="n">{`0${i + 1}`}</span>
            <span>{x}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .session {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px) clamp(80px, 9vw, 128px);
  }
  .box {
    background: var(--surf2);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(32px, 5vw, 64px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    letter-spacing: -0.035em;
    font-weight: 700;
    line-height: 1.04;
    text-wrap: balance;
  }
  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mut);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
  }
  .cta {
    display: inline-flex;
    white-space: nowrap;
    background: var(--ink);
    color: var(--bg);
    padding: 16px 26px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
  }
  .cta:hover {
    opacity: 0.88;
    color: var(--bg);
  }
  .note {
    font-size: 14px;
    color: var(--mut);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  li {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 18px 20px;
    background: var(--surf);
    border-radius: 16px;
    font-size: 17px;
  }
  .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accText);
    min-width: 22px;
  }
</style>
