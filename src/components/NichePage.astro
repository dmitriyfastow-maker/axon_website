---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, langPath, type Lang } from '../i18n';
import { NICHES, NICHE_UI, type Niche } from '../data/niches';

interface Props { lang: Lang; niche: Niche }
const { lang, niche } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const pre = lang === 'en' ? '' : `/${lang}`;
const alts = { en: `/for/${niche.slug}/`, ru: `/ru/for/${niche.slug}/`, ua: `/ua/for/${niche.slug}/` };
const U = NICHE_UI[lang];
const P = niche.t[lang];
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: P.h1, description: P.desc, inLanguage: lang === 'ua' ? 'uk' : lang, provider: { '@type': 'Organization', name: 'Vaxo', url: 'https://vaxogroup.com/' } };
---

<Base lang={lang} title={P.title} description={P.desc} path={alts[lang]} alts={alts}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="niche">
    <p class="tag">{P.name}</p>
    <h1>{P.h1}</h1>
    <p class="lead">{P.lead}</p>
    <div class="row"><a class="cta" href={`${home}#contact`}>{U.cta}</a> <a class="ghost" href={`${pre}/start/`}>{U.start}</a></div>
    <section><h2>{U.pains}</h2><ul>{P.pains.map((x) => <li>{x}</li>)}</ul></section>
    <section><h2>{U.gets}</h2><ul>{P.gets.map((x) => <li>{x}</li>)}</ul></section>
    <div class="box"><b>{U.price}</b><p>{U.priceP}</p><a class="cta" href={`${home}#contact`}>{U.cta}</a></div>
    <p class="more">{U.all}: {NICHES.filter((n) => n.slug !== niche.slug).map((n, i) => <>{i > 0 ? ' · ' : ''}<a href={`${pre}/for/${n.slug}/`}>{n.t[lang].name}</a></>)}</p>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .niche { max-width: 760px; margin: 0 auto; padding: 110px 16px 80px; line-height: 1.65; font-size: 17px; }
  .tag { color: var(--mut); text-transform: uppercase; letter-spacing: .08em; font-size: 13px; margin: 0; }
  h1 { font-size: clamp(30px, 5vw, 46px); line-height: 1.12; letter-spacing: -0.02em; margin: 8px 0 12px; }
  .lead { font-size: 19px; color: var(--mut); }
  h2 { font-size: 22px; margin: 30px 0 8px; } li { margin: 6px 0; }
  .row { margin: 18px 0; }
  .cta { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 12px 20px; border-radius: 999px; text-decoration: none; }
  .ghost { color: var(--ink); margin-left: 10px; }
  .box { margin-top: 36px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px; }
  .more { margin-top: 28px; color: var(--mut); font-size: 15px; } .more a { color: var(--ink); }
</style>
