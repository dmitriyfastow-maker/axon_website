---
// Vax the raccoon with a speech bubble — a small brand moment in context (monobank-cat style).
// Click Vax for a random joke (see scripts/vax.ts).
interface Props { text: string; face?: 'happy' | 'shocked' | 'smug' | 'front'; pose?: string; flip?: boolean; big?: boolean }
// pose = a section-specific raccoon (/mascot/vax-<pose>.webp, transparent, full body), e.g. chef, calc, checklist.
const { text, face = 'happy', pose, flip = false, big = false } = Astro.props;
---

<div class:list={['vax-says', { flip, big, pose: !!pose }]}>
  {pose ? <img src={`/mascot/vax-${pose}.webp`} alt="Vax, the Vaxo raccoon" width="300" height="400" loading="lazy" class="posed" /> : <img src={`/mascot/vax-${face}.webp`} alt="Vax, the Vaxo raccoon" width="120" height="120" loading="lazy" data-vax-poke />}
  <p class="vax-bubble">{text}</p>
</div>

<style>
  .vax-says { display: flex; align-items: center; gap: 14px; max-width: 560px; margin: 20px auto 0; }
  .vax-says.flip { flex-direction: row-reverse; }
  img { width: 72px; height: auto; flex: none; }
  .vax-bubble { position: relative; margin: 0; background: var(--surf); border: 1px solid var(--line); border-radius: 16px; padding: 12px 16px; font-size: 15px; font-weight: 500; color: var(--ink); }
  .vax-bubble::before { content: ''; position: absolute; left: -7px; top: 50%; width: 12px; height: 12px; background: var(--surf); border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); transform: translateY(-50%) rotate(45deg); }
  .flip .vax-bubble::before { left: auto; right: -7px; transform: translateY(-50%) rotate(-135deg); }
  .vax-says.big { flex-direction: column-reverse; align-items: flex-start; margin: 28px 0 0; max-width: 340px; gap: 10px; }
  .big img { width: clamp(110px, 14vw, 170px); transform: rotate(-3deg); }
  .big .vax-bubble::before { left: 36px; top: auto; bottom: -7px; transform: rotate(-45deg); }
  .pose img.posed { width: 110px; height: auto; filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.18)); }
  .big.pose img.posed { width: clamp(150px, 18vw, 220px); transform: none; }
  @media (max-width: 760px) { .vax-says.big { flex-direction: row; align-items: center; max-width: none; } .big img { width: 84px; } .big.pose img.posed { width: 120px; } .big .vax-bubble::before { left: -7px; top: 50%; bottom: auto; transform: translateY(-50%) rotate(45deg); } }
</style>
