---
import type { Dict, Lang } from '../i18n';

interface Props { t: Dict; lang?: Lang }
const { lang = 'en' } = Astro.props;
// How working with us goes, in three steps (the hero already shows the three packages).
const S = {
  en: { h: 'How it works', steps: [
    ['01', 'Tell Vax what you need', 'In the chat, in your own words. In a minute you get a plan and a price — and a free look at your current site or social pages.'],
    ['02', 'We launch in days', 'Website, AI employee and your app. You see the result first — the second half is paid only after you like it.'],
    ['03', 'We run it for you every month', 'The AI answers your clients 24/7, and we fix, improve and show you the results. You run the business — the rest is ours.'] ] },
  ru: { h: 'Как это работает', steps: [
    ['01', 'Напишите Vax, что нужно', 'В чате, своими словами. За минуту — план и цена, плюс бесплатно посмотрим ваш сайт или соцсети.'],
    ['02', 'Запускаем за дни', 'Сайт, ИИ-сотрудник и ваше приложение. Сначала вы смотрите результат — вторую половину платите, только если всё нравится.'],
    ['03', 'Каждый месяц ведём всё за вас', 'ИИ отвечает вашим клиентам 24/7, а мы исправляем, улучшаем и показываем результаты. Вы занимаетесь бизнесом — остальное наше.'] ] },
  ua: { h: 'Як це працює', steps: [
    ['01', 'Напишіть Vax, що потрібно', 'У чаті, своїми словами. За хвилину — план і ціна, плюс безкоштовно подивимося ваш сайт чи соцмережі.'],
    ['02', 'Запускаємо за дні', 'Сайт, ШІ-працівник і ваш застосунок. Спочатку ви дивитеся результат — другу половину платите, лише якщо все подобається.'],
    ['03', 'Щомісяця ведемо все за вас', 'ШІ відповідає вашим клієнтам 24/7, а ми виправляємо, покращуємо й показуємо результати. Ви займаєтесь бізнесом — решта наша.'] ] },
}[lang];
---

<section id="method" class="method">
  <h2 class="mh">{S.h}</h2>
  <div class="grid">
    {
      S.steps.map(([n, h, d]) => (
        <div class="card">
          <div class="n">{n}</div>
          <h2>{h}</h2>
          <p>{d}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .mh { font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.03em; margin: 0 0 22px; }
  .method {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px) clamp(80px, 9vw, 128px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .card {
    background: var(--surf);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .n {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--accText);
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-size: 26px;
    letter-spacing: -0.025em;
    font-weight: 700;
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--mut);
    text-wrap: pretty;
  }
</style>
