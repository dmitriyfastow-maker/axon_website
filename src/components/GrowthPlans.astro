---
// Growth cabinet subscription (Decision 24, prices approved by Dmitry 30.10): after the project the client keeps a
// cabinet with leads, site analytics, a weekly AI report and monthly improvements. Care / Growth / Pro.
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const C = {
  en: {
    eyebrow: 'After launch', h2: 'Your growth cabinet — the whole business on one screen',
    sub: 'Every site, shop or app we build comes with a personal cabinet. Keep it running on a monthly plan: you see every lead, where people come from and what to fix next — and we keep improving it for you.',
    per: '/ month', pop: 'Most popular', cta: 'Ask Vax about it →', note: 'Cancel any time. Prices in USD; you can pay by card.',
    plans: [
      ['Care', '$39', ['Hosting, backups and security', 'Fixes when something breaks', 'Monthly AI report: what happened and what to improve']],
      ['Growth', '$129', ['Everything in Care', 'All leads in one inbox: site, AI chat, Instagram', 'AI assistant answering customers 24/7', 'Weekly AI report in plain words', '2 improvements every month']],
      ['Pro', '$299', ['Everything in Growth', '5 improvements every month', 'Ads management (basic)', 'Priority: answers within hours']],
    ],
    ask: 'Hi Vax! Tell me about the growth cabinet plans (Care / Growth / Pro).',
  },
  ru: {
    eyebrow: 'После запуска', h2: 'Кабинет роста — весь бизнес на одном экране',
    sub: 'К каждому сайту, магазину или приложению, которые мы делаем, идёт личный кабинет. Подключите его помесячно: видно каждую заявку, откуда приходят люди и что улучшить дальше — а мы продолжаем улучшать за вас.',
    per: '/ мес', pop: 'Чаще всего выбирают', cta: 'Спросить Vax →', note: 'Отменить можно в любой момент. Цены в долларах, оплата картой.',
    plans: [
      ['Care', '$39', ['Хостинг, резервные копии и защита', 'Исправления, если что-то сломалось', 'ИИ-отчёт раз в месяц: что было и что улучшить']],
      ['Growth', '$129', ['Всё из Care', 'Все заявки в одном месте: сайт, ИИ-чат, Instagram', 'ИИ-помощник отвечает клиентам 24/7', 'ИИ-отчёт каждую неделю простыми словами', '2 улучшения в месяц']],
      ['Pro', '$299', ['Всё из Growth', '5 улучшений в месяц', 'Ведение рекламы (базовое)', 'Приоритет: ответ в течение нескольких часов']],
    ],
    ask: 'Привет, Vax! Расскажи про тарифы кабинета роста (Care / Growth / Pro).',
  },
  ua: {
    eyebrow: 'Після запуску', h2: 'Кабінет зростання — весь бізнес на одному екрані',
    sub: 'До кожного сайту, магазину чи застосунку, які ми робимо, йде особистий кабінет. Підключіть його щомісяця: видно кожну заявку, звідки приходять люди і що покращити далі — а ми продовжуємо покращувати за вас.',
    per: '/ міс', pop: 'Обирають найчастіше', cta: 'Запитати Vax →', note: 'Скасувати можна будь-коли. Ціни в доларах, оплата карткою.',
    plans: [
      ['Care', '$39', ['Хостинг, резервні копії й захист', 'Виправлення, якщо щось зламалося', 'ШІ-звіт раз на місяць: що було і що покращити']],
      ['Growth', '$129', ['Усе з Care', 'Усі заявки в одному місці: сайт, ШІ-чат, Instagram', 'ШІ-помічник відповідає клієнтам 24/7', 'ШІ-звіт щотижня простими словами', '2 покращення на місяць']],
      ['Pro', '$299', ['Усе з Growth', '5 покращень на місяць', 'Ведення реклами (базове)', 'Пріоритет: відповідь протягом кількох годин']],
    ],
    ask: 'Привіт, Vax! Розкажи про тарифи кабінету зростання (Care / Growth / Pro).',
  },
}[lang];
---

<section class="gp" id="growth">
  <div class="in">
    <p class="eyebrow">{C.eyebrow}</p>
    <h2>{C.h2}</h2>
    <p class="sub">{C.sub}</p>
    <div class="grid">
      {C.plans.map(([name, price, items], i) => (
        <article class:list={['plan', { pop: i === 1 }]}>
          {i === 1 && <span class="badge">{C.pop}</span>}
          <h3>{name}</h3>
          <p class="price"><b>{price}</b> {C.per}</p>
          <ul>{(items as string[]).map((x) => <li>{x}</li>)}</ul>
          <a href="#" class="go" data-vax-chat data-vax-ask={C.ask}>{C.cta}</a>
        </article>
      ))}
    </div>
    <p class="note">{C.note}</p>
  </div>
</section>

<style>
  .gp { padding: 80px 0; }
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .eyebrow { color: var(--accText); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 13px; margin: 0 0 10px; }
  h2 { font-size: clamp(30px, 4.5vw, 46px); line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 14px; max-width: 22ch; }
  .sub { color: var(--mut); font-size: 18px; line-height: 1.55; max-width: 62ch; margin: 0 0 32px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .plan { position: relative; border: 1px solid var(--line); border-radius: 22px; padding: 26px; background: var(--surf); display: flex; flex-direction: column; }
  .plan.pop { border-color: var(--acc); box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--acc) 70%, transparent); }
  .badge { position: absolute; top: -12px; left: 22px; background: var(--acc); color: var(--dark-ink); font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
  h3 { margin: 0; font-size: 22px; }
  .price { margin: 10px 0 16px; color: var(--mut); }
  .price b { font-size: 40px; color: var(--ink); letter-spacing: -0.03em; }
  ul { list-style: none; padding: 0; margin: 0 0 22px; display: grid; gap: 9px; flex: 1; }
  li { padding-left: 22px; position: relative; line-height: 1.4; }
  li::before { content: '✓'; position: absolute; left: 0; color: var(--accText); font-weight: 700; }
  .go { align-self: flex-start; font-weight: 700; color: var(--accText); text-decoration: none; }
  .note { color: var(--mut); font-size: 14px; margin: 18px 0 0; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
