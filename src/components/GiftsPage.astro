---
// Cartoon gifts (/gifts/, Decision 15): personalised clips with Vax for birthdays, anniversaries, apologies.
// Video orders are not open yet, so the form hands the idea to Vax in Workspace (no waitlist, no contacts).
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, langPath, navHref, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/gifts/', ua: '/ua/gifts/', ru: '/ru/gifts/' };

const C = {
  en: {
    title: 'Vaxo Gifts — a cartoon with your names', desc: 'A personalised cartoon clip with Vax the raccoon for a birthday, an anniversary or just because. From $7.99.',
    eyebrow: 'Cartoon gifts', h1: 'A cartoon gift with their name in it.', sub: 'A short animated clip with Vax for a birthday, an anniversary, an apology or “just because”. Made with AI by Vaxo and sent to you as a link.',
    soon: 'Video orders open very soon. Right now Vax writes the story and the wish with you for free, and the video is made from them.', cta: 'Describe the gift →',
    tiersH: 'Choose the gift', tiers: [
      ['card', 'Video card', '$7.99', '10 seconds: a ready Vax scene with your names and a short wish on screen. Ready in minutes.'],
      ['scene', 'Personal scene', '$19–39', '20–30 seconds made for your story: the place, the joke, the moment. 1–2 days.'],
      ['series', 'Mini-episode', '$79–129', '40–60 seconds, 2–3 scenes, a little story about you two. 2–3 days.'],
      ['business', 'For your business', 'quote', 'Your own brand mascot in clips like these, for social media and ads.'],
    ],
    occH: 'For any moment', occ: ['Birthday', 'Anniversary', 'Sorry', 'Miss you', 'Thank you', 'Congrats', 'Proposal', 'Just because'],
    howH: 'How it works', how: [['Tell us', 'Names, the occasion and one detail that makes them smile.'], ['We animate', 'Vax plays your story. You see a preview first.'], ['They smile', 'You get a link to send or post. Keep it forever.']],
    formH: 'Describe the gift', tier: 'Gift', occasion: 'Occasion', note: 'Your idea (optional)', idea: 'Names, the occasion and one detail that makes them smile', go: 'Write it with Vax →', hint: 'Free. Vax writes the story and the wish in your Workspace, no contacts needed.', ask: 'Help me plan a cartoon gift with Vax the raccoon. Gift: {t}. Occasion: {o}. Write a short story for the clip and a warm wish. My idea: ',
    fine: 'Personalised digital videos are made just for you, so they are not refundable after delivery; if we make a mistake, we fix it for free. Terms: ',
  },
  ru: {
    title: 'Подарки Vaxo — мультик с вашими именами', desc: 'Именной мультик с енотом Vax на день рождения, годовщину или просто так. От $7.99.',
    eyebrow: 'Подарочные мультики', h1: 'Мультик в подарок — с их именем.', sub: 'Короткий мультик с Vax на день рождения, годовщину, «прости» или просто так. Делает Vaxo с помощью ИИ, вы получаете ссылку.',
    soon: 'Заказ видео откроется совсем скоро. Уже сейчас Vax бесплатно напишет с вами историю и пожелание — по ним и сделаем мультик.', cta: 'Описать подарок →',
    tiersH: 'Выберите подарок', tiers: [
      ['card', 'Видеооткрытка', '$7.99', '10 секунд: готовая сцена с Vax, ваши имена и короткое пожелание на экране. Готово за минуты.'],
      ['scene', 'Именная сцена', '$19–39', '20–30 секунд по вашей истории: место, шутка, момент. 1–2 дня.'],
      ['series', 'Мини-серия', '$79–129', '40–60 секунд, 2–3 сцены, маленькая история про вас двоих. 2–3 дня.'],
      ['business', 'Для бизнеса', 'по запросу', 'Ваш собственный маскот бренда в таких роликах — для соцсетей и рекламы.'],
    ],
    occH: 'Для любого повода', occ: ['День рождения', 'Годовщина', 'Прости', 'Скучаю', 'Спасибо', 'Поздравляю', 'Предложение', 'Просто так'],
    howH: 'Как это работает', how: [['Расскажите', 'Имена, повод и одну деталь, от которой человек улыбнётся.'], ['Мы оживляем', 'Vax разыгрывает вашу историю. Сначала вы видите превью.'], ['Улыбка', 'Вы получаете ссылку — отправить или выложить. Остаётся навсегда.']],
    formH: 'Опишите подарок', tier: 'Подарок', occasion: 'Повод', note: 'Ваша идея (необязательно)', idea: 'Имена, повод и одна деталь, от которой человек улыбнётся', go: 'Написать с Vax →', hint: 'Бесплатно. Vax напишет историю и пожелание в вашем Workspace, контакты не нужны.', ask: 'Помоги придумать мультик-подарок с енотом Vax. Подарок: {t}. Повод: {o}. Напиши короткую историю для ролика и тёплое пожелание. Моя идея: ',
    fine: 'Именное видео делается только для вас, поэтому после сдачи не возвращается; если ошиблись мы — исправим бесплатно. Условия: ',
  },
  ua: {
    title: 'Подарунки Vaxo — мультик з вашими іменами', desc: 'Іменний мультик з єнотом Vax на день народження, річницю або просто так. Від $7.99.',
    eyebrow: 'Подарункові мультики', h1: 'Мультик у подарунок — з їхнім імʼям.', sub: 'Короткий мультик з Vax на день народження, річницю, «пробач» або просто так. Робить Vaxo за допомогою ШІ, ви отримуєте посилання.',
    soon: 'Замовлення відео відкриється зовсім скоро. Вже зараз Vax безкоштовно напише з вами історію і побажання — за ними й зробимо мультик.', cta: 'Описати подарунок →',
    tiersH: 'Оберіть подарунок', tiers: [
      ['card', 'Відеолистівка', '$7.99', '10 секунд: готова сцена з Vax, ваші імена і коротке побажання на екрані. Готово за хвилини.'],
      ['scene', 'Іменна сцена', '$19–39', '20–30 секунд за вашою історією: місце, жарт, момент. 1–2 дні.'],
      ['series', 'Міні-серія', '$79–129', '40–60 секунд, 2–3 сцени, маленька історія про вас двох. 2–3 дні.'],
      ['business', 'Для бізнесу', 'за запитом', 'Ваш власний маскот бренду в таких роликах — для соцмереж і реклами.'],
    ],
    occH: 'Для будь-якого приводу', occ: ['День народження', 'Річниця', 'Пробач', 'Сумую', 'Дякую', 'Вітаю', 'Пропозиція', 'Просто так'],
    howH: 'Як це працює', how: [['Розкажіть', 'Імена, привід і одну деталь, від якої людина усміхнеться.'], ['Ми оживлюємо', 'Vax розігрує вашу історію. Спершу ви бачите превʼю.'], ['Усмішка', 'Ви отримуєте посилання — надіслати або викласти. Залишається назавжди.']],
    formH: 'Опишіть подарунок', tier: 'Подарунок', occasion: 'Привід', note: 'Ваша ідея (необовʼязково)', idea: 'Імена, привід і одна деталь, від якої людина усміхнеться', go: 'Написати з Vax →', hint: 'Безкоштовно. Vax напише історію і побажання у вашому Workspace, контакти не потрібні.', ask: 'Допоможи придумати мультик-подарунок з єнотом Vax. Подарунок: {t}. Привід: {o}. Напиши коротку історію для ролика і тепле побажання. Моя ідея: ',
    fine: 'Іменне відео робиться лише для вас, тому після здачі не повертається; якщо помилилися ми — виправимо безкоштовно. Умови: ',
  },
}[lang];
const shots = ['/gifts/f13.jpg', '/gifts/f37.jpg', '/gifts/f1.jpg'];
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="gifts">
    <section class="in hero">
      <div>
        <span class="eyebrow">{C.eyebrow}</span>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
        <p class="soon">{C.soon}</p>
        <a class="cta" href="#form">{C.cta}</a>
      </div>
      <div class="shots">{shots.map((s, i) => <img src={s} alt="Vax cartoon scene" width="540" height="960" loading={i ? 'lazy' : 'eager'} />)}</div>
    </section>

    <section class="in">
      <h2>{C.tiersH}</h2>
      <div class="tiers">{C.tiers.map(([k, n, p, d]) => <a class="tier" href="#form" data-pick={k}><b>{n}</b><span class="price">{p}</span><p>{d}</p></a>)}</div>
    </section>

    <section class="in">
      <h2>{C.occH}</h2>
      <div class="occ">{C.occ.map((o) => <span>{o}</span>)}</div>
    </section>

    <section class="in">
      <h2>{C.howH}</h2>
      <ol class="how">{C.how.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}</ol>
    </section>

    <section class="in" id="form">
      <form class="card" data-gift>
        <h2>{C.formH}</h2>
        <div class="two">
          <label><span>{C.tier}</span><select name="tier">{C.tiers.map(([k, n, p]) => <option value={k}>{n} · {p}</option>)}</select></label>
          <label><span>{C.occasion}</span><select name="occasion">{C.occ.map((o) => <option>{o}</option>)}</select></label>
        </div>
        <label><span>{C.note}</span><textarea name="note" rows="3" maxlength="800" placeholder={C.idea}></textarea></label>
        <button class="cta" type="submit">{C.go}</button>
        <small class="mut">{C.hint}</small>
        <small class="mut">{C.fine}<a href={navHref('/terms/', lang)}>vaxogroup.com/terms</a></small>
      </form>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script define:vars={{ app: navHref('/app/', lang), ask: C.ask }}>
  // No waitlist and no contacts (Decision 40): the gift idea goes straight to Vax in Workspace.
  const form = document.querySelector('[data-gift]');
  document.querySelectorAll('[data-pick]').forEach((a) => a.addEventListener('click', () => { form.tier.value = a.dataset.pick; }));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const t = form.tier.options[form.tier.selectedIndex].text, o = form.occasion.value, n = form.note.value.trim();
    location.href = app + '#q=' + encodeURIComponent(ask.replace('{t}', t).replace('{o}', o) + (n || '—'));
  });
</script>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px 48px; }
  .hero { padding-top: 110px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 32px; align-items: center; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; padding-top: 92px; } }
  h1 { font-size: clamp(34px, 6vw, 58px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; }
  .sub { color: var(--mut); font-size: 18px; max-width: 56ch; }
  .soon { background: var(--surf); border: 1px solid var(--line); border-radius: 14px; padding: 10px 14px; }
  .cta { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 22px; border-radius: 999px; text-decoration: none; border: 0; font-size: 16px; cursor: pointer; }
  .shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .shots img { width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 16px; }
  .shots img:nth-child(2) { transform: translateY(18px); }
  h2 { font-size: clamp(24px, 3.5vw, 32px); margin: 0 0 16px; }
  .tiers { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .tier { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 18px; color: var(--ink); text-decoration: none; display: flex; flex-direction: column; gap: 6px; }
  .tier:hover { border-color: var(--acc); }
  .tier .price { font-size: 24px; font-weight: 700; } .tier p { color: var(--mut); margin: 0; line-height: 1.5; }
  .occ { display: flex; flex-wrap: wrap; gap: 8px; }
  .occ span { border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; background: var(--surf); }
  .how { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; counter-reset: s; }
  .how li { counter-increment: s; display: flex; flex-direction: column; gap: 4px; border-top: 4px solid var(--acc); padding-top: 10px; }
  .how li b::before { content: counter(s) '. '; } .how li span { color: var(--mut); }
  #form { padding-bottom: 80px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 22px; padding: 24px; display: grid; gap: 14px; max-width: 760px; }
  .card h2 { margin: 0; }
  .card[hidden] { display: none; }
  #form :global(.pchat) { max-width: 760px; margin-bottom: 14px; }
  label { display: grid; gap: 6px; font-size: 14px; color: var(--mut); }
  input, select, textarea { font: 16px var(--font); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 11px 12px; width: 100%; box-sizing: border-box; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 640px) { .two { grid-template-columns: 1fr; } }
  .trap { position: absolute; left: -9999px; }
  .ok { color: #2e9e6b; margin: 0; font-weight: 600; } .err { color: #c0392b; margin: 0; }
  .mut { color: var(--mut); } .mut a { color: var(--ink); }
</style>
