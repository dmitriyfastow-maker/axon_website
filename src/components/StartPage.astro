---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">{C.eyebrow}</div>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
        <div class="acts"><a href="#packages" class="cta">{C.cta}</a><a href={`${home}#services`} class="cta ghost">{C.extra.cta2}</a></div>
      </div>
    </section>

    <section class="packs" id="packages">
      <div class="in grid">
        {C.packages.map((p, i) => (
          <article class="card">
            <h2>{p.name}</h2>
            <div class="price">{p.price}<span> {C.once}</span></div>
            <p>{p.what}</p>
            <ul>{p.get.map((g) => <li>{g}</li>)}</ul>
            <a href="#contact" class="order" data-choose-tier={p.name} data-choose-note={C.extra.notes[i]}>{C.extra.order} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="road">
      <div class="in">
        <div class="eyebrow">{C.roadEyebrow}</div>
        <h2 class="h2">{C.roadH}</h2>
        <ol>
          {C.steps.map((s, i) => (
            <li>
              <a href={C.extra.stepsHref[i]}>
                <span class="n">{s.n}</span>
                <div><strong>{s.title}</strong> <span class="p">{s.price}</span><p>{s.text}</p></div>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="how">
      <div class="in">
        <h2 class="h2">{C.extra.howH}</h2>
        <ol class="how-grid">
          {C.extra.how.map(([t, d], i) => <li><span class="n">0{i + 1}</span><strong>{t}</strong><p>{d}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="qa">
      <div class="in">
        <h2 class="h2">{C.extra.faqH}</h2>
        {C.extra.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <CrossSell lang={lang} items={['tools', 'partner']} />
    <Contact t={t} lang={lang} />
    <AiPluses t={t} />
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .hero { padding: 120px 0 56px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 16ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 56ch; margin: 0 0 28px; }
  .cta { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 22px; border-radius: 999px; text-decoration: none; }
  .packs { padding: 24px 0 64px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .card h2 { font-size: 22px; margin: 0 0 8px; }
  .price { font-size: 32px; font-weight: 700; color: var(--accText); margin-bottom: 12px; }
  .price span { font-size: 14px; font-weight: 400; color: var(--mut); }
  .card p { color: var(--mut); margin: 0 0 12px; }
  .card ul { margin: 0; padding-left: 18px; }
  .card li { margin: 6px 0; }
  .road { padding: 24px 0 80px; }
  .road ol { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .road li a { display: flex; gap: 16px; align-items: center; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px 24px; color: inherit; text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .road li a:hover { border-color: var(--acc); transform: translateY(-2px); }
  .road li a > div { flex: 1; }
  .road .go { font-size: 22px; color: var(--accText); }
  .acts { display: flex; gap: 10px; flex-wrap: wrap; }
  .cta.ghost { background: var(--surf); color: var(--ink); border: 1px solid var(--line); }
  .card { display: flex; flex-direction: column; }
  .card ul { flex: 1; }
  .order { align-self: flex-start; margin-top: 16px; background: var(--ink); color: var(--bg); font-weight: 700; padding: 11px 18px; border-radius: 999px; text-decoration: none; }
  .how { padding: 16px 0 64px; }
  .how-grid { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .how-grid li { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .how-grid p { color: var(--mut); margin: 0; }
  .qa { padding: 0 0 72px; }
  .qa details { background: var(--surf); border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; margin-top: 10px; }
  .qa summary { font-weight: 700; cursor: pointer; }
  .qa p { color: var(--mut); margin: 8px 0 0; }
  .road .n { font-family: var(--mono); color: var(--accText); font-weight: 600; }
  .road .p { color: var(--accText); margin-left: 8px; }
  .road p { color: var(--mut); margin: 6px 0 0; }
</style>
