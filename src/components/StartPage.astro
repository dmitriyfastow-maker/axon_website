---
// Starter packages: a low-risk first step for small businesses (Decision 03). EN / UA / RU.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import CrossSell from './CrossSell.astro';
import { getDict, langPath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/start/', ua: '/ua/start/', ru: '/ru/start/' };

const C = {
  en: {
    title: 'Vaxo — Starter packages for small businesses', desc: 'Start small: an AI chat assistant, a one-page website or one automation, delivered within 7 days.',
    eyebrow: 'Starter packages', h1: 'Start small. See the result in 7 days.',
    sub: 'Not ready for a big project? Pick one small thing that brings you customers now. If you like the result, we grow it step by step.',
    cta: 'Pick a package →', once: 'one-time', roadEyebrow: 'Your growth plan', roadH: 'The starter package is step one, not the whole story',
    packages: [
      { name: 'AI chat assistant', price: '$249', what: 'A chatbot on your website that answers common questions 24/7 and collects contact details of new customers.', get: ['Trained on your services, prices and FAQ', 'Leads sent to your email or Telegram', 'Works on any website'] },
      { name: 'One-page website', price: '$199', what: 'A clean, fast page that explains what you do and turns visitors into inquiries.', get: ['Mobile-first design', 'Contact form and click-to-call', 'Basic Google setup'] },
      { name: 'One automation', price: '$149', what: 'One routine task done for you automatically, so no request gets lost.', get: ['Website requests into a sheet or CRM', 'Instant notifications to your phone', 'Auto-reply to every new lead'] },
    ],
    steps: [
      { n: '01', title: 'Try it', price: '$149 – $249', text: 'One starter package, delivered within 7 days. One round of edits included.' },
      { n: '02', title: 'Grow', price: 'from $800', text: 'Full website, lead funnel or ads. The starter price is credited if you continue within 30 days.' },
      { n: '03', title: 'Keep it running', price: '$50 – $200 / mo', text: 'Support, updates and a monthly report. You focus on clients, we keep the system working.' },
    ],
  },
  ru: {
    title: 'Vaxo — Стартовые пакеты для малого бизнеса', desc: 'Начните с малого: ИИ-чат, сайт-визитка или одна автоматизация за 7 дней.',
    eyebrow: 'Стартовые пакеты', h1: 'Начните с малого. Результат — через 7 дней.',
    sub: 'Не готовы к большому проекту? Выберите одну небольшую вещь, которая приведёт клиентов уже сейчас. Понравится результат — развиваем дальше шаг за шагом.',
    cta: 'Выбрать пакет →', once: 'разово', roadEyebrow: 'План роста', roadH: 'Стартовый пакет — первый шаг, а не вся история',
    packages: [
      { name: 'ИИ-чат на сайте', price: '$249', what: 'Чат-бот на вашем сайте отвечает на частые вопросы 24/7 и собирает контакты новых клиентов.', get: ['Обучен на ваших услугах, ценах и FAQ', 'Заявки приходят на почту или в Telegram', 'Работает на любом сайте'] },
      { name: 'Сайт-визитка', price: '$199', what: 'Аккуратная быстрая страница: объясняет, чем вы занимаетесь, и превращает посетителей в заявки.', get: ['Удобен с телефона', 'Форма заявки и звонок в один клик', 'Базовая настройка Google'] },
      { name: 'Одна автоматизация', price: '$149', what: 'Одна рутинная задача выполняется сама — ни одна заявка не потеряется.', get: ['Заявки с сайта — в таблицу или CRM', 'Мгновенные уведомления на телефон', 'Автоответ на каждую новую заявку'] },
    ],
    steps: [
      { n: '01', title: 'Попробовать', price: '$149 – $249', text: 'Один стартовый пакет за 7 дней. Один круг правок включён.' },
      { n: '02', title: 'Вырасти', price: 'от $800', text: 'Полноценный сайт, воронка заявок или реклама. Цена стартового пакета засчитывается, если продолжаете в течение 30 дней.' },
      { n: '03', title: 'Поддерживать', price: '$50 – $200 / мес', text: 'Поддержка, обновления и отчёт раз в месяц. Вы занимаетесь клиентами, мы — системой.' },
    ],
  },
  ua: {
    title: 'Vaxo — Стартові пакети для малого бізнесу', desc: 'Почніть з малого: ШІ-чат, сайт-візитка або одна автоматизація за 7 днів.',
    eyebrow: 'Стартові пакети', h1: 'Почніть з малого. Результат — за 7 днів.',
    sub: 'Не готові до великого проєкту? Оберіть одну невелику річ, яка приведе клієнтів уже зараз. Сподобається результат — розвиваємо далі крок за кроком.',
    cta: 'Обрати пакет →', once: 'разово', roadEyebrow: 'План зростання', roadH: 'Стартовий пакет — перший крок, а не вся історія',
    packages: [
      { name: 'ШІ-чат на сайті', price: '$249', what: 'Чат-бот на вашому сайті відповідає на часті питання 24/7 і збирає контакти нових клієнтів.', get: ['Навчений на ваших послугах, цінах і FAQ', 'Заявки приходять на пошту або в Telegram', 'Працює на будь-якому сайті'] },
      { name: 'Сайт-візитка', price: '$199', what: 'Акуратна швидка сторінка: пояснює, чим ви займаєтеся, і перетворює відвідувачів на заявки.', get: ['Зручний з телефона', 'Форма заявки і дзвінок в один клік', 'Базове налаштування Google'] },
      { name: 'Одна автоматизація', price: '$149', what: 'Одна рутинна задача виконується сама — жодна заявка не загубиться.', get: ['Заявки з сайту — у таблицю або CRM', 'Миттєві сповіщення на телефон', 'Автовідповідь на кожну нову заявку'] },
    ],
    steps: [
      { n: '01', title: 'Спробувати', price: '$149 – $249', text: 'Один стартовий пакет за 7 днів. Одне коло правок включено.' },
      { n: '02', title: 'Вирости', price: 'від $800', text: 'Повноцінний сайт, воронка заявок або реклама. Ціна стартового пакета зараховується, якщо продовжуєте протягом 30 днів.' },
      { n: '03', title: 'Підтримувати', price: '$50 – $200 / міс', text: 'Підтримка, оновлення і звіт раз на місяць. Ви займаєтеся клієнтами, ми — системою.' },
    ],
  },
}[lang];
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">{C.eyebrow}</div>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
        <a href="#contact" class="cta">{C.cta}</a>
      </div>
    </section>

    <section class="packs" id="packages">
      <div class="in grid">
        {C.packages.map((p) => (
          <article class="card">
            <h2>{p.name}</h2>
            <div class="price">{p.price}<span> {C.once}</span></div>
            <p>{p.what}</p>
            <ul>{p.get.map((g) => <li>{g}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="road">
      <div class="in">
        <div class="eyebrow">{C.roadEyebrow}</div>
        <h2 class="h2">{C.roadH}</h2>
        <ol>
          {C.steps.map((s) => (
            <li>
              <span class="n">{s.n}</span>
              <div><strong>{s.title}</strong> <span class="p">{s.price}</span><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <CrossSell lang={lang} items={['tools', 'partner']} />
    <Contact t={t} lang={lang} />
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .hero { padding: 120px 0 56px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 16ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 56ch; margin: 0 0 28px; }
  .cta { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 22px; border-radius: 999px; text-decoration: none; }
  .packs { padding: 24px 0 64px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .card h2 { font-size: 22px; margin: 0 0 8px; }
  .price { font-size: 32px; font-weight: 700; color: var(--accText); margin-bottom: 12px; }
  .price span { font-size: 14px; font-weight: 400; color: var(--mut); }
  .card p { color: var(--mut); margin: 0 0 12px; }
  .card ul { margin: 0; padding-left: 18px; }
  .card li { margin: 6px 0; }
  .road { padding: 24px 0 80px; }
  .road ol { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .road li { display: flex; gap: 16px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px 24px; }
  .road .n { font-family: var(--mono); color: var(--accText); font-weight: 600; }
  .road .p { color: var(--accText); margin-left: 8px; }
  .road p { color: var(--mut); margin: 6px 0 0; }
</style>
