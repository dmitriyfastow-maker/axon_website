.otp-actions { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.cab .or { display: flex; align-items: center; gap: 12px; color: var(--mut); font-size: 13px; } .cab .or::before, .cab .or::after { content: ''; flex: 1; height: 1px; background: var(--line); }
