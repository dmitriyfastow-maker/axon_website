.cab input:focus-visible, .cab textarea:focus-visible, .cab select:focus-visible { outline: none; border-color: var(--acc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--acc) 25%, transparent); }
.cab .check { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; color: var(--mut); } .cab .check input { margin-top: 3px; width: 18px; height: 18px; flex: none; accent-color: var(--acc); } .cab .check a { color: var(--accText); }
.cab .msg { margin: 0; font-size: 14px; font-weight: 600; color: var(--accText); } .cab .msg:empty { display: none; }

/* skeleton */
.cab-skel { display: grid; gap: 14px; } .cab-skel i { display: block; height: 120px; border-radius: var(--r); background: linear-gradient(90deg, var(--surf), var(--surf2), var(--surf)); background-size: 200% 100%; }
