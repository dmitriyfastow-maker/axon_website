.auth-side::before { content: ''; position: absolute; inset: -30% -30% auto auto; width: 120%; aspect-ratio: 1; background: radial-gradient(circle, color-mix(in srgb, var(--acc) 40%, transparent), transparent 60%); z-index: -1; }
