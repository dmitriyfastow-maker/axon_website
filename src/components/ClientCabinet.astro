---

<Base lang={lang} title={`Vaxo — ${T.title}`} description={T.lead} path={alts[lang]} alts={alts} noindex>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="me" data-me data-lang={lang} data-home={home}>
    <script type="application/json" data-me-t set:html={JSON.stringify(T)} />
    <div class="me-top"><h1>{T.title}</h1><button type="button" class="ghost" data-out hidden>{T.out}</button></div>
    <p class="mut lead" data-lead>{T.lead}</p>

    <section class="card login" data-login hidden>
      <img src="/mascot/vax-key.webp" alt="" width="120" height="149" />
      <div>
        <p class="hint" data-save-hint hidden>{T.saveHint}</p>
        <div class="tabs" role="tablist"><button type="button" role="tab" aria-selected="true" data-tab="in">{T.tabIn}</button><button type="button" role="tab" aria-selected="false" data-tab="up">{T.tabUp}</button></div>
        <a class="gbtn" href="/api/me/google" data-google hidden><svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>{T.google}</a>
        <form class="stack" data-in>
          <input type="email" name="email" required autocomplete="email" placeholder={T.email} />
          <input type="password" name="password" required autocomplete="current-password" placeholder={T.pass} />
          <button class="cta">{T.signIn}</button>
          <button type="button" class="link" data-bycode hidden>{T.byCode}</button>
        </form>
        <form class="stack" data-up hidden>
          <input name="name" required maxlength="80" autocomplete="name" placeholder={T.name} />
          <input type="email" name="email" required autocomplete="email" placeholder={T.email} />
          <input type="tel" name="phone" maxlength="40" autocomplete="tel" placeholder={T.phone} />
          <input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder={T.pass8} />
          <label class="check"><input type="checkbox" name="consent" required /> <span set:html={T.consent} /></label>
          <label class="check"><input type="checkbox" name="marketing" /> <span>{T.news}</span></label>
          <button class="cta">{T.signUp}</button>
        </form>
        <form class="row" data-email hidden><input type="email" required autocomplete="email" placeholder={T.email} /><button class="cta">{T.getCode}</button></form>
        <form class="row" data-code hidden><input inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder={T.code} /><button class="cta">{T.enter}</button></form>
        <p class="msg" data-msg></p>
      </div>
    </section>

    <section data-dash hidden>
      <div class="grid3">
        <div class="card stat"><small>{T.level}</small><b data-level></b><span class="mut small" data-next></span></div>
        <div class="card stat"><small>{T.bonus}</small><b data-bonus></b><span class="mut small">{T.bonusRule}</span></div>
        <div class="card tasks"><small>{T.tasks}</small><ul data-tasks></ul></div>
      </div>
      <form class="card profile" data-profile hidden>
        <div class="two"><input name="business" placeholder={T.pBusiness} /><input name="name" placeholder={T.pName} /></div>
        <div class="two"><input name="niche" placeholder={T.pNiche} /><input name="city" placeholder={T.pCity} /></div>
        <input name="site" placeholder={T.pSite} />
        <textarea name="goal" rows="2" placeholder={T.pGoal}></textarea>
        <button class="cta">{T.save} (+$5)</button>
      </form>
    </section>

    <h2 data-ph hidden>{T.projects}</h2>
    <div data-projects></div>
    <p class="none" data-none hidden>{T.none} <a class="cta" href={`${home}#contact`}>{T.start} →</a></p>
    <details class="card hist" data-hist hidden><summary>{T.history}</summary><ul data-hist-list></ul></details>
    <section class="card acct" data-acct hidden>
      <b>{T.account}</b>
      <p class="mut small" data-verify hidden>{T.verify}</p>
      <label class="check"><input type="checkbox" data-news /> <span>{T.newsOn}</span></label>
      <div class="btns"><a class="ghost" href="/api/me/export" download>{T.export}</a><button type="button" class="ghost danger" data-del>{T.del}</button></div>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  type R = Record<string, any>;
  const root = document.querySelector<HTMLElement>('[data-me]')!;
  const T: R = JSON.parse(root.querySelector('[data-me-t]')!.textContent || '{}');
  const lang = root.dataset.lang!;
  const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const el = (tag: string, attrs: R = {}, ...kids: (Node | string | null | undefined | false)[]) => {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) { if (k === 'class') e.className = v; else if (k.startsWith('on')) (e as any)[k] = v; else if (v != null && v !== false) e.setAttribute(k, String(v)); }
    for (const k of kids) if (k != null && k !== false) e.append(k);
    return e;
  };
  const q = new URLSearchParams(location.search);
  const room = q.get('t') || '';
  const money = (n: number) => '$' + (Math.round(n * 100) / 100).toLocaleString('en-US');
  const day = (s: string) => new Date(String(s).replace(' ', 'T') + (String(s).length > 10 ? 'Z' : '')).toLocaleDateString(lang === 'ua' ? 'uk-UA' : lang === 'ru' ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  const msg = (s: string) => { $('[data-msg]').textContent = s; };
  let email = '';

  function project(p: R, signedIn: boolean) {
    const stepKey = p.status === 'won' ? (p.stage || 'work') : p.status;
    const pct = p.status === 'won' ? (p.progress ?? 0) : null;
    const card = el('article', { class: 'card proj' },
      el('div', { class: 'ph' }, el('b', {}, p.what || `#${p.id}`), el('span', { class: 'badge' }, T.next[stepKey] || stepKey)),
      pct != null && el('div', { class: 'bar' }, el('i', { style: `width:${pct}%` }), el('span', {}, `${T.progress}: ${pct}%`)),
      el('ul', { class: 'facts' },
        p.status === 'won' && el('li', {}, '✏️ ' + T.revisions.replace('{u}', p.revisions_used ?? 0).replace('{t}', p.revisions_total)),
        el('li', {}, p.brief_confirmed_at ? '✅ ' + T.brief.replace('{d}', day(p.brief_confirmed_at)) : '📝 ' + T.briefNo),
        p.strategy_url && el('li', {}, el('a', { href: p.strategy_url, target: '_blank', rel: 'noopener' }, '🧭 ' + T.strategy))),
      p.payments?.length > 0 && el('div', { class: 'pays' }, el('small', {}, T.payments), ...p.payments.map((x: R) => el('div', {}, `${day(x.at)} · ${T.parts[x.part] || x.part} · ${x.amount} ${x.currency}`))),
      el('div', { class: 'btns' }, p.room && el('a', { class: 'cta', href: `/room/?t=${p.room}` }, T.chat)));
    if (signedIn && p.stage === 'delivered' && !p.reviewed) {
      const f = el('form', { class: 'rev' },
        el('label', {}, T.stars + ' ', el('select', { name: 'stars' }, ...[5, 4, 3, 2, 1].map((n) => el('option', { value: n }, '★'.repeat(n))))),
        el('textarea', { name: 'text', rows: '3', required: true, minlength: '20', placeholder: T.reviewText }),
        el('label', { class: 'small' }, el('input', { type: 'checkbox', name: 'public' }), ' ' + T.publicOk),
        el('button', { class: 'cta' }, T.send)) as HTMLFormElement;
      f.hidden = true;
      f.onsubmit = async (e) => { e.preventDefault(); const d = Object.fromEntries(new FormData(f)); const r = await fetch('/api/me/review', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ lead_id: p.id, stars: Number(d.stars), text: d.text, public: !!d.public }) }); if (r.ok) load(); };
      card.append(el('button', { type: 'button', class: 'ghost', onclick: () => { f.hidden = !f.hidden; } }, '⭐ ' + T.review), f);
    }
    return card;
  }

  async function load() {
    const r = await fetch(`/api/me${room ? `?t=${room}` : ''}`).catch(() => null);
    const d: R = r?.ok ? await r.json() : { ok: false, signedIn: false, ways: {}, projects: [] };
    const err = q.get('err');
    if (err) msg(err === 'google_off' ? T.off : T.errGoogle);
    $('[data-out]').hidden = !d.signedIn;
    $('[data-login]').hidden = !!d.signedIn;
    $('[data-dash]').hidden = !d.signedIn;
    $('[data-acct]').hidden = !d.signedIn;
    if (d.signedIn) { $<HTMLInputElement>('[data-news]').checked = !!d.me?.marketing; $('[data-verify]').hidden = !!d.me?.verified; }
    if (!d.signedIn) {
      const g = $<HTMLAnchorElement>('[data-google]'); g.hidden = !d.ways?.google; if (room) g.href = `/api/me/google?back=${room}`;
      $('[data-bycode]').hidden = !d.ways?.email;
      $('[data-save-hint]').hidden = !d.projects?.length;
    } else {
      const lv = d.level, next = lv === 'start' ? ['pro', 1000] : lv === 'pro' ? ['vip', 5000] : null;
      $('[data-level]').textContent = T.levels[lv];
      $('[data-next]').textContent = next ? T.toNext.replace('${n}', '$' + Math.max(0, (next[1] as number) - d.paidUsd)).replace('{lvl}', T.levels[next[0] as string]) : T.vipPerks;
      $('[data-bonus]').textContent = money(d.bonus);
      const prof = d.me?.profile || {};
      const profDone = !!(prof.business && prof.niche && (prof.goal || '').length >= 10);
      const delivered = d.projects.filter((p: R) => p.stage === 'delivered');
      $('[data-tasks]').replaceChildren(
        el('li', {}, el('button', { type: 'button', class: 'link', onclick: () => { $('[data-profile]').hidden = !$('[data-profile]').hidden; } }, `${profDone ? '✅' : '⬜'} ${T.tProfile} (+$5)`)),
        el('li', {}, `${delivered.length && delivered.every((p: R) => p.reviewed) ? '✅' : '⬜'} ${T.tReview} (+$10)`),
        el('li', {}, el('a', { href: `${root.dataset.home === '/' ? '' : root.dataset.home!.replace(/\/$/, '')}/partners/` }, `🤝 ${T.tFriend} →`)));
      const pf = $<HTMLFormElement>('[data-profile]');
      for (const [k, v] of Object.entries({ ...prof, name: d.me?.name || '' })) { const i = pf.elements.namedItem(k) as HTMLInputElement | null; if (i && !i.value) i.value = String(v || ''); }
      const hist = d.bonusHistory || [];
      $('[data-hist]').hidden = !hist.length;
      $('[data-hist-list]').replaceChildren(...hist.map((h: R) => el('li', {}, `${day(h.at)} · ${T.kinds[h.kind] || h.kind} · ${h.amount_usd > 0 ? '+' : ''}${money(h.amount_usd)}`)));
      $('[data-lead]').textContent = `${T.hi}${d.me?.name ? ', ' + d.me.name : ''}! ${d.me?.email || ''}`;
    }
    $('[data-ph]').hidden = !d.projects?.length;
    $('[data-none]').hidden = !!d.projects?.length || !d.signedIn;
    $('[data-projects]').replaceChildren(...(d.projects || []).map((p: R) => project(p, !!d.signedIn)));
  }

  $<HTMLFormElement>('[data-email]').onsubmit = async (e) => {
    e.preventDefault();
    email = ($<HTMLInputElement>('[data-email] input').value || '').trim();
    const r = await fetch('/api/me/code', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, lang }) });
    const d = await r.json().catch(() => ({}));
    if (r.ok) { msg(T.sent.replace('{email}', email)); $('[data-code]').hidden = false; $<HTMLInputElement>('[data-code] input').focus(); }
    else msg(d.error === 'wait' ? T.errWait : d.error === 'mail_off' ? T.off : T.errEmail);
  };
  $<HTMLFormElement>('[data-code]').onsubmit = async (e) => {
    e.preventDefault();
    const code = $<HTMLInputElement>('[data-code] input').value;
    const r = await fetch('/api/me/verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, code, room, lang }) });
    const d = await r.json().catch(() => ({}));
    if (r.ok) { msg(''); load(); } else msg(d.error === 'expired' ? T.errExpired : T.errCode);
  };
  $<HTMLFormElement>('[data-profile]').onsubmit = async (e) => {
    e.preventDefault();
    await fetch('/api/me/profile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(e.target as HTMLFormElement))) });
    $('[data-profile]').hidden = true; load();
  };

  root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.onclick = () => {
    root.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    $('[data-in]').hidden = b.dataset.tab !== 'in'; $('[data-up]').hidden = b.dataset.tab !== 'up'; msg('');
  });
  $('[data-bycode]').onclick = () => { $('[data-email]').hidden = false; $<HTMLInputElement>('[data-email] input').focus(); };
  const ERR: R = { wrong: T.errWrong, no_password: T.errNoPass, exists: T.errExists, password: T.errPass, consent: T.errConsent, email: T.errEmail, wait: T.errMany };
  const post = (u: string, body: R) => fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...body, room, lang }) });
  $<HTMLFormElement>('[data-in]').onsubmit = async (e) => {
    e.preventDefault();
    const f = Object.fromEntries(new FormData(e.target as HTMLFormElement));
    const r = await post('/api/me/login', f); const d = await r.json().catch(() => ({}));
    if (r.ok) { msg(''); load(); } else msg(ERR[d.error] || T.errWrong);
  };
  $<HTMLFormElement>('[data-up]').onsubmit = async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const r = await post('/api/me/register', { ...Object.fromEntries(fd), consent: fd.has('consent'), marketing: fd.has('marketing') }); const d = await r.json().catch(() => ({}));
    if (r.ok) { msg(''); load(); } else msg(ERR[d.error] || T.errEmail);
  };
  $<HTMLInputElement>('[data-news]').onchange = (e) => { post('/api/me/marketing', { on: (e.target as HTMLInputElement).checked }); };
  $('[data-del]').onclick = async () => { if (!confirm(T.delQ)) return; await fetch('/api/me/delete', { method: 'POST' }); location.href = location.pathname; };
  $('[data-out]').onclick = async () => { await fetch('/api/me/logout', { method: 'POST' }); location.href = location.pathname; };
  load();
</script>

<style is:global>
.me .tabs { display: inline-flex; gap: 4px; background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 4px; align-self: flex-start; }
.me .tabs button { border: 0; background: none; padding: 8px 14px; border-radius: 999px; font: 600 14px var(--font); color: var(--mut); cursor: pointer; }
.me .tabs button[aria-selected='true'] { background: var(--ink); color: var(--bg); }
.me .stack { display: flex; flex-direction: column; gap: 8px; max-width: 460px; } .me .stack[hidden] { display: none; }
.me .stack input:not([type='checkbox']) { font: 16px var(--font); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 11px 13px; }
.me .check { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; color: var(--mut); } .me .check input { margin-top: 3px; width: 18px; height: 18px; flex: none; } .me .check a { color: var(--accText); }
.me .msg { margin: 0; font-size: 14px; font-weight: 600; color: var(--accText); } .me .msg:empty { display: none; }
.me .acct { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; } .me .acct .btns { display: flex; gap: 8px; flex-wrap: wrap; } .me .acct a.ghost { text-decoration: none; }
.me .danger { color: var(--error, #d33); border-color: currentColor; }

.me { max-width: 1040px; margin: 0 auto; padding: 120px 20px 64px; }
.me .me-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.me h1 { font-size: clamp(30px, 5vw, 46px); letter-spacing: -0.03em; margin: 0; }
.me h2 { margin: 32px 0 12px; }
.me .lead { font-size: 17px; max-width: 680px; }
.me .mut { color: var(--mut); }.me .small { font-size: 13px; }
.me .card { background: var(--surf); border: 1px solid var(--line); border-radius: 20px; padding: 18px 20px; }
.me .login { display: flex; gap: 20px; align-items: center; margin-top: 18px; border: 2px solid var(--acc); }
.me .login img { width: 110px; height: auto; flex: none; }
.me .login > div { flex: 1; display: flex; flex-direction: column; gap: 10px; }
.me .row { display: flex; gap: 8px; flex-wrap: wrap; }
.me .row input, .me .profile input, .me .profile textarea, .me .rev textarea, .me .rev select { flex: 1; min-width: 200px; font: 16px var(--font); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 11px 13px; }
.me .cta { display: inline-flex; align-items: center; justify-content: center; border: 0; background: var(--acc); color: var(--dark-ink); font: 700 15px var(--font); padding: 11px 18px; border-radius: 12px; cursor: pointer; text-decoration: none; }
.me .ghost { background: transparent; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; padding: 8px 14px; cursor: pointer; font: 600 14px var(--font); }
.me .gbtn { display: inline-flex; gap: 10px; align-items: center; align-self: flex-start; padding: 11px 18px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font-weight: 700; text-decoration: none; }
.me .gbtn[hidden], .me .row[hidden] { display: none; }
.me .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; margin-top: 20px; }
.me .stat { display: flex; flex-direction: column; gap: 4px; }.me .stat small, .me .tasks small { color: var(--mut); }.me .stat b { font-size: 30px; }
.me .tasks ul { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 8px; }
.me .link { background: none; border: 0; padding: 0; color: var(--accText); font: 600 15px var(--font); cursor: pointer; text-align: left; }
.me .tasks a { color: var(--accText); font-weight: 600; }
.me .profile { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }.me .profile[hidden] { display: none; }
.me .two { display: flex; gap: 8px; flex-wrap: wrap; }
.me .proj { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
.me .ph { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center; }.me .ph b { font-size: 18px; }
.me .badge { background: var(--bg); border: 1px solid var(--accText); color: var(--accText); border-radius: 999px; padding: 4px 10px; font-size: 13px; font-weight: 600; }
.me .bar { position: relative; height: 26px; background: var(--bg); border-radius: 999px; overflow: hidden; border: 1px solid var(--line); }
.me .bar i { position: absolute; inset: 0 auto 0 0; background: var(--acc); }.me .bar span { position: relative; padding: 0 12px; line-height: 26px; font-size: 13px; font-weight: 700; }
.me .facts { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; font-size: 15px; }.me .facts a { color: var(--accText); font-weight: 600; }
.me .pays { font-size: 14px; color: var(--mut); }.me .pays small { font-weight: 700; color: var(--ink); }
.me .rev { display: flex; flex-direction: column; gap: 8px; }.me .rev[hidden] { display: none; }
.me .none { margin-top: 18px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.me .hist { margin-top: 18px; }.me .hist ul { margin: 10px 0 0; padding-left: 18px; color: var(--mut); }
  @media (max-width: 600px) {.me { padding-top: 96px; }.me .login { flex-direction: column; align-items: stretch; }.me .login img { width: 84px; align-self: center; } }
</style>
