    bonus: 'Бонусний рахунок', bonusRule: '5% з кожної оплати повертаються бонусами. Ними можна оплатити до 20% наступного замовлення, зберігаються 12 місяців. У гроші не виводяться.',
    tasks: 'Отримати бонуси', tProfile: 'Заповнити профіль бізнесу', tReview: 'Залишити чесний відгук після здачі', tFriend: 'Привести друга — 10% грошима або 15% знижки', done: 'готово',
    pBusiness: 'Назва бізнесу', pSite: 'Сайт або Instagram', pNiche: 'Ніша', pCity: 'Місто / країна', pGoal: 'Головна мета на 3 місяці', pName: "Ваше ім'я", save: 'Зберегти',
    projects: 'Ваші проєкти', none: 'Проєктів поки немає. Розкажіть Vax, що потрібно, — це хвилина.', start: 'Обговорити проєкт',
    chat: 'Відкрити чат проєкту →', progress: 'Готовність', revisions: 'Правки: {u} з {t}', brief: 'Бриф підтверджено {d} — це ваш договір', briefNo: 'Бриф ще не підтверджено',
    strategy: 'Документ стратегії →', payments: 'Оплати', review: 'Залишити відгук (+$10)', stars: 'Оцінка', reviewText: 'Що сподобалося і що нам зробити краще?', publicOk: 'Можна показати на сайті', send: 'Надіслати',
    history: 'Історія бонусів', kinds: { cashback: 'Кешбек 5%', profile: 'Профіль бізнесу', review: 'Відгук', spend: 'Оплачено бонусами', manual: 'Бонус від команди' },
    parts: { prepay: 'Передоплата', stage: 'Етап', final: 'Залишок', full: 'Повна оплата', support: 'Підтримка', micro: 'Мікрозадача', strategy: 'Стратегія', product: 'Продукт', other: 'Оплата' },
    next: { new: 'Vax уточнює задачу', open: 'Vax уточнює задачу', claimed: 'Менеджер готує варіанти', contacted: 'Обговорюємо задачу', proposal: 'Пропозиція чекає вашого рішення', gift: 'Ви в списку очікування подарунка', collab: 'Обговорюємо співпрацю', lost: 'На паузі', work: 'У роботі', qa: 'Перевірка якості', review: 'Превʼю чекає вашої перевірки', revisions: 'Вносимо ваші правки', delivered: 'Готово — дякуємо!' },
