.pw { border-top: 1px dashed var(--line); padding-top: 12px; } .pw summary { cursor: pointer; color: var(--mut); font-weight: 600; font-size: 14px; list-style: none; } .pw summary::-webkit-details-marker { display: none; } .pw summary::after { content: ' ↓'; } .pw[open] summary::after { content: ' ↑'; }
