---
// Client cabinet: vaxogroup.com/me/, the account around the workspace (Decision 41). Sign-in: email first → 6-digit code
// (auto-submit), Google second, a password tucked away. Signed in: three tabs, plan and balance, modules and projects,
// what Vax remembers. Daily work happens in /app/. Without signing in, the personal project link (/me/?t=<room>) shows
// that project and a "save it — 1 step" card. Data: /api/me (worker/cabinet.ts), /api/ws (worker/workspace.ts). Texts: ./cabinet/i18n.ts.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BizApp from './BizApp.astro';
import { CAB_T } from './cabinet/i18n';
import { getDict, langPath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/me/', ua: '/ua/me/', ru: '/ru/me/' };
const T = CAB_T[lang];
const pre = home === '/' ? '' : home.replace(/\/$/, '');
const G = `<svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>`;
---

<Base lang={lang} title={`Vaxo — ${T.title}`} description={T.lead} path={alts[lang]} alts={alts} noindex>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="cab" data-me data-lang={lang} data-home={home} aria-busy="true">
    <script type="application/json" data-me-t set:html={JSON.stringify(T)} />
    <div class="cab-skel" data-skel aria-hidden="true"><i></i><i></i><i></i></div>

    <!-- Sign-in: one screen, email first -->
    <section class="cab-auth" data-auth hidden aria-labelledby="cab-auth-h">
      <div class="auth-side" aria-hidden="true">
        <img src="/mascot/vax-key.webp" alt="" width="419" height="520" loading="eager" />
        <ul class="trust">{T.trust.map((x, i) => <li><span class="dot">{['01', '02', '03'][i]}</span>{x}</li>)}</ul>
      </div>
      <div class="auth-main">
        <p class="eyebrow" data-auth-eye>Vaxo</p>
        <h1 id="cab-auth-h" data-auth-h>{T.loginH}</h1>
        <p class="mut" data-auth-p>{T.loginP}</p>
        <p class="note" data-off hidden>{T.off}</p>

        <form class="step" data-step-email novalidate>
          <label class="field"><span class="sr">{T.email}</span>
            <input type="email" name="email" required autocomplete="email" inputmode="email" placeholder={T.email} />
          </label>
          <button class="cta big" data-cont>{T.cont} <span aria-hidden="true">→</span></button>
          <p class="micro"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{T.noPass}</p>
        </form>

        <form class="step" data-step-code hidden novalidate>
          <h2 class="code-h">{T.codeH}</h2>
          <p class="mut" data-code-p></p>
          <div class="otp" role="group" aria-label={T.codeH} data-otp>
            {[1, 2, 3, 4, 5, 6].map((n) => <input inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="•" autocomplete={n === 1 ? 'one-time-code' : 'off'} aria-label={T.codeLabel.replace('{n}', String(n))} />)}
          </div>
          <div class="otp-actions">
            <button type="button" class="link" data-change>{T.change}</button>
            <button type="button" class="link" data-resend disabled></button>
          </div>
        </form>

        <div class="or" data-or hidden><span>{T.or}</span></div>
        <a class="gbtn" href="/api/me/google" data-google hidden><Fragment set:html={G} />{T.google}</a>

        <details class="pw" data-pw>
          <summary>{T.passToggle}</summary>
          <div class="tabs" role="tablist"><button type="button" role="tab" aria-selected="true" data-tab="in">{T.tabIn}</button><button type="button" role="tab" aria-selected="false" data-tab="up">{T.tabUp}</button></div>
          <form class="stack" data-in>
            <input type="email" name="email" required autocomplete="email" placeholder={T.email} aria-label={T.email} />
            <input type="password" name="password" required autocomplete="current-password" placeholder={T.pass} aria-label={T.pass} />
            <button class="cta">{T.signIn}</button>
          </form>
          <form class="stack" data-up hidden>
            <input name="name" required maxlength="80" autocomplete="name" placeholder={T.name} aria-label={T.name} />
            <input type="email" name="email" required autocomplete="email" placeholder={T.email} aria-label={T.email} />
            <input type="tel" name="phone" maxlength="40" autocomplete="tel" placeholder={T.phone} aria-label={T.phone} />
            <input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder={T.pass8} aria-label={T.pass8} />
            <label class="check"><input type="checkbox" name="consent" required /> <span set:html={T.consent} /></label>
            <label class="check"><input type="checkbox" name="marketing" /> <span>{T.news}</span></label>
            <button class="cta">{T.signUp}</button>
          </form>
        </details>
        <p class="msg" data-msg role="status" aria-live="polite"></p>
      </div>
    </section>

    <!-- Signed in: three tabs. Daily work lives in the workspace, this is the account around it. -->
    <section class="me-top" data-dash hidden>
      <div><h1 data-hello></h1><p class="mut" data-mail></p></div>
      <a class="cta" href={`${pre}/app/`}>{T.toWs} <span aria-hidden="true">→</span></a>
    </section>
    <div class="me-tabs" role="tablist" aria-label={T.title} data-tabs hidden>
      {[['plan', T.tabPlan], ['modules', T.tabMods], ['memory', T.tabMem]].map(([id, name]) => <button type="button" role="tab" id={`tab-${id}`} aria-controls={`pane-${id}`} aria-selected="false" data-go={id}>{name}</button>)}
    </div>

    <section class="me-pane" id="pane-plan" role="tabpanel" aria-labelledby="tab-plan" data-pane="plan" hidden>
      <article class="cab-card plan">
        <div class="plan-head">
          <div><p class="eyebrow">{T.planH}</p><h2 data-plan-name></h2><p class="mut" data-plan-st></p></div>
          <div class="plan-act"><a class="cta" data-plan-link hidden></a><button type="button" class="cta" data-plan-try hidden>{T.tryBtn}</button></div>
        </div>
        <p class="msg" data-plan-msg role="status"></p>
        <div class="allow" data-allow hidden>
          <h3>{T.allowH}</h3>
          <div class="al-rows" data-allow-rows></div>
        </div>
      </article>
      <article class="cab-card wal">
        <p class="eyebrow">{T.bonus}</p>
        <b class="w-sum" data-bonus>$0</b>
        <p class="mut small">{T.bonusRule}</p>
        <details class="w-hist"><summary>{T.history}</summary><ul data-hist-list></ul></details>
      </article>
      <article class="cab-card" data-mailbox hidden>
        <div class="acct-row"><div><b>{T.sEmail}</b><p class="mut small">{T.sEmailP}</p></div><button type="button" class="ghost sm" data-mail-go>{T.sEmailDo}</button></div>
        <form class="vcode" data-vcode hidden>
          <p class="mut small" data-vcode-p></p>
          <div class="row"><input inputmode="numeric" autocomplete="one-time-code" maxlength="6" required aria-label={T.codeH} placeholder="000000" /><button class="cta">{T.confirm}</button></div>
        </form>
      </article>
      <details class="cab-card more invite" id="invite" data-invite>
        <summary>{T.invH}</summary>
        <p class="inv-got" data-inv-got hidden></p>
        <p class="mut">{T.invP}</p>
        <div class="inv-row">
          <input class="inv-link" data-inv-link readonly aria-label={T.invH} value="" />
          <button type="button" class="cta" data-inv-copy>{T.invCopy}</button>
          <button type="button" class="ghost" data-inv-share hidden>{T.invShare}</button>
        </div>
        <p class="small" data-inv-stats></p>
        <details class="inv-why"><summary>{T.fairH}</summary><p class="mut small">{T.fairP}</p></details>
        <p class="mut small">{T.invFine} <a href={`${pre}/partners/`}>{T.invPartner} →</a></p>
      </details>
      <details class="cab-card more acct">
        <summary>{T.account}</summary>
        <label class="check"><input type="checkbox" data-news /> <span>{T.newsOn}</span></label>
        <div class="btns"><a class="ghost" href="/api/me/export" download>{T.export}</a><button type="button" class="ghost" data-out>{T.out}</button><button type="button" class="ghost danger" data-del>{T.del}</button></div>
      </details>
    </section>

    <section class="me-pane" id="pane-modules" role="tabpanel" aria-labelledby="tab-modules" data-pane="modules" hidden>
      <div class="mods" data-mods></div>
      <section class="cab-projects" data-proj-sec hidden aria-labelledby="cab-proj-h">
        <div class="sec-head"><h2 id="cab-proj-h" data-ph>{T.projects}</h2></div>
        <div class="proj-grid" data-projects></div>
      </section>
      <div id="biz" class="cab-biz" data-biz hidden><BizApp lang={lang} /></div>
    </section>

    <section class="me-pane" id="pane-memory" role="tabpanel" aria-labelledby="tab-memory" data-pane="memory" hidden>
      <form class="cab-card mem" data-mem>
        <h2>{T.memH}</h2>
        <p class="mut">{T.memP}</p>
        {[['niche', T.memNiche], ['goals', T.memGoals], ['project', T.memProject], ['limits', T.memLimits]].map(([k, name]) => <label>{name}<textarea name={k} rows="2" maxlength="600"></textarea></label>)}
        <div class="mem-go"><button class="cta">{T.memSave}</button><span class="mut small" data-mem-msg role="status"></span></div>
      </form>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  type R = Record<string, any>;
  const root = document.querySelector<HTMLElement>('[data-me]')!;
  const T: R = JSON.parse(root.querySelector('[data-me-t]')!.textContent || '{}');
  const lang = root.dataset.lang!;
  const homePre = root.dataset.home === '/' ? '' : root.dataset.home!.replace(/\/$/, '');
  const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const $$ = <E extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<E>(s));
  const el = (tag: string, attrs: R = {}, ...kids: (Node | string | null | undefined | false)[]) => {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) { if (k === 'class') e.className = v; else if (k === 'html') e.innerHTML = v; else if (k.startsWith('on')) (e as any)[k] = v; else if (v != null && v !== false) e.setAttribute(k, String(v)); }
    for (const k of kids) if (k != null && k !== false) e.append(k);
    return e;
  };
  const P: R = {
    check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
    star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>',
    chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
    doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/>',
  };
  const svg = (n: string, s = 20) => `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${P[n] || ''}</svg>`;

  const q = new URLSearchParams(location.search);
  const room = q.get('t') || '';
  const money = (n: number) => '$' + (Math.round(n * 100) / 100).toLocaleString('en-US');
  const day = (s: string) => new Date(String(s).replace(' ', 'T') + (String(s).length > 10 ? 'Z' : '')).toLocaleDateString(lang === 'ua' ? 'uk-UA' : lang === 'ru' ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  const msg = (s: string) => { $('[data-msg]').textContent = s; };
  const post = (u: string, body: R = {}) => fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ room, lang, ...body }) });
  let email = '', D: R = {}, W: R = {}, timer = 0;

  /* ---------- Projects ---------- */
  const STEP_OF: R = { work: 1, qa: 1, review: 2, revisions: 3, delivered: 5 };
  function project(p: R, signedIn: boolean) {
    const won = p.status === 'won';
    const key = won ? (p.stage || 'work') : p.status;
    const cur = won ? (STEP_OF[p.stage || 'work'] ?? 1) : 0;
    const pct = won ? (p.stage === 'delivered' ? 100 : (p.progress ?? 0)) : 0;
    const paused = p.status === 'lost';
    const used = p.revisions_used ?? 0, total = p.revisions_total ?? 2;
    const tl = el('ol', { class: 'tl', 'aria-label': T.progress },
      ...T.tl.map((name: string, i: number) => el('li', { class: i < cur ? 'done' : i === cur ? 'cur' : '', 'aria-current': i === cur ? 'step' : null }, el('i', { html: i < cur ? svg('check', 14) : '' }), el('span', {}, name))));
    const card = el('article', { class: `proj${paused ? ' paused' : ''}${p.stage === 'delivered' ? ' delivered' : ''}`, id: `p${p.id}` },
      el('div', { class: 'p-head' },
        el('div', {}, el('small', { class: 'mut' }, `#${p.id} · ${day(p.created_at)}`), el('h3', {}, p.what || p.name || `#${p.id}`)),
        el('span', { class: 'pill' }, T.next[key] || key)),
      tl,
      el('div', { class: 'p-meta' },
        el('div', { class: 'p-prog' }, el('div', { class: 'p-prog-top' }, el('span', {}, T.progress), el('b', {}, `${pct}%`)), el('div', { class: 'meter', role: 'progressbar', 'aria-valuenow': pct, 'aria-valuemin': 0, 'aria-valuemax': 100, 'aria-label': T.progress }, el('i', { style: `--w:${pct}%` }))),
        won && el('div', { class: 'p-rev' }, el('div', { class: 'p-prog-top' }, el('span', {}, T.revisions), el('b', {}, T.revOf.replace('{u}', used).replace('{t}', total))),
          el('div', { class: 'pips', 'aria-hidden': 'true' }, ...Array.from({ length: Math.min(total, 10) }, (_, i) => el('i', { class: i < used ? 'on' : '' }))))),
      el('div', { class: 'p-now' }, el('span', { class: 'now-tag' }, T.nextStep), el('span', {}, T.next[key] || key)),
      el('ul', { class: 'facts' },
        el('li', { class: p.brief_confirmed_at ? 'ok' : '' }, el('span', { html: svg(p.brief_confirmed_at ? 'check' : 'doc', 16) }), p.brief_confirmed_at ? T.brief.replace('{d}', day(p.brief_confirmed_at)) : T.briefNo),
        p.strategy_url && el('li', {}, el('span', { html: svg('doc', 16) }), el('a', { href: p.strategy_url, target: '_blank', rel: 'noopener' }, T.strategy + ' ↗'))),
      p.payments?.length > 0 && el('details', { class: 'pays' }, el('summary', {}, `${T.payments} · ${p.payments.length}`),
        el('ul', {}, ...p.payments.map((x: R) => el('li', {}, el('span', {}, `${day(x.at)} · ${T.parts[x.part] || x.part}`), el('b', {}, `${x.amount} ${x.currency}`))))),
      p.room && el('a', { class: 'cta big chat', href: `/room/?t=${p.room}` }, el('span', { html: svg('chat') }), T.chat, el('span', { 'aria-hidden': 'true' }, '→')));
    if (signedIn && p.stage === 'delivered') {
      if (p.reviewed) card.append(el('p', { class: 'reviewed' }, el('span', { html: svg('star', 16) }), T.reviewed));
      else {
        const f = el('form', { class: 'rev', hidden: true },
          el('label', {}, T.stars + ' ', el('select', { name: 'stars' }, ...[5, 4, 3, 2, 1].map((n) => el('option', { value: n }, '★'.repeat(n))))),
          el('textarea', { name: 'text', rows: '3', required: true, minlength: '20', placeholder: T.reviewText, 'aria-label': T.reviewText }),
          el('label', { class: 'check' }, el('input', { type: 'checkbox', name: 'public' }), ' ' + T.publicOk),
          el('button', { class: 'cta' }, T.send)) as HTMLFormElement;
        f.onsubmit = async (e) => { e.preventDefault(); const d = Object.fromEntries(new FormData(f)); const r = await post('/api/me/review', { lead_id: p.id, stars: Number(d.stars), text: d.text, public: !!d.public }); if (r.ok) load(); };
        card.append(el('button', { type: 'button', class: 'ghost rev-btn', 'data-rev': p.id, onclick: () => { f.hidden = !f.hidden; if (!f.hidden) f.querySelector('textarea')!.focus(); } }, el('span', { html: svg('star', 16) }), T.review), f);
      }
    }
    return card;
  }

  /* ---------- Signed-in parts ---------- */
  function renderTop(d: R) {
    const name = d.me?.name ? `, ${d.me.name.split(' ')[0]}` : '';
    $('[data-hello]').textContent = `${T.hi}${name}!`;
    $('[data-mail]').textContent = d.me?.email || '';
    $('[data-bonus]').textContent = money(d.bonus || 0);
    const hist: R[] = d.bonusHistory || [];
    $('[data-hist-list]').replaceChildren(...(hist.length ? hist.map((h) => el('li', {}, el('span', {}, `${day(h.at)} · ${T.kinds[h.kind] || h.kind}`), el('b', { class: h.amount_usd > 0 ? 'plus' : '' }, `${h.amount_usd > 0 ? '+' : ''}${money(h.amount_usd)}`))) : [el('li', { class: 'mut' }, T.histEmpty)]));
    $('[data-mailbox]').hidden = !!d.me?.verified;
  }

  function renderPlan(d: R) {
    const plan: string = d.allowance?.plan || 'start', trial = !!d.allowance?.trial, free = plan === 'start';
    $('[data-plan-name]').textContent = free ? T.levels.start : plan[0].toUpperCase() + plan.slice(1);
    $('[data-plan-st]').textContent = free ? T.planFree : trial ? T.planTrial : T.planOn;
    const a = $<HTMLAnchorElement>('[data-plan-link]');
    a.hidden = free && !d.payUrl;
    a.href = d.payUrl || `${homePre}/#pricing`;
    a.textContent = d.payUrl ? T.payBtn : T.chgBtn;
    $('[data-plan-try]').hidden = !free || !!d.payUrl;
  }

  function renderMods(w: R) {
    const m: R = w.modules || {}, go = (k: string) => `${homePre}/app/#deploy=${k}`;
    const row = (name: string, state: string, href: string, label: string, on: boolean, extra?: Node | false) =>
      el('article', { class: `cab-card mod${on ? ' on' : ''}` }, el('div', {}, el('b', {}, name), el('span', { class: 'mut small' }, state)), el('div', { class: 'mod-act' }, extra, el('a', { class: 'ghost sm', href }, label + ' →')));
    const locked = !w.access, off = locked ? T.mLock : T.mOff;
    $('[data-mods]').replaceChildren(
      row(T.mCrm, m.crm ? T.mCrmOn.replace('{n}', m.crm.total) : off, go('crm'), m.crm ? T.mOpen : T.mDeploy, !!m.crm),
      row(T.mSite, m.site ? T.mSiteOn.replace('{n}', m.requests ?? 0) : T.mOff, go('site'), m.site ? T.mOpen : T.mDeploy, !!m.site, !!m.site && el('a', { class: 'link', href: m.site.url, target: '_blank', rel: 'noopener' }, T.mSee + ' ↗')),
      row(T.mPartner, m.partner ? T.mParOn.replace('{n}', m.partner.links.length) : off, go('partner'), m.partner ? T.mOpen : T.mDeploy, !!m.partner));
    $('[data-biz]').hidden = !w.access;
    const f = $<HTMLFormElement>('[data-mem]');
    for (const k of ['niche', 'goals', 'project', 'limits']) { const t = f.elements.namedItem(k) as HTMLTextAreaElement; if (document.activeElement !== t) t.value = w.memory?.[k] || ''; }
  }

  function renderInvite(d: R) {
    const v: R = d.invite || {};
    const link = v.slug ? `${location.origin}/r/${v.slug}` : '';
    const inp = $<HTMLInputElement>('[data-inv-link]');
    inp.value = link || T.invNo;
    const copy = $<HTMLButtonElement>('[data-inv-copy]');
    copy.disabled = !link;
    copy.onclick = async () => {
      try { await navigator.clipboard.writeText(link); } catch { inp.select(); document.execCommand('copy'); }
      copy.textContent = T.invCopied; setTimeout(() => (copy.textContent = T.invCopy), 1800);
    };
    const sh = $<HTMLButtonElement>('[data-inv-share]');
    sh.hidden = !link || !('share' in navigator);
    sh.onclick = () => navigator.share({ title: 'Vaxo', text: T.invP, url: link }).catch(() => {});
    const r = v.rules || { maxMonthsYear: 12 };
    $('[data-inv-stats]').textContent = T.invStats.replace('{i}', v.invited || 0).replace('{p}', v.pending || 0).replace('{c}', v.credited || 0) + ' ' + T.invYear.replace('{y}', v.yearMonths || 0).replace('{m}', r.maxMonthsYear);
    const got = $('[data-inv-got]');
    got.hidden = !v.friendBonus;
    if (v.friendBonus) got.textContent = T.invGot.replace('{n}', v.friendBonus.months);
  }

  function renderAllow(d: R) {
    const a: R | null = d.allowance;
    $('[data-allow]').hidden = !a;
    if (!a) return;
    const row = (label: string, x: R) => {
      const left = Math.max(0, 1 - x.used / x.cap);
      const word = left <= 0 ? T.allowOut : left < 0.25 ? T.allowLow : T.allowOk;
      return el('div', { class: 'al-row' }, el('b', {}, label), el('div', { class: 'al-bar' }, el('i', { style: `width:${Math.round(left * 100)}%` })), el('span', { class: left < 0.25 ? 'low' : '' }, word));
    };
    $('[data-allow-rows]').replaceChildren(row(T.allowDay, a.day), row(T.allowWeek, a.week));
  }

  async function confirmEmail() {
    const box = $('[data-vcode]');
