---
// Client cabinet (Decision 16): vaxogroup.com/me/. Sign-in: email first → 6-digit code (auto-submit), Google second, a
// password tucked away. Signed in: hero with level ring and points, bonus wallet, a first-run welcome, a setup checklist
// (only rewards the backend really pays), project cards with a stage timeline, achievements and the business app.
// Without signing in, the personal project link (/me/?t=<room>) shows that project and a "save it — 1 step" card.
// Data: /api/me (worker/cabinet.ts). Texts: ./cabinet/i18n.ts.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BizApp from './BizApp.astro';
import { CAB_T } from './cabinet/i18n';
import { getDict, langPath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/me/', ua: '/ua/me/', ru: '/ru/me/' };
const T = CAB_T[lang];
const G = `<svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>`;
---

<Base lang={lang} title={`Vaxo — ${T.title}`} description={T.lead} path={alts[lang]} alts={alts} noindex>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="cab" data-me data-lang={lang} data-home={home} aria-busy="true">
    <script type="application/json" data-me-t set:html={JSON.stringify(T)} />
    <div class="cab-glow" aria-hidden="true"></div>
    <div class="cab-skel" data-skel aria-hidden="true"><i></i><i></i><i></i></div>

    <!-- Sign-in: one screen, email first -->
    <section class="cab-auth" data-auth hidden aria-labelledby="cab-auth-h">
      <div class="auth-side" aria-hidden="true">
        <img src="/mascot/vax-key.webp" alt="" width="419" height="520" loading="eager" />
        <ul class="trust">{T.trust.map((x, i) => <li><span class="dot">{['01', '02', '03'][i]}</span>{x}</li>)}</ul>
      </div>
      <div class="auth-main">
        <p class="eyebrow" data-auth-eye>Vaxo</p>
        <h1 id="cab-auth-h" data-auth-h>{T.loginH}</h1>
        <p class="mut" data-auth-p>{T.loginP}</p>
        <p class="note" data-off hidden>{T.off}</p>

        <form class="step" data-step-email novalidate>
          <label class="field"><span class="sr">{T.email}</span>
            <input type="email" name="email" required autocomplete="email" inputmode="email" placeholder={T.email} />
          </label>
          <button class="cta big" data-cont>{T.cont} <span aria-hidden="true">→</span></button>
          <p class="micro"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{T.noPass}</p>
        </form>

        <form class="step" data-step-code hidden novalidate>
          <h2 class="code-h">{T.codeH}</h2>
          <p class="mut" data-code-p></p>
          <div class="otp" role="group" aria-label={T.codeH} data-otp>
            {[1, 2, 3, 4, 5, 6].map((n) => <input inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="•" autocomplete={n === 1 ? 'one-time-code' : 'off'} aria-label={T.codeLabel.replace('{n}', String(n))} />)}
          </div>
          <div class="otp-actions">
            <button type="button" class="link" data-change>{T.change}</button>
            <button type="button" class="link" data-resend disabled></button>
          </div>
        </form>

        <div class="or" data-or hidden><span>{T.or}</span></div>
        <a class="gbtn" href="/api/me/google" data-google hidden><Fragment set:html={G} />{T.google}</a>

        <details class="pw" data-pw>
          <summary>{T.passToggle}</summary>
          <div class="tabs" role="tablist"><button type="button" role="tab" aria-selected="true" data-tab="in">{T.tabIn}</button><button type="button" role="tab" aria-selected="false" data-tab="up">{T.tabUp}</button></div>
          <form class="stack" data-in>
            <input type="email" name="email" required autocomplete="email" placeholder={T.email} aria-label={T.email} />
            <input type="password" name="password" required autocomplete="current-password" placeholder={T.pass} aria-label={T.pass} />
            <button class="cta">{T.signIn}</button>
          </form>
          <form class="stack" data-up hidden>
            <input name="name" required maxlength="80" autocomplete="name" placeholder={T.name} aria-label={T.name} />
            <input type="email" name="email" required autocomplete="email" placeholder={T.email} aria-label={T.email} />
            <input type="tel" name="phone" maxlength="40" autocomplete="tel" placeholder={T.phone} aria-label={T.phone} />
            <input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder={T.pass8} aria-label={T.pass8} />
            <label class="check"><input type="checkbox" name="consent" required /> <span set:html={T.consent} /></label>
            <label class="check"><input type="checkbox" name="marketing" /> <span>{T.news}</span></label>
            <button class="cta">{T.signUp}</button>
          </form>
        </details>
        <p class="msg" data-msg role="status" aria-live="polite"></p>
      </div>
    </section>

    <!-- Signed in: hero + wallet -->
    <section class="cab-top" data-dash hidden>
      <article class="hero">
        <div class="hero-txt">
          <p class="eyebrow on-deep" data-hello-eye></p>
          <h1 data-hello></h1>
          <p class="hero-mail" data-mail></p>
          <div class="chips"><span class="chip gold" data-points title={T.pointsNote}></span><span class="chip" data-paid></span></div>
          <p class="hero-note">{T.pointsNote}</p>
        </div>
        <div class="hero-lvl">
          <div class="ring-wrap" data-lvl-ring></div>
          <p class="lvl-next" data-next></p>
        </div>
        <img class="hero-vax" src="/mascot/vax-happy.webp" alt="" width="203" height="210" aria-hidden="true" />
      </article>
      <article class="wallet">
        <div class="w-head"><span class="ico-box" data-ico="wallet"></span><p class="eyebrow">{T.bonus}</p></div>
        <b class="w-sum" data-bonus>$0</b>
        <p class="mut small">{T.bonusRule}</p>
        <details class="w-hist"><summary>{T.history}</summary><ul data-hist-list></ul></details>
      </article>
    </section>

    <!-- Setup checklist -->
    <section class="cab-card setup" data-setup hidden aria-labelledby="cab-setup-h">
      <div class="setup-head">
        <div class="ring-wrap sm" data-setup-ring></div>
        <div><h2 id="cab-setup-h">{T.setupH}</h2><p class="mut" data-setup-p></p></div>
      </div>
      <ol class="steps" data-steps></ol>
      <form class="profile" data-profile hidden>
        <div class="two"><input name="business" placeholder={T.pBusiness} aria-label={T.pBusiness} /><input name="name" placeholder={T.pName} aria-label={T.pName} /></div>
        <div class="two"><input name="niche" placeholder={T.pNiche} aria-label={T.pNiche} /><input name="city" placeholder={T.pCity} aria-label={T.pCity} /></div>
        <input name="site" placeholder={T.pSite} aria-label={T.pSite} />
        <textarea name="goal" rows="2" placeholder={T.pGoal} aria-label={T.pGoal}></textarea>
        <button class="cta" data-profile-btn>{T.saveBonus}</button>
      </form>
      <form class="vcode" data-vcode hidden>
        <p class="mut small" data-vcode-p></p>
        <div class="row"><input inputmode="numeric" autocomplete="one-time-code" maxlength="6" required aria-label={T.codeH} placeholder="000000" /><button class="cta">{T.confirm}</button></div>
      </form>
    </section>

    <!-- Projects (also for a guest with the project link) -->
    <section class="cab-projects" data-proj-sec hidden aria-labelledby="cab-proj-h">
      <div class="sec-head"><h2 id="cab-proj-h" data-ph>{T.projects}</h2></div>
      <div class="proj-grid" data-projects></div>
      <div class="cab-card none" data-none hidden>
        <img src="/mascot/vax-sprout.webp" alt="" width="429" height="520" loading="lazy" />
        <div><p>{T.none}</p><a class="cta" href={`${home}#contact`}>{T.start} →</a></div>
      </div>
    </section>

    <!-- Achievements -->
    <section class="cab-ach" data-ach-sec hidden aria-labelledby="cab-ach-h">
      <div class="sec-head"><h2 id="cab-ach-h">{T.achH}</h2><p class="mut">{T.achP}</p></div>
      <ul class="ach" data-ach></ul>
    </section>

    <div id="biz" class="cab-biz"><BizApp lang={lang} /></div>

    <section class="cab-card acct" data-acct hidden>
      <div class="acct-row"><b>{T.account}</b><button type="button" class="ghost" data-out>{T.out}</button></div>
      <label class="check"><input type="checkbox" data-news /> <span>{T.newsOn}</span></label>
      <div class="btns"><a class="ghost" href="/api/me/export" download>{T.export}</a><button type="button" class="ghost danger" data-del>{T.del}</button></div>
    </section>

    <dialog class="welcome" data-welcome aria-labelledby="cab-w-h">
      <form method="dialog" class="w-in">
        <div class="w-art"><img data-w-img src="/mascot/vax-checklist.webp" alt="" width="371" height="420" /></div>
        <p class="eyebrow" data-w-step></p>
        <h2 id="cab-w-h" data-w-h></h2>
        <p class="mut" data-w-p></p>
        <div class="w-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="w-btns"><button value="skip" class="link" data-w-skip>{T.wSkip}</button><button type="button" class="cta" data-w-next></button></div>
      </form>
    </dialog>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  type R = Record<string, any>;
  const root = document.querySelector<HTMLElement>('[data-me]')!;
  const T: R = JSON.parse(root.querySelector('[data-me-t]')!.textContent || '{}');
  const lang = root.dataset.lang!;
  const homePre = root.dataset.home === '/' ? '' : root.dataset.home!.replace(/\/$/, '');
  const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const $$ = <E extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<E>(s));
  const el = (tag: string, attrs: R = {}, ...kids: (Node | string | null | undefined | false)[]) => {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) { if (k === 'class') e.className = v; else if (k === 'html') e.innerHTML = v; else if (k.startsWith('on')) (e as any)[k] = v; else if (v != null && v !== false) e.setAttribute(k, String(v)); }
    for (const k of kids) if (k != null && k !== false) e.append(k);
    return e;
  };
  const P: R = {
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
    store: '<path d="M4 10v10h16V10"/><path d="M2.5 10 4.5 4h15l2 6z"/><path d="M9.5 20v-5h5v5"/>',
    globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>',
    friend: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M18 9v6M15 12h6"/>',
    star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>',
    rocket: '<path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2"/><path d="m9 15-3-3c1-4 4.5-8.5 12-9 0 7.5-5 11-9 12z"/><circle cx="14.5" cy="9.5" r="1.6"/>',
    inbox: '<path d="M3 13h5l1.5 3h5l1.5-3h5"/><path d="M5.5 5h13L21 13v6H3v-6z"/>',
    check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
    lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
    chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
    wallet: '<path d="M3 7a2 2 0 0 1 2-2h12v3"/><rect x="3" y="7" width="18" height="13" rx="2.5"/><circle cx="16.5" cy="13.5" r="1.3"/>',
    doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/>',
    pen: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13.5 6.5 4 4"/>',
  };
  const svg = (n: string, s = 20) => `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${P[n] || ''}</svg>`;
  const ico = (n: string, cls = 'ico-box') => el('span', { class: cls, html: svg(n) });
  $$('[data-ico]').forEach((x) => (x.innerHTML = svg(x.dataset.ico!)));
  /** A progress ring: pct 0–100, centre text. */
  const ring = (pct: number, big: string, small = '', size = 132) => {
    const r = 44, c = 2 * Math.PI * r, off = c * (1 - Math.max(0, Math.min(100, pct)) / 100);
    return `<svg class="ring" viewBox="0 0 100 100" width="${size}" height="${size}" role="img" aria-label="${big} ${small}"><circle class="tr" cx="50" cy="50" r="${r}"/><circle class="arc" cx="50" cy="50" r="${r}" stroke-dasharray="${c.toFixed(1)}" stroke-dashoffset="${c.toFixed(1)}" data-off="${off.toFixed(1)}" transform="rotate(-90 50 50)"/></svg><div class="ring-txt"><b>${big}</b>${small ? `<small>${small}</small>` : ''}</div>`;
  };
  const playRings = () => requestAnimationFrame(() => requestAnimationFrame(() => $$<SVGCircleElement>('.ring .arc').forEach((a) => a.setAttribute('stroke-dashoffset', a.dataset.off!))));

  const q = new URLSearchParams(location.search);
  const room = q.get('t') || '';
  const money = (n: number) => '$' + (Math.round(n * 100) / 100).toLocaleString('en-US');
  const day = (s: string) => new Date(String(s).replace(' ', 'T') + (String(s).length > 10 ? 'Z' : '')).toLocaleDateString(lang === 'ua' ? 'uk-UA' : lang === 'ru' ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  const msg = (s: string) => { $('[data-msg]').textContent = s; };
  const post = (u: string, body: R = {}) => fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ room, lang, ...body }) });
  const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return 'x'; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} } };
  let email = '', D: R = {}, timer = 0;

  /* ---------- Projects ---------- */
  const STEP_OF: R = { work: 1, qa: 1, review: 2, revisions: 3, delivered: 5 };
  function project(p: R, signedIn: boolean) {
    const won = p.status === 'won';
    const key = won ? (p.stage || 'work') : p.status;
    const cur = won ? (STEP_OF[p.stage || 'work'] ?? 1) : 0;
    const pct = won ? (p.stage === 'delivered' ? 100 : (p.progress ?? 0)) : 0;
    const paused = p.status === 'lost';
    const used = p.revisions_used ?? 0, total = p.revisions_total ?? 2;
    const tl = el('ol', { class: 'tl', 'aria-label': T.progress },
      ...T.tl.map((name: string, i: number) => el('li', { class: i < cur ? 'done' : i === cur ? 'cur' : '', 'aria-current': i === cur ? 'step' : null }, el('i', { html: i < cur ? svg('check', 14) : '' }), el('span', {}, name))));
    const card = el('article', { class: `proj${paused ? ' paused' : ''}${p.stage === 'delivered' ? ' delivered' : ''}`, id: `p${p.id}` },
      el('div', { class: 'p-head' },
        el('div', {}, el('small', { class: 'mut' }, `#${p.id} · ${day(p.created_at)}`), el('h3', {}, p.what || p.name || `#${p.id}`)),
        el('span', { class: 'pill' }, T.next[key] || key)),
      tl,
      el('div', { class: 'p-meta' },
        el('div', { class: 'p-prog' }, el('div', { class: 'p-prog-top' }, el('span', {}, T.progress), el('b', {}, `${pct}%`)), el('div', { class: 'meter', role: 'progressbar', 'aria-valuenow': pct, 'aria-valuemin': 0, 'aria-valuemax': 100, 'aria-label': T.progress }, el('i', { style: `--w:${pct}%` }))),
        won && el('div', { class: 'p-rev' }, el('div', { class: 'p-prog-top' }, el('span', {}, T.revisions), el('b', {}, T.revOf.replace('{u}', used).replace('{t}', total))),
          el('div', { class: 'pips', 'aria-hidden': 'true' }, ...Array.from({ length: Math.min(total, 10) }, (_, i) => el('i', { class: i < used ? 'on' : '' }))))),
      el('div', { class: 'p-now' }, el('span', { class: 'now-tag' }, T.nextStep), el('span', {}, T.next[key] || key)),
      el('ul', { class: 'facts' },
        el('li', { class: p.brief_confirmed_at ? 'ok' : '' }, el('span', { html: svg(p.brief_confirmed_at ? 'check' : 'doc', 16) }), p.brief_confirmed_at ? T.brief.replace('{d}', day(p.brief_confirmed_at)) : T.briefNo),
        p.strategy_url && el('li', {}, el('span', { html: svg('doc', 16) }), el('a', { href: p.strategy_url, target: '_blank', rel: 'noopener' }, T.strategy + ' ↗'))),
      p.payments?.length > 0 && el('details', { class: 'pays' }, el('summary', {}, `${T.payments} · ${p.payments.length}`),
        el('ul', {}, ...p.payments.map((x: R) => el('li', {}, el('span', {}, `${day(x.at)} · ${T.parts[x.part] || x.part}`), el('b', {}, `${x.amount} ${x.currency}`))))),
      p.room && el('a', { class: 'cta big chat', href: `/room/?t=${p.room}` }, el('span', { html: svg('chat') }), T.chat, el('span', { 'aria-hidden': 'true' }, '→')));
    if (signedIn && p.stage === 'delivered') {
      if (p.reviewed) card.append(el('p', { class: 'reviewed' }, el('span', { html: svg('star', 16) }), T.reviewed));
      else {
        const f = el('form', { class: 'rev', hidden: true },
          el('label', {}, T.stars + ' ', el('select', { name: 'stars' }, ...[5, 4, 3, 2, 1].map((n) => el('option', { value: n }, '★'.repeat(n))))),
          el('textarea', { name: 'text', rows: '3', required: true, minlength: '20', placeholder: T.reviewText, 'aria-label': T.reviewText }),
          el('label', { class: 'check' }, el('input', { type: 'checkbox', name: 'public' }), ' ' + T.publicOk),
          el('button', { class: 'cta' }, T.send)) as HTMLFormElement;
        f.onsubmit = async (e) => { e.preventDefault(); const d = Object.fromEntries(new FormData(f)); const r = await post('/api/me/review', { lead_id: p.id, stars: Number(d.stars), text: d.text, public: !!d.public }); if (r.ok) load(); };
        card.append(el('button', { type: 'button', class: 'ghost rev-btn', 'data-rev': p.id, onclick: () => { f.hidden = !f.hidden; if (!f.hidden) f.querySelector('textarea')!.focus(); } }, el('span', { html: svg('star', 16) }), T.review), f);
      }
    }
    return card;
  }

  /* ---------- Signed-in parts ---------- */
  function facts(d: R) {
    const prof = d.me?.profile || {}, eco = d.eco || {}, ps: R[] = d.projects || [];
    const delivered = ps.filter((p) => p.stage === 'delivered');
    return {
      email: !!d.me?.verified,
      profile: !!(prof.business && prof.niche && (prof.goal || '').length >= 10),
      site: (eco.sites || 0) > 0,
      lead: (eco.bizLeads || 0) > 0,
      friend: (eco.friends || 0) > 0,
      review: ps.some((p) => p.reviewed),
      reviewOpen: delivered.find((p) => !p.reviewed),
      project: ps.length > 0,
    };
  }

  function renderHero(d: R, f: R) {
    const name = d.me?.name ? `, ${d.me.name.split(' ')[0]}` : '';
    $('[data-hello]').textContent = `${T.hi}${name}!`;
    $('[data-hello-eye]').textContent = T.title;
    $('[data-mail]').textContent = d.me?.email || '';
    const unlocked = ['project', 'profile', 'site', 'lead', 'review', 'friend'].filter((k) => f[k]).length;
    const points = unlocked * 100 + (d.projects?.length || 0) * 25 + (f.email ? 50 : 0);
    $('[data-points]').textContent = `★ ${points.toLocaleString('en-US')} ${T.points}`;
    $('[data-paid]').textContent = T.paid.replace('{n}', money(d.paidUsd || 0));
    const L: R[] = d.levels || [{ id: 'start', from: 0 }, { id: 'pro', from: 1000 }, { id: 'vip', from: 5000 }];
    const i = Math.max(0, L.findIndex((x) => x.id === d.level)), nx = L[i + 1];
    const pct = nx ? ((d.paidUsd - L[i].from) / (nx.from - L[i].from)) * 100 : 100;
    $('[data-lvl-ring]').innerHTML = ring(pct, T.levels[d.level] || d.level, T.level);
    $('[data-next]').textContent = nx ? T.toNext.replace('${n}', '$' + Math.max(0, Math.round(nx.from - d.paidUsd)).toLocaleString('en-US')).replace('{lvl}', T.levels[nx.id]) : T.vipPerks;
    $('[data-bonus]').textContent = money(d.bonus || 0);
    const hist: R[] = d.bonusHistory || [];
    $('[data-hist-list]').replaceChildren(...(hist.length ? hist.map((h) => el('li', {}, el('span', {}, `${day(h.at)} · ${T.kinds[h.kind] || h.kind}`), el('b', { class: h.amount_usd > 0 ? 'plus' : '' }, `${h.amount_usd > 0 ? '+' : ''}${money(h.amount_usd)}`))) : [el('li', { class: 'mut' }, T.histEmpty)]));
  }

  function renderSetup(d: R, f: R) {
    const steps = [
      { id: 'email', ic: 'mail', done: f.email, h: T.sEmail, p: T.sEmailP, act: T.sEmailDo, go: confirmEmail },
      { id: 'profile', ic: 'store', done: f.profile, h: T.sProfile, p: T.sProfileP, reward: '+$5', act: T.sProfileDo, go: () => { const pf = $('[data-profile]'); pf.hidden = !pf.hidden; if (!pf.hidden) pf.querySelector('input')!.focus(); } },
      { id: 'site', ic: 'globe', done: f.site, h: T.sSite, p: T.sSiteP, act: T.sSiteDo, go: () => { const b = document.getElementById('biz')!; b.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); setTimeout(() => b.querySelector<HTMLInputElement>('[data-biz-new] input')?.focus({ preventScroll: true }), 400); } },
      { id: 'friend', ic: 'friend', done: f.friend, h: T.sFriend, p: T.sFriendP, reward: '50% + 30%', act: T.sFriendDo, href: `${homePre}/partners/` },
      { id: 'review', ic: 'star', done: f.review, h: T.sReview, p: f.reviewOpen || f.review ? T.sReviewP : T.sReviewWait, reward: '+$10', act: f.reviewOpen ? T.sReviewDo : '', go: () => { const b = root.querySelector<HTMLButtonElement>(`[data-rev="${f.reviewOpen?.id}"]`); b?.scrollIntoView({ block: 'center' }); b?.click(); } },
    ];
    const n = steps.length, done = steps.filter((s) => s.done).length;
    $('[data-setup-ring]').innerHTML = ring((done / n) * 100, `${done}/${n}`, '', 76);
    $('[data-setup-p]').textContent = done === n ? T.setupDone : T.setupP.replace('{d}', done).replace('{n}', n);
    $('[data-setup]').classList.toggle('all', done === n);
    $('[data-steps]').replaceChildren(...steps.map((s) => el('li', { class: s.done ? 'done' : '' },
      el('span', { class: 'st-ic', html: svg(s.done ? 'check' : s.ic) }),
      el('div', { class: 'st-txt' }, el('b', {}, s.h), el('span', { class: 'mut small' }, s.p)),
      el('div', { class: 'st-act' },
        s.reward && el('span', { class: 'reward' }, s.reward),
        s.done ? el('span', { class: 'st-done' }, T.done)
          : s.href ? el('a', { class: 'ghost sm', href: s.href }, s.act + ' →')
          : s.act ? el('button', { type: 'button', class: 'ghost sm', onclick: s.go }, s.act) : null))));
    const pf = $<HTMLFormElement>('[data-profile]');
    for (const [k, v] of Object.entries({ ...(d.me?.profile || {}), name: d.me?.name || '' })) { const i = pf.elements.namedItem(k) as HTMLInputElement | null; if (i && !i.value) i.value = String(v || ''); }
    $('[data-profile-btn]').textContent = f.profile ? T.save : T.saveBonus;
  }

  function renderAch(f: R) {
    const A: [string, string][] = [['project', 'rocket'], ['profile', 'store'], ['site', 'globe'], ['lead', 'inbox'], ['review', 'star'], ['friend', 'friend']];
    $('[data-ach]').replaceChildren(...A.map(([k, ic], i) => el('li', { class: f[k] ? 'on' : '', style: `--i:${i}` },
      el('span', { class: 'medal', html: svg(f[k] ? ic : 'lock', 26) }),
      el('b', {}, T.ach[k][0]), el('span', { class: 'mut small' }, T.ach[k][1]),
      el('span', { class: 'sr' }, f[k] ? T.unlocked : T.locked),
      el('span', { class: 'xp', 'aria-hidden': 'true' }, f[k] ? '+100' : T.locked))));
  }

  async function confirmEmail() {
    const box = $('[data-vcode]');
    const r = await post('/api/me/code', { email: D.me?.email }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { error: 'net' };
    if (r?.ok || d.error === 'wait') { $('[data-vcode-p]').textContent = T.codeSentInline.replace('{email}', D.me?.email || ''); box.hidden = false; box.querySelector('input')!.focus(); }
    else { $('[data-vcode-p]').textContent = d.error === 'mail_off' ? T.off : T.errNet; box.hidden = false; }
  }

  /* ---------- Welcome (first run) ---------- */
  const W_IMG = ['/mascot/vax-checklist.webp', '/mascot/vax-allinone.webp', '/mascot/vax-earn.webp'];
  function welcome(key: string) {
    const dlg = $<HTMLDialogElement>('[data-welcome]');
    if (!dlg.showModal || store.get(key)) return;
    let i = 0;
    const show = () => {
      $('[data-w-step]').textContent = T.wStep.replace('{n}', i + 1);
      $('[data-w-h]').textContent = T.w[i].h; $('[data-w-p]').textContent = T.w[i].p;
      $<HTMLImageElement>('[data-w-img]').src = W_IMG[i];
      $$('.w-dots i').forEach((x, j) => x.classList.toggle('on', j <= i));
      $('[data-w-next]').textContent = i < 2 ? T.wNext + ' →' : T.wGo;
    };
    $('[data-w-next]').onclick = () => { if (i < 2) { i++; show(); } else dlg.close(); };
    dlg.addEventListener('close', () => store.set(key, '1'), { once: true });
    show(); dlg.showModal(); $('[data-w-next]').focus();
  }

  /* ---------- Load ---------- */
  async function load() {
    const r = await fetch(`/api/me${room ? `?t=${room}` : ''}`).catch(() => null);
    const d: R = r?.ok ? await r.json() : { ok: false, signedIn: false, ways: r ? (await r.json().catch(() => ({}))).ways || {} : {}, projects: [] };
    D = d;
    root.removeAttribute('aria-busy');
    $('[data-skel]').hidden = true;
    const err = q.get('err');
    if (err) msg(err === 'google_off' ? T.off : T.errGoogle);
    const si = !!d.signedIn, ps: R[] = d.projects || [];
    const guest = !si && ps.length > 0;
    root.classList.toggle('is-guest', guest);
    root.classList.toggle('is-in', si);
    $('[data-auth]').hidden = si;
    for (const s of ['[data-dash]', '[data-setup]', '[data-ach-sec]', '[data-acct]']) $(s).hidden = !si;
    $('[data-proj-sec]').hidden = !si && !guest;
    $('[data-ph]').textContent = guest ? T.guestH : T.projects;
    $('[data-none]').hidden = !si || ps.length > 0;
    $('[data-projects]').replaceChildren(...ps.map((p) => project(p, si)));
    if (!si) {
      $('[data-auth-h]').textContent = guest ? T.saveH : T.loginH;
      $('[data-auth-p]').textContent = guest ? T.saveP : T.loginP;
      $('[data-auth-eye]').hidden = guest;
      const g = $<HTMLAnchorElement>('[data-google]'); g.hidden = !d.ways?.google; if (room) g.href = `/api/me/google?back=${room}`;
      $('[data-or]').hidden = !d.ways?.google;
      $('[data-off]').hidden = !!d.ways?.email;
      if (!d.ways?.email) $<HTMLDetailsElement>('[data-pw]').open = true;
      return;
    }
    const f = facts(d);
    renderHero(d, f); renderSetup(d, f); renderAch(f);
    $<HTMLInputElement>('[data-news]').checked = !!d.me?.marketing;
    playRings();
    window.dispatchEvent(new CustomEvent('vx:signed-in'));
    welcome(`vx_me_welcome_${d.me?.email || 'x'}`);
  }

  /* ---------- Email → code ---------- */
  const otp = $$<HTMLInputElement>('[data-otp] input');
  const showStep = (code: boolean) => { $('[data-step-email]').hidden = code; $('[data-step-code]').hidden = !code; };
  function countdown() {
    clearInterval(timer);
    let s = 60; const b = $<HTMLButtonElement>('[data-resend]');
    const tick = () => { b.disabled = s > 0; b.textContent = s > 0 ? T.resendIn.replace('{s}', s) : T.resend; s--; if (s < 0) clearInterval(timer); };
    tick(); timer = window.setInterval(tick, 1000);
  }
  async function sendCode() {
    const btn = $<HTMLButtonElement>('[data-cont]');
    btn.disabled = true; btn.firstChild!.textContent = T.sending + ' ';
    const r = await post('/api/me/code', { email }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { error: 'net' };
    btn.disabled = false; btn.firstChild!.textContent = T.cont + ' ';
    if (r?.ok || d.error === 'wait') {
      msg(d.error === 'wait' ? T.errWait : '');
      $('[data-code-p]').textContent = T.codeP.replace('{email}', email);
      showStep(true); otp.forEach((i) => (i.value = '')); otp[0].focus(); countdown();
    } else if (d.error === 'mail_off') {
      msg(T.off); const pw = $<HTMLDetailsElement>('[data-pw]'); pw.open = true;
      $$<HTMLInputElement>('[data-pw] input[type=email]').forEach((i) => (i.value = email));
      pw.querySelector<HTMLInputElement>('[data-in] input[type=password]')!.focus();
    } else msg(d.error === 'net' ? T.errNet : T.errEmail);
  }
  $<HTMLFormElement>('[data-step-email]').onsubmit = (e) => {
    e.preventDefault();
    email = ($<HTMLInputElement>('[data-step-email] input').value || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) { msg(T.errEmail); $<HTMLInputElement>('[data-step-email] input').focus(); return; }
    sendCode();
  };
  const fill = (from: number, digits: string) => {
    digits.split('').slice(0, 6 - from).forEach((ch, k) => (otp[from + k].value = ch));
    const next = otp.find((x) => !x.value);
    (next || otp[5]).focus();
    if (otp.every((x) => x.value)) verify();
  };
  otp.forEach((inp, i) => {
    inp.addEventListener('input', () => {
      const v = inp.value.replace(/\D/g, '');
      inp.value = v.slice(0, 1);
      if (v.length > 1) fill(i, v); else if (v) fill(i, v);
      root.querySelector('[data-otp]')!.classList.remove('bad');
    });
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !inp.value && i > 0) { otp[i - 1].value = ''; otp[i - 1].focus(); e.preventDefault(); }
      if (e.key === 'ArrowLeft' && i > 0) otp[i - 1].focus();
      if (e.key === 'ArrowRight' && i < 5) otp[i + 1].focus();
    });
    inp.addEventListener('paste', (e) => { const v = (e.clipboardData?.getData('text') || '').replace(/\D/g, ''); if (v) { e.preventDefault(); fill(v.length >= 6 ? 0 : i, v); } });
    inp.addEventListener('focus', () => inp.select());
  });
  let verifying = false;
  async function verify() {
    if (verifying) return; verifying = true;
    const code = otp.map((x) => x.value).join('');
    msg(T.checking); otp.forEach((x) => (x.disabled = true));
    const r = await post('/api/me/verify', { email, code }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : { error: 'net' };
    otp.forEach((x) => (x.disabled = false)); verifying = false;
    if (r?.ok) { msg(''); clearInterval(timer); showStep(false); load(); return; }
    msg(d.error === 'expired' ? T.errExpired : d.error === 'net' ? T.errNet : T.errCode);
    const box = root.querySelector('[data-otp]')!; box.classList.remove('bad'); void (box as HTMLElement).offsetWidth; box.classList.add('bad');
    otp.forEach((x) => (x.value = '')); otp[0].focus();
  }
  $<HTMLFormElement>('[data-step-code]').onsubmit = (e) => { e.preventDefault(); if (otp.every((x) => x.value)) verify(); };
  $('[data-change]').onclick = () => { clearInterval(timer); showStep(false); msg(''); $<HTMLInputElement>('[data-step-email] input').focus(); };
  $('[data-resend]').onclick = () => sendCode();

  /* ---------- Password (tucked away) ---------- */
  $$<HTMLButtonElement>('[data-tab]').forEach((b) => (b.onclick = () => {
    $$('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    $('[data-in]').hidden = b.dataset.tab !== 'in'; $('[data-up]').hidden = b.dataset.tab !== 'up'; msg('');
  }));
  const ERR: R = { wrong: T.errWrong, no_password: T.errNoPass, exists: T.errExists, password: T.errPass, consent: T.errConsent, email: T.errEmail, wait: T.errMany };
  $<HTMLFormElement>('[data-in]').onsubmit = async (e) => {
    e.preventDefault();
    const r = await post('/api/me/login', Object.fromEntries(new FormData(e.target as HTMLFormElement))).catch(() => null); const d = r ? await r.json().catch(() => ({})) : {};
    if (r?.ok) { msg(''); load(); } else msg(r ? ERR[d.error] || T.errWrong : T.errNet);
  };
  $<HTMLFormElement>('[data-up]').onsubmit = async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const r = await post('/api/me/register', { ...Object.fromEntries(fd), consent: fd.has('consent'), marketing: fd.has('marketing') }).catch(() => null); const d = r ? await r.json().catch(() => ({})) : {};
    if (r?.ok) { msg(''); load(); } else msg(r ? ERR[d.error] || T.errEmail : T.errNet);
  };

  /* ---------- Signed-in actions ---------- */
  $<HTMLFormElement>('[data-profile]').onsubmit = async (e) => {
    e.preventDefault();
    await post('/api/me/profile', Object.fromEntries(new FormData(e.target as HTMLFormElement)));
    $('[data-profile]').hidden = true; load();
  };
  $<HTMLFormElement>('[data-vcode]').onsubmit = async (e) => {
    e.preventDefault();
    const inp = $<HTMLInputElement>('[data-vcode] input');
    const r = await post('/api/me/verify', { email: D.me?.email, code: inp.value });
    const d = await r.json().catch(() => ({}));
    if (r.ok) { $('[data-vcode]').hidden = true; load(); } else $('[data-vcode-p]').textContent = d.error === 'expired' ? T.errExpired : T.errCode;
  };
  $<HTMLInputElement>('[data-vcode] input').addEventListener('input', (e) => { const i = e.target as HTMLInputElement; i.value = i.value.replace(/\D/g, '').slice(0, 6); if (i.value.length === 6) $<HTMLFormElement>('[data-vcode]').requestSubmit(); });
  $<HTMLInputElement>('[data-news]').onchange = (e) => { post('/api/me/marketing', { on: (e.target as HTMLInputElement).checked }); };
  $('[data-del]').onclick = async () => { if (!confirm(T.delQ)) return; await fetch('/api/me/delete', { method: 'POST' }); location.href = location.pathname; };
  $('[data-out]').onclick = async () => { await fetch('/api/me/logout', { method: 'POST' }); location.href = location.pathname; };
  window.addEventListener('vx:biz', () => load());
  load();
</script>

<style is:global>
.cab { --r: 24px; --sh: 0 1px 0 color-mix(in srgb, var(--ink) 4%, transparent), 0 24px 48px -32px color-mix(in srgb, var(--ink) 35%, transparent); position: relative; max-width: 1120px; margin: 0 auto; padding: 116px 16px 72px; display: flex; flex-direction: column; gap: 22px; overflow-x: clip; }
