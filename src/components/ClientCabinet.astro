.cab .sec-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-bottom: 14px; } .cab .sec-head p { margin: 0; }

/* buttons */
.cab .cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; background: var(--acc); color: var(--dark-ink); font: 700 15px var(--font); padding: 12px 20px; border-radius: 999px; cursor: pointer; text-decoration: none; transition: transform .2s, box-shadow .2s, filter .2s; }
