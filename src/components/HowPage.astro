    grow: [['Клієнти запрошують друзів', 'Друг отримує подарунковий місяць після оплати, ви — +1 місяць вашого тарифу. Подарунок — знижка на наш сервіс, не гроші.', 'Ваше посилання-запрошення', '/app/'], ['Партнери заробляють', '50% першої оплати та 30% кожної наступної, поки клієнт платить. 18+, виплати після оплати клієнта.', 'Стати партнером', '/partners/'], ['Подарунки та інструменти', 'Безкоштовні калькулятори, магазин готових шаблонів і ШІ-наборів.', 'Безкоштовні інструменти', '/tools/']],
    trustH: 'Що ми обіцяємо — і чого не обіцяємо',
    trust: ['Ваші акаунти, сайт і дані лишаються на ваше ім’я.', 'Ціна називається до початку роботи. Жодних прихованих платежів і несподіваних рахунків.', 'У кожного важливого рішення ШІ є зрозуміла причина, про яку можна спитати.', 'Ми не обіцяємо того, чого не можна обіцяти, і не спамимо.', 'Живі люди підключаються, коли задачі потрібна людина.'],
  },
}[lang];
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="hw">
    <section class="hero">
      <div class="w">
        <p class="tag">{C.eyebrow}</p>
        <h1>{C.h1}</h1>
        <p class="lead">{C.sub}</p>
        <p class="lead pos">{C.pos}</p>
        <div class="row"><a class="cta" href={h('/start/')}>{C.cta1}</a><a class="ghost" href={h('/examples/')}>{C.cta2}</a></div>
      </div>
    </section>
    <section class="sec alt">
      <div class="w split">
        <h2>{C.loopH}</h2>
        <ol class="steps">{C.loop.map(([a, b], i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><div><h3>{a}</h3><p>{b}</p></div></li>)}</ol>
      </div>
    </section>
    <section class="sec">
      <div class="w split">
        <div><h2>{C.vsH}</h2><p class="note">{C.vsP}</p></div>
        <ul class="ticks">{C.vs.map(([a]) => <li>{a}</li>)}</ul>
      </div>
    </section>
    <section class="sec alt">
      <div class="w">
        <h2>{C.onlyH}</h2>
        <div class="cells">{C.only.map(([a, b]) => <div><h3>{a}</h3><p>{b}</p></div>)}</div>
      </div>
    </section>
    <section class="sec">
      <div class="w">
        <h2>{C.allH}</h2>
        <p class="note">{C.allP}</p>
        <div class="cells">{C.all.map(([a, b]) => <div><h3>{a}</h3><p>{b}</p></div>)}</div>
      </div>
    </section>
    <section class="sec alt">
      <div class="w">
        <h2>{C.plansH}</h2>
        <div class="plans">{C.plans.map(([n, p, w, d]) => <div class:list={['plan', { focus: n === 'Pro' }]}><small>{w}</small><h3>{n}</h3><b>{p}</b><p>{d}</p></div>)}</div>
        <p class="note small">{C.plansNote}</p>
      </div>
    </section>
    <section class="sec">
      <div class="w">
        <h2>{C.growH}</h2>
        <div class="doors">{C.grow.map(([a, b, c, href]) => <a href={h(href)}><h3>{a}</h3><p>{b}</p><span>{c} →</span></a>)}</div>
      </div>
    </section>
    <section class="sec alt">
      <div class="w split">
        <h2>{C.trustH}</h2>
        <div><ul class="ticks">{C.trust.map((x) => <li>{x}</li>)}</ul><div class="row left"><a class="cta" href={h('/start/')}>{C.cta1}</a><a class="ghost" href={h('/score/')}>Vaxo Score →</a></div></div>
      </div>
    </section>
    <AiPluses t={t} />
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .hw { background: var(--bg); color: var(--ink); overflow-x: clip; }
  .w { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
  h1, h2, h3, p, ul, ol { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  .hero { padding: clamp(96px, 14vw, 170px) 0 clamp(72px, 10vw, 120px); text-align: center; }
  .tag { font: 500 12px/1 var(--mono, 'JetBrains Mono', monospace); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accText); margin-bottom: 18px; }
  h1 { font-weight: 600; font-size: clamp(38px, 6.4vw, 80px); line-height: 1.02; letter-spacing: -0.035em; max-width: 16ch; margin: 0 auto; }
  .lead { max-width: 620px; margin: 26px auto 0; font-size: clamp(17px, 1.7vw, 21px); line-height: 1.45; color: var(--mut); }
  h2 { font-weight: 600; font-size: clamp(30px, 4.2vw, 54px); line-height: 1.05; letter-spacing: -0.03em; }
  h3 { font-weight: 600; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; }
  .sec { padding: clamp(64px, 9vw, 116px) 0; background: var(--bg); }
  .sec.alt { background: var(--surf2); }
  .note { margin-top: 18px; max-width: 62ch; color: var(--mut); font-size: 17px; line-height: 1.5; }
  .note.small { margin-top: 22px; font-size: 15px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 34px; }
  .row.left { justify-content: flex-start; }
  .cta, .ghost { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border-radius: 999px; font-weight: 600; text-decoration: none; }
  .cta { background: var(--acc); color: #1a1408; }
  .cta:hover { filter: brightness(1.08); }
  .ghost { border: 1px solid var(--line); color: var(--ink); }
  .ghost:hover { border-color: var(--acc); }
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 88px); align-items: start; }
  .steps li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; padding: 22px 0; border-top: 1px solid var(--line); }
  .steps li:first-child { border-top: 0; padding-top: 4px; }
  .n { font: 500 13px/1.8 var(--mono, monospace); color: var(--accText); }
  .steps p, .cells p, .doors p, .plan p { margin-top: 6px; color: var(--mut); font-size: 15.5px; line-height: 1.5; }
  .ticks { display: grid; gap: 14px; }
  .ticks li { position: relative; padding-left: 30px; font-size: 17px; line-height: 1.45; }
  .ticks li::before { content: ''; position: absolute; left: 3px; top: 5px; width: 7px; height: 12px; border: solid var(--accText); border-width: 0 2px 2px 0; transform: rotate(40deg); }
  .cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px clamp(24px, 4vw, 48px); margin-top: clamp(32px, 4vw, 52px); }
  .cells > div { padding-top: 16px; border-top: 1px solid var(--line); }
  .plans { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: clamp(32px, 4vw, 52px); }
  .plan { display: flex; flex-direction: column; padding: 20px; border: 1px solid var(--line); border-radius: 18px; background: var(--surf); }
  .plan.focus { border-color: var(--acc); }
  .plan small { font: 500 11px/1.3 var(--mono, monospace); letter-spacing: 0.05em; text-transform: uppercase; color: var(--mut); }
  .plan h3 { margin-top: 10px; }
  .plan b { margin-top: 4px; font-size: 28px; font-weight: 600; letter-spacing: -0.03em; }
  .doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: clamp(32px, 4vw, 52px); }
  .doors a { display: flex; flex-direction: column; padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--surf); color: var(--ink); text-decoration: none; transition: border-color 0.2s; }
  .doors a:hover { border-color: var(--acc); }
  .doors span { margin-top: auto; padding-top: 16px; font-weight: 600; color: var(--accText); }
  @media (max-width: 960px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } .plan:first-child { grid-column: 1 / -1; } .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .split, .doors { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .plans, .cells { grid-template-columns: minmax(0, 1fr); } .cells { gap: 24px; } .row a { width: 100%; justify-content: center; } }
  .pos { margin-top: 12px; color: var(--ink); font-weight: 500; }
</style>
