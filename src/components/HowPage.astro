// How Vaxo works (Decision 33): an AI partner that moves first — the loop, why not just a chat, the plans, partners, trust.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AiPluses from './AiPluses.astro';
import { getDict, langPath, navHref, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/how/', ua: '/ua/how/', ru: '/ru/how/' };
const h = (p: string) => navHref(p, lang, home);

const C = {
  en: {
