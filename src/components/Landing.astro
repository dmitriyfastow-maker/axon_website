---
// Home page shell: header, the one-path home (Home.astro), footer. Old sections (Hero, Method, Platform, Compare,
// Pricing, GrowthPlans, Services, Faq, Contact) were retired 01.11.2026 — they repeated each other and confused people.
import { getDict, type Lang } from '../i18n';
import Header from './Header.astro';
import Home from './Home.astro';
import Footer from './Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---

<Header lang={lang} t={t} />
<Home lang={lang} />
<Footer t={t} lang={lang} />
