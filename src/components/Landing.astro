---
import { getDict, type Lang } from '../i18n';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Method from './Method.astro';
import Cases from './Cases.astro';
import Pricing from './Pricing.astro';
import GrowthPlans from './GrowthPlans.astro';
import Compare from './Compare.astro';
import EcoShowcase from './EcoShowcase.astro';
import Services from './Services.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import StickyCta from './StickyCta.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---

<Header lang={lang} t={t} />
<main>
  <Hero t={t} />
  <Method t={t} lang={lang} />
  <Compare lang={lang} />
  <EcoShowcase lang={lang} />
  <Cases t={t} />
  <Pricing t={t} />
  <GrowthPlans lang={lang} />
  <Services t={t} lang={lang} />
  <Faq t={t} />
  <Contact t={t} lang={lang} />
</main>
<Footer t={t} lang={lang} />
<StickyCta t={t} />

