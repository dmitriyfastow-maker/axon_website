---
// Home page shell: header, the one-path home (Home.astro), footer. Old sections (Hero, Method, Platform, Compare,
// Pricing, GrowthPlans, Services, Faq, Contact) were retired 01.11.2026 — they repeated each other and confused people.
import { getDict, type Lang } from '../i18n';
import Header from './Header.astro';
import Home from './Home.astro';
import Footer from './Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---

<!-- The home page is one dark surface whatever the visitor's theme is (Dmitry, 07.11). -->
<div class="mono" data-theme="dark">
  <Header lang={lang} t={t} />
  <Home lang={lang} />
  <Footer t={t} lang={lang} />
</div>

<style>
  .mono { --bg: #0d0c0a; --surf: #1c1a15; --surf2: #14120e; --line: rgba(255, 255, 255, 0.08); --deep: #14120e; background: #0d0c0a; color: #f5f1e8; }
  .mono :global([data-theme-toggle]) { display: none; }
</style>
