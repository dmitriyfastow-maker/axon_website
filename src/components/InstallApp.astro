---
// "Install the app" chip: Android / desktop Chrome use the browser's install prompt, iPhone gets a two-step hint.
interface Props { lang: 'en' | 'ru' | 'ua' }
const { lang } = Astro.props;
const T = {
  en: { install: 'Install the app', ios: 'Tap Share, then “Add to Home Screen”', close: 'Close' },
  ru: { install: 'Установить приложение', ios: 'Нажмите «Поделиться», затем «На экран Домой»', close: 'Закрыть' },
  ua: { install: 'Встановити застосунок', ios: 'Натисніть «Поділитися», потім «На початковий екран»', close: 'Закрити' },
}[lang];
---

<div class="vx-install" data-install hidden>
  <button type="button" class="vx-i-btn" data-install-go>{T.install}</button>
  <span class="vx-i-ios" data-install-ios hidden>{T.ios}</span>
  <button type="button" class="vx-i-x" data-install-x aria-label={T.close}>×</button>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-install]');
  if (box && !location.pathname.startsWith('/admin') && !location.pathname.startsWith('/fin')) {
    const key = 'vx-install-off';
    let off = false;
    try { off = localStorage.getItem(key) === '1'; } catch {}
    const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    let ev: any = null;
    const go = box.querySelector<HTMLButtonElement>('[data-install-go]')!;
    const ios = box.querySelector<HTMLElement>('[data-install-ios]')!;
    const show = () => { if (!off && !standalone) box.hidden = false; };
    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); ev = e; setTimeout(show, 8000); });
    window.addEventListener('appinstalled', () => { box.hidden = true; });
    if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !standalone) { go.hidden = true; ios.hidden = false; setTimeout(show, 12000); }
    go.addEventListener('click', async () => { if (!ev) return; ev.prompt(); await ev.userChoice.catch(() => {}); ev = null; box.hidden = true; });
    box.querySelector('[data-install-x]')!.addEventListener('click', () => { box.hidden = true; try { localStorage.setItem(key, '1'); } catch {} });
  }
</script>

<style>
  .vx-install { position: fixed; left: 12px; bottom: 12px; z-index: 60; display: flex; align-items: center; gap: 8px; background: var(--surf); color: var(--ink); border: 1px solid var(--line); border-radius: 16px; padding: 8px 8px 8px 12px; box-shadow: 0 12px 34px -12px rgba(0, 0, 0, .35); max-width: calc(100vw - 24px); }
  .vx-install[hidden] { display: none; }
  .vx-i-btn { background: var(--acc); color: var(--dark-ink, #111); border: 0; border-radius: 12px; font-weight: 700; padding: 10px 14px; cursor: pointer; min-height: 40px; }
  .vx-i-ios { font-size: 14px; line-height: 1.3; }
  .vx-i-x { background: transparent; border: 0; color: var(--mut); font-size: 22px; line-height: 1; cursor: pointer; width: 36px; height: 36px; }
</style>
