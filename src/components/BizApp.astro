---
// Owner app inside the client cabinet (Decision 29): the client's own business — visitors, sources, actions, requests
// from their site, team with roles, an AI assistant, and the one line of code that connects any site. Data: /api/biz.
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  en: {
    h: 'Your business in Vaxo', sub: 'Everything your website brings, in one place: who comes, from where, what they do and every request. Your team works here too.',
    soon: 'Your business dashboard switches on in the next few days. Nothing to do on your side.',
    newH: 'Connect your website — one line of code', newP: 'Already have a site (Wix, WordPress, Shopify, anything)? Add one line and every visit and request appears here. No site yet — we build it, and it is connected from day one.',
    name: 'Business name', domain: 'Website address (e.g. mybakery.com)', create: 'Connect', days: { 1: 'Today', 7: '7 days', 30: '30 days', 90: '90 days' },
    k: ['Visitors', 'Requests', 'Conversion', 'Calls & messages'], kHint: ['people on your site', 'forms sent', 'visitors who left a request', 'taps on phone, WhatsApp, Telegram, buttons'],
    sources: 'Where people come from', pages: 'Most visited pages', actions: 'What people do', leadSrc: 'Requests by source', empty: 'No data yet',
    leads: 'Requests', noLeads: 'No requests yet. As soon as someone fills in a form on your site, it appears here — and the team sees it too.',
    st: { new: 'New', work: 'In progress', won: 'Client', lost: 'Lost' }, assign: 'Assign', nobody: 'Nobody', addLead: 'Add a request by hand', lName: 'Name', lContact: 'Phone or email', lMsg: 'What they need', add: 'Add',
    brief: ['Morning plan from AI', 'Today’s result from AI'], ai: 'AI assistant', aiP: 'Ask about your numbers: why there are few requests, which channel works, what to do this week.', aiQ: 'e.g. What should I do this week to get more requests?', ask: 'Ask', thinking: 'Thinking…',
    team: 'Team and roles', teamP: 'Add an employee by email. They sign in at vaxogroup.com/app with a code from that email and see only their part.', roles: { manager: 'Manager — requests and numbers', viewer: 'Viewer — numbers only' }, invite: 'Add', remove: 'Remove', you: 'You — owner',
    set: 'Settings and code', code: 'Put this line before </head> on every page of your site — or just send it to Vax in your project chat and we do it for you.', copy: 'Copy', copied: 'Copied ✓',
    about: 'About your business: services, prices, hours, area. The AI chat on your site answers from this text — fill it in and the chat switches on.', save: 'Save', saved: 'Saved ✓', roleIs: 'Your role',
    roleName: { owner: 'Owner', manager: 'Manager', viewer: 'Viewer' }, more: 'Need something more — booking, payments, an app? Tell Vax in the project chat.',
  },
  ru: {
    h: 'Ваш бизнес в Vaxo', sub: 'Всё, что приносит ваш сайт, в одном месте: кто приходит, откуда, что делает, и каждая заявка. Здесь же работает ваша команда.',
    soon: 'Пульт вашего бизнеса включается в ближайшие дни. С вашей стороны ничего делать не нужно.',
    newH: 'Подключите свой сайт — одна строка кода', newP: 'Уже есть сайт (Wix, WordPress, Tilda, Shopify — любой)? Добавьте одну строку, и каждый визит и каждая заявка появятся здесь. Сайта нет — сделаем, и он подключён с первого дня.',
    name: 'Название бизнеса', domain: 'Адрес сайта (например, mybakery.com)', create: 'Подключить', days: { 1: 'Сегодня', 7: '7 дней', 30: '30 дней', 90: '90 дней' },
    k: ['Посетители', 'Заявки', 'Конверсия', 'Звонки и сообщения'], kHint: ['людей на сайте', 'отправленных форм', 'посетителей оставили заявку', 'нажатия на телефон, WhatsApp, Telegram, кнопки'],
    sources: 'Откуда приходят', pages: 'Самые популярные страницы', actions: 'Что делают люди', leadSrc: 'Заявки по источникам', empty: 'Пока нет данных',
    leads: 'Заявки', noLeads: 'Заявок пока нет. Как только кто-то заполнит форму на вашем сайте, она появится здесь — и её увидит команда.',
    st: { new: 'Новая', work: 'В работе', won: 'Клиент', lost: 'Отказ' }, assign: 'Ответственный', nobody: 'Никто', addLead: 'Добавить заявку вручную', lName: 'Имя', lContact: 'Телефон или email', lMsg: 'Что нужно', add: 'Добавить',
    brief: ['Утренний план от ИИ', 'Итог дня от ИИ'], ai: 'ИИ-помощник', aiP: 'Спросите про свои цифры: почему мало заявок, какой канал работает, что сделать на этой неделе.', aiQ: 'Например: что сделать на этой неделе, чтобы заявок стало больше?', ask: 'Спросить', thinking: 'Думаю…',
    team: 'Команда и роли', teamP: 'Добавьте сотрудника по email. Он входит на vaxogroup.com/app по коду из этой почты и видит только своё.', roles: { manager: 'Менеджер — заявки и цифры', viewer: 'Наблюдатель — только цифры' }, invite: 'Добавить', remove: 'Убрать', you: 'Вы — владелец',
    set: 'Настройки и код', code: 'Вставьте эту строку перед </head> на всех страницах сайта — или просто отправьте её Vax в чате проекта, и мы всё сделаем за вас.', copy: 'Копировать', copied: 'Скопировано ✓',
    about: 'О бизнесе: услуги, цены, часы работы, район. По этому тексту отвечает ИИ-чат на вашем сайте — заполните, и чат включится.', save: 'Сохранить', saved: 'Сохранено ✓', roleIs: 'Ваша роль',
    roleName: { owner: 'Владелец', manager: 'Менеджер', viewer: 'Наблюдатель' }, more: 'Нужно больше — запись, оплата, приложение? Напишите Vax в чате проекта.',
  },
  ua: {
    h: 'Ваш бізнес у Vaxo', sub: 'Усе, що приносить ваш сайт, в одному місці: хто приходить, звідки, що робить, і кожна заявка. Тут же працює ваша команда.',
    soon: 'Пульт вашого бізнесу вмикається найближчими днями. З вашого боку нічого робити не треба.',
    newH: 'Підключіть свій сайт — один рядок коду', newP: 'Уже є сайт (Wix, WordPress, Tilda, Shopify — будь-який)? Додайте один рядок, і кожен візит і кожна заявка зʼявляться тут. Сайту немає — зробимо, і він підключений з першого дня.',
    name: 'Назва бізнесу', domain: 'Адреса сайту (наприклад, mybakery.com)', create: 'Підключити', days: { 1: 'Сьогодні', 7: '7 днів', 30: '30 днів', 90: '90 днів' },
    k: ['Відвідувачі', 'Заявки', 'Конверсія', 'Дзвінки й повідомлення'], kHint: ['людей на сайті', 'надісланих форм', 'відвідувачів залишили заявку', 'натискання на телефон, WhatsApp, Telegram, кнопки'],
    sources: 'Звідки приходять', pages: 'Найпопулярніші сторінки', actions: 'Що роблять люди', leadSrc: 'Заявки за джерелами', empty: 'Поки немає даних',
    leads: 'Заявки', noLeads: 'Заявок поки немає. Щойно хтось заповнить форму на вашому сайті, вона зʼявиться тут — і її побачить команда.',
    st: { new: 'Нова', work: 'У роботі', won: 'Клієнт', lost: 'Відмова' }, assign: 'Відповідальний', nobody: 'Ніхто', addLead: 'Додати заявку вручну', lName: 'Імʼя', lContact: 'Телефон або email', lMsg: 'Що потрібно', add: 'Додати',
    brief: ['Ранковий план від ШІ', 'Підсумок дня від ШІ'], ai: 'ШІ-помічник', aiP: 'Запитайте про свої цифри: чому мало заявок, який канал працює, що зробити цього тижня.', aiQ: 'Наприклад: що зробити цього тижня, щоб заявок стало більше?', ask: 'Запитати', thinking: 'Думаю…',
    team: 'Команда і ролі', teamP: 'Додайте працівника за email. Він входить на vaxogroup.com/app за кодом з цієї пошти і бачить лише своє.', roles: { manager: 'Менеджер — заявки й цифри', viewer: 'Спостерігач — лише цифри' }, invite: 'Додати', remove: 'Прибрати', you: 'Ви — власник',
    set: 'Налаштування і код', code: 'Вставте цей рядок перед </head> на всіх сторінках сайту — або просто надішліть його Vax у чаті проєкту, і ми все зробимо за вас.', copy: 'Копіювати', copied: 'Скопійовано ✓',
    about: 'Про бізнес: послуги, ціни, години роботи, район. За цим текстом відповідає ШІ-чат на вашому сайті — заповніть, і чат увімкнеться.', save: 'Зберегти', saved: 'Збережено ✓', roleIs: 'Ваша роль',
    roleName: { owner: 'Власник', manager: 'Менеджер', viewer: 'Спостерігач' }, more: 'Потрібно більше — запис, оплата, застосунок? Напишіть Vax у чаті проєкту.',
  },
}[lang];
const X = {
  en: { remind: 'Every morning at 9:00 we email you what is due.', imp: 'Upload from a table (CSV)', impDone: 'Added: {n}',  refRate: 'Partners’ reward, % of each deal (people sign up at your-site/partner)',  board: 'Board', list: 'List', today: 'Today', todayNone: 'Nothing due today — good.', open: 'Open', hist: 'History', comment: 'Add a comment…', add: 'Add', aiNext: '✦ Next step and a message from AI', aiWait: 'Thinking…', copyMsg: 'Copy the message', drag: 'Drag cards between columns', amt: 'Deal amount', nextS: 'Next step date', due: 'next step today', over: 'next step overdue', sumWon: 'Won', sumOpen: 'In progress', all: 'All', find: 'Search by name, contact or text', note: 'Note: what was agreed, next step', noteSave: 'Save note', call: 'Call', mail: 'Email', wa: 'WhatsApp', tg: 'Telegram', csv: 'Download CSV', conv: 'Became clients', noMatch: 'Nothing found for this filter.', stale: 'waiting over a day' },
  ru: { remind: 'Каждое утро в 9:00 пришлём письмо: что сегодня сделать.', imp: 'Загрузить из таблицы (CSV)', impDone: 'Добавлено: {n}',  refRate: 'Вознаграждение партнёрам, % от сделки (партнёры регистрируются на ваш-сайт/partner)',  board: 'Доска', list: 'Список', today: 'Сегодня', todayNone: 'На сегодня ничего не горит — отлично.', open: 'Открыть', hist: 'История', comment: 'Добавить комментарий…', add: 'Добавить', aiNext: '✦ Следующий шаг и сообщение от ИИ', aiWait: 'Думаю…', copyMsg: 'Скопировать сообщение', drag: 'Перетаскивайте карточки между колонками', amt: 'Сумма сделки', nextS: 'Дата следующего шага', due: 'шаг сегодня', over: 'шаг просрочен', sumWon: 'Заработано', sumOpen: 'В работе', all: 'Все', find: 'Поиск по имени, контакту или тексту', note: 'Заметка: о чём договорились, следующий шаг', noteSave: 'Сохранить заметку', call: 'Позвонить', mail: 'Письмо', wa: 'WhatsApp', tg: 'Telegram', csv: 'Скачать CSV', conv: 'Стали клиентами', noMatch: 'По этому фильтру ничего нет.', stale: 'ждёт больше суток' },
  ua: { remind: 'Щоранку о 9:00 надішлемо лист: що сьогодні зробити.', imp: 'Завантажити з таблиці (CSV)', impDone: 'Додано: {n}',  refRate: 'Винагорода партнерам, % від угоди (партнери реєструються на ваш-сайт/partner)',  board: 'Дошка', list: 'Список', today: 'Сьогодні', todayNone: 'На сьогодні нічого не горить — чудово.', open: 'Відкрити', hist: 'Історія', comment: 'Додати коментар…', add: 'Додати', aiNext: '✦ Наступний крок і повідомлення від ШІ', aiWait: 'Думаю…', copyMsg: 'Скопіювати повідомлення', drag: 'Перетягуйте картки між колонками', amt: 'Сума угоди', nextS: 'Дата наступного кроку', due: 'крок сьогодні', over: 'крок прострочено', sumWon: 'Зароблено', sumOpen: 'У роботі', all: 'Усі', find: 'Пошук за імʼям, контактом або текстом', note: 'Нотатка: про що домовились, наступний крок', noteSave: 'Зберегти нотатку', call: 'Подзвонити', mail: 'Лист', wa: 'WhatsApp', tg: 'Telegram', csv: 'Завантажити CSV', conv: 'Стали клієнтами', noMatch: 'За цим фільтром нічого немає.', stale: 'чекає понад добу' },
}[lang];
---

<section class="biz" data-biz hidden>
  <script type="application/json" data-biz-t set:html={JSON.stringify({ ...T, ...X, lang })} />
  <div class="head">
    <div class="head-txt"><span class="biz-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><rect x="5" y="11" width="3" height="6" rx="1"/><rect x="10.5" y="7" width="3" height="10" rx="1"/><rect x="16" y="4" width="3" height="13" rx="1"/></svg></span><div><p class="eyebrow">Vaxo App</p><h2>{T.h}</h2><p class="mut">{T.sub}</p></div></div>
    <div class="ctl">
      <select data-biz-pick hidden></select>
      <div class="seg" data-days>{[1, 7, 30, 90].map((d) => <button type="button" data-d={d} aria-pressed={d === 7 ? 'true' : 'false'}>{(T.days as Record<number, string>)[d]}</button>)}</div>
    </div>
  </div>
  <p class="card mut" data-biz-soon hidden>{T.soon}</p>

  <form class="card new" data-biz-new hidden>
    <img src="/mascot/vax-allinone.webp" alt="" width="402" height="520" loading="lazy" />
    <div class="new-txt">
    <h3>{T.newH}</h3>
    <p class="mut">{T.newP}</p>
    <div class="row"><input name="name" required maxlength="80" placeholder={T.name} /><input name="domain" maxlength="120" placeholder={T.domain} /><button class="cta">{T.create}</button></div>
    </div>
  </form>

  <div data-biz-main hidden>
    <p class="mut small" data-role></p>
    <div class="card brief" data-brief hidden><h3 data-brief-h></h3><p data-brief-t></p></div>
    <div class="kpi" data-kpi></div>
    <div class="card"><div class="bars" data-bars></div></div>
    <div class="grid4" data-lists></div>

    <div class="card" data-leads-box>
      <div class="lh"><h3>{T.leads}</h3><button type="button" class="ghost" data-csv>{X.csv}</button></div>
      <div class="funnel" data-funnel></div>
      <div class="today" data-today></div>
      <div class="vsw" data-vsw><button type="button" data-v="board" aria-pressed="true"></button><button type="button" data-v="list" aria-pressed="false"></button><small class="mut" data-drag></small></div>
      <div class="kb" data-kb></div>
      <input class="lfind" type="search" maxlength="80" data-lfind placeholder={X.find} />
      <div data-leads></div>
      <label class="ghost imp">📄 {X.imp}<input type="file" accept=".csv,text/csv" data-imp hidden /></label> <small class="mut" data-imp-msg></small>
      <details><summary>{T.addLead}</summary>
        <form class="row" data-lead-add><input name="name" maxlength="80" placeholder={T.lName} /><input name="contact" maxlength="120" placeholder={T.lContact} /><input name="message" maxlength="500" placeholder={T.lMsg} /><button class="cta">{T.add}</button></form>
      </details>
    </div>

    <dialog class="ld" data-ld>
      <header><b data-ld-h></b><button type="button" data-ld-x>×</button></header>
      <div class="ld-b">
        <p class="mut small" data-ld-meta></p>
        <p data-ld-msg></p>
        <button type="button" class="cta" data-ld-ai></button>
        <pre class="ld-ai" data-ld-out hidden></pre>
        <button type="button" class="ghost" data-ld-copy hidden></button>
        <h4 data-ld-hh></h4>
        <form class="row" data-ld-form><input name="t" maxlength="1000" /><button class="ghost"></button></form>
        <ul class="ld-h" data-ld-list></ul>
      </div>
    </dialog>

    <form class="card ai" data-ai>
      <h3><span class="ai-dot" aria-hidden="true"></span>{T.ai}</h3>
      <p class="mut small">{T.aiP}</p>
      <div class="row"><input name="q" maxlength="500" required placeholder={T.aiQ} /><button class="cta">{T.ask}</button></div>
      <p class="ans" data-ans></p>
    </form>

    <div class="card" data-owner hidden>
      <h3>{T.team}</h3>
      <p class="mut small">{T.teamP}</p>
      <ul class="team" data-team></ul>
      <form class="row" data-team-add><input type="email" name="email" required placeholder="email" /><select name="role"><option value="manager">{T.roles.manager}</option><option value="viewer">{T.roles.viewer}</option></select><button class="cta">{T.invite}</button></form>
    </div>

    <form class="card" data-owner data-settings hidden>
      <h3>{T.set}</h3>
      <p class="mut small">{T.code}</p>
      <div class="row"><code data-code></code><button type="button" class="ghost" data-copy>{T.copy}</button></div>
      <div class="row"><input name="name" maxlength="80" placeholder={T.name} /><input name="domain" maxlength="120" placeholder={T.domain} /></div>
      <textarea name="about" rows="3" maxlength="4000" placeholder={T.about}></textarea>
      <label class="rr"><span class="mut small">{X.refRate}</span><input type="number" name="refRate" min="0" max="50" step="0.5" /></label>
      <div class="row"><button class="cta">{T.save}</button><span class="mut small" data-saved></span></div>
    </form>
    <p class="mut small">{T.more}</p>
  </div>
</section>

<script>
  type R = Record<string, any>;
  const fmt = (n: number) => new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 }).format(n);
  const root = document.querySelector<HTMLElement>('[data-biz]')!;
  const T = JSON.parse(root.querySelector('[data-biz-t]')!.textContent!) as R;
  const q = <E extends HTMLElement = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const send = (u: string, body: R, method = 'POST') => fetch(u, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  let cur = 0, days = 7, team: R[] = [];
  const ki = (d: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
  const KI = [ki('<circle cx="12" cy="12" r="3"/><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/>'), ki('<path d="M3 13h5l1.5 3h5l1.5-3h5"/><path d="M5.5 5h13L21 13v6H3v-6z"/>'), ki('<path d="M4 19 19 4M7 7h.01M17 17h.01"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/>'), ki('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>')];

  let leads: R[] = [], isOwner = false, stage = '', term = '';
  // A contact becomes one tap: phone → call and WhatsApp, email → letter, @nick → Telegram.
  const reach = (c: string) => {
    const v = String(c || '').trim(), out: string[] = [];
    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) out.push(`<a href="mailto:${esc(v)}">${esc(T.mail)}</a>`);
    const digits = v.replace(/[^\d+]/g, '');
    if (!v.includes('@') && digits.replace('+', '').length >= 7) out.push(`<a href="tel:${esc(digits)}">${esc(T.call)}</a>`, `<a href="https://wa.me/${esc(digits.replace('+', ''))}" target="_blank" rel="noopener">${esc(T.wa)}</a>`);
    if (/^@[\w.]{3,}$/.test(v)) out.push(`<a href="https://t.me/${esc(v.slice(1))}" target="_blank" rel="noopener">${esc(T.tg)}</a>`);
    return out.length ? `<span class="reach">${out.join('')}</span>` : '';
  };
  function renderLeads() {
    queueMicrotask(renderBoard);
    const n = (k: string) => leads.filter((l) => l.status === k).length;
    const won = n('won'), done = won + n('lost');
    q('[data-funnel]').innerHTML = [['', T.all, leads.length], ...Object.entries(T.st).map(([k, v]) => [k, v, n(k)])]
      .map(([k, v, c]) => `<button type="button" data-stage="${k}" aria-pressed="${k === stage}"><b>${c}</b><span>${esc(v)}</span></button>`).join('')
      + (done ? `<span class="conv mut small">${esc(T.conv)}: ${Math.round((won / done) * 100)}%</span>` : '')
      + [['won', T.sumWon], ['work', T.sumOpen]].map(([k, v]) => { const sum = leads.filter((l) => l.status === k).reduce((a, l) => a + (l.amount || 0), 0); return sum ? `<span class="conv mut small">${esc(v)}: <b>${fmt(sum)}</b></span>` : ''; }).join('');
    q('[data-funnel]').hidden = q('[data-lfind]').hidden = q('[data-csv]').hidden = !leads.length;
    const t = term.toLowerCase();
    const list = leads.filter((l) => (!stage || l.status === stage) && (!t || `${l.name} ${l.contact} ${l.message} ${l.note || ''}`.toLowerCase().includes(t)));
    const opts = (sel: string) => `<option value="">${esc(T.nobody)}</option>` + team.map((m) => `<option ${m.email === sel ? 'selected' : ''}>${esc(m.email)}</option>`).join('');
    const old = (l: R) => l.status === 'new' && Date.now() - Date.parse(String(l.at).replace(' ', 'T') + 'Z') > 864e5;
    const today = new Date().toLocaleDateString('sv');
    const due = (l: R) => !l.next || l.status === 'won' || l.status === 'lost' ? 0 : l.next < today ? 1 : l.next === today ? -1 : 0;
    q('[data-leads]').innerHTML = !leads.length ? `<p class="mut">${esc(T.noLeads)}</p>` : !list.length ? `<p class="mut">${esc(T.noMatch)}</p>`
      : `<div class="tw"><table><tbody>${list.map((l) => `<tr data-id="${l.id}"><td class="mut small">${esc(String(l.at).slice(5, 16))}<br>${esc(l.source || '')}${old(l) ? `<br><span class="late">${esc(T.stale)}</span>` : ''}${due(l) ? `<br><span class="late">${esc(due(l) > 0 ? T.over : T.due)}</span>` : ''}</td><td><b>${esc(l.name || '—')}</b><br>${esc(l.contact || '')}${reach(l.contact)}</td><td>${esc(l.message || '')}${l.amount ? `<br><b class="lamt">${fmt(l.amount)}</b>` : ''}<details class="lnote"${l.note || l.amount || l.next ? ' open' : ''}><summary>${esc(T.note)}</summary><textarea maxlength="1000" rows="2" data-note>${esc(l.note || '')}</textarea><span class="lmeta"><label>${esc(T.amt)}<input type="number" min="0" step="any" inputmode="decimal" data-amt value="${l.amount ?? ''}"></label><label>${esc(T.nextS)}<input type="date" data-next value="${esc(l.next || '')}"></label></span><button type="button" class="ghost" data-note-save>${esc(T.noteSave)}</button></details></td><td><select data-st>${Object.entries(T.st).map(([k, v]) => `<option value="${k}" ${k === l.status ? 'selected' : ''}>${esc(v)}</option>`).join('')}</select>${isOwner && team.length ? `<select data-as title="${esc(T.assign)}">${opts(l.assignee)}</select>` : ''}</td></tr>`).join('')}</tbody></table></div>`;
    root.querySelectorAll<HTMLSelectElement>('[data-st],[data-as]').forEach((el) => (el.onchange = () => {
      const id = Number(el.closest('tr')!.dataset.id), l = leads.find((x) => x.id === id), st = el.matches('[data-st]');
      send(`/api/biz/${cur}/leads/${id}`, st ? { status: el.value } : { assignee: el.value });
      if (l) { if (st) l.status = el.value; else l.assignee = el.value; }
      if (st) renderLeads();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-note-save]').forEach((b) => (b.onclick = async () => {
      const tr = b.closest('tr')!, id = Number(tr.dataset.id), note = tr.querySelector<HTMLTextAreaElement>('[data-note]')!.value;
      const av = tr.querySelector<HTMLInputElement>('[data-amt]')!.value, next = tr.querySelector<HTMLInputElement>('[data-next]')!.value;
      const amount = av && Number(av) > 0 ? Number(av) : null;
      if ((await send(`/api/biz/${cur}/leads/${id}`, { note, amount, next })).ok) { const l = leads.find((x) => x.id === id); if (l) Object.assign(l, { note, amount, next: next || null }); renderLeads(); }
    }));
  }

  /* ---------- Board (kanban), today, the lead card ---------- */
  let view = (() => { try { return localStorage.getItem('vx_biz_view') || 'board'; } catch { return 'board'; } })();
  function renderBoard() {
    const kb = q('[data-kb]'), sw = q('[data-vsw]');
    sw.hidden = !leads.length;
    sw.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((b) => { b.textContent = T[b.dataset.v!]; b.setAttribute('aria-pressed', String(b.dataset.v === view)); b.onclick = () => { view = b.dataset.v!; try { localStorage.setItem('vx_biz_view', view); } catch {} renderLeads(); }; });
    q('[data-drag]').textContent = view === 'board' ? T.drag : '';
    const board = view === 'board' && leads.length > 0;
    kb.hidden = !board; q('[data-leads]').hidden = board;
    // Today: next steps due today or late
    const today = new Date().toLocaleDateString('sv');
    const hot = leads.filter((l) => l.next && l.next <= today && l.status !== 'won' && l.status !== 'lost');
    q('[data-today]').innerHTML = leads.length ? `<b>☀ ${esc(T.today)}</b>` + (hot.length ? hot.map((l) => `<button type="button" data-open="${l.id}" class="${l.next < today ? 'late' : ''}">${esc(l.name || l.contact || '#' + l.id)}</button>`).join('') : `<span class="mut small">${esc(T.todayNone)}</span>`) + `<span class="mut small" style="margin-left:auto">✉ ${esc(T.remind)}</span>` : '';
    if (board) {
      const t = term.toLowerCase();
      kb.innerHTML = Object.entries(T.st as R).map(([k, v]) => {
        const col = leads.filter((l) => l.status === k && (!t || `${l.name} ${l.contact} ${l.message} ${l.note || ''}`.toLowerCase().includes(t)));
        const sum = col.reduce((a, l) => a + (l.amount || 0), 0);
        return `<div class="kc" data-col="${k}"><h5>${esc(v)} <span>${col.length}</span>${sum ? `<em>${fmt(sum)}</em>` : ''}</h5>${col.map((l) => `<article draggable="true" data-card="${l.id}"><b>${esc(l.name || l.contact || '#' + l.id)}</b><small>${esc((l.message || '').slice(0, 80))}</small><span>${esc(String(l.at).slice(5, 10))} · ${esc(l.source || '')}${l.amount ? ` · ${fmt(l.amount)}` : ''}${l.next ? ` · ⏰ ${esc(l.next)}` : ''}</span></article>`).join('')}</div>`;
      }).join('');
      kb.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => {
        c.ondragstart = (e) => e.dataTransfer?.setData('text/lead', c.dataset.card!);
        c.onclick = () => openLead(Number(c.dataset.card));
      });
      kb.querySelectorAll<HTMLElement>('[data-col]').forEach((col) => {
        col.ondragover = (e) => { e.preventDefault(); col.classList.add('over'); };
        col.ondragleave = () => col.classList.remove('over');
        col.ondrop = (e) => {
          e.preventDefault(); col.classList.remove('over');
          const id = Number(e.dataTransfer?.getData('text/lead')), l = leads.find((x) => x.id === id), st = col.dataset.col!;
          if (!l || l.status === st) return;
          l.status = st; send(`/api/biz/${cur}/leads/${id}`, { status: st }); renderLeads();
        };
      });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => (b.onclick = () => openLead(Number(b.dataset.open))));
  }
  async function openLead(id: number) {
    const l = leads.find((x) => x.id === id); if (!l) return;
    const d = q<HTMLDialogElement>('[data-ld]');
    q('[data-ld-h]').textContent = l.name || l.contact || '#' + id;
    q('[data-ld-meta]').innerHTML = `${esc(String(l.at).slice(0, 16))} · ${esc(l.source || '')} · ${esc(T.st[l.status] || l.status)}${l.amount ? ' · ' + fmt(l.amount) : ''}${l.contact ? ' · ' + esc(l.contact) + ' ' + reach(l.contact) : ''}`;
    q('[data-ld-msg]').textContent = l.message || '';
    const ai = q<HTMLButtonElement>('[data-ld-ai]'), out = q('[data-ld-out]'), cp = q<HTMLButtonElement>('[data-ld-copy]');
    ai.textContent = T.aiNext; out.hidden = true; cp.hidden = true; cp.textContent = T.copyMsg;
    ai.onclick = async () => {
      ai.disabled = true; ai.textContent = T.aiWait;
      const r = await send(`/api/biz/${cur}/leads/${id}/next`, { lang: T.lang }).then((x) => x.json()).catch(() => null);
      ai.disabled = false; ai.textContent = T.aiNext;
      if (r?.text) { out.textContent = r.text; out.hidden = false; const m = r.text.split(/MESSAGE:|ПОВІДОМЛЕННЯ:|СООБЩЕНИЕ:/i)[1]; if (m) { cp.hidden = false; cp.onclick = () => navigator.clipboard.writeText(m.trim()).catch(() => {}); } }
    };
    q('[data-ld-hh]').textContent = T.hist;
    const f = q<HTMLFormElement>('[data-ld-form]'), inp = f.querySelector('input')!;
    inp.placeholder = T.comment; f.querySelector('button')!.textContent = T.add;
    const draw = (items: R[]) => { q('[data-ld-list]').innerHTML = items.map((x) => `<li><small class="mut">${esc(String(x.at).slice(5, 16))} · ${esc(x.who || '')}</small><span>${esc(x.text)}</span></li>`).join(''); };
    f.onsubmit = async (e) => { e.preventDefault(); const t = inp.value.trim(); if (!t) return; inp.value = ''; const r = await send(`/api/biz/${cur}/leads/${id}/activity`, { text: t }).then((x) => x.json()).catch(() => null); if (r?.ok) draw(r.items); };
    draw([]);
    fetch(`/api/biz/${cur}/leads/${id}/activity`).then((x) => x.json()).then((r) => r?.ok && draw(r.items)).catch(() => {});
    q('[data-ld-x]').onclick = () => d.close();
    d.showModal();
  }

  let booting = false;
  async function boot() {
    booting = true;
    const r = await fetch('/api/biz').catch(() => null);
    booting = false;
    if (!r || r.status === 401) return; // not signed in — the cabinet shows the sign-in
    root.hidden = false;
    if (r.status === 503) { q('[data-biz-soon]').hidden = false; q('[data-days]').hidden = true; return; }
    const d = await r.json();
    const list = d.list as R[];
    if (!list.length) { q('[data-biz-new]').hidden = false; q('[data-days]').hidden = true; return; }
    const pick = q<HTMLSelectElement>('[data-biz-pick]');
    pick.innerHTML = list.map((b) => `<option value="${b.id}">${esc(b.name)}</option>`).join('');
    pick.hidden = list.length < 2;
    pick.onchange = () => { cur = Number(pick.value); load(); brief(); };
    cur = cur && list.some((b) => b.id === cur) ? cur : list[0].id;
    pick.value = String(cur);
    load();
    brief();
  }

  const listCard = (h: string, rows: R[]) => {
    const max = Math.max(1, ...rows.map((x) => x.n));
    return `<div class="card"><h4>${esc(h)}</h4>${rows.length ? `<ul class="lst">${rows.map((x) => `<li><span>${esc(x.k || '—')}</span><b>${x.n}</b><i style="width:${Math.round((x.n / max) * 100)}%"></i></li>`).join('')}</ul>` : `<p class="mut small">${esc(T.empty)}</p>`}</div>`;
  };

  async function load() {
    const r = await fetch(`/api/biz/${cur}?days=${days}`);
    if (!r.ok) return;
    const d = await r.json();
    const s = d.stats, b = d.biz;
    team = d.team || [];
    q('[data-biz-main]').hidden = false;
    q('[data-role]').textContent = `${T.roleIs}: ${T.roleName[b.role]}${b.domain ? ' · ' + b.domain : ''}`;
    const conv = s.visits ? `${((s.leads / s.visits) * 100).toFixed(1)}%` : '—';
    q('[data-kpi]').innerHTML = [s.visits, s.leads, conv, s.clicks].map((v, i) => `<div class="card"><span class="k-ico" aria-hidden="true">${KI[i]}</span><small>${esc(T.k[i])}</small><b>${esc(v)}</b><span class="mut small">${esc(T.kHint[i])}</span></div>`).join('');
    const ld: Record<string, number> = Object.fromEntries((s.leadsByDay as R[]).map((x) => [x.d, x.n]));
    const max = Math.max(1, ...(s.byDay as R[]).map((x) => x.visits));
    q('[data-bars]').innerHTML = (s.byDay as R[]).length
      ? (s.byDay as R[]).map((x) => `<div class="bar" title="${x.d}: ${x.visits} / ${ld[x.d] || 0}"><i style="height:${Math.max(4, Math.round((x.visits / max) * 100))}%"></i>${ld[x.d] ? `<em>${ld[x.d]}</em>` : ''}<small>${x.d.slice(5)}</small></div>`).join('')
      : `<p class="mut small">${esc(T.empty)}</p>`;
    q('[data-lists]').innerHTML = listCard(T.sources, s.sources) + listCard(T.pages, s.pages) + listCard(T.actions, s.actions) + listCard(T.leadSrc, s.leadSources);

    const owner = b.role === 'owner';
    q('[data-leads-box]').hidden = b.role === 'viewer';
    leads = d.leads as R[]; isOwner = owner;
    renderLeads();

    root.querySelectorAll<HTMLElement>('[data-owner]').forEach((el) => (el.hidden = !owner));
    if (owner) {
      q('[data-team]').innerHTML = `<li><b>${esc(T.you)}</b></li>` + team.map((m) => `<li><span>${esc(m.email)} · ${esc(T.roles[m.role])}</span><button type="button" class="ghost" data-rm="${esc(m.email)}">${esc(T.remove)}</button></li>`).join('');
      root.querySelectorAll<HTMLButtonElement>('[data-rm]').forEach((x) => (x.onclick = async () => { await send(`/api/biz/${cur}/team`, { email: x.dataset.rm }, 'DELETE'); load(); }));
      q('[data-code]').textContent = b.code;
      const f = q<HTMLFormElement>('[data-settings]');
      (f.elements.namedItem('name') as HTMLInputElement).value = b.name || '';
      (f.elements.namedItem('domain') as HTMLInputElement).value = b.domain || '';
      (f.elements.namedItem('about') as HTMLTextAreaElement).value = b.about || '';
      (f.elements.namedItem('refRate') as HTMLInputElement).value = String(d.refRate ?? 10);
    }
  }

  // Morning plan before 15:00 local time, the day's result after; cached for an hour per business.
  async function brief() {
    const evening = new Date().getHours() >= 15;
    const ck = `vx_brief_${cur}_${evening ? 'e' : 'm'}`;
    let text = '';
    try { const c = JSON.parse(sessionStorage.getItem(ck) || 'null'); if (c && Date.now() - c.at < 3600e3) text = c.text; } catch {}
    if (!text) {
      const r = await fetch(`/api/biz/${cur}/brief?mode=${evening ? 'evening' : 'morning'}&lang=${T.lang}`).catch(() => null);
      text = r?.ok ? (await r.json()).text : '';
      if (text) try { sessionStorage.setItem(ck, JSON.stringify({ at: Date.now(), text })); } catch {}
    }
    q('[data-brief]').hidden = !text;
    q('[data-brief-h]').textContent = T.brief[evening ? 1 : 0];
    q('[data-brief-t]').textContent = text;
  }

  q('[data-funnel]').onclick = (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-stage]');
    if (b) { stage = b.dataset.stage || ''; renderLeads(); }
  };
  q<HTMLInputElement>('[data-lfind]').oninput = (e) => { term = (e.target as HTMLInputElement).value.trim(); renderLeads(); };
  q('[data-csv]').onclick = () => {
    const cell = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
    const rows = [['date', 'name', 'contact', 'message', 'source', 'status', 'assignee', 'note', 'amount', 'next_step'], ...leads.map((l) => [l.at, l.name, l.contact, l.message, l.source, T.st[l.status] || l.status, l.assignee, l.note, l.amount ?? '', l.next ?? ''])];
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob(['\ufeff' + rows.map((r) => r.map(cell).join(',')).join('\n')], { type: 'text/csv' }));
    a.download = 'requests.csv'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  };
  q('[data-days]').onclick = (e) => {
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-d]');
    if (!t) return;
    days = Number(t.dataset.d);
    root.querySelectorAll('[data-d]').forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    load();
  };
  q<HTMLFormElement>('[data-biz-new]').onsubmit = async (e) => {
    e.preventDefault();
    const r = await send('/api/biz', Object.fromEntries(new FormData(e.target as HTMLFormElement)));
    if (r.ok) { q('[data-biz-new]').hidden = true; q('[data-days]').hidden = false; boot(); window.dispatchEvent(new CustomEvent('vx:biz')); }
  };
  q<HTMLFormElement>('[data-lead-add]').onsubmit = async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    if ((await send(`/api/biz/${cur}/leads`, Object.fromEntries(new FormData(f)))).ok) { f.reset(); load(); }
  };
  q<HTMLFormElement>('[data-team-add]').onsubmit = async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    if ((await send(`/api/biz/${cur}/team`, Object.fromEntries(new FormData(f)))).ok) { f.reset(); load(); }
  };
  q<HTMLFormElement>('[data-settings]').onsubmit = async (e) => {
    e.preventDefault();
    if ((await send(`/api/biz/${cur}/settings`, Object.fromEntries(new FormData(e.target as HTMLFormElement)))).ok) { q('[data-saved]').textContent = T.saved; boot(); }
  };
  q<HTMLButtonElement>('[data-copy]').onclick = () => { navigator.clipboard.writeText(q('[data-code]').textContent || ''); q('[data-copy]').textContent = T.copied; };
  q<HTMLFormElement>('[data-ai]').onsubmit = async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const ans = q('[data-ans]');
    ans.textContent = T.thinking;
    const r = await send(`/api/biz/${cur}/ask`, { q: (f.elements.namedItem('q') as HTMLInputElement).value, lang: T.lang });
    ans.textContent = r.ok ? (await r.json()).text : '…';
  };
  // The cabinet signs the client in without a reload — then the app boots too.
  // Boots only when the Workspace opens the CRM (it fires this event): guests no longer hit /api/biz → 401 on every load.
  window.addEventListener('vx:signed-in', () => { if (root.hidden && !booting) boot(); });

  /* ---------- Import leads from a CSV table ---------- */
  q<HTMLInputElement>('[data-imp]').onchange = async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
    const text = await f.text();
    const sep = (text.split('\n')[0].match(/;/g) || []).length > (text.split('\n')[0].match(/,/g) || []).length ? ';' : ',';
    const parse = (line: string) => { const out: string[] = []; let cur2 = '', qt = false; for (const ch of line) { if (ch === '"') qt = !qt; else if (ch === sep && !qt) { out.push(cur2); cur2 = ''; } else cur2 += ch; } out.push(cur2); return out.map((x) => x.trim()); };
    const lines = text.split(/\r?\n/).filter((x) => x.trim());
    const head = parse(lines[0]).map((h) => h.toLowerCase());
    const has = head.some((h) => /name|имя|ім|contact|телефон|phone|email|почт/.test(h));
    const col = (re: RegExp, d: number) => { const i = head.findIndex((h) => re.test(h)); return i >= 0 ? i : d; };
    const ci = { name: col(/name|имя|імʼя|ім'я|клиент|клієнт/, 0), contact: col(/contact|контакт|телефон|phone|email|почт|пошт/, 1), message: col(/message|сообщ|повідом|коммент|комент|note|заметк/, 2) };
    const rows = (has ? lines.slice(1) : lines).map((l) => { const c = parse(l); return { name: c[ci.name] || '', contact: c[ci.contact] || '', message: c[ci.message] || '' }; });
    const r = await send(`/api/biz/${cur}/import`, { rows }).then((x) => x.json()).catch(() => null);
    q('[data-imp-msg]').textContent = r?.ok ? String(T.impDone).replace('{n}', String(r.n)) : '—';
    (e.target as HTMLInputElement).value = ''; load();
  };
</script>

<style is:global>
  .biz { margin: 8px 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; --r: 22px; min-width: 0; }
  .biz [data-biz-main] { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .biz .eyebrow { margin: 0 0 6px; font: 700 12px/1 var(--font); letter-spacing: .12em; text-transform: uppercase; color: var(--accText); }
  .biz h2 { margin: 0 0 6px; font-size: clamp(22px, 3vw, 30px); letter-spacing: -0.025em; }
  .biz h3 { margin: 0 0 8px; font-size: 18px; letter-spacing: -0.01em; display: flex; align-items: center; gap: 8px; }
  .biz h4 { margin: 0 0 10px; font-size: 12px; color: var(--mut); text-transform: uppercase; letter-spacing: .08em; }
  .biz .mut { color: var(--mut); }
  .biz .small { font-size: 13px; }
  .biz .card { border: 1px solid var(--line); border-radius: var(--r); background: var(--surf); padding: clamp(16px, 2.6vw, 22px); box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 4%, transparent), 0 24px 48px -36px color-mix(in srgb, var(--ink) 35%, transparent); min-width: 0; }
  .biz .head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: flex-end; }
  .biz .head-txt { display: flex; gap: 14px; align-items: flex-start; }
  .biz .biz-ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 16px; background: var(--deep); color: var(--accText); flex: none; }
  .biz .head p.mut { margin: 0; max-width: 60ch; }
  .biz .ctl { display: flex; gap: 8px; flex-wrap: wrap; }
  .biz .ctl select { padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surf); color: inherit; font: inherit; }
  .biz .seg { display: flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--surf); }
  .biz .seg button { border: 0; background: none; padding: 7px 12px; border-radius: 999px; cursor: pointer; color: var(--mut); font: 600 13px var(--font); }
  .biz .seg button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .biz .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 8px; }
  .biz .row input, .biz .row select, .biz textarea { flex: 1 1 180px; min-width: 0; padding: 11px 13px; border-radius: 14px; border: 1px solid var(--line); background: var(--bg); color: inherit; font: 16px var(--font); }
  .biz input:focus-visible, .biz select:focus-visible, .biz textarea:focus-visible { outline: none; border-color: var(--acc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--acc) 25%, transparent); }
  .biz textarea { width: 100%; box-sizing: border-box; margin-top: 8px; }
  .biz .new { display: flex; gap: 20px; align-items: center; border: 2px dashed color-mix(in srgb, var(--acc) 55%, var(--line)); background: color-mix(in srgb, var(--acc) 5%, var(--surf)); }
  .biz .new img { width: 110px; height: auto; flex: none; }
  .biz .new-txt { flex: 1; min-width: 0; } .biz .new p { margin: 0 0 6px; }
  .biz .kpi { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .biz .kpi .card { display: grid; gap: 3px; align-content: start; }
  .biz .k-ico { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 11px; background: color-mix(in srgb, var(--acc) 16%, transparent); color: var(--accText); margin-bottom: 6px; }
