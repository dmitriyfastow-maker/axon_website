---
import type { Dict } from '../i18n';
import { TIMES } from '../data/tiers';

interface Props { t: Dict }
const { t } = Astro.props;
---

<section id="top" class="hero">
  <div class="grid">
    <div class="copy">
      <div class="badge"><span class="dot"></span>{t.eyebrow}</div>
      <h1>{t.h1}</h1>
      <p class="sub">{t.sub}</p>
      <div class="actions">
        <a href="#contact" class="btn-primary">{t.cta1} <span>→</span></a>
        <a href="#pricing" class="btn-secondary">{t.cta2}</a>
      </div>
      <div class="tags">
        {t.heroTags.map((h) => <span><span class="check">✓</span>{h}</span>)}
      </div>
    </div>
    <div class="cascade">
      {
        t.layers.map((ly, i) => (
          <a href="#pricing" class={`step step--${i}`} data-hero-tier={i}>
            <div class="step-head">
              <span class="step-n">{ly.n}</span>
              <span class="step-time">{`${TIMES[i]} ${t.time[i]}`}</span>
            </div>
            <div class="step-t">{ly.t}</div>
            <div class="step-d">{ly.d}</div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 112px) clamp(20px, 4vw, 40px) clamp(56px, 7vw, 96px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 16px;
    line-height: 1.5;
    background: var(--surf);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accText);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acc);
    flex: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(50px, 7vw, 100px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    text-wrap: balance;
  }
  .sub {
    margin: 0;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.6;
    color: var(--mut);
    max-width: 560px;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    background: var(--acc);
    color: var(--dark-ink);
    padding: 18px 30px;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 600;
    transition: transform 0.2s;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    color: var(--dark-ink);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border: 1px solid var(--line);
    background: var(--surf);
    padding: 18px 30px;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 600;
  }
  .btn-secondary:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-top: 8px;
    font-size: 14px;
    color: var(--mut);
  }
  .tags > span {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .check {
    color: var(--accText);
  }
  .cascade {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 26px;
    border-radius: 22px;
    transition: transform 0.25s;
  }
  .step--0 {
    background: var(--surf);
    color: var(--ink);
    border: 1px solid var(--line);
    margin-right: 12%;
  }
  .step--1 {
    background: var(--acc);
    color: var(--dark-ink);
    border: 1px solid transparent;
    margin: 0 6%;
  }
  .step--2 {
    background: var(--deep);
    color: var(--deepInk);
    border: 1px solid var(--deepLine);
    margin-left: 12%;
  }
  .step-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .step-n {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .step-time {
    font-size: 13px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid currentColor;
    opacity: 0.75;
    white-space: nowrap;
    flex: none;
  }
  .step-t {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .step-d {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.75;
  }
</style>
