---
// Home page: the three live reference ecosystems (fictional brands) people can click through.
// Each one shows the whole system a client gets — site, AI, client cabinet, owner CRM, partners.
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const C = {
  en: {
    eyebrow: 'Live demos', h2: 'Don’t imagine it — click through it',
    sub: 'Three working examples of what we build. Each has its own design for its niche, real AI (ask it anything) and everything behind the scenes: client cabinet, owner CRM, partners.',
    open: 'Open the demo →', note: 'Brands are fictional. Yours gets your design and your wishes on top.', all: 'All examples',
    items: [
      ['Aesthetic clinic', 'Aurelia', 'AI concierge picks treatments from a description · booking in 4 steps · client app with plan and points · CRM with no-show risk and AI morning report'],
      ['Online store', 'Ostra', 'Search in your own words with AI · filters · AI perfumer in chat · cart with AI upsell · customer cabinet · owner dashboard · affiliates'],
      ['CRM for your business', 'Pipeline', 'Your own CRM: drag deals between stages, automations on every move, AI weekly report — set up for how you work'],
    ],
  },
  ru: {
    eyebrow: 'Живые примеры', h2: 'Не представляйте — попробуйте сами',
    sub: 'Три рабочих примера того, что мы делаем. У каждого свой дизайн под нишу, настоящий ИИ (спросите что угодно) и всё «за кулисами»: кабинет клиента, CRM владельца, партнёры.',
    open: 'Открыть пример →', note: 'Бренды вымышленные. Ваш получит свой дизайн и ваши пожелания сверху.', all: 'Все примеры',
    items: [
      ['Клиника эстетики', 'Aurelia', 'ИИ-консьерж подбирает процедуры по описанию · запись в 4 шага · приложение клиента с планом и баллами · CRM с риском неявки и утренним ИИ-отчётом'],
      ['Интернет-магазин', 'Ostra', 'Поиск своими словами через ИИ · фильтры · ИИ-парфюмер в чате · корзина с подсказками ИИ · кабинет покупателя · панель владельца · партнёры'],
      ['CRM для вашего бизнеса', 'Pipeline', 'Своя CRM: сделки перетаскиваются по этапам, автоматизации на каждый шаг, ИИ-отчёт раз в неделю — под то, как работаете вы'],
    ],
  },
  ua: {
    eyebrow: 'Живі приклади', h2: 'Не уявляйте — спробуйте самі',
    sub: 'Три робочі приклади того, що ми робимо. У кожного свій дизайн під нішу, справжній ШІ (запитайте будь-що) і все «за лаштунками»: кабінет клієнта, CRM власника, партнери.',
    open: 'Відкрити приклад →', note: 'Бренди вигадані. Ваш отримає свій дизайн і ваші побажання зверху.', all: 'Усі приклади',
    items: [
      ['Клініка естетики', 'Aurelia', 'ШІ-консьєрж підбирає процедури за описом · запис у 4 кроки · застосунок клієнта з планом і балами · CRM з ризиком неявки та ранковим ШІ-звітом'],
      ['Інтернет-магазин', 'Ostra', 'Пошук своїми словами через ШІ · фільтри · ШІ-парфумер у чаті · кошик із підказками ШІ · кабінет покупця · панель власника · партнери'],
      ['CRM для вашого бізнесу', 'Pipeline', 'Своя CRM: угоди перетягуються етапами, автоматизації на кожен крок, ШІ-звіт щотижня — під те, як працюєте ви'],
    ],
  },
}[lang];
const slugs = ['eco-clinic', 'eco-shop', 'eco-crm'];
const allHref = lang === 'en' ? '/examples/' : `/${lang}/examples/`;
---

<section class="eco" id="demos">
  <div class="in">
    <p class="eyebrow">{C.eyebrow}</p>
    <h2>{C.h2}</h2>
    <p class="sub">{C.sub}</p>
    <div class="grid">
      {C.items.map(([kind, name, what], i) => (
        <a class:list={['card', { big: i === 0 }]} href={`/examples/${slugs[i]}/?lang=${lang}`} target="_blank" rel="noopener">
          <span class="shot"><img src={`/examples/thumbs/${slugs[i]}.jpg`} alt={name} loading="lazy" width="960" height="600" /></span>
          <span class="tx">
            <span class="kind">{kind} · <b>{name}</b></span>
            <span class="what">{what}</span>
            <span class="go">{C.open}</span>
          </span>
        </a>
      ))}
    </div>
    <p class="note">{C.note} <a href={allHref}>{C.all} →</a></p>
  </div>
</section>

<style>
  .eco { padding: 80px 0; }
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .eyebrow { color: var(--accText); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 13px; margin: 0 0 10px; }
  h2 { font-size: clamp(30px, 4.5vw, 46px); line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 14px; max-width: 22ch; }
  .sub { color: var(--mut); font-size: 18px; line-height: 1.55; max-width: 62ch; margin: 0 0 32px; }
  .grid { display: grid; grid-template-columns: 1.25fr 1fr; grid-template-rows: auto auto; gap: 16px; }
  .card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 22px; overflow: hidden; background: var(--surf); text-decoration: none; color: inherit; transition: transform 0.25s, box-shadow 0.25s; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 22px 44px -28px rgba(0, 0, 0, 0.45); }
  .card.big { grid-row: span 2; }
  .shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--line); }
  .big .shot { flex: 1; aspect-ratio: auto; min-height: 300px; }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.6s; }
  .card:hover .shot img { transform: scale(1.03); }
  .tx { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 20px; }
  .kind { font-size: 14px; color: var(--mut); }
  .kind b { color: var(--ink); font-size: 17px; }
  .what { line-height: 1.5; }
  .go { font-weight: 700; color: var(--accText); margin-top: 4px; }
  .note { color: var(--mut); font-size: 14px; margin: 18px 0 0; }
  .note a { color: var(--accText); font-weight: 600; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .card.big { grid-row: auto; }
    .big .shot { aspect-ratio: 16 / 10; min-height: 0; }
  }
</style>
