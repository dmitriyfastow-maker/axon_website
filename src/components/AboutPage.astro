---
// About Vaxo: the whole company on one page — who we are, what we do, how we work, and a door for every visitor.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AiPluses from './AiPluses.astro';
import { getDict, langPath, navHref, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/about/', ua: '/ua/about/', ru: '/ru/about/' };
const h = (p: string) => navHref(p, lang, home);

const C = {
  en: {
    title: 'About Vaxo — a personal operating system for life and work', desc: 'Who we are, what we build and how we work: websites, apps, AI assistants, ads, content and our own cartoon.',
    meme: 'Designer, developer, marketer and support. One raccoon. Five hats, one coffee.', memeAlt: 'Vax the raccoon wearing five hats with a laptop and coffee',
    eyebrow: 'About Vaxo', h1: 'You describe it. We and AI build it.',
    sub: 'Vaxo is one platform on a simple subscription: websites, apps, assistants, ads and content are all included — you only pay the plan, the work is done by us and AI. People step in where a human touch matters. Something unique? We build it as a custom project, with the price agreed upfront.',
    whatH: 'What we do', what: [['Websites and stores', 'From a one-page site in days to e-commerce.'], ['Apps and SaaS', 'From MVP to a full product with payments and accounts.'], ['AI assistants and automation', 'Chats that answer clients 24/7, CRM, auto-replies.'], ['Ads, SMM and SEO', 'Meta, Google, TikTok, content plans and search.'], ['Video and characters', 'Short videos, brand mascots and AI-animated series — like our own Vax and Roxy.'], ['Design and branding', 'Logos, UI/UX, copywriting.']],
    howH: 'How we work', how: [['Vax answers in seconds', 'Our AI manager talks to you in your language, 24/7 — on the site, in Telegram or by email.'], ['Everything in one chat', 'Brief, price, stages and the result live in your private project chat.'], ['Checked before you see it', 'Every piece of work goes through quality checks. A human joins for calls.'], ['Clear terms', 'Fixed scope and price, honest refund rules, no hidden fees.']],
    whoH: 'Who we work with', who: [['Business owners', 'One platform for the whole business: free to start, plans from $39 a month. Anything custom on top.', 'Start free', '/#contact'], ['Partners', 'Recommend Vaxo and earn 50% of the first payment + 30% for life.', 'Become a partner', '/partners/'], ['Creators, UGC, agencies, brands', 'Collaborations, ads, white-label, jobs.', 'Send a proposal', '/collab/']],
    casesH: 'Real work', cases: 'See our cases — AiPro Partners and TrichoTech — on the examples page.', casesCta: 'See cases',
    values: 'We are honest about prices and results, we keep your accounts in your name, and we never spam.',
  },
  ru: {
    title: 'О Vaxo — личная операционная система для жизни и дел', desc: 'Кто мы, что делаем и как работаем: сайты, приложения, ИИ-ассистенты, реклама, контент и свой мультик.',
    meme: 'Дизайнер, программист, маркетолог и поддержка. Один енот. Пять шапок, один кофе.', memeAlt: 'Енот Vax в пяти шапках с ноутбуком и кофе',
    eyebrow: 'О Vaxo', h1: 'Вы описываете. Мы и ИИ делаем.',
    sub: 'Vaxo — одна платформа по простой подписке: сайты, приложения, ассистенты, реклама и контент входят в тариф — вы платите только подписку, работу делаем мы и ИИ. Люди подключаются там, где важен человек. Нужно что-то особенное? Сделаем как кастом-проект, с ценой заранее.',
    whatH: 'Что мы делаем', what: [['Сайты и магазины', 'От одностраничника за несколько дней до интернет-магазина.'], ['Приложения и SaaS', 'От MVP до полного продукта с оплатой и кабинетами.'], ['ИИ-ассистенты и автоматизация', 'Чаты, которые отвечают клиентам 24/7, CRM, автоответы.'], ['Реклама, SMM и SEO', 'Meta, Google, TikTok, контент-планы и поиск.'], ['Видео и персонажи', 'Короткие ролики, маскоты брендов и ИИ-мультсериалы — как наши Vax и Roxy.'], ['Дизайн и брендинг', 'Логотипы, UI/UX, тексты.']],
    howH: 'Как мы работаем', how: [['Vax отвечает за секунды', 'Наш ИИ-менеджер общается на вашем языке 24/7 — на сайте, в Telegram или по почте.'], ['Всё в одном чате', 'Задача, цена, этапы и результат — в личном чате вашего проекта.'], ['Проверено до того, как вы увидите', 'Каждая работа проходит проверку качества. Человек подключается на созвоны.'], ['Понятные условия', 'Фиксированный объём и цена, честные правила возврата, без скрытых платежей.']],
    whoH: 'С кем мы работаем', who: [['Владельцы бизнеса', 'Одна платформа для всего бизнеса: начать бесплатно, тарифы от $39 в месяц. Любой кастом сверху.', 'Начать бесплатно', '/#contact'], ['Партнёры', 'Рекомендуйте Vaxo и получайте 50% первой оплаты + 30% пожизненно.', 'Стать партнёром', '/partners/'], ['Блогеры, UGC, агентства, бренды', 'Коллаборации, реклама, белая марка, работа.', 'Отправить предложение', '/collab/']],
    casesH: 'Реальные работы', cases: 'Наши кейсы — AiPro Partners и TrichoTech — на странице примеров.', casesCta: 'Смотреть кейсы',
    values: 'Мы честны в ценах и результатах, оформляем ваши аккаунты на вас и никогда не спамим.',
  },
  ua: {
    title: 'Про Vaxo — особиста операційна система для життя і справ', desc: 'Хто ми, що робимо і як працюємо: сайти, застосунки, ШІ-асистенти, реклама, контент і власний мультик.',
    meme: 'Дизайнер, програміст, маркетолог і підтримка. Один єнот. П’ять шапок, одна кава.', memeAlt: 'Єнот Vax у п’яти шапках з ноутбуком і кавою',
    eyebrow: 'Про Vaxo', h1: 'Ви описуєте. Ми і ШІ робимо.',
    sub: 'Vaxo — одна платформа за простою підпискою: сайти, застосунки, асистенти, реклама і контент входять у тариф — ви платите лише підписку, роботу робимо ми і ШІ. Люди підключаються там, де важлива людина. Потрібно щось особливе? Зробимо як кастом-проєкт, з ціною наперед.',
    whatH: 'Що ми робимо', what: [['Сайти та магазини', 'Від односторінкового сайту за кілька днів до інтернет-магазину.'], ['Застосунки та SaaS', 'Від MVP до повного продукту з оплатою і кабінетами.'], ['ШІ-асистенти та автоматизація', 'Чати, що відповідають клієнтам 24/7, CRM, автовідповіді.'], ['Реклама, SMM і SEO', 'Meta, Google, TikTok, контент-плани і пошук.'], ['Відео та персонажі', 'Короткі ролики, маскоти брендів і ШІ-мультсеріали — як наші Vax і Roxy.'], ['Дизайн і брендинг', 'Логотипи, UI/UX, тексти.']],
    howH: 'Як ми працюємо', how: [['Vax відповідає за секунди', 'Наш ШІ-менеджер спілкується вашою мовою 24/7 — на сайті, в Telegram або поштою.'], ['Усе в одному чаті', 'Задача, ціна, етапи і результат — в особистому чаті вашого проєкту.'], ['Перевірено до того, як ви побачите', 'Кожна робота проходить перевірку якості. Людина підключається на дзвінки.'], ['Зрозумілі умови', 'Фіксований обсяг і ціна, чесні правила повернення, без прихованих платежів.']],
    whoH: 'З ким ми працюємо', who: [['Власники бізнесу', 'Одна платформа для всього бізнесу: почати безкоштовно, тарифи від $39 на місяць. Будь-який кастом зверху.', 'Почати безкоштовно', '/#contact'], ['Партнери', 'Рекомендуйте Vaxo й отримуйте 50% першої оплати + 30% довічно.', 'Стати партнером', '/partners/'], ['Блогери, UGC, агенції, бренди', 'Колаборації, реклама, біла марка, робота.', 'Надіслати пропозицію', '/collab/']],
    casesH: 'Реальні роботи', cases: 'Наші кейси — AiPro Partners і TrichoTech — на сторінці прикладів.', casesCta: 'Дивитися кейси',
    values: 'Ми чесні в цінах і результатах, оформлюємо ваші акаунти на вас і ніколи не спамимо.',
  },
}[lang];
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="about">
    <section class="in hero">
      <div class="htext">
        <span class="eyebrow">{C.eyebrow}</span>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
      </div>
      <figure class="meme">
        <p class="bubble">{C.meme}</p>
        <img src="/mascot/vax-allinone.webp" alt={C.memeAlt} width="403" height="520" loading="eager" />
      </figure>
    </section>
    <section class="in">
      <h2>{C.whatH}</h2>
      <div class="grid">{C.what.map(([a, b]) => <div class="card"><b>{a}</b><p>{b}</p></div>)}</div>
    </section>
    <section class="in">
      <h2>{C.howH}</h2>
      <ol class="how">{C.how.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}</ol>
    </section>
    <section class="in">
      <h2>{C.whoH}</h2>
      <div class="grid three">{C.who.map(([a, b, c, href]) => <a class="card door" href={h(href)}><b>{a}</b><p>{b}</p><span class="go">{c} →</span></a>)}</div>
    </section>
    <section class="in last">
      <h2>{C.casesH}</h2>
      <p>{C.cases} <a href={h('/examples/')}>{C.casesCta} →</a></p>
      <p class="mut">{C.values}</p>
    </section>
    <AiPluses t={t} />
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px 48px; }
  .hero { padding-top: 110px; display: grid; grid-template-columns: 1fr 300px; gap: 24px; align-items: end; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 18ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 62ch; }
  .meme { margin: 0; position: relative; display: flex; flex-direction: column; align-items: center; }
  .meme img { width: 100%; height: auto; max-width: 300px; filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.18)); }
  .bubble { position: relative; margin: 0 0 10px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px 18px 18px 4px; padding: 10px 14px; font-weight: 600; font-size: 15px; line-height: 1.35; color: var(--ink); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08); transform: rotate(-2deg); }
  .bubble::after { content: ''; position: absolute; left: 22px; bottom: -9px; width: 16px; height: 16px; background: var(--surf); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transform: rotate(45deg); }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; padding-top: 96px; } .meme img { max-width: 220px; } .bubble { max-width: 320px; } .bubble::after { left: calc(50% - 8px); } }
  h2 { font-size: clamp(24px, 3.5vw, 32px); margin: 0 0 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 18px; color: var(--ink); text-decoration: none; }
  .card b { font-size: 18px; } .card p { color: var(--mut); margin: 6px 0 0; line-height: 1.5; }
  .door { display: flex; flex-direction: column; transition: border-color 0.2s; } .door:hover { border-color: var(--acc); }
  .door .go { margin-top: auto; padding-top: 12px; font-weight: 600; color: var(--accText, var(--ink)); }
  .how { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; counter-reset: s; }
  .how li { counter-increment: s; display: flex; flex-direction: column; gap: 4px; border-top: 4px solid var(--acc); padding-top: 10px; }
  .how li b::before { content: counter(s) '. '; } .how li span { color: var(--mut); }
  .last { padding-bottom: 80px; } .last a { color: var(--ink); font-weight: 600; } .mut { color: var(--mut); }
</style>
