---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, langPath, type Lang } from '../i18n';
import { POSTS, BLOG_UI } from '../data/blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const pre = lang === 'en' ? '' : `/${lang}`;
const alts = { en: '/blog/', ru: '/ru/blog/', ua: '/ua/blog/' };
const U = BLOG_UI[lang];
---

<Base lang={lang} title={U.title} description={U.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="blog">
    <span class="eyebrow">Blog</span>
    <h1>{U.h}</h1>
    <div class="list">
      {POSTS.map((p) => (
        <a class="post" href={`${pre}/blog/${p.slug}/`}><h2>{p.t[lang].title}</h2><p>{p.t[lang].desc}</p><small>{p.date}</small></a>
      ))}
    </div>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .blog { max-width: 860px; margin: 0 auto; padding: 110px 16px 80px; }
  h1 { font-size: clamp(32px, 5vw, 48px); letter-spacing: -0.02em; margin: 12px 0 24px; }
  .list { display: grid; gap: 12px; }
  .post { display: block; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 18px; color: var(--ink); text-decoration: none; }
  .post:hover { border-color: var(--acc); }
  .post h2 { margin: 0 0 6px; font-size: 21px; } .post p { color: var(--mut); margin: 0 0 8px; } .post small { color: var(--mut); }
</style>
