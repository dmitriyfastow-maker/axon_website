---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  class?: string;
  style?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const { name, alt, class: cls, style, sizes = '100vw', widths = [480, 800, 1200], eager = false } = Astro.props;
const entry = Object.entries(images).find(([path]) => path.replace(/^.*\/|\.\w+$/g, '') === name);
if (!entry) throw new Error(`Image not found: ${name}`);
const src = entry[1].default;
const isSvg = src.format === 'svg';
const loading = eager ? 'eager' : 'lazy';
const usable = widths.filter((w) => w <= src.width);
---

{
  isSvg ? (
    <img src={src.src} width={src.width} height={src.height} alt={alt} class={cls} style={style} loading={loading} decoding="async" />
  ) : (
    <Picture
      src={src}
      alt={alt}
      class={cls}
      style={style}
      formats={['avif']}
      fallbackFormat="webp"
      widths={usable.length ? usable : [src.width]}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  )
}
