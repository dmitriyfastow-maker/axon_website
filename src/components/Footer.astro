---
import { navHref, type Dict, type Lang } from '../i18n';
import { NAV_HREFS } from '../data/tiers';
import { NICHES } from '../data/niches';

interface Props { t: Dict; home?: string; lang?: Lang }
const { t, home = '', lang = 'en' } = Astro.props;
const F = { en: { examples: 'Examples', tools: 'Free tools', blog: 'Blog', start: 'Start free', shop: 'Templates shop', me: 'Client cabinet', login: 'Partner login', collab: 'Collaborate', about: 'About', gifts: 'Gifts 🎁', terms: 'Terms & refunds', privacy: 'Privacy', refunds: 'Refunds', pterms: 'Partner terms' },
            ru: { examples: 'Примеры работ', tools: 'Бесплатные инструменты', blog: 'Блог', start: 'Начать бесплатно', shop: 'Магазин шаблонов', me: 'Кабинет клиента', login: 'Вход для партнёров', collab: 'Сотрудничество', about: 'О нас', gifts: 'Подарки 🎁', terms: 'Условия и возвраты', privacy: 'Конфиденциальность', refunds: 'Возвраты', pterms: 'Условия партнёрки' },
            ua: { examples: 'Приклади робіт', tools: 'Безкоштовні інструменти', blog: 'Блог', start: 'Почати безкоштовно', shop: 'Магазин шаблонів', me: 'Кабінет клієнта', login: 'Вхід для партнерів', collab: 'Співпраця', about: 'Про нас', gifts: 'Подарунки 🎁', terms: 'Умови та повернення', privacy: 'Конфіденційність', refunds: 'Повернення', pterms: 'Умови партнерки' } }[lang];
---

<footer class="footer">
  <div class="inner">
    <span class="logo">VAXO<span>.</span></span>
    <nav aria-label="Footer">
      {t.nav.map((label, i) => <a href={navHref(NAV_HREFS[i], lang, home)}>{label}</a>)}
      <a href={navHref('/examples/', lang)}>{F.examples}</a>
      <a href={navHref('/start/', lang)}>{F.start}</a>
      <a href={navHref('/shop/', lang)}>{F.shop}</a>
      <a href={navHref('/tools/', lang)}>{F.tools}</a>
      <a href={navHref("/blog/", lang)}>{F.blog}</a>
      <a href={navHref('/app/', lang)}>{F.me}</a>
      <a href={navHref('/partner/', lang)}>{F.login}</a>
      <a href={navHref('/how/', lang)}>{{ en: 'How it works', ru: 'Как это работает', ua: 'Як це працює' }[lang]}</a>
      <a href={navHref('/score/', lang)}>Vaxo Score</a>
      <a href={navHref('/about/', lang)}>{F.about}</a>
      <a href={navHref('/gifts/', lang)}>{F.gifts}</a>
      <a href={navHref('/collab/', lang)}>{F.collab}</a>
    </nav>
    <nav class="legal-links" aria-label="Niches">
      {NICHES.map((n) => <a href={navHref(`/for/${n.slug}/`, lang)}>{n.t[lang].name}</a>)}
    </nav>
    <nav class="legal-links" aria-label="Legal">
      <a href={navHref('/terms/', lang)}>{F.terms}</a>
      <a href={navHref('/privacy/', lang)}>{F.privacy}</a>
      <a href={navHref('/refunds/', lang)}>{F.refunds}</a>
      <a href={navHref('/partner-terms/', lang)}>{F.pterms}</a>
    </nav>
    <span class="copy">© 2026 {t.footer}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px clamp(20px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .logo {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.03em;
  }
  .logo span {
    color: var(--accText);
  }
  .legal-links a { font-size: 13px; opacity: 0.75; }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
    color: var(--mut);
  }
  .copy {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--mut);
  }
</style>
