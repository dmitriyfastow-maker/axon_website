---
import { navHref, type Dict, type Lang } from '../i18n';
import { NAV_HREFS } from '../data/tiers';
import { NICHES } from '../data/niches';

interface Props { t: Dict; home?: string; lang?: Lang }
const { t, home = '', lang = 'en' } = Astro.props;
const F = { en: { examples: 'Examples', tools: 'Free tools', blog: 'Blog', start: 'Start free', shop: 'Templates shop', me: 'Client cabinet', login: 'Partner login', collab: 'Collaborate', about: 'About', gifts: 'Gifts 🎁', terms: 'Terms & refunds', privacy: 'Privacy', refunds: 'Refunds', pterms: 'Partner terms' },
            ru: { examples: 'Примеры работ', tools: 'Бесплатные инструменты', blog: 'Блог', start: 'Начать бесплатно', shop: 'Магазин шаблонов', me: 'Кабинет клиента', login: 'Вход для партнёров', collab: 'Сотрудничество', about: 'О нас', gifts: 'Подарки 🎁', terms: 'Условия и возвраты', privacy: 'Конфиденциальность', refunds: 'Возвраты', pterms: 'Условия партнёрки' },
            ua: { examples: 'Приклади робіт', tools: 'Безкоштовні інструменти', blog: 'Блог', start: 'Почати безкоштовно', shop: 'Магазин шаблонів', me: 'Кабінет клієнта', login: 'Вхід для партнерів', collab: 'Співпраця', about: 'Про нас', gifts: 'Подарунки 🎁', terms: 'Умови та повернення', privacy: 'Конфіденційність', refunds: 'Повернення', pterms: 'Умови партнерки' } }[lang];
// Our social accounts (18.11): only the ones that are live. Facebook joins after the business portfolio.
const SOC: [string, string, string][] = [
  ['Instagram', 'https://www.instagram.com/vaxo_group/', 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.2-1.6a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z'],
  ['TikTok', 'https://www.tiktok.com/@vaxo_group', 'M14 3v11.5a3.5 3.5 0 1 1-3-3.46V8.1A6.5 6.5 0 1 0 17 14.5V8.8a7 7 0 0 0 4 1.2V7a4 4 0 0 1-4-4h-3Z'],
  ['YouTube', 'https://www.youtube.com/@vaxo_group', 'M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1c.3-1.2.4-2.5.4-3.8s-.1-2.6-.4-3.8ZM10 15V9l5.2 3L10 15Z'],
  ['Threads', 'https://www.threads.net/@vaxo_group', 'M16.7 11.1c-.1-2.6-1.6-4.1-4.2-4.1-1.6 0-2.9.7-3.6 1.9l1.4.9c.5-.8 1.2-1.1 2.2-1.1 1.3 0 2.1.7 2.3 1.9a10 10 0 0 0-2.2-.1c-2.3.1-3.8 1.4-3.7 3.3.1 1.8 1.7 3 3.7 2.9 2.4-.1 3.6-1.8 3.9-3.9.8.5 1.2 1.1 1.4 1.9.4 1.4-.1 3-1.3 4.2-1.1 1.1-2.4 1.6-4.4 1.6-2.2 0-3.9-.7-5-2.1-1-1.3-1.6-3.2-1.6-5.5s.5-4.2 1.6-5.5c1.1-1.4 2.8-2.1 5-2.1 2.3 0 4 .7 5.1 2.1.6.7 1 1.5 1.3 2.5l1.7-.5c-.3-1.2-.9-2.3-1.6-3.2C17.3 2.9 15.2 2 12.5 2 9.8 2 7.7 2.9 6.3 4.6 5 6.2 4.3 8.5 4.3 11.2s.7 5 2 6.6c1.4 1.7 3.5 2.6 6.2 2.6 2.4 0 4.1-.6 5.5-2 1.8-1.8 2.4-4.2 1.7-6.2-.4-1.4-1.4-2.4-3-3.1Zm-4.2 4.6c-1 0-2-.4-2-1.3 0-.7.5-1.5 2.3-1.6.7 0 1.4 0 2 .2-.2 1.8-1.1 2.7-2.3 2.7Z'],
  ['LinkedIn', 'https://www.linkedin.com/company/145357235/', 'M4.5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 9h3v12H3V9Zm6 0h2.9v1.7c.5-.9 1.7-2 3.6-2 3.1 0 4.5 1.9 4.5 5.2V21h-3v-6.4c0-1.7-.6-2.9-2.1-2.9-1.6 0-2.4 1.2-2.4 2.9V21H9V9Z'],
