---
import { navHref, type Dict, type Lang } from '../i18n';
import { NAV_HREFS } from '../data/tiers';

interface Props { t: Dict; home?: string; lang?: Lang }
const { t, home = '', lang = 'en' } = Astro.props;
const F = { en: { examples: 'Examples', gifts: 'Cartoon gifts', tools: 'Free tools', blog: 'Blog', gifts: '🎁 Cartoon gifts', start: 'Starter packages', shop: 'Templates shop', login: 'Partner login', collab: 'Collaborate', terms: 'Terms & refunds', privacy: 'Privacy', pterms: 'Partner terms' },
            ru: { examples: 'Примеры работ', gifts: 'Мультики в подарок', tools: 'Бесплатные инструменты', blog: 'Блог', gifts: '🎁 Мультик в подарок', start: 'Стартовые пакеты', shop: 'Магазин шаблонов', login: 'Вход для партнёров', collab: 'Сотрудничество', terms: 'Условия и возвраты', privacy: 'Конфиденциальность', pterms: 'Условия партнёрки' },
            ua: { examples: 'Приклади робіт', gifts: 'Мультики в подарунок', tools: 'Безкоштовні інструменти', blog: 'Блог', gifts: '🎁 Мультик у подарунок', start: 'Стартові пакети', shop: 'Магазин шаблонів', login: 'Вхід для партнерів', collab: 'Співпраця', terms: 'Умови та повернення', privacy: 'Конфіденційність', pterms: 'Умови партнерки' } }[lang];
---

<footer class="footer">
  <div class="inner">
    <span class="logo">VAXO<span>.</span></span>
    <nav aria-label="Footer">
      {t.nav.map((label, i) => <a href={navHref(NAV_HREFS[i], lang, home)}>{label}</a>)}
      <a href={navHref('/examples/', lang)}>{F.examples}</a>
      <a href={navHref('/start/', lang)}>{F.start}</a>
      <a href={navHref('/gifts/', lang)}>{F.gifts}</a>
      <a href={navHref('/shop/', lang)}>{F.shop}</a>
      <a href={navHref('/gifts/', lang)}>{F.gifts}</a>
      <a href={navHref('/tools/', lang)}>{F.tools}</a>
      <a href="/blog/">{F.blog}</a>
      <a href={navHref('/partner/', lang)}>{F.login}</a>
    </nav>
    <nav class="legal-links" aria-label="Legal">
      <a href={navHref('/terms/', lang)}>{F.terms}</a>
      <a href={navHref('/privacy/', lang)}>{F.privacy}</a>
      <a href={navHref('/partner-terms/', lang)}>{F.pterms}</a>
    </nav>
    <span class="copy">© 2026 {t.footer}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px clamp(20px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .logo {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.03em;
  }
  .logo span {
    color: var(--acc);
  }
  .legal-links a { font-size: 13px; opacity: 0.75; }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
    color: var(--mut);
  }
  .copy {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--mut);
  }
</style>
