---

<footer class="footer">
  <div class="inner">
    <span class="logo">VAXO<span>.</span></span>
    <div class="cols">
      <nav aria-label="Product">
        <b>{{ en: 'Product', ru: 'Продукт', ua: 'Продукт' }[lang]}</b>
        <a href={navHref('/app/', lang)}>{{ en: 'Open Vax', ru: 'Открыть Vax', ua: 'Відкрити Vax' }[lang]}</a>
        <a href={navHref('/how/', lang)}>{{ en: 'How it works', ru: 'Как это работает', ua: 'Як це працює' }[lang]}</a>
        <a href={navHref('/examples/', lang)}>{F.examples}</a>
        <a href={navHref('#pricing', lang, home)}>{{ en: 'Plans', ru: 'Тарифы', ua: 'Тарифи' }[lang]}</a>
      </nav>
      <nav aria-label="Extras">
        <b>{{ en: 'Useful', ru: 'Полезное', ua: 'Корисне' }[lang]}</b>
        <a href={navHref('/tools/', lang)}>{F.tools}</a>
        <a href={navHref('/shop/', lang)}>{F.shop}</a>
        <a href={navHref("/blog/", lang)}>{F.blog}</a>
        <a href={navHref('/gifts/', lang)}>{{ en: 'Cartoon as a gift', ru: 'Мультик в подарок', ua: 'Мультик у подарунок' }[lang]}</a>
      </nav>
      <nav aria-label="Partners">
        <b>{{ en: 'Partners', ru: 'Партнёрам', ua: 'Партнерам' }[lang]}</b>
        <a href={navHref('/partners/', lang)}>{{ en: 'Earn with Vaxo', ru: 'Заработать с Vaxo', ua: 'Заробити з Vaxo' }[lang]}</a>
        <a href={navHref('/partner/', lang)}>{F.login}</a>
        <a href={navHref('/collab/', lang)}>{F.collab}</a>
      </nav>
      <nav aria-label="Company">
        <b>{{ en: 'Company', ru: 'Компания', ua: 'Компанія' }[lang]}</b>
        <a href={navHref('/about/', lang)}>{F.about}</a>
        <a href={navHref('/terms/', lang)}>{F.terms}</a>
        <a href={navHref('/privacy/', lang)}>{F.privacy}</a>
        <a href={navHref('/refunds/', lang)}>{F.refunds}</a>
        <a href={navHref('/partner-terms/', lang)}>{F.pterms}</a>
      </nav>
    </div>
    <div class="soc">
      <b>{{ en: 'Follow Vaxo', ru: 'Мы в соцсетях', ua: 'Ми в соцмережах' }[lang]}</b>
      <p>{{ en: 'Cartoons with Vax and Roxy, real results and new features — every week.', ru: 'Мультики про Vax и Roxy, реальные результаты и новые возможности — каждую неделю.', ua: 'Мультики про Vax і Roxy, реальні результати й нові можливості — щотижня.' }[lang]}</p>
      <div class="sl">{SOC.map(([n, href, d]) => <a href={href} target="_blank" rel="noopener me" aria-label={n} title={n}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={d} fill="currentColor" fill-rule="evenodd" /></svg><span>{n}</span></a>)}</div>
    </div>
    <nav class="legal-links" aria-label="Niches">
      {NICHES.map((n) => <a href={navHref(`/for/${n.slug}/`, lang)}>{n.t[lang].name}</a>)}
    </nav>
    <span class="copy">© 2026 {t.footer}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px clamp(20px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .logo {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.03em;
  }
  .logo span {
    color: var(--accText);
  }
  .legal-links a { font-size: 13px; opacity: 0.75; }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
    color: var(--mut);
  }
  /* Телефон: ссылки под палец (≥40 px), а не 18 px */
  @media (max-width: 760px) {
    nav { gap: 0 18px; }
    nav a { display: inline-flex; align-items: center; min-height: 40px; }
  }
  .copy {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--mut);
  }
  .cols { flex-basis: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .cols nav { display: grid; gap: 9px; align-content: start; }
  .cols nav b { color: var(--ink); font-size: 13px; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 2px; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr 1fr; } }
  .soc { flex-basis: 100%; display: grid; gap: 8px; padding: 18px 0 4px; border-top: 1px solid var(--line); }
  .soc b { font-size: 13px; letter-spacing: .04em; text-transform: uppercase; }
  .soc p { margin: 0; color: var(--mut); font-size: 14px; }
  .soc .sl { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .soc .sl a { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 14px 0 12px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: 14px; font-weight: 600; transition: border-color .2s, transform .2s, background .2s; }
  .soc .sl a:hover { border-color: var(--accText); transform: translateY(-1px); background: color-mix(in srgb, var(--accText) 8%, transparent); }
  .soc .sl svg { color: var(--accText); flex: none; }
</style>
