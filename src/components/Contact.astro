---
// Final "tell us what you need" block on /start/ and /tools/ (Decision 40): no contacts, no old chat.
// The request goes straight to Vax in Workspace (/app/#q=…), where the plan and the price appear on the canvas.
import type { Dict, Lang } from '../i18n';
import VaxSays from './VaxSays.astro';
import { navHref } from '../i18n';

interface Props { t: Dict; lang: Lang }
const { t, lang } = Astro.props;
const L = lang as 'en' | 'ru' | 'ua';
const C = {
  en: { sub: 'Vax, our AI, makes the plan, the price and the first result in your Workspace. You only pay the subscription — the work is done by us and AI.', chips: ['More clients', 'A website or an app', 'Ads & social media', 'Automate work with AI', 'Something personal'], ph: 'In a few words: what should change?', go: 'Start with Vax →', hint: 'Free to start, plans from $39/mo. No sign-up forms and no phone number.' },
  ru: { sub: 'Vax, наш ИИ, сделает план, цену и первый результат в вашем Workspace. Вы только платите подписку — работу делаем мы и ИИ.', chips: ['Больше клиентов', 'Сайт или приложение', 'Реклама и соцсети', 'Автоматизация с ИИ', 'Личная задача'], ph: 'В двух словах: что должно измениться?', go: 'Начать с Vax →', hint: 'Начать бесплатно, тарифы от $39/мес. Без анкет и номера телефона.' },
  ua: { sub: 'Vax, наш ШІ, зробить план, ціну і перший результат у вашому Workspace. Ви лише платите підписку — роботу робимо ми і ШІ.', chips: ['Більше клієнтів', 'Сайт або застосунок', 'Реклама і соцмережі', 'Автоматизація з ШІ', 'Особиста задача'], ph: 'Двома словами: що має змінитися?', go: 'Почати з Vax →', hint: 'Почати безкоштовно, тарифи від $39/міс. Без анкет і номера телефону.' },
}[L] || null;
const c = C || { sub: '', chips: [], ph: '', go: 'Start with Vax →', hint: '' };
---

<section id="contact" class="contact">
  <div class="box">
    <div class="copy">
      <h2>{t.finalTitle}</h2>
      <p>{c.sub}</p>
      <div class="notes">
        <span>◆ {t.footerCities}</span>
      </div>
      <VaxSays text={t.vax.contact} pose="headset" big />
    </div>
    <form class="card ask" data-ws-ask data-app={navHref('/app/', lang)}>
      <div class="chips">
        {c.chips.map((x) => <button type="button" class="chip" data-chip aria-pressed="false">{x}</button>)}
      </div>
      <label class="field">
        <span class="sr">{c.ph}</span>
        <textarea name="q" rows="4" maxlength="1500" placeholder={c.ph}></textarea>
      </label>
      <button type="submit" class="submit">{c.go}</button>
      <small class="hint">{c.hint}</small>
    </form>
  </div>
</section>

<script>
  // Chips mark the topic; submit opens Workspace with topics + own words (no contacts collected).
  document.querySelectorAll<HTMLFormElement>('[data-ws-ask]').forEach((form) => {
    const ta = form.querySelector('textarea')!;
    form.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) => b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      ta.focus();
    }));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const picked = [...form.querySelectorAll('[data-chip][aria-pressed="true"]')].map((x) => x.textContent?.trim());
      const q = [picked.join(', '), ta.value.trim()].filter(Boolean).join(': ');
      location.href = form.dataset.app + (q ? '#q=' + encodeURIComponent(q) : '');
    });
  });
</script>

<style>
  .contact {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px) clamp(64px, 8vw, 104px);
  }
  .box {
    background: var(--deep);
    color: var(--deepInk);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(32px, 5vw, 72px);
  }
  /* Phone: the chat gets the whole width (a thick frame squeezed the text field to a few words per line). */
  @media (max-width: 600px) {
    .contact { padding-left: 8px; padding-right: 8px; }
    .box { padding: 28px 8px 8px; border-radius: 24px; gap: 24px; }
    .copy { padding: 0 12px; }
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h2 {
    margin: 0;
    font-size: clamp(40px, 5.5vw, 76px);
    letter-spacing: -0.045em;
    font-weight: 700;
    line-height: 0.98;
    text-wrap: balance;
  }
  .copy p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--deepMut);
  }
  .notes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: 16px;
    font-size: 15px;
    color: var(--deepMut);
  }
  .card {
    background: var(--surf);
    color: var(--ink);
    border-radius: 24px;
    padding: clamp(22px, 3vw, 32px);
  }
  .chatcard { padding: 0; background: transparent; display: flex; flex-direction: column; gap: 14px; }
  .chatcard .fallback { background: var(--surf); border-radius: 24px; padding: clamp(22px, 3vw, 32px); }
  .success {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 320px;
    justify-content: center;
  }
  .tick {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--acc);
    color: var(--dark-ink);
    display: grid;
    place-items: center;
    font-size: 22px;
  }
  .vax-ok { width: 96px; height: auto; }
  .vax-line { color: var(--mut); font-style: italic; }
  .success p {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 600;
  }
  .again {
    align-self: flex-start;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .modes {
    display: flex;
    gap: 8px;
    padding: 4px;
    background: var(--surf2);
    border-radius: 999px;
  }
  .mode {
    flex: 1;
    min-width: 0;
    padding: 11px 12px;
    /* Deviation from the design: long UA/RU labels overflowed 360px screens. */
    white-space: normal;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--mut);
  }
  [data-interest] {
    gap: 8px;
  }
  input,
  textarea {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--ink);
    padding: 14px;
    font-size: 16px;
    outline: none;
  }
  textarea {
    resize: vertical;
  }
  input[aria-invalid='true'] {
    border-color: var(--error);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 1px;
  }
  .err {
    color: var(--error);
    font-size: 13px;
  }
  .form-err {
    margin: 0;
    font-size: 14px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .chip[aria-pressed='true'] {
    background: var(--acc);
    color: var(--dark-ink);
    border-color: var(--acc);
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .submit {
    background: var(--acc);
    color: var(--dark-ink);
    border: 0;
    padding: 18px;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
  }
  .submit:hover {
    filter: brightness(1.05);
  }
  .submit:disabled {
    cursor: progress;
    opacity: 0.75;
  }
  .room-link p { margin: 8px 0; font-size: 14px; }
  .room-btn { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 700; padding: 10px 16px; border-radius: 999px; text-decoration: none; }
  .ask { display: flex; flex-direction: column; gap: 16px; align-self: start; }
  .ask textarea { font: 17px var(--font); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 16px; padding: 14px; width: 100%; box-sizing: border-box; resize: vertical; }
  .hint { color: var(--mut); font-size: 14px; line-height: 1.5; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
