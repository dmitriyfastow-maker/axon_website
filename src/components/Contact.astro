---

import type { Dict, Lang } from '../i18n';
import VaxSays from './VaxSays.astro';
import PageChat from './PageChat.astro';
import { TIER_NAMES } from '../data/tiers';
import { LIMITS } from '../lib/validate';

interface Props { t: Dict; lang: Lang }
const { t, lang } = Astro.props;
const f = t.form;
const interests = [{ v: 'Starter', label: 'Starter' }, ...TIER_NAMES.map((n) => ({ v: n, label: n })), { v: 'single', label: f.single }, { v: 'any', label: f.any }];
// Labels the script swaps when the form mode changes.
const CHIPS = { en: ['I need a website', 'I need an app', 'I need more clients', 'An AI chat for my business', 'Not sure what I need'], ru: ['Хочу сайт', 'Нужно приложение', 'Нужно больше клиентов', 'ИИ-чат для бизнеса', 'Не знаю, что нужно'], ua: ['Хочу сайт', 'Потрібен застосунок', 'Потрібно більше клієнтів', 'ІІ-чат для бізнесу', 'Не знаю, що потрібно'] }[lang];
const copy = { message: f.message, question: f.question, send: f.send, sendQ: f.sendQ, sending: f.sending };
---

<section id="contact" class="contact">
  <div class="box">
    <div class="copy">
      <h2>{t.finalTitle}</h2>
      <p>{t.sessSub}</p>
      <div class="notes">
        <span>◆ {t.sessNote}</span>
        <span>◆ {t.footerCities}</span>
      </div>
      <VaxSays text={t.vax.contact} face="front" big />
    </div>
    <div class="card chatcard" data-chat-host>
      <PageChat lang={lang} kind="request" chips={CHIPS} />
      <div class="fallback" data-chat-fallback hidden>
      <div class="success" data-form-success hidden>
        <img class="vax-ok" src="/mascot/vax-happy.webp" alt="Vax" width="120" height="120" loading="lazy" data-vax-poke />
        <p>{f.success}</p>
        <p class="vax-line">{t.vax.success}</p>
        <div class="room-link" data-room-box hidden><p>{f.room}</p><a href="#" class="room-btn" data-room-link>{f.roomBtn}</a></div>
        <button type="button" class="again" data-form-again>{f.again}</button>
      </div>
      <form data-lead-form data-lang={lang} data-copy={JSON.stringify(copy)} novalidate>
        <div class="modes" role="group">
          <button type="button" class="pill mode" data-mode="request" aria-pressed="true">{t.submit}</button>
          <button type="button" class="pill mode" data-mode="question" aria-pressed="false">{t.ask}</button>
        </div>
        <label class="field">
          {f.name}
          <input name="name" autocomplete="name" maxlength={LIMITS.name} aria-describedby="err-name" />
          <span class="err" id="err-name" data-error="name" hidden>{f.required}</span>
        </label>
        <label class="field">
          {f.contact}
          <input name="contact" autocomplete="email" maxlength={LIMITS.contact} placeholder="@telegram / +971… / mail@…" aria-describedby="err-contact" />
          <span class="err" id="err-contact" data-error="contact" hidden>{f.invalid}</span>
        </label>
        <div class="field" data-interest>
          <span>{f.interest}</span>
          <div class="chips">
            {interests.map((o) => <button type="button" class="chip" data-interest-value={o.v} aria-pressed="false">{o.label}</button>)}
          </div>
        </div>
        <label class="field">
          <span data-message-label>{f.message}</span>
          <textarea name="message" rows="4" maxlength={LIMITS.message}></textarea>
        </label>
        <label class="field promo">
          <span>{lang === 'ru' ? 'Промокод (если есть)' : lang === 'ua' ? 'Промокод (якщо є)' : 'Promo code (if you have one)'}</span>
          <input name="promo" maxlength="20" autocomplete="off" data-promo />
        </label>
        <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="err form-err" data-form-error role="alert" hidden>{f.error}</p>
        <button type="submit" class="submit"><span data-submit-label>{f.send}</span> <span data-submit-arrow>→</span></button>
      </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px) clamp(64px, 8vw, 104px);
  }
  .box {
    background: var(--deep);
    color: var(--deepInk);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(32px, 5vw, 72px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h2 {
    margin: 0;
    font-size: clamp(40px, 5.5vw, 76px);
    letter-spacing: -0.045em;
    font-weight: 700;
    line-height: 0.98;
    text-wrap: balance;
  }
  .copy p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--deepMut);
  }
  .notes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: 16px;
    font-size: 15px;
    color: var(--deepMut);
  }
  .card {
    background: var(--surf);
    color: var(--ink);
    border-radius: 24px;
    padding: clamp(22px, 3vw, 32px);
  }
  .chatcard { padding: 0; background: transparent; display: flex; flex-direction: column; gap: 14px; }
  .chatcard .fallback { background: var(--surf); border-radius: 24px; padding: clamp(22px, 3vw, 32px); }
  .success {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 320px;
    justify-content: center;
  }
  .tick {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--acc);
    color: var(--dark-ink);
    display: grid;
    place-items: center;
    font-size: 22px;
  }
  .vax-ok { width: 96px; height: auto; }
  .vax-line { color: var(--mut); font-style: italic; }
  .success p {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 600;
  }
  .again {
    align-self: flex-start;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .modes {
    display: flex;
    gap: 8px;
    padding: 4px;
    background: var(--surf2);
    border-radius: 999px;
  }
  .mode {
    flex: 1;
    min-width: 0;
    padding: 11px 12px;
    /* Deviation from the design: long UA/RU labels overflowed 360px screens. */
    white-space: normal;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--mut);
  }
  [data-interest] {
    gap: 8px;
  }
  input,
  textarea {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--ink);
    padding: 14px;
    font-size: 16px;
    outline: none;
  }
  textarea {
    resize: vertical;
  }
  input[aria-invalid='true'] {
    border-color: var(--error);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 1px;
  }
  .err {
    color: var(--error);
    font-size: 13px;
  }
  .form-err {
    margin: 0;
    font-size: 14px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .chip[aria-pressed='true'] {
    background: var(--acc);
    color: var(--dark-ink);
    border-color: var(--acc);
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .submit {
    background: var(--acc);
    color: var(--dark-ink);
    border: 0;
    padding: 18px;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
  }
  .submit:hover {
    filter: brightness(1.05);
  }
  .submit:disabled {
    cursor: progress;
    opacity: 0.75;
  }
  .room-link p { margin: 8px 0; font-size: 14px; }
  .room-btn { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 700; padding: 10px 16px; border-radius: 999px; text-decoration: none; }
</style>
