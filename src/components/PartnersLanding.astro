---
// Partner program landing (EN/UA/RU): animated money flow, flat rates, transparent calculator,
// training preview, team, coming-soon prize draws → sign up / log in at /partner/.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import VaxSays from './VaxSays.astro';
import { getDict, langPath, type Lang } from '../i18n';
import { CALC, PARTNERS_TEXT, RATES } from '../data/partners';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
// Vax reacts to the calculator total: [from $, image, line].
const VAXCALC = {
  en: [[0, 'coin', 'Zero so far. Not even enough for a bun — move the sliders 👀'], [1, 'coin', 'Coffee and a donut are covered. Nice start ☕'], [100, 'cash', 'That’s a month of rent for my latest business!'], [500, 'rain', 'Wait, wait — I’m already picking a new oven!'], [1500, 'rich', 'Sunglasses on. Time to call an accountant 😎']],
  ru: [[0, 'coin', 'Пока ноль. Даже на булочку не хватит — двигайте ползунки 👀'], [1, 'coin', 'На кофе с пончиком уже хватает. Неплохое начало ☕'], [100, 'cash', 'Это месячная аренда моего нового бизнеса!'], [500, 'rain', 'Стоп-стоп, я уже выбираю новую печь!'], [1500, 'rich', 'Я надел очки. Пора звать бухгалтера 😎']],
  ua: [[0, 'coin', 'Поки нуль. Навіть на булочку не вистачить — рухайте повзунки 👀'], [1, 'coin', 'На каву з пончиком уже вистачає. Непоганий початок ☕'], [100, 'cash', 'Це місячна оренда мого нового бізнесу!'], [500, 'rain', 'Стоп-стоп, я вже обираю нову піч!'], [1500, 'rich', 'Я вдягнув окуляри. Час кликати бухгалтера 😎']],
}[lang];
const p = PARTNERS_TEXT[lang];
const home = langPath(lang);
const cab = lang === 'en' ? '/partner/' : `/${lang}/partner/`;
const alts = { en: '/partners/', ua: '/ua/partners/', ru: '/ru/partners/' };
const calc = { ...CALC, own: RATES.agencyOwn, renewal: RATES.agencyRenewal, products: RATES.products };
const chips = ['Claude', 'ChatGPT', 'Gemini', 'CapCut', 'Canva', 'TikTok', 'Reels', 'Shorts', 'Telegram', 'Reddit', 'Facebook', 'LinkedIn'];
const payout = Math.round(CALC.packages[2] * RATES.agencyOwn) / 100;
---

<Base lang={lang} title={p.meta.title} description={p.meta.description} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="pl">
    <section class="hero">
      <div class="glow" aria-hidden="true"></div>
      <div class="in hero-grid">
        <div>
          <div class="eyebrow">{p.eyebrow}</div>
          <h1>{p.h1}</h1>
          <p class="sub">{p.sub}</p>
          <div class="ctas">
            <a class="btn" href={cab}>{p.join}</a>
            <a class="btn ghost" href={`${cab}?tab=login`}>{p.login}</a>
          </div>
        </div>
        <ol class="flow" aria-label={p.flow.join(' → ')}>
          {p.flow.map((f, i) => (
            <li style={`--i:${i}`}>
              <span class="dot">{i + 1}</span>
              <span class="lbl">{f}</span>
              {i === p.flow.length - 1 && <span class="pay">+${payout.toFixed(2)}</span>}
            </li>
          ))}
        </ol>
      </div>
      <div class="in">
        <div class="stats">
          {p.stats.map(([n, pat, l]) => (
            <div>
              <b>{pat.startsWith('+') ? '+' : ''}<span data-count={n}>{n}</span>{pat.replace('+', '')}</b>
              <span>{l}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="marquee" aria-hidden="true"><div>{[...chips, ...chips].map((c) => <span>{c}</span>)}</div></div>
    </section>

    <section class="rv">
      <div class="in">
        <h2>{p.aloneH}</h2>
        <p class="lead">{p.aloneSub}</p>
        <div class="grid four">
          {p.alone.map(([icon, h, x]) => <article class="card feat"><span class="ic">{icon}</span><h3>{h}</h3><p>{x}</p></article>)}
        </div>
        <VaxSays text={t.vax.partners} pose="partners" />
      </div>
    </section>

    <section class="rv">
      <div class="in">
        <h2>{p.promoteH}</h2>
        <div class="grid three">
          {p.directions.map((d, i) => (
            <article class={`card dir${i === 0 ? ' main' : ''}`}>
              <div class="rate">{d.rate}</div>
              <h3>{d.name}</h3>
              <div class="tag">{d.price}</div>
              <p>{d.what}</p>
              <ul>{d.points.map((x) => <li>{x}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="calc" class="rv">
      <div class="in">
        <div class="calc" data-calc={JSON.stringify(calc)}>
          <div class="calc-in">
            <h2>{p.calcH}</h2>
            <p class="lead">{p.calcSub}</p>
            {p.calcRows.map((row) => (
              <div class="crow">
                <label>
                  <span class="cl"><b>{row.label}</b><output data-out={row.id}>{row.value}</output></span>
                  <input type="range" min="0" max={row.max} step={row.step} value={row.value} data-in={row.id} />
                </label>
                {row.id === 'pk' && (
                  <div class="seg" role="group">
                    {CALC.packages.map((price, i) => (
                      <button type="button" data-pkg={price} aria-pressed={i === 2 ? 'true' : 'false'}>{p.calcPkg[i]} ${price}</button>
                    ))}
                  </div>
                )}
                <div class="formula"><span>{row.hint}</span><span data-f={row.id}></span></div>
              </div>
            ))}
          </div>
          <div class="calc-out" data-vaxcalc={JSON.stringify(VAXCALC)}>
            <div class="vaxcalc">
              <p class="vc-say" data-vc-say>{VAXCALC[2][2]}</p>
              <img src="/mascot/vax-money-cash.webp" alt="Vax" width="242" height="360" data-vc-img data-vax-poke />
            </div>
            <div class="big">$<span data-total>0</span></div>
            <div class="per">{p.calcMonth}</div>
            <div class="bars" aria-hidden="true">
              {p.calcRows.map((row) => <i data-bar={row.id}></i>)}
            </div>
            <div class="year">≈ $<span data-year>0</span> {p.calcYear}</div>
            <p class="note">{p.calcNote}</p>
            <a class="btn" href={cab}>{p.join}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="rv">
      <div class="in">
        <h2>{p.academyH}</h2>
        <p class="lead">{p.academySub}</p>
        <ol class="modules">
          {p.modules.map(([h, x], i) => (
            <li class="card"><span class="num">{String(i).padStart(2, '0')}</span><div><h3>{h}</h3><p>{x}</p></div></li>
          ))}
        </ol>
        <div class="grid two ways">
          {p.ways.map(([h, x], i) => <div class={`card way${i ? ' max' : ''}`}><h3>{h}</h3><p>{x}</p></div>)}
        </div>
      </div>
    </section>

    <section class="rv">
      <div class="in">
        <h2>{p.stepsH}</h2>
        <ol class="steps">
          {p.steps.map(([h, x]) => <li class="card"><h3>{h}</h3><p>{x}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="rv">
      <div class="in grid two">
        <div class="team card">
          <div class="orbit" aria-hidden="true"><span class="me">{({ en: "You", ua: "Ви", ru: "Вы" })[lang]}</span><i></i><i></i><i></i><i></i></div>
          <h2>{p.teamH}</h2>
          <p>{p.teamP}</p>
          <ul>{p.teamPoints.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="soon card">
          <span class="pill-soon">{p.soonTag}</span>
          <div class="gift" aria-hidden="true">🎁</div>
          <h2>{p.soonH}</h2>
          <p>{p.soonP}</p>
        </div>
      </div>
    </section>

    <section class="rv">
      <div class="in">
        <h2>{p.faqH}</h2>
        <div class="faq">
          {p.faq.map(([q, a]) => <details class="card"><summary>{q}</summary><p>{a}</p></details>)}
        </div>
        <p class="rules">{p.rules} <a href={`${cab}#rules`}>{p.rulesLink}</a>.</p>
      </div>
    </section>

    <section class="final rv">
      <div class="in">
        <div class="box">
          <div><h2>{p.finalH}</h2><p>{p.finalP}</p></div>
          <div class="ctas">
            <a class="btn" href={cab}>{p.create}</a>
            <a class="btn ghost" href={`${cab}?tab=login`}>{p.login}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number) => Math.round(n).toLocaleString('en-US');

  // Smoothly roll a number to its new value.
  function roll(el: Element, to: number) {
    const from = Number(el.getAttribute('data-now') ?? 0);
    el.setAttribute('data-now', String(to));
    if (still) return void (el.textContent = fmt(to));
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 450);
      el.textContent = fmt(from + (to - from) * (1 - (1 - k) ** 3));
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Reveal sections and count up the stats when they scroll into view.
  document.documentElement.classList.add('js-rv');
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in-view');
        e.target.querySelectorAll('[data-count]').forEach((n) => {
          n.setAttribute('data-now', '0');
          roll(n, Number(n.getAttribute('data-count')));
        });
        io.unobserve(e.target);
      }),
    { threshold: 0.15 },
  );
  document.querySelectorAll('.rv, .stats').forEach((s) => io.observe(s));

  const box = document.querySelector<HTMLElement>('[data-calc]');
  if (box) {
    const c = JSON.parse(box.dataset.calc!) as { packages: number[]; project: number; template: number; bundle: number; support: number; own: number; renewal: number; products: number };
    let pkg = c.packages[2];
    const val = (k: string) => Number(box.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value);
    const rows = () => ({
      pk: [val('pk'), pkg, c.own],
      pr: [val('pr'), c.project, c.own],
      tp: [val('tp'), c.template, c.products],
      bd: [val('bd'), c.bundle, c.products],
      sp: [val('sp'), c.support, c.renewal],
    });
    const update = () => {
      const all = rows();
      let total = 0;
      for (const [k, [n, price, rate]] of Object.entries(all)) {
        const sum = (n * price * rate) / 100;
        total += sum;
        box.querySelector(`[data-out="${k}"]`)!.textContent = String(n);
        box.querySelector(`[data-f="${k}"]`)!.textContent = `${n} × $${price} × ${rate}% = $${fmt(sum)}`;
        box.querySelector<HTMLElement>(`[data-bar="${k}"]`)!.style.flexGrow = String(sum);
      }
      roll(box.querySelector('[data-total]')!, total);
      roll(box.querySelector('[data-year]')!, Math.round(total) * 12);
      // Vax's reaction: the highest tier the total reached.
      const out = box.querySelector<HTMLElement>('[data-vaxcalc]');
      if (out) {
        const tiers = JSON.parse(out.dataset.vaxcalc!) as [number, string, string][];
        const [, img, say] = [...tiers].reverse().find(([from]) => total >= from) ?? tiers[0];
        const im = out.querySelector<HTMLImageElement>('[data-vc-img]')!;
        const src = `/mascot/vax-money-${img}.webp`;
        if (!im.src.endsWith(src)) { im.src = src; im.classList.remove('vax-wiggle'); void im.offsetWidth; im.classList.add('vax-wiggle'); }
        out.querySelector('[data-vc-say]')!.textContent = say;
      }
    };
    box.querySelectorAll('input').forEach((i) => i.addEventListener('input', update));
    box.querySelectorAll<HTMLButtonElement>('[data-pkg]').forEach((b) =>
      b.addEventListener('click', () => {
        pkg = Number(b.dataset.pkg);
        box.querySelectorAll('[data-pkg]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        update();
      }),
    );
    update();
  }
</script>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; position: relative; }
  .pl section { padding: 40px 0; }
  .pl .hero { padding: 96px 0 24px; position: relative; overflow: hidden; }
  h1 { font-size: clamp(34px, 5.6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; }
  h2 { font-size: clamp(26px, 4vw, 38px); letter-spacing: -0.01em; margin: 0 0 14px; }
  h3 { font-size: 19px; margin: 0 0 6px; }
  .sub, .lead { color: var(--mut); font-size: 18px; max-width: 62ch; margin: 0 0 24px; }
  .sub { font-size: 19px; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 24px; border-radius: 999px; text-decoration: none; white-space: nowrap; transition: transform 0.2s, box-shadow 0.2s; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px -10px var(--acc); color: var(--dark-ink); }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  .btn.ghost:hover { box-shadow: none; color: var(--ink); }

  /* hero motion */
  .glow { position: absolute; width: 620px; height: 620px; right: -160px; top: -120px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--acc) 28%, transparent), transparent 65%); animation: float 12s ease-in-out infinite; pointer-events: none; }
  @keyframes float { 50% { transform: translate(-60px, 50px) scale(1.08); } }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 40px; align-items: center; }
  .flow { list-style: none; margin: 0; padding: 20px; display: grid; gap: 10px; position: relative; background: color-mix(in srgb, var(--surf) 85%, transparent); border: 1px solid var(--line); border-radius: 24px; backdrop-filter: blur(8px); }
  .flow li { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 14px; background: var(--bg); border: 1px solid var(--line); position: relative; animation: lit 6s infinite; animation-delay: calc(var(--i) * 1s); }
  .flow li:not(:last-child)::after { content: ''; position: absolute; left: 31px; top: 100%; width: 2px; height: 10px; background: var(--line); }
  .flow .dot { width: 34px; height: 34px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--surf2); font-family: var(--mono); font-size: 13px; font-weight: 600; animation: dot 6s infinite; animation-delay: calc(var(--i) * 1s); }
  .flow .lbl { font-weight: 600; }
  .flow .pay { margin-left: auto; font-weight: 800; color: var(--accText); font-size: 20px; animation: pop 6s infinite; animation-delay: 4s; }
  @keyframes lit { 0%, 100% { border-color: var(--line); transform: none; } 6%, 14% { border-color: var(--acc); transform: translateX(6px); box-shadow: 0 8px 24px -14px var(--acc); } 22% { border-color: var(--line); transform: none; box-shadow: none; } }
  @keyframes dot { 0%, 100% { background: var(--surf2); color: var(--ink); } 6%, 14% { background: var(--acc); color: var(--dark-ink); } 22% { background: var(--surf2); color: var(--ink); } }
  @keyframes pop { 0%, 100% { opacity: 0.25; transform: scale(0.9); } 6%, 30% { opacity: 1; transform: scale(1.12); } 40% { opacity: 0.25; transform: scale(0.9); } }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; margin-top: 44px; background: var(--line); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .stats div { background: var(--surf); padding: 20px; display: flex; flex-direction: column; gap: 4px; }
  .stats b { font-size: clamp(28px, 4vw, 42px); color: var(--accText); letter-spacing: -0.02em; }
  .stats div > span { color: var(--mut); font-size: 14px; }
  .marquee { overflow: hidden; margin-top: 28px; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee div { display: flex; gap: 10px; width: max-content; animation: slide 40s linear infinite; }
  .marquee span { border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; font-family: var(--mono); font-size: 13px; color: var(--mut); white-space: nowrap; }
  @keyframes slide { to { transform: translateX(-50%); } }

  /* reveal on scroll */
  :global(.js-rv) .rv { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
  :global(.js-rv) .rv.in-view { opacity: 1; transform: none; }

  .grid { display: grid; gap: 16px; }
  .four { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .three { grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); }
  .two { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; transition: transform 0.25s, border-color 0.25s; }
  .card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--acc) 60%, var(--line)); }
  .card p { color: var(--mut); margin: 0; }
  .card ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 8px; }
  .card li { padding-left: 24px; position: relative; }
  .card ul li::before { content: '✓'; position: absolute; left: 0; color: var(--accText); font-weight: 700; }
  .feat .ic { font-size: 30px; display: block; margin-bottom: 12px; }
  .tag { font-family: var(--mono); font-size: 13px; color: var(--mut); margin-bottom: 10px; }
  .rate { font-size: clamp(44px, 5vw, 58px); font-weight: 800; letter-spacing: -0.03em; color: var(--accText); line-height: 1; margin-bottom: 14px; }
  .dir.main { border-color: var(--acc); box-shadow: 0 0 0 1px var(--acc); }

  /* calculator */
  .calc { display: grid; grid-template-columns: 1.35fr 1fr; border-radius: 24px; overflow: hidden; border: 1px solid var(--line); }
  .calc-in { background: var(--surf); padding: 32px; }
  .crow { padding: 14px 0; border-top: 1px solid var(--line); }
  .crow label { display: block; }
  .cl { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .cl b { font-weight: 600; }
  .cl output { font-family: var(--mono); color: var(--accText); font-weight: 700; font-size: 18px; }
  input[type='range'] { width: 100%; accent-color: var(--acc); }
  .formula { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--mut); margin-top: 4px; }
  .formula [data-f] { font-family: var(--mono); color: var(--ink); }
  .seg { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0 4px; }
  .seg button { border: 1px solid var(--line); background: var(--bg); color: var(--mut); padding: 6px 12px; border-radius: 999px; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  .seg button[aria-pressed='true'] { background: var(--acc); border-color: var(--acc); color: var(--dark-ink); }
  .calc-out { background: var(--deep); color: var(--deepInk); padding: 32px; display: flex; flex-direction: column; justify-content: center; position: sticky; top: 0; }
  .big { font-size: clamp(52px, 8vw, 84px); font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--acc); }
  .per { color: var(--deepMut); margin-top: 6px; }
  .bars { display: flex; gap: 3px; height: 10px; margin: 24px 0 12px; background: var(--deepLine); border-radius: 99px; overflow: hidden; }
  .bars i { flex: 0 1 0; background: var(--acc); transition: flex-grow 0.4s; }
  .bars i:nth-child(2) { opacity: 0.8; } .bars i:nth-child(3) { opacity: 0.6; } .bars i:nth-child(4) { opacity: 0.45; } .bars i:nth-child(5) { opacity: 0.3; }
  .year { font-size: 20px; font-weight: 600; }
  .note { color: var(--deepMut); font-size: 13px; margin: 16px 0 20px; }
  .calc-out .btn { align-self: flex-start; }
  .calc-out { position: relative; }
  .vaxcalc { position: absolute; top: 18px; right: 18px; width: 150px; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .vaxcalc img { width: 118px; height: auto; filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.35)); }
  .vc-say { margin: 0; background: var(--acc); color: var(--dark-ink); font-size: 13px; font-weight: 700; line-height: 1.3; padding: 8px 11px; border-radius: 14px 14px 4px 14px; max-width: 180px; text-align: left; }
  @media (max-width: 900px) { .vaxcalc { position: static; flex-direction: row-reverse; align-items: center; width: auto; margin-bottom: 12px; } .vaxcalc img { width: 84px; } .vc-say { max-width: none; } }

  /* academy */
  .modules { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .modules li { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; }
  .modules .num { font-family: var(--mono); color: var(--accText); font-weight: 700; font-size: 15px; padding-top: 2px; }
  .modules h3 { font-size: 17px; margin: 0 0 2px; }
  .way.max { background: var(--deep); border-color: var(--deepLine); }
  .way.max h3 { color: var(--acc); }
  .way.max p { color: var(--deepMut); }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); counter-reset: s; }
  .steps li { counter-increment: s; }
  .steps li::before { content: counter(s); display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; background: var(--acc); color: var(--dark-ink); font-weight: 700; margin-bottom: 14px; }

  /* team + soon */
