---
// Examples of work: anonymized demo sites by niche (fictional businesses, clearly labeled). EN / UA / RU.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import CrossSell from './CrossSell.astro';
import { getDict, langPath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/examples/', ua: '/ua/examples/', ru: '/ru/examples/' };
const SITES = [
  { slug: 'cleaning', color: '#0e7490' },
  { slug: 'landscaping', color: '#15803d' },
  { slug: 'dental', color: '#2563eb' },
];

const C = {
  en: {
    title: 'Vaxo — Website examples for small businesses', desc: 'See what a Vaxo one-page website looks like: examples for cleaning, landscaping and dental offices.',
    eyebrow: 'Examples', h1: 'This is what your new website can look like',
    sub: 'Three sample sites for popular small-business niches. The businesses are made up, the design and the quote form are exactly what you get.',
    note: 'Fictional businesses: names, prices and phone numbers are examples.',
    open: 'Open example →', cta: 'Want one like this? $199 →',
    sites: [
      { niche: 'House cleaning', name: 'Sunny Nest Cleaning', what: 'Quote form, first-visit offer, before & after gallery.' },
      { niche: 'Landscaping', name: 'Green Acre Landscaping', what: 'Free estimate form, seasonal special, project photos.' },
      { niche: 'Dental office', name: 'Bright Oak Family Dental', what: 'Appointment request, new patient offer, office photos.' },
    ],
    incl: 'Every site includes', inclList: ['Works great on phones', 'Click-to-call button', 'Requests sent straight to your phone', 'Your real photos and reviews', 'Ready in 7 days'],
  },
  ru: {
    title: 'Vaxo — Примеры сайтов для малого бизнеса', desc: 'Как выглядит сайт-визитка от Vaxo: примеры для клининга, ландшафтного дизайна и стоматологии.',
    eyebrow: 'Примеры работ', h1: 'Так может выглядеть ваш новый сайт',
    sub: 'Три примера для популярных ниш малого бизнеса. Бизнесы вымышленные, а дизайн и форма заявки — ровно то, что вы получите.',
    note: 'Бизнесы вымышленные: названия, цены и телефоны — для примера. Сайты на английском (для клиентов в США).',
    open: 'Открыть пример →', cta: 'Хочу такой же — $199 →',
    sites: [
      { niche: 'Клининг', name: 'Sunny Nest Cleaning', what: 'Форма расчёта, скидка на первую уборку, фото «до и после».' },
      { niche: 'Ландшафт', name: 'Green Acre Landscaping', what: 'Форма бесплатной оценки, сезонное предложение, фото работ.' },
      { niche: 'Стоматология', name: 'Bright Oak Family Dental', what: 'Запись на приём, предложение для новых пациентов, фото клиники.' },
    ],
    incl: 'В каждом сайте', inclList: ['Удобно с телефона', 'Звонок в один клик', 'Заявки сразу на ваш телефон', 'Ваши настоящие фото и отзывы', 'Готово за 7 дней'],
  },
  ua: {
    title: 'Vaxo — Приклади сайтів для малого бізнесу', desc: 'Який вигляд має сайт-візитка від Vaxo: приклади для клінінгу, ландшафтного дизайну і стоматології.',
    eyebrow: 'Приклади робіт', h1: 'Ось який вигляд може мати ваш новий сайт',
    sub: 'Три приклади для популярних ніш малого бізнесу. Бізнеси вигадані, а дизайн і форма заявки — саме те, що ви отримаєте.',
    note: 'Бізнеси вигадані: назви, ціни й телефони — для прикладу. Сайти англійською (для клієнтів у США).',
    open: 'Відкрити приклад →', cta: 'Хочу такий самий — $199 →',
    sites: [
      { niche: 'Клінінг', name: 'Sunny Nest Cleaning', what: 'Форма розрахунку, знижка на перше прибирання, фото «до і після».' },
      { niche: 'Ландшафт', name: 'Green Acre Landscaping', what: 'Форма безкоштовної оцінки, сезонна пропозиція, фото робіт.' },
      { niche: 'Стоматологія', name: 'Bright Oak Family Dental', what: 'Запис на прийом, пропозиція для нових пацієнтів, фото клініки.' },
    ],
    incl: 'У кожному сайті', inclList: ['Зручно з телефона', 'Дзвінок в один клік', 'Заявки одразу на ваш телефон', 'Ваші справжні фото й відгуки', 'Готово за 7 днів'],
  },
}[lang];
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">{C.eyebrow}</div>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
      </div>
    </section>

    <section class="list">
      <div class="in grid">
        {C.sites.map((s, i) => (
          <a class="card" href={`/examples/${SITES[i].slug}/`} target="_blank" rel="noopener">
            <div class="thumb" style={`--c:${SITES[i].color}`}>
              <span class="bar"></span><span class="h"></span><span class="l"></span><span class="b"></span>
            </div>
            <div class="niche">{s.niche}</div>
            <h2>{s.name}</h2>
            <p>{s.what}</p>
            <span class="open">{C.open}</span>
          </a>
        ))}
      </div>
      <p class="in note">{C.note}</p>
    </section>

    <section class="incl">
      <div class="in">
        <h2 class="h2">{C.incl}</h2>
        <ul>{C.inclList.map((x) => <li>{x}</li>)}</ul>
        <a href="#contact" class="cta">{C.cta}</a>
      </div>
    </section>

    <CrossSell lang={lang} items={['done', 'partner']} />
    <Contact t={t} lang={lang} />
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<style>
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .hero { padding: 120px 0 40px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 18ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 58ch; margin: 0; }
  .list { padding: 16px 0 48px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card { display: block; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 16px 16px 22px; color: inherit; text-decoration: none; transition: transform .2s, border-color .2s; }
  .card:hover { transform: translateY(-3px); border-color: var(--acc); }
  .thumb { aspect-ratio: 16 / 10; border-radius: 12px; background: #f4f6f8; position: relative; overflow: hidden; margin-bottom: 16px; }
  .thumb span { position: absolute; left: 8%; border-radius: 6px; }
  .thumb .bar { top: 0; left: 0; right: 0; height: 12%; background: #fff; border-radius: 0; }
  .thumb .h { top: 26%; width: 62%; height: 12%; background: #1b1f24; opacity: .85; }
  .thumb .l { top: 44%; width: 48%; height: 6%; background: #9aa3ad; }
  .thumb .b { top: 60%; width: 26%; height: 12%; background: var(--c); }
  .niche { font-family: var(--mono); font-size: 13px; color: var(--accText); text-transform: uppercase; letter-spacing: .04em; }
  .card h2 { font-size: 21px; margin: 6px 0 8px; }
  .card p { color: var(--mut); margin: 0 0 14px; }
  .open { color: var(--accText); font-weight: 600; }
  .note { color: var(--mut); font-size: 14px; margin-top: 16px; }
  .incl { padding: 16px 0 72px; }
  .incl ul { list-style: none; padding: 0; margin: 20px 0 28px; display: flex; flex-wrap: wrap; gap: 10px; }
  .incl li { background: var(--surf); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; }
  .cta { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 14px 22px; border-radius: 999px; text-decoration: none; }
</style>
