const start = `${home}#contact`;
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="exm">
    <section class="hero">
      <div class="in">
        <p class="tagline">{C.eyebrow}</p>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
        <p class="sub how">{C.how}</p>
        <div class="acts"><a class="btn" href={start}>{C.cta}</a></div>
      </div>
    </section>

    <section class="in">
      <div class="filters" role="group" data-filters>
        {Object.entries(C.filters).map(([k, v], i) => <button type="button" data-f={k} aria-pressed={i === 0 ? 'true' : 'false'}>{v}</button>)}
      </div>
      <p class="only">ⓘ {C.only}</p>
      <div class="grid">
        {ITEMS.map(([type, slug, img], i) => (
          <article class="card" data-type={type} data-slug={slug} id={`ex-${slug}`}>
            <a class="thumb" href={`/examples/${slug}/?lang=${lang}`} target="_blank" rel="noopener">
              <img src={`/examples/thumbs/${img}`} alt={C.items[i][0]} loading="lazy" width="480" height="300" />
              <span class="type">{(C.types as Record<string, string>)[type.split(' ')[0]]}</span>
            </a>
            <div class="body">
              <h3>{C.items[i][0]}</h3>
              <p>{C.items[i][1]}</p>

              <div class="row">
                <a class="btn sm" href={`/examples/${slug}/?lang=${lang}`} target="_blank" rel="noopener">{C.open}</a>
                <a class="btn sm ghost" href={`${home === '/' ? '' : home.replace(/\/$/, '')}/app/#q=${encodeURIComponent(C.want + ': ' + C.items[i][0])}`}>{C.want}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="note">{C.note}</p>
    </section>

    <section class="in block">
      <div class="custom">
        <div><h2>{C.customH}</h2><p>{C.customP}</p></div>
        <a class="btn" href={start}>{C.cta2} →</a>
      </div>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  // Links from other pages land on the real work; the page's smooth scroll does not always finish on load.
  if (location.hash === '#real') document.getElementById('real')?.scrollIntoView({ behavior: 'instant' });
  const box = document.querySelector<HTMLElement>('[data-filters]');
  box?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-f]');
    if (!b) return;
    box.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    pick(b.dataset.f || 'all');
  });
  function pick(f: string) {
    box?.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.f === f)));
    document.querySelectorAll<HTMLElement>('.card[data-type]').forEach((c) => (c.hidden = f !== 'all' && !c.dataset.type!.split(' ').includes(f)));
  }
  // From the home page: ?cat=<tab>&ex=<example> opens this category with that example first and highlighted.
  {
    const q = new URLSearchParams(location.search), cat = q.get('cat') || '', ex = q.get('ex') || '';
    if (cat && box?.querySelector(`[data-f="${CSS.escape(cat)}"]`)) pick(cat);
    const card = ex ? document.getElementById('ex-' + ex) : null;
    if (card) { card.parentElement!.prepend(card); card.classList.add('hit'); setTimeout(() => card.scrollIntoView({ behavior: 'smooth', block: 'center' }), 200); }
  }
</script>

<style>
  .exm { padding-bottom: clamp(64px, 9vw, 116px); background: var(--bg); color: var(--ink); overflow-x: clip; }
  .in { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
  .hero { padding: clamp(96px, 14vw, 170px) 0 clamp(48px, 7vw, 84px); text-align: center; }
  .hero h1, .hero .sub { margin-left: auto; margin-right: auto; }
  .hero .acts { display: flex; justify-content: center; }
  .tagline { font: 500 12px/1 var(--mono, 'JetBrains Mono', monospace); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accText); margin: 0 0 18px; }
  h1 { font-weight: 600; font-size: clamp(38px, 6.4vw, 80px); line-height: 1.02; letter-spacing: -0.035em; margin: 0 0 26px; max-width: 16ch; }
  h2 { font-weight: 600; font-size: clamp(30px, 4.2vw, 54px); letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1.05; }
  h3 { margin: 0 0 6px; font-weight: 600; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; }
  .sub { color: var(--mut); font-size: clamp(17px, 1.7vw, 21px); line-height: 1.45; max-width: 620px; margin: 0 0 30px; }
  .sub.how { font-size: 14px; margin-top: -18px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 999px; background: var(--acc); color: var(--dark-ink); font-weight: 600; text-decoration: none; white-space: nowrap; }
