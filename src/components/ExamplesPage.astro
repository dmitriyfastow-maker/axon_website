---
// "Examples" (rebuilt 01.11.2026 for conversion): plain-language types (one-page site, site with booking, store, app),
// which plan each one comes with, a filter by type, "open it" + "I want one like this"; then real projects and custom
// work. Every demo is a working build with a fictional brand. EN / UA / RU.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, langPath, type Lang } from '../i18n';
import tricho from '../assets/images/tricho-hero.jpg';
import aipro from '../assets/images/aipro-hero.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/examples/', ua: '/ua/examples/', ru: '/ru/examples/' };

// [type key, slug, thumb, plan]
const ITEMS = [
  ['site', 'flagship', `flagship-${lang}.jpg`, 'Care · Growth · Pro'],
  ['marketing', 'marketing', `marketing-${lang}.jpg`, 'Growth · Pro'],
  ['app', 'ai-assistant', `ai-assistant-${lang}.jpg`, 'Care · Growth · Pro'],
  ['booking', 'eco-clinic', `eco-clinic-${lang}.jpg`, 'Growth'],
  ['shop', 'eco-shop', `eco-shop-${lang}.jpg`, 'Pro'],
  ['app', 'eco-crm', `eco-os-${lang}.jpg`, 'Care · Growth · Pro'],
  ['app', 'eco-partners', `eco-partners-${lang}.jpg`, 'Pro'],
  ['site', 'personal-brand', `personal-brand-${lang}.jpg`, 'Care · Growth · Pro'],
  ['shop', 'shop-2026', `shop-2026-${lang}.jpg`, 'Pro'],
  ['app', 'client-app', `client-app-${lang}.jpg`, 'Growth · Pro'],
] as const;

const C = {
  en: {
    title: 'Vaxo — Examples: websites, stores and apps you can click through', desc: 'Working examples of what Vaxo builds: one-page sites, sites with online booking, online stores, business apps. Included in your plan; anything custom on request.',
    eyebrow: 'Examples', h1: 'This is what you get. Open it and try it.',
    sub: 'Every example is a working build: click, book, chat with the AI. Yours is built around your business — and everything in your plan is already included.', how: 'How they are made: these are detailed builds by Vax from a full brief (the Pro level, one to three days). A site from one word in the chat is simpler and ready in a minute, and you can then improve it in words.',
    cta: 'I want one like this →', cta2: 'Describe your task',
    filters: { all: 'All', site: 'Websites', booking: 'Sites with booking', shop: 'Online stores', marketing: 'Marketing', app: 'Apps and CRM' },
    types: { site: 'Website', booking: 'Site with online booking', shop: 'Online store', marketing: 'Marketing', app: 'App' },
    items: [
      ['Flagship site', 'Motion, bold type, online orders and an AI barista. The level every site gets now.'],
      ['Marketing on autopilot', 'Ad creatives, AI posts, a content calendar and a requests report — every month.'],
      ['AI employee in every chat', 'Instagram, WhatsApp, Telegram: answers, books, takes payment. Try it yourself.'],
      ['Clinic + client app', 'Booking in 30 seconds, a client app with points, an owner CRM with AI reports.'],
      ['Store with an AI consultant', 'Search in your own words, AI in chat, smart cart, customer cabinet.'],
      ['Business app (CRM)', 'Requests, chats, team roles, ads and AI reports on one screen. Comes with every plan.'],
      ['Partner program', 'Personal links, live earnings, levels, payouts and an AI coach for partners.'],
      ['Personal brand', 'A site for an expert or a speaker: results, programs, newsletter and a booking calendar. In three languages.'],
      ['Shop 2026', 'An AI picks products from a sentence, one-click checkout, a free-shipping meter and order status in Telegram.'],
      ['Client app', 'Class booking, membership, chat with the coach and reminders. Opens from a link, no app store.'],
    ],
    plan: 'In plan', open: 'Open', want: 'I want one',
    note: 'The brands are made up — the functions are real. Your design, texts and functions follow your business.',
    realH: 'Already working for real clients', realSub: 'Built by our team and running today.',
    real: [['MedTech · AI platform', 'TrichoTech', 'AI image analysis, treatment plans and patient records for dermatologists.'], ['Partner platform', 'AiPro Partners', 'Partners, referral links, analytics and a promo store in one platform.'], ['Our own system', 'Vaxo + Vax AI', 'This site: an AI manager 24/7, client cabinets, project chats, invoices and a CRM.']],
    tryCta: 'Talk to Vax →',
    customH: 'Need something that is not here?', customP: 'An app, a bot, an integration, a game — for a business or a personal task. Vax names a fixed price upfront; you watch the progress live in your cabinet and can ask anything at any moment.',
  },
  ru: {
    title: 'Vaxo — Примеры: сайты, магазины и приложения, которые можно открыть', desc: 'Рабочие примеры того, что делает Vaxo: одностраничные сайты, сайты с онлайн-записью, интернет-магазины, приложения для бизнеса. Входят в тариф, кастом — по запросу.',
    eyebrow: 'Примеры', h1: 'Вот что вы получите. Откройте и попробуйте.',
    sub: 'Каждый пример — рабочий: нажимайте, записывайтесь, поговорите с ИИ. Ваш вариант соберём под ваш бизнес — и всё из тарифа уже включено.', how: 'Как они сделаны: это подробные сборки Vax по полному описанию (уровень Pro, от одного до трёх дней). Сайт по одному слову в чате проще и готов за минуту, дальше его можно улучшать словами.',
    cta: 'Хочу такой →', cta2: 'Описать задачу',
    filters: { all: 'Все', site: 'Сайты', booking: 'Сайты с записью', shop: 'Интернет-магазины', marketing: 'Маркетинг', app: 'Приложения и CRM' },
    types: { site: 'Сайт', booking: 'Сайт с онлайн-записью', shop: 'Интернет-магазин', marketing: 'Маркетинг', app: 'Приложение' },
    items: [
      ['Сайт-эталон', 'Движение, крупная типографика, заказ онлайн и ИИ-бариста. Такой уровень теперь получает каждый сайт.'],
      ['Маркетинг на автопилоте', 'Креативы, посты от ИИ, контент-план и отчёт по заявкам — каждый месяц.'],
      ['ИИ-сотрудник в каждом чате', 'Instagram, WhatsApp, Telegram: отвечает, записывает, принимает оплату. Попробуйте сами.'],
      ['Клиника + приложение клиента', 'Запись за 30 секунд, приложение клиента с баллами, CRM владельца с отчётами ИИ.'],
      ['Магазин с ИИ-консультантом', 'Поиск своими словами, ИИ в чате, умная корзина, кабинет покупателя.'],
      ['Приложение для бизнеса (CRM)', 'Заявки, переписки, роли команды, реклама и отчёты ИИ на одном экране. Входит в любой тариф.'],
      ['Партнёрская программа', 'Личные ссылки, заработок вживую, уровни, выплаты и ИИ-тренер для партнёров.'],
      ['Личный бренд', 'Сайт эксперта или спикера: результаты, программы, рассылка и календарь записи. На трёх языках.'],
      ['Магазин 2026', 'ИИ подбирает товары по фразе, оплата в один клик, шкала бесплатной доставки и статус заказа в Telegram.'],
      ['Приложение клиента', 'Запись на занятия, абонемент, чат с тренером и напоминания. Открывается по ссылке, без магазина приложений.'],
    ],
    plan: 'Тариф', open: 'Открыть', want: 'Хочу такой',
    note: 'Бренды придуманы — функции настоящие. Дизайн, тексты и функции подстроим под ваш бизнес.',
    realH: 'Уже работают у реальных клиентов', realSub: 'Сделаны нашей командой и работают сегодня.',
    real: [['Медтех · ИИ-платформа', 'TrichoTech', 'ИИ-анализ снимков, планы лечения и карты пациентов для дерматологов.'], ['Партнёрская платформа', 'AiPro Partners', 'Партнёры, реферальные ссылки, аналитика и промо-магазин в одной платформе.'], ['Наша собственная система', 'Vaxo + ИИ-менеджер Vax', 'Этот сайт: ИИ-менеджер 24/7, кабинеты клиентов, чаты проектов, счета и CRM.']],
    tryCta: 'Поговорить с Vax →',
    customH: 'Нужно то, чего здесь нет?', customP: 'Приложение, бот, интеграция, игра — для бизнеса или личная задача. Vax заранее называет точную цену, прогресс вы видите в кабинете в реальном времени и можете спросить что угодно в любой момент.',
  },
  ua: {
    title: 'Vaxo — Приклади: сайти, магазини й застосунки, які можна відкрити', desc: 'Робочі приклади того, що робить Vaxo: односторінкові сайти, сайти з онлайн-записом, інтернет-магазини, застосунки для бізнесу. Входять у тариф, кастом — на запит.',
    eyebrow: 'Приклади', h1: 'Ось що ви отримаєте. Відкрийте й спробуйте.',
    sub: 'Кожен приклад — робочий: натискайте, записуйтеся, поговоріть із ШІ. Ваш варіант зберемо під ваш бізнес — і все з тарифу вже включено.', how: 'Як їх зроблено: це детальні збірки Vax за повним описом (рівень Pro, від одного до трьох днів). Сайт за одним словом у чаті простіший і готовий за хвилину, далі його можна покращувати словами.',
    cta: 'Хочу такий →', cta2: 'Описати завдання',
    filters: { all: 'Усі', site: 'Сайти', booking: 'Сайти із записом', shop: 'Інтернет-магазини', marketing: 'Маркетинг', app: 'Застосунки і CRM' },
    types: { site: 'Сайт', booking: 'Сайт з онлайн-записом', shop: 'Інтернет-магазин', marketing: 'Маркетинг', app: 'Застосунок' },
    items: [
      ['Сайт-еталон', 'Рух, велика типографіка, замовлення онлайн і ШІ-бариста. Такий рівень тепер отримує кожен сайт.'],
      ['Маркетинг на автопілоті', 'Креативи, пости від ШІ, контент-план і звіт по заявках — щомісяця.'],
      ['ШІ-працівник у кожному чаті', 'Instagram, WhatsApp, Telegram: відповідає, записує, приймає оплату. Спробуйте самі.'],
      ['Клініка + застосунок клієнта', 'Запис за 30 секунд, застосунок клієнта з балами, CRM власника зі звітами ШІ.'],
      ['Магазин із ШІ-консультантом', 'Пошук своїми словами, ШІ в чаті, розумний кошик, кабінет покупця.'],
      ['Застосунок для бізнесу (CRM)', 'Заявки, листування, ролі команди, реклама і звіти ШІ на одному екрані. Входить у будь-який тариф.'],
      ['Партнерська програма', 'Особисті посилання, заробіток наживо, рівні, виплати і ШІ-тренер для партнерів.'],
      ['Особистий бренд', 'Сайт експерта чи спікера: результати, програми, розсилка і календар запису. Трьома мовами.'],
      ['Магазин 2026', 'ШІ добирає товари за фразою, оплата в один клік, шкала безкоштовної доставки й статус замовлення в Telegram.'],
      ['Застосунок клієнта', 'Запис на заняття, абонемент, чат із тренером і нагадування. Відкривається за посиланням, без магазину застосунків.'],
    ],
    plan: 'Тариф', open: 'Відкрити', want: 'Хочу такий',
    note: 'Бренди вигадані — функції справжні. Дизайн, тексти й функції підлаштуємо під ваш бізнес.',
    realH: 'Уже працюють у реальних клієнтів', realSub: 'Зроблені нашою командою і працюють сьогодні.',
    real: [['Медтех · ШІ-платформа', 'TrichoTech', 'ШІ-аналіз знімків, плани лікування й карти пацієнтів для дерматологів.'], ['Партнерська платформа', 'AiPro Partners', 'Партнери, реферальні посилання, аналітика і промо-магазин в одній платформі.'], ['Наша власна система', 'Vaxo + ШІ-менеджер Vax', 'Цей сайт: ШІ-менеджер 24/7, кабінети клієнтів, чати проєктів, рахунки і CRM.']],
    tryCta: 'Поговорити з Vax →',
    customH: 'Потрібно те, чого тут немає?', customP: 'Застосунок, бот, інтеграція, гра — для бізнесу чи особисте завдання. Vax заздалегідь називає точну ціну, прогрес ви бачите в кабінеті в реальному часі й можете запитати будь-що будь-коли.',
  },
}[lang];
const realImg = [tricho.src, aipro.src, `/examples/thumbs/vaxo.jpg`];
const start = `${home}#contact`;
---

<Base lang={lang} title={C.title} description={C.desc} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="exm">
    <section class="hero">
      <div class="in">
        <p class="tagline">{C.eyebrow}</p>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub}</p>
        <p class="sub how">{C.how}</p>
        <div class="acts"><a class="btn" href={start}>{C.cta}</a></div>
      </div>
    </section>

    <section class="in">
      <div class="filters" role="group" data-filters>
        {Object.entries(C.filters).map(([k, v], i) => <button type="button" data-f={k} aria-pressed={i === 0 ? 'true' : 'false'}>{v}</button>)}
      </div>
      <div class="grid">
        {ITEMS.map(([type, slug, img, plan], i) => (
          <article class="card" data-type={type}>
            <a class="thumb" href={`/examples/${slug}/?lang=${lang}`} target="_blank" rel="noopener">
              <img src={`/examples/thumbs/${img}`} alt={C.items[i][0]} loading="lazy" width="480" height="300" />
              <span class="type">{(C.types as Record<string, string>)[type]}</span>
            </a>
            <div class="body">
              <h3>{C.items[i][0]}</h3>
              <p>{C.items[i][1]}</p>
              <small class="plan">{C.plan}: <b>{plan}</b></small>
              <div class="row">
                <a class="btn sm" href={`/examples/${slug}/?lang=${lang}`} target="_blank" rel="noopener">{C.open}</a>
                <a class="btn sm ghost" href={start}>{C.want}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="note">{C.note}</p>
    </section>

    <section class="in block">
      <div class="custom">
        <div><h2>{C.customH}</h2><p>{C.customP}</p></div>
        <a class="btn" href={start}>{C.cta2} →</a>
      </div>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  // Links from other pages land on the real work; the page's smooth scroll does not always finish on load.
  if (location.hash === '#real') document.getElementById('real')?.scrollIntoView({ behavior: 'instant' });
  const box = document.querySelector<HTMLElement>('[data-filters]');
  box?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-f]');
    if (!b) return;
    box.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-type]').forEach((c) => (c.hidden = b.dataset.f !== 'all' && c.dataset.type !== b.dataset.f));
  });
</script>

<style>
  .exm { padding-bottom: clamp(64px, 9vw, 116px); background: var(--bg); color: var(--ink); overflow-x: clip; }
  .in { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
  .hero { padding: clamp(96px, 14vw, 170px) 0 clamp(48px, 7vw, 84px); text-align: center; }
  .hero h1, .hero .sub { margin-left: auto; margin-right: auto; }
  .hero .acts { display: flex; justify-content: center; }
  .tagline { font: 500 12px/1 var(--mono, 'JetBrains Mono', monospace); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accText); margin: 0 0 18px; }
  h1 { font-weight: 600; font-size: clamp(38px, 6.4vw, 80px); line-height: 1.02; letter-spacing: -0.035em; margin: 0 0 26px; max-width: 16ch; }
  h2 { font-weight: 600; font-size: clamp(30px, 4.2vw, 54px); letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1.05; }
  h3 { margin: 0 0 6px; font-weight: 600; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; }
  .sub { color: var(--mut); font-size: clamp(17px, 1.7vw, 21px); line-height: 1.45; max-width: 620px; margin: 0 0 30px; }
  .sub.how { font-size: 14px; margin-top: -18px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 999px; background: var(--acc); color: var(--dark-ink); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .btn:hover { filter: brightness(1.08); }
  .btn.sm { min-height: 40px; padding: 0 16px; font-size: 14px; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); font-weight: 600; }
  .btn.ghost:hover { filter: none; border-color: var(--acc); }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin: 0 0 28px; }
  .filters button { font: inherit; font-size: 14px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surf); color: var(--ink); cursor: pointer; }
  .filters button:hover { border-color: var(--acc); }
  .filters button[aria-pressed='true'] { background: var(--acc); color: var(--dark-ink); border-color: var(--acc); font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .card { border: 1px solid var(--line); border-radius: 18px; transition: border-color 0.2s; overflow: hidden; background: var(--surf); display: flex; flex-direction: column; }
  .card:hover { border-color: var(--acc); }
  .card[hidden] { display: none; }
  .thumb { position: relative; display: block; }
  .thumb img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; transition: transform 0.3s; }
  .card:hover .thumb img { transform: scale(1.03); }
  .type { position: absolute; left: 12px; top: 12px; background: var(--surf); color: var(--ink); border: 1px solid var(--line); font: 500 11px/1.3 var(--mono, monospace); letter-spacing: 0.05em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; }
  .body { padding: 18px 20px 20px; display: grid; gap: 6px; flex: 1; align-content: start; }
  .body p { margin: 0; color: var(--mut); font-size: 15.5px; line-height: 1.5; }
  .plan { color: var(--mut); }
  .plan b { color: var(--accText); }
  .row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .note { color: var(--mut); font-size: 15px; margin: 22px 0 0; text-align: center; }
  .block { padding-top: clamp(64px, 9vw, 116px); scroll-margin-top: 40px; }
  .real { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .rcard { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--surf); text-decoration: none; color: inherit; transition: border-color 0.2s; }
  .rcard:hover { border-color: var(--acc); }
  .rcard img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .rcard div { padding: 16px 18px 18px; display: grid; gap: 6px; }
  .rcard p { margin: 0; color: var(--mut); font-size: 15.5px; line-height: 1.5; }
  .tag { color: var(--accText); font: 500 11px/1.3 var(--mono, monospace); text-transform: uppercase; letter-spacing: 0.05em; }
  .go { color: var(--accText); font-weight: 600; }
  .custom { display: flex; gap: 24px; align-items: center; justify-content: space-between; padding: clamp(24px, 4vw, 44px); border-radius: 18px; border: 1px solid var(--line); background: var(--surf2); color: var(--ink); }
  .custom p { margin: 0; max-width: 62ch; color: var(--mut); font-size: 17px; line-height: 1.5; }
  @media (max-width: 960px) { .grid, .real { grid-template-columns: repeat(2, minmax(0, 1fr)); } .custom { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 560px) { .grid, .real { grid-template-columns: minmax(0, 1fr); } .custom .btn { width: 100%; white-space: normal; } }
</style>
