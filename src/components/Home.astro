<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hq = document.querySelector<HTMLFormElement>('[data-ask]');
  const input = hq?.querySelector('input');
  const askVax = (q: string) => { const a = document.createElement('a'); a.href = '#'; a.setAttribute('data-vax-chat', ''); a.dataset.vaxAsk = q; a.hidden = true; document.body.appendChild(a); a.click(); a.remove(); };
  document.querySelectorAll<HTMLFormElement>('[data-ask], [data-ask2]').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const i = f.querySelector('input')!; const q = i.value.trim();
    if (!q) { i.focus(); return; }
    i.value = ''; askVax(q);
  }));
  const toTop = () => { window.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' }); setTimeout(() => input?.focus({ preventScroll: true }), 500); };
  if (location.hash === '#contact') setTimeout(() => input?.focus({ preventScroll: true }), 400);

  // The placeholder shows what people can ask.
  if (hq && input && !calm) {
    let ph: string[] = []; try { ph = JSON.parse(hq.dataset.ph || '[]'); } catch { /* none */ }
    let n = 0;
    setInterval(() => { n = (n + 1) % ph.length; input.placeholder = ph[n]; }, 3200);
  }

  // Product window: three scenes; rotates only while on screen and until the visitor picks one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-s]')], scenes = [...document.querySelectorAll<HTMLElement>('.sc')];
  let cur = 0, auto = true, seen = false;
  const show = (n: number) => { cur = n; tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === n))); scenes.forEach((s, i) => s.classList.toggle('on', i === n)); };
  tabs.forEach((t, i) => (t.onclick = () => { auto = false; show(i); }));
  const app = document.querySelector('.app');
  if (app && 'IntersectionObserver' in window) new IntersectionObserver((e) => { seen = e[0].isIntersecting; }).observe(app);
  if (!calm) setInterval(() => { if (auto && seen) show((cur + 1) % scenes.length); }, 7000);

  // Plans: one tap + an email starts the free month (the lead opens the private project chat). Start = just ask Vax.
  const dlg = document.querySelector<HTMLDialogElement>('[data-pdlg]');
  const pf = document.querySelector<HTMLFormElement>('[data-pform]');
  let planSlug = '', planName = '';
  document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((b) => (b.onclick = () => {
    if (b.dataset.plan === 'start') { toTop(); return; }
    planSlug = b.dataset.plan || ''; planName = b.dataset.pn || '';
    const nm = dlg?.querySelector('[data-pname]'); if (nm) nm.textContent = planName;
    const pm = dlg?.querySelector('[data-pmsg]'); if (pm) pm.textContent = '';
    dlg?.showModal?.();
    setTimeout(() => pf?.querySelector<HTMLInputElement>('[name=email]')?.focus(), 50);
  }));
  dlg?.querySelector('[data-pclose]')?.addEventListener('click', () => dlg.close());
  const pstart = Date.now();
  pf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(pf); const email = String(d.get('email') || '').trim();
    const pm = pf.querySelector<HTMLElement>('[data-pmsg]')!;
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { pm.textContent = pf.dataset.bad || ''; return; }
    const btn = pf.querySelector<HTMLButtonElement>('button[type=submit]')!; btn.disabled = true; pm.textContent = '…';
    let ref = ''; try { ref = localStorage.getItem('vaxo_ref') || ''; } catch {}
    const r = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Vx-Src': (window as unknown as { vxSrc?: () => string }).vxSrc?.() || '' },
      body: JSON.stringify({ mode: 'request', interest: 'any', name: email.split('@')[0], contact: email, lang: document.documentElement.lang === 'uk' ? 'ua' : document.documentElement.lang, ref, website: d.get('website'), startedAt: Math.min(pstart, Date.now() - 2500), message: `[PLAN ${planSlug}] ${planName}: start the free first month` }) }).catch(() => null);
    const out = r ? await r.json().catch(() => null) : null;
    if (r?.ok && out?.room) { location.href = `/room/?t=${out.room}`; return; }
    btn.disabled = false; pm.textContent = r?.status === 400 ? (pf.dataset.bad || '') : (pf.dataset.fail || '');
  });
</script>

