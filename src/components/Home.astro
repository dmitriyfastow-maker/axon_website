---
// Home page v2 (Dmitry, 07.11.2026): one dark surface from top to bottom. First screen: headline, subheadline, input.
// Then the product itself (real Vax answers, shortened), what is instant and what is real work, the four sections of
// Vaxo with interface mock-ups, plans with one focus offer, questions. Only promises that work today.
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const P = (p: string) => (lang === 'en' ? p : `/${lang}${p}`);

const T = {
  ru: {
    h1: ['Скажите, что нужно.', 'Vax берётся за дело.'],
