    s2: { q: 'Разложи по шагам запуск онлайн-курса', a: 'Начните с аудитории, а не с видео. Вот весь путь.', t: 'Запуск онлайн-курса', n: '2/7', i: ['Анализ целевой аудитории и их болей', 'Программа и структура курса', 'Первая минимальная версия', 'Платформа для обучения', 'Контент: видео, тексты, задания', 'Воронка продаж и прогрев', 'Рекламная кампания'] },
