const ava = '/mascot/vax-happy.webp';
---

<main class="hm" id="top">
  <section class="hero">
    <div class="w">
      <h1>{T.h1[0]}<span>{T.h1[1]}</span></h1>
      <p class="lead">{T.sub}</p>
      <form class="ask" data-ask id="contact" data-ph={JSON.stringify(T.ph)}>
        <input name="q" type="text" maxlength="400" autocomplete="off" placeholder={T.ph[0]} aria-label={T.askL} />
        <button type="submit">{T.go}</button>
      </form>
    </div>
  </section>

  <section class="sec" id="get">
    <div class="w">
      <p class="tag">{T.showT}</p>
      <div class="top"><h2>{T.showH[0]}<br />{T.showH[1]}</h2><p>{T.showP}</p></div>
      <div class="seg" role="tablist">{T.tabs.map((x, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-s={i}>{x}</button>)}</div>
      <div class="app">
        <aside class="side">
          <span class="lg">VAXO<i>.</i></span>
          {T.side.map((x, i) => <span class:list={['nv', { on: i === 0 }]}>{x}</span>)}
          <div class="al">{T.allow}<i></i></div>
        </aside>
        <div class="talk">
          <div class="log">
            <div class="sc on">
              <div class="me">{T.s1.q}</div>
              <div class="vx"><img src={ava} alt="Vax" width="34" height="34" loading="lazy" /><div><p>{T.s1.a}</p>
                <div class="tl"><h3>{T.s1.t}</h3>
                  <div class="kv">{T.s1.f.map(([k, v]) => <div>{k}<b>{v}</b></div>)}</div>
                  <div class="kv out">{T.s1.o.map(([k, v]) => <div>{k}<b>{v}</b></div>)}</div>
                </div></div></div>
            </div>
            <div class="sc">
              <div class="me">{T.s2.q}</div>
              <div class="vx"><img src={ava} alt="Vax" width="34" height="34" loading="lazy" /><div><p>{T.s2.a}</p>
                <div class="tl"><h3>{T.s2.t}<em>{T.s2.n}</em></h3>
                  <ul class="chk">{T.s2.i.map((x, i) => <li class:list={{ d: i < 2 }}><s></s>{x}</li>)}</ul>
                </div></div></div>
            </div>
            <div class="sc">
              <div class="me">{T.s3.q}</div>
              <div class="vx"><img src={ava} alt="Vax" width="34" height="34" loading="lazy" /><div><p>{T.s3.a}</p>
                <div class="tl"><h3>{T.s3.t}</h3><small>{T.s3.n}</small><div class="yes"><span>{T.s3.y}</span><span>{T.s3.x}</span></div></div></div></div>
            </div>
          </div>
          <div class="box">{T.box}</div>
        </div>
      </div>
      <p class="cap">{T.cap}</p>
    </div>
  </section>

  <section class="sec alt">
    <div class="w">
      <h2>{T.getH}</h2>
      <div class="two">
        <div><h3>{T.now}</h3><ul>{T.nowL.map((x) => <li>{x}</li>)}</ul></div>
