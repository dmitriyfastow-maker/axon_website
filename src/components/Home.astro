      <div class="tali" data-tali data-phrases={JSON.stringify(C.tali)}><img src="/mascot/vax-happy.webp" alt="Vax" width="72" height="72" loading="lazy" /><span data-tali-t>{C.tali[0]}</span></div>
      <a class="all" href={P('/examples/')}>{C.allDemos} →</a>
    </div>
  </section>

  <section class="sec rv" id="pricing">
    <div class="in">
      <h2>{C.priceH}</h2>
      <p class="sub">{C.priceSub}</p>
      <div class="plans">
        {[HQ.start, ...C.plans].map(([n, v, tag, d, sc], i) => (
          <div class:list={['plan', { mid: i === 3 }]}>
            <div class="cap" aria-hidden="true"><i style={`--w:${[4, 16, 36, 66, 100][i]}%`}></i></div>
            <div class="pb">
              <small class="tag">{tag}</small>
              <b>{n}</b>
              <span class="v">{v}<small>{C.mo}</small></span>
              <p>{d}</p>
              <em class="sc">{sc}</em>
              <button type="button" class:list={['btn', 'pbtn', { ghost: i === 0 }]} data-plan={['start', 'personal', 'care', 'growth', 'pro'][i]} data-pn={n}>{i === 0 ? HQ.btnStart : HQ.btnTrial}</button>
            </div>
          </div>
        ))}
        <div class="plan custom">
          <div class="pb">
            <small class="tag">✨</small>
            <b>{C.custom[0]}</b>
            <p>{C.custom[1]}</p>
            <a class="btn" href="#" data-focus-hq>{C.custom[2]} →</a>
          </div>
        </div>
      </div>
      <p class="pnote">{C.priceNote}</p>
      <p class="pnote"><a href={`${lang === 'en' ? '' : '/' + lang}/how/`}>{{ en: 'How Vaxo works →', ru: 'Как работает Vaxo →', ua: 'Як працює Vaxo →' }[lang]}</a> · <a href={`${lang === 'en' ? '' : '/' + lang}/score/`}>{{ en: 'Free Vaxo Score →', ru: 'Бесплатный Vaxo Score →', ua: 'Безкоштовний Vaxo Score →' }[lang]}</a></p>
      <details class="lim">
        <summary>{C.limH}</summary>
        <p class="sub">{C.limP}</p>
        <div class="limg">{C.lim.map(([e, h, tx]) => <article><span>{e}</span><h4>{h}</h4><p>{tx}</p></article>)}</div>
      </details>
      <details class="more">
        <summary>{C.more}</summary>
        <div class="full">{C.planFull.map(([h, li]) => <div><h4>{h}</h4><ul>{(li as string[]).map((x) => <li>{x}</li>)}</ul></div>)}</div>
      </details>
    </div>
  </section>


  <section class="sec" id="faq">
    <div class="in narrow">
      <h2>{C.faqH}</h2>
      {C.faq.slice(-4).concat(C.faq.slice(0, 2)).map(([q, a]) => <details class="qa"><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <a class="sticky" href="#top" data-focus-hq>{C.sticky} →</a>
<dialog class="pdlg" data-pdlg>
    <form data-pform novalidate data-bad={HQ.dbad} data-fail={HQ.dfail}>
      <button type="button" class="x" data-pclose aria-label="×">×</button>
      <h3 data-pname></h3>
      <p>{HQ.dnote}</p>
      <input type="email" name="email" required autocomplete="email" placeholder={HQ.demail} aria-label={HQ.demail} />
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn wide" type="submit">{HQ.dgo}</button>
      <p class="pm" data-pmsg role="status"></p>
    </form>
  </dialog>
</main>

<script>
  const hq = document.querySelector<HTMLFormElement>('[data-hq]');
  const askVax = (q: string) => { const a = document.createElement('a'); a.href = '#'; a.setAttribute('data-vax-chat', ''); a.dataset.vaxAsk = q; a.hidden = true; document.body.appendChild(a); a.click(); a.remove(); };
  hq?.addEventListener('submit', (e) => { e.preventDefault(); const inp = hq.elements.namedItem('q') as HTMLInputElement; const q = inp.value.trim(); if (!q) { inp.focus(); return; } inp.value = ''; askVax(q); });

  // Live tools (Decision 37): three real micro-apps on the landing page; "make my own" opens Vax with a ready request.
  {
    const sec = document.querySelector<HTMLElement>('#tools');
    if (sec) {
      let cur = '1';
      const $$ = (q: string) => [...sec.querySelectorAll<HTMLElement>(q)];
      $$('[data-tab]').forEach((b) => (b.onclick = () => { cur = b.dataset.tab || '1'; $$('[data-tab]').forEach((x) => x.classList.toggle('on', x === b)); $$('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== cur)); }));
      const val = (k: string) => { const e = sec.querySelector<HTMLInputElement>(`[data-k="${k}"]`); return e ? Number(e.value) || 0 : 0; };
      const sv = (k: string) => (sec.querySelector<HTMLSelectElement>(`[data-k="${k}"]`)?.value || '');
      const calc = () => {
        const w = val('wt'), base = 10 * w + 6.25 * val('ht') - 5 * val('age') + (sv('sex') === 'm' ? 5 : -161);
        const kcal = Math.round(base * Number(sv('act')) * Number(sv('goal')));
        const pro = Math.round(1.8 * w), fat = Math.round((kcal * 0.25) / 9), carb = Math.max(0, Math.round((kcal - pro * 4 - fat * 9) / 4));
        const set = (o: string, v: number) => { const e = sec.querySelector(`[data-o="${o}"]`); if (e) e.textContent = String(v); };
        set('kcal', kcal); set('pro', pro); set('fat', fat); set('carb', carb);
      };
      sec.querySelectorAll('[data-pane="1"] input, [data-pane="1"] select').forEach((e) => e.addEventListener('input', calc)); calc();
      const fv = (k: string) => Number(sec.querySelector<HTMLInputElement>(`[data-f="${k}"]`)?.value) || 0;
      const fun = () => {
        const leads = Math.round(fv('vis') * fv('c1') / 100), sales = Math.round(leads * fv('c2') / 100), rev = sales * fv('chk');
        const set = (o: string, v: string) => { const e = sec.querySelector(`[data-fo="${o}"]`); if (e) e.textContent = v; };
        set('leads', String(leads)); set('sales', String(sales)); set('rev', '$' + rev.toLocaleString('en-US'));
      };
      sec.querySelectorAll('[data-pane="3"] input').forEach((e) => e.addEventListener('input', fun)); fun();
      type Task = { t: string; d: boolean };
      let tasks: Task[] = []; try { tasks = JSON.parse(localStorage.getItem('vaxo_demo_tasks') || '[]'); } catch {}
      const list = sec.querySelector<HTMLElement>('[data-list]')!, prog = sec.querySelector<HTMLElement>('[data-prog]')!;
      const draw = () => {
        try { localStorage.setItem('vaxo_demo_tasks', JSON.stringify(tasks)); } catch {}
        list.replaceChildren(...tasks.map((k, n) => { const li = document.createElement('li'); if (k.d) li.className = 'd'; const c = document.createElement('input'); c.type = 'checkbox'; c.checked = k.d; c.onchange = () => { k.d = c.checked; draw(); }; const sp = document.createElement('span'); sp.textContent = k.t; li.append(c, sp); return li; }));
        prog.textContent = tasks.length ? `${tasks.filter((k) => k.d).length}/${tasks.length} ${sec.dataset.done || ''}` : '';
      };
      sec.querySelector<HTMLInputElement>('[data-add]')!.addEventListener('keydown', (e) => { const i = e.currentTarget as HTMLInputElement; if (e.key === 'Enter' && i.value.trim()) { tasks.push({ t: i.value.trim(), d: false }); i.value = ''; draw(); } });
      sec.querySelector<HTMLElement>('[data-clr]')!.onclick = () => { tasks = tasks.filter((k) => !k.d); draw(); };
      draw();
      const asks = JSON.parse(sec.dataset.asks || '{}');
      sec.querySelector<HTMLElement>('[data-mine]')!.onclick = () => askVax(asks[cur] || '');
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-hqc]').forEach((b) => (b.onclick = () => askVax(b.dataset.hqc || '')));
  document.querySelectorAll<HTMLButtonElement>('.tc').forEach((b) => (b.onclick = () => askVax(b.dataset.try || '')));
  if (location.hash === '#contact') setTimeout(() => hq?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true }), 400);
  const toTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); setTimeout(() => hq?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true }), 500); };
  document.querySelectorAll<HTMLElement>('[data-focus-hq]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); toTop(); }));
  // Plans: one tap + an email starts the free month (the lead opens the private project chat). Start = just ask Vax.
  const dlg = document.querySelector<HTMLDialogElement>('[data-pdlg]');
  const pf = document.querySelector<HTMLFormElement>('[data-pform]');
  let planSlug = '', planName = '';
  document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((b) => (b.onclick = () => {
    if (b.dataset.plan === 'start') { toTop(); return; }
    planSlug = b.dataset.plan || ''; planName = b.dataset.pn || '';
    const nm = dlg?.querySelector('[data-pname]'); if (nm) nm.textContent = planName;
    const pm = dlg?.querySelector('[data-pmsg]'); if (pm) pm.textContent = '';
    dlg?.showModal?.();
    setTimeout(() => pf?.querySelector<HTMLInputElement>('[name=email]')?.focus(), 50);
  }));
  dlg?.querySelector('[data-pclose]')?.addEventListener('click', () => dlg.close());
  const pstart = Date.now();
  pf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(pf); const email = String(d.get('email') || '').trim();
    const pm = pf.querySelector<HTMLElement>('[data-pmsg]')!;
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { pm.textContent = pf.dataset.bad || ''; return; }
    const btn = pf.querySelector<HTMLButtonElement>('button[type=submit]')!; btn.disabled = true; pm.textContent = '…';
    let ref = ''; try { ref = localStorage.getItem('vaxo_ref') || ''; } catch {}
    const r = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Vx-Src': (window as unknown as { vxSrc?: () => string }).vxSrc?.() || '' },
      body: JSON.stringify({ mode: 'request', interest: 'any', name: email.split('@')[0], contact: email, lang: document.documentElement.lang === 'uk' ? 'ua' : document.documentElement.lang, ref, website: d.get('website'), startedAt: Math.min(pstart, Date.now() - 2500), message: `[PLAN ${planSlug}] ${planName}: start the free first month` }) }).catch(() => null);
    const out = r ? await r.json().catch(() => null) : null;
    if (r?.ok && out?.room) { location.href = `/room/?t=${out.room}`; return; }
    btn.disabled = false; pm.textContent = r?.status === 400 ? (pf.dataset.bad || '') : (pf.dataset.fail || '');
  });
  document.querySelectorAll<HTMLElement>('[data-tali]').forEach((el) => {
    let ph: string[] = []; try { ph = JSON.parse(el.dataset.phrases || '[]'); } catch { /* none */ }
    const t = el.querySelector('[data-tali-t]'); let n = 0;
    if (t && ph.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { n = (n + 1) % ph.length; t.textContent = ph[n]; }, 6000);
  });
  // Sections fade up as they enter the screen.
  const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('seen'), io!.unobserve(e.target))), { rootMargin: '0px 0px -10% 0px' }) : null;
  document.querySelectorAll('.rv').forEach((el) => (io ? io.observe(el) : el.classList.add('seen')));

  // Hero: one task after another — request, Vax's plan, live progress, result (not a business screenshot).
  const st = document.querySelector<HTMLElement>('[data-stage]');
  if (st) {
    const S = JSON.parse(st.dataset.scenes!) as [string, string, string, string[], string][];
    const q = (k: string) => st.querySelector<HTMLElement>(`[data-${k}]`)!;
    let i = 0;
    const play = () => {
      const [ask, ans, title, steps, res] = S[i % S.length];
      st.classList.remove('on'); void st.offsetWidth;
      q('q').textContent = ask; q('a').textContent = ans; q('t').textContent = title; q('r').textContent = res;
      q('steps').innerHTML = steps.map((x) => `<li>${x}</li>`).join('');
      st.classList.add('on');
      i++;
    };
    play();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(play, 9500);
  }

  // Two steps, no "form" feeling: first the task (chips fill it), then only name + contact → the private project chat.
  const f = document.querySelector<HTMLFormElement>('[data-start]');
  if (f) {
    const M = JSON.parse(f.dataset.msg!) as Record<string, string>;
    const msg = f.querySelector<HTMLElement>('[data-smsg]')!;
    const task = f.querySelector<HTMLTextAreaElement>('[name=task]')!;
    const s1 = f.querySelector<HTMLElement>('[data-s1]')!, s2 = f.querySelector<HTMLElement>('[data-s2]')!;
    const started = Date.now();
    f.querySelectorAll<HTMLButtonElement>('.chips button').forEach((b) => (b.onclick = () => {
      const v = b.textContent || '';
      if (!task.value.includes(v)) task.value = task.value ? `${task.value.trim().replace(/[:,]$/, '')}, ${v.toLowerCase()}` : `${v}: `;
      task.focus();
    }));
    const go = () => {
      if (task.value.trim().replace(/[:,\s]+$/, '').length < 3) { msg.textContent = M.err; task.focus(); return; }
      msg.textContent = ''; s1.hidden = true; s2.hidden = false;
      f.querySelector<HTMLInputElement>('[name=name]')!.focus();
    };
    f.querySelector<HTMLButtonElement>('[data-go]')!.onclick = go;
    task.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) go(); });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const name = String(d.get('name') || '').trim(), contact = String(d.get('contact') || '').trim();
      if (!name || contact.length < 4) { msg.textContent = M.err2; return; }
      let ref = '';
      try { ref = localStorage.getItem('vaxo_ref') || ''; } catch {}
      const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true; msg.textContent = M.sending;
      const r = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Vx-Src': (window as unknown as { vxSrc?: () => string }).vxSrc?.() || '' },
        body: JSON.stringify({ mode: 'request', interest: 'any', name, contact, lang: f.dataset.lang, ref, website: d.get('website'), startedAt: Math.min(started, Date.now() - 2500), message: task.value.trim() || '—' }),
      }).catch(() => null);
      const out = r ? await r.json().catch(() => null) : null;
      if (r?.ok && out?.room) { location.href = `/room/?t=${out.room}`; return; }
      btn.disabled = false;
      msg.textContent = r?.status === 400 ? M.err2 : M.fail;
    });
  }
</script>

