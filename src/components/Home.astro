    s1: { q: 'Порахуй юніт-економіку підписки: $39 на місяць, клієнт залишається 8 місяців, залучення коштує $60', a: 'Клієнт приносить $312, на залучення йде $60. Окупність 5,2×: модель стійка.', t: 'Юніт-економіка підписки', f: [['Ціна', '$39'], ['Строк клієнта', '8 міс'], ['Залучення', '$60']], o: [['Виручка з клієнта', '$312'], ['LTV / CAC', '5,2×'], ['Залишається з клієнта', '$252']] },
