    exa: ['Живі приклади', 'Робочі сторінки, які можна відкрити й спробувати.', 'Дивитися'],
    cab: ['Кабінет клієнта', 'Ваші проєкти, оплати й інструменти.', 'До кабінету', ['Готовність проєкту', 'Запас на сьогодні', 'Мої інструменти', 'Рахунок оплачено']],
