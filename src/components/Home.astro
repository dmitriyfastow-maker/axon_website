        <p class="tn"><span data-prog></span> <button type="button" class="lnk" data-clr>{TL.clear}</button></p>
      </div>
      <div class="tool" data-pane="3" hidden>
        <div class="tgrid">
          <label>{TL.vis}<input type="number" data-f="vis" value="3000" min="0" /></label>
          <label>{TL.c1}<input type="number" data-f="c1" value="3" min="0" max="100" step="0.1" /></label>
          <label>{TL.c2}<input type="number" data-f="c2" value="20" min="0" max="100" step="0.1" /></label>
          <label>{TL.chk}<input type="number" data-f="chk" value="150" min="0" /></label>
        </div>
        <div class="res"><div><b data-fo="leads">—</b><span>{TL.leads}</span></div><div><b data-fo="sales">—</b><span>{TL.sales}</span></div><div><b data-fo="rev">—</b><span>{TL.rev}</span></div></div>
