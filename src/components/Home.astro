    s2: { q: 'Break an online course launch into steps', a: 'Start with the audience, not the videos. Here is the whole path.', t: 'Online course launch', n: '2/7', i: ['Research the audience and its problems', 'Course program and structure', 'First minimal version', 'Learning platform', 'Content: video, text, assignments', 'Sales funnel and warm-up', 'Ad campaign'] },
