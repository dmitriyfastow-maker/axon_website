---

<main class="home" id="top">
  <section class="hero">
    <div class="aur" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="in hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{C.eyebrow}</p>
        <h1 class="kin">{C.h1[0].split(' ').map((w, i) => <><span style={`--i:${i}`}>{w}</span>{' '}</>)}<span class="hl">{C.h1[1].split(' ').map((w, i) => <><span style={`--i:${i + 4}`}>{w}</span>{' '}</>)}</span></h1>
        <p class="lead">{C.sub}</p>
        <form class="hq" data-hq id="contact">
          <input name="q" type="text" maxlength="400" autocomplete="off" placeholder={HQ.ph} aria-label={HQ.ph} />
          <button class="btn" type="submit">{HQ.go}</button>
        </form>
        <div class="hqc">{C.tryCards.slice(0, 3).map(([e, tx]) => <button type="button" data-hqc={tx}>{e} {tx}</button>)}</div>
        <a class="hint" href="#get">{HQ.hint}</a>
        <ul class="trust">{C.trust.map((x) => <li>✓ {x}</li>)}</ul>
      </div>
    </div>
  </section>


  <section class="sec rv" id="get">
    <div class="in">
      <div class="ben">{HQ.ben.map(([e, h, tx]) => <article><span>{e}</span><h3>{h}</h3><p>{tx}</p></article>)}</div>
    </div>
  </section>

  <section class="sec how rv">
    <div class="in">
      <h2>{C.howH}</h2>
      <ol class="steps">{C.how.map(([h, p], i) => <li><span class="n">{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}</ol>
    </div>
  </section>

  <section class="sec rv" id="tools" data-asks={JSON.stringify(TL.mineAsk)} data-done={TL.done}>
    <div class="in">
      <h2>{TL.h}</h2>
      <p class="sub">{TL.s}</p>
      <div class="tabs" role="tablist"><button type="button" class="on" data-tab="1">🥗 {TL.t1}</button><button type="button" data-tab="2">✅ {TL.t2}</button><button type="button" data-tab="3">📈 {TL.t3}</button></div>
      <div class="tool" data-pane="1">
        <div class="tgrid">
          <label>{TL.sex}<select data-k="sex"><option value="m">{TL.m}</option><option value="f">{TL.f}</option></select></label>
          <label>{TL.age}<input type="number" data-k="age" value="30" min="14" max="90" /></label>
          <label>{TL.ht}<input type="number" data-k="ht" value="175" min="120" max="220" /></label>
          <label>{TL.wt}<input type="number" data-k="wt" value="75" min="35" max="250" /></label>
          <label>{TL.act}<select data-k="act"><option value="1.2">{TL.a1}</option><option value="1.375" selected>{TL.a2}</option><option value="1.55">{TL.a3}</option><option value="1.725">{TL.a4}</option></select></label>
          <label>{TL.goal}<select data-k="goal"><option value="0.85">{TL.g1}</option><option value="1" selected>{TL.g2}</option><option value="1.1">{TL.g3}</option></select></label>
        </div>
        <div class="res"><div><b data-o="kcal">—</b><span>{TL.kcal}</span></div><div><b data-o="pro">—</b><span>{TL.pro}</span></div><div><b data-o="fat">—</b><span>{TL.fat}</span></div><div><b data-o="carb">—</b><span>{TL.carb}</span></div></div>
        <p class="tn">{TL.note}</p>
      </div>
      <div class="tool" data-pane="2" hidden>
        <input class="tadd" type="text" maxlength="80" placeholder={TL.add} data-add />
