---
// Shop: ready-made templates and guides for small businesses (sold via Gumroad).
// Each product: what = { en, ua, ru } (the templates themselves are in English). Set `url` to the Gumroad link once the store is registered; empty = "Coming soon".
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AiPluses from './AiPluses.astro';
import CrossSell from './CrossSell.astro';
import { getDict, langPath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const home = langPath(lang);
const alts = { en: '/shop/', ua: '/ua/shop/', ru: '/ru/shop/' };
const startHref = lang === 'en' ? '/start/' : `/${lang}/start/`;

const products = [
  {
    slug: 'ai-prompt-pack',
    name: 'AI Prompt Pack for Small Business',
    price: '$12',
    format: 'PDF · 13 pages',
    what: { en: '100 copy-and-paste prompts for ChatGPT, Claude and Gemini: marketing, sales, customer replies, planning.', ua: '100 готових промптів для ChatGPT, Claude і Gemini: маркетинг, продажі, відповіді клієнтам, планування.', ru: '100 готовых промптов для ChatGPT, Claude и Gemini: маркетинг, продажи, ответы клиентам, планирование.' },
    url: '',
  },
  {
    slug: 'lead-tracker',
    name: 'Lead & Client Tracker',
    price: '$9',
    format: 'Excel / Google Sheets',
    what: { en: 'A simple CRM spreadsheet: every inquiry, its status and next step, with a summary of where clients come from.', ua: 'Проста CRM-таблиця: кожна заявка, її статус і наступний крок, плюс зведення — звідки приходять клієнти.', ru: 'Простая CRM-таблица: каждая заявка, её статус и следующий шаг, плюс сводка — откуда приходят клиенты.' },
    url: '',
  },
  {
    slug: 'message-templates',
    name: '50 Customer Message Templates',
    price: '$9',
    format: 'PDF · 11 pages',
    what: { en: 'Ready texts for inquiries, bookings, quotes, reminders, reviews and complaints. For SMS, WhatsApp, DMs and email.', ua: 'Готові тексти для заявок, запису, кошторисів, нагадувань, відгуків і скарг. Для SMS, WhatsApp, директу та пошти.', ru: 'Готовые тексты для заявок, записи, смет, напоминаний, отзывов и жалоб. Для SMS, WhatsApp, директа и почты.' },
    url: '',
  },
  {
    slug: 'marketing-workbook',
    name: '90-Day Marketing Plan Workbook',
    price: '$12',
    format: 'Printable PDF',
    what: { en: 'A fill-in plan to get more customers in the next 90 days — no marketing degree needed.', ua: 'План на 90 днів із полями для заповнення: більше клієнтів без диплома маркетолога.', ru: 'План на 90 дней с полями для заполнения: больше клиентов без диплома маркетолога.' },
    url: '',
  },
  {
    slug: 'faq-builder',
    name: 'AI Chatbot FAQ Builder',
    price: '$12',
    format: 'PDF · 16 pages',
    what: { en: 'Write everything your AI assistant needs to answer customers correctly — prices, rules, examples — in one afternoon.', ua: 'Зберіть усе, що потрібно ШІ-помічнику, щоб правильно відповідати клієнтам: ціни, правила, приклади — за один вечір.', ru: 'Соберите всё, что нужно ИИ-помощнику, чтобы правильно отвечать клиентам: цены, правила, примеры — за один вечер.' },
    url: '',
  },
  {
    slug: 'pricing-calculator',
    name: 'Service Pricing & Quote Calculator',
    price: '$12',
    format: 'Excel · Google Sheets',
    what: { en: 'Find what one hour of your work really costs, the right price for every service — and turn it into a client quote.', ua: 'Дізнайтеся, скільки насправді коштує година вашої роботи, правильну ціну кожної послуги — і перетворіть її на кошторис для клієнта.', ru: 'Узнайте, сколько на самом деле стоит час вашей работы, правильную цену каждой услуги — и превратите её в смету для клиента.' },
    url: '',
  },
  {
    slug: 'content-calendar',
    name: 'Social Media Content Calendar',
    price: '$9',
    format: 'Excel · Google Sheets',
    what: { en: 'Plan a year of posts in one afternoon: 12-month plan with key dates, 52-week planner, 60 post ideas and a dashboard.', ua: 'План постів на рік за один вечір: план на 12 місяців із ключовими датами, планер на 52 тижні, 60 ідей постів і зведення.', ru: 'План постов на год за один вечер: план на 12 месяцев с ключевыми датами, планер на 52 недели, 60 идей постов и сводка.' },
    url: '',
  },
  {
    slug: 'weekly-kpi',
    name: 'Weekly Planner & KPI Tracker',
    price: '$9',
    format: 'Excel · Google Sheets',
    what: { en: '15 minutes every Monday: weekly scorecard, task list, 10 review questions and a dashboard with trends and quarters.', ua: '15 хвилин щопонеділка: тижнева таблиця результатів, список задач, 10 питань для розбору і графіки по кварталах.', ru: '15 минут каждый понедельник: недельная таблица результатов, список задач, 10 вопросов для разбора и графики по кварталам.' },
    url: '',
  },
  {
    slug: 'review-kit',
    name: 'Customer Review Request Kit',
    price: '$9',
    format: 'PDF',
    what: { en: 'Get more 5-star Google reviews: 16 request scripts, 12 reply templates, printable QR cards and a 30-day tracker.', ua: 'Більше відгуків на 5 зірок у Google: 16 сценаріїв прохання, 12 шаблонів відповідей, QR-картки для друку і трекер на 30 днів.', ru: 'Больше отзывов на 5 звёзд в Google: 16 сценариев просьбы, 12 шаблонов ответов, QR-карточки для печати и трекер на 30 дней.' },
    url: '',
  },  {
    slug: 'onboarding-kit',
    name: 'Client Onboarding Kit',
    price: '$9',
    format: 'PDF',
    what: { en: 'Start every client right: 7 welcome messages, an intake form, a first-week checklist, a "what to expect" sheet and check-in scripts.', ua: 'Правильний старт із кожним клієнтом: 7 вітальних повідомлень, анкета, чек-лист першого тижня, пам\'ятка «що далі» і сценарії дзвінків.', ru: 'Правильный старт с каждым клиентом: 7 приветственных сообщений, анкета, чек-лист первой недели, памятка «что дальше» и сценарии созвонов.' },
    url: '',
  },
  {
    slug: 'payment-kit',
    name: 'Get Paid On Time Kit',
    price: '$9',
    format: 'PDF',
    what: { en: 'Stop chasing unpaid invoices: payment terms, an invoice checklist, 6 polite reminders, replies to common excuses and a tracker.', ua: 'Досить ганятися за неоплаченими рахунками: умови оплати, чек-лист рахунку, 6 ввічливих нагадувань, відповіді на відмовки і трекер.', ru: 'Хватит гоняться за неоплаченными счетами: условия оплаты, чек-лист счёта, 6 вежливых напоминаний, ответы на отговорки и трекер.' },
    url: '',
  },
  {
    slug: 'job-kit',
    name: 'Booking & Job Checklist Pack',
    price: '$9',
    format: 'PDF',
    what: { en: 'Every job the same smooth way: a booking checklist, 5 confirmation texts, prep, on-site and handover checklists, follow-ups and a job sheet.', ua: 'Кожне замовлення за одним зрозумілим порядком: чек-лист запису, 5 текстів підтвердження, чек-листи підготовки, роботи й здачі, follow-up і картка замовлення.', ru: 'Каждый заказ по одному понятному порядку: чек-лист записи, 5 текстов подтверждения, чек-листы подготовки, работы и сдачи, follow-up и карта заказа.' },
    url: '',
  },
];
const bundle = { name: 'All 12 in one bundle', price: '$67', old: '$120', url: '' };
const C = {
  en: { title: 'Vaxo — Templates and guides for small businesses', eyebrow: 'Shop', h1: 'Do it yourself, with ready-made templates.',
        sub: 'Simple tools we use with our own clients. Instant download, from $9. Want us to set it up for you? See', subLink: 'starter packages',
        buy: 'Buy now →', mh: 'Where should we send the file?', em: 'Your email', pay: 'Pay', note: 'Instant download link by email after payment. Card, Apple Pay or Google Pay (monobank, charged in UAH at the day’s rate).', offMsg: 'Card payment is paused. Please try later.', errMsg: 'Check the email and try again.', soon: 'Coming soon', best: 'Best value', bundle: 'All 12 in one bundle', bundleSub: 'Every template above in one download.', getBundle: 'Get the bundle →', langNote: '' },
  ru: { title: 'Vaxo — Шаблоны и инструкции для малого бизнеса', eyebrow: 'Магазин', h1: 'Сделайте сами — по готовым шаблонам.',
        sub: 'Простые инструменты, которыми мы пользуемся с нашими клиентами. Скачивание сразу, от $9. Хотите, чтобы мы всё настроили за вас? Смотрите', subLink: 'стартовые пакеты',
        buy: 'Купить →', mh: 'Куда прислать файл?', em: 'Ваш email', pay: 'Оплатить', note: 'Ссылка на скачивание придёт на почту сразу после оплаты. Карта, Apple Pay или Google Pay (monobank, в гривнах по курсу дня).', offMsg: 'Оплата картой на паузе. Попробуйте позже.', errMsg: 'Проверьте email и попробуйте ещё раз.', soon: 'Скоро', best: 'Выгоднее всего', bundle: 'Все 12 одним набором', bundleSub: 'Все шаблоны выше одной загрузкой.', getBundle: 'Получить набор →', langNote: 'Шаблоны на английском языке.' },
  ua: { title: 'Vaxo — Шаблони та інструкції для малого бізнесу', eyebrow: 'Магазин', h1: 'Зробіть самі — за готовими шаблонами.',
        sub: 'Прості інструменти, якими ми користуємося з нашими клієнтами. Завантаження одразу, від $9. Хочете, щоб ми все налаштували за вас? Дивіться', subLink: 'стартові пакети',
        buy: 'Купити →', mh: 'Куди надіслати файл?', em: 'Ваш email', pay: 'Сплатити', note: 'Посилання на завантаження прийде на пошту одразу після оплати. Картка, Apple Pay або Google Pay (monobank, у гривнях за курсом дня).', offMsg: 'Оплата карткою на паузі. Спробуйте пізніше.', errMsg: 'Перевірте email і спробуйте ще раз.', soon: 'Незабаром', best: 'Найвигідніше', bundle: 'Усі 12 одним набором', bundleSub: 'Усі шаблони вище одним завантаженням.', getBundle: 'Отримати набір →', langNote: 'Шаблони англійською мовою.' },
}[lang];

---

<Base lang={lang} title={C.title} description={lang === 'en' ? 'Ready-made templates for small businesses: AI prompts, client tracker, message templates, a 90-day marketing plan, an AI chatbot FAQ builder, a pricing calculator, a social media content calendar, a weekly KPI tracker, a review request kit and a client onboarding kit.' : C.h1} path={alts[lang]} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main>
    <section class="hero">
      <div class="in">
        <div class="eyebrow">{C.eyebrow}</div>
        <h1>{C.h1}</h1>
        <p class="sub">{C.sub} <a href={startHref}>{C.subLink}</a>. {C.langNote}</p>
      </div>
    </section>

    <section class="bundle">
      <div class="in">
        <div class="box">
          <div>
            <div class="eyebrow">{C.best}</div>
            <h2>{C.bundle}</h2>
            <p>{C.bundleSub}</p>
          </div>
          <div class="buy">
            <span class="price">{bundle.price} <s>{bundle.old}</s></span>
            <button class="btn" type="button" data-buy="bundle" data-name={C.bundle} data-price={bundle.price}>{C.getBundle}</button>
          </div>
        </div>
      </div>
    </section>

    <section class="list">
      <div class="in grid">
        {products.map((p) => (
          <article class="card">
            <img src={`/shop/${p.slug}.jpg`} alt={p.name} width="800" height="450" loading="lazy" />
            <div class="body">
              <h2>{p.name}</h2>
              <div class="fmt">{p.format}</div>
              <p>{p.what[lang]}</p>
              <div class="buy">
                <span class="price">{p.price}</span>
                <button class="btn" type="button" data-buy={p.slug} data-name={p.name} data-price={p.price}>{C.buy}</button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
    <CrossSell lang={lang} items={['done', 'partner']} />
    <AiPluses t={t} />
  </main>
  <Footer t={t} home={home} lang={lang} />
  <dialog class="buyd" data-buyd data-lang={lang} data-off={C.offMsg} data-err={C.errMsg}>
    <form method="dialog" data-buyf>
      <button class="x" value="cancel" aria-label="Close">×</button>
      <h3>{C.mh}</h3>
      <p class="what" data-what></p>
      <label>{C.em}<input type="email" name="email" required maxlength="120" autocomplete="email" /></label>
      <button class="btn" type="submit" value="pay" data-paybtn>{C.pay}</button>
      <p class="note">{C.note}</p>
      <p class="msg" data-msg role="status"></p>
    </form>
  </dialog>
</Base>

<script>
  const d = document.querySelector<HTMLDialogElement>('[data-buyd]')!;
  const f = d.querySelector<HTMLFormElement>('[data-buyf]')!;
  const msg = d.querySelector<HTMLElement>('[data-msg]')!;
  let slug = '';
  document.querySelectorAll<HTMLButtonElement>('[data-buy]').forEach((b) => b.addEventListener('click', () => {
    slug = b.dataset.buy || '';
    d.querySelector<HTMLElement>('[data-what]')!.textContent = `${b.dataset.name} — ${b.dataset.price}`;
    msg.textContent = '';
    d.showModal();
  }));
  f.addEventListener('submit', async (e) => {
    const sub = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    if (sub?.value === 'cancel') return;
    e.preventDefault();
    const btn = d.querySelector<HTMLButtonElement>('[data-paybtn]')!;
    btn.disabled = true; msg.textContent = '…';
    try {
      const r = await fetch('/api/shop/buy', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug, email: new FormData(f).get('email'), lang: d.dataset.lang, src: (window as unknown as { vxSrc?: () => string }).vxSrc?.() }) });
      const j = await r.json();
      if (j?.url) { location.href = j.url; return; }
      msg.textContent = (j?.error === 'card_off' ? d.dataset.off : d.dataset.err) || '';
    } catch { msg.textContent = d.dataset.err || ''; }
    btn.disabled = false;
  });
</script>


<style>
  .buyd { border: 0; border-radius: 22px; padding: 0; width: min(420px, calc(100vw - 32px)); background: var(--bg); color: var(--ink); }
  .buyd::backdrop { background: rgba(0, 0, 0, 0.5); }
  .buyd form { display: grid; gap: 12px; padding: 24px; position: relative; }
  .buyd h3 { margin: 0; font-size: 22px; }
  .buyd .what { margin: 0; color: var(--mut); }
  .buyd label { display: grid; gap: 6px; font-weight: 600; }
  .buyd input { font: inherit; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surf); color: var(--ink); }
  .buyd .note { margin: 0; font-size: 13px; color: var(--mut); line-height: 1.45; }
  .buyd .msg { margin: 0; color: var(--accText); min-height: 1.2em; }
  .buyd .x { position: absolute; top: 10px; right: 12px; border: 0; background: none; font-size: 26px; color: var(--mut); cursor: pointer; }
  button.btn { font: inherit; border: 0; cursor: pointer; }
  .in { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .hero { padding: 120px 0 40px; }
  h1 { font-size: clamp(34px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em; margin: 16px 0; max-width: 18ch; }
  .sub { color: var(--mut); font-size: 19px; max-width: 60ch; margin: 0; }
  .sub a { color: var(--accText); }
  .list { padding: 24px 0 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
  .card img { width: 100%; height: auto; display: block; border-bottom: 1px solid var(--line); }
  .body { padding: 20px 24px 24px; display: flex; flex-direction: column; flex: 1; }
  .card h2 { font-size: 20px; margin: 0 0 4px; }
  .fmt { font-family: var(--mono); font-size: 13px; color: var(--mut); margin-bottom: 10px; }
  .card p { color: var(--mut); margin: 0 0 16px; flex: 1; }
  .buy { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .price { font-size: 28px; font-weight: 700; color: var(--accText); }
  .price s { font-size: 16px; font-weight: 400; color: var(--mut); }
  .btn { display: inline-block; background: var(--acc); color: var(--dark-ink); font-weight: 600; padding: 12px 20px; border-radius: 999px; text-decoration: none; white-space: nowrap; }
  .btn.off { background: transparent; color: var(--mut); border: 1px solid var(--line); cursor: default; }
  .bundle { padding: 0 0 28px; }
  .box { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .box h2 { font-size: 26px; margin: 8px 0 4px; }
  .box p { color: var(--mut); margin: 0; }
</style>
