---
// Partner cabinet (EN/UA/RU): sign up / log in, then tabs — Home (next step, Vax's road, rates, achievements),
// Links (unlimited tracking links), Academy (lessons with prompts), AI prompts, Team, Payouts & rules.
import Base from '../layouts/Base.astro';
import PromptCard from './PromptCard.astro';
import Deals from './Deals.astro';
import Coach from './Coach.astro';
import { LANGS, type Lang } from '../i18n';
import { CABINET } from '../i18n/cabinet';
import { OFFERS, PROMPTS } from '../data/ai-toolkit';
import { LESSONS } from '../data/academy';
import { RATES } from '../data/partners';
import { LEVELS } from '../data/roadmap';
import { OFFER_TEXT, PROMPT_TEXT } from '../data/ai-toolkit-i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = CABINET[lang];
const PLAN = {"en": {"h": "How you are paid", "top": "Bring a client and close the deal on a call yourself — <b>40%</b> of the first payment + 10% of every later payment for life (the top rate).", "opts": [["classic", "I recommend Vaxo to people I know: 30% of the first order + 10% of every later payment, for life"], ["first30", "I post content (clips, videos): 30% of the first sale only"], ["life10", "I post content (clips, videos): 10% of every sale, for life"]], "ok": "Saved"}, "ru": {"h": "Как вам платят", "top": "Привели клиента и сами довели созвон до оплаты — <b>40%</b> первой оплаты + 10% с каждой следующей пожизненно (самая высокая ставка).", "opts": [["classic", "Рекомендую Vaxo знакомым: 30% первого заказа + 10% с каждой следующей оплаты пожизненно"], ["first30", "Выкладываю контент (нарезки, ролики): 30% только с первой продажи"], ["life10", "Выкладываю контент (нарезки, ролики): 10% с каждой продажи пожизненно"]], "ok": "Сохранено"}, "ua": {"h": "Як вам платять", "top": "Привели клієнта і самі довели дзвінок до оплати — <b>40%</b> першої оплати + 10% з кожної наступної довічно (найвища ставка).", "opts": [["classic", "Рекомендую Vaxo знайомим: 30% першого замовлення + 10% з кожної наступної оплати довічно"], ["first30", "Викладаю контент (нарізки, ролики): 30% лише з першого продажу"], ["life10", "Викладаю контент (нарізки, ролики): 10% з кожного продажу довічно"]], "ok": "Збережено"}}[lang];
const base = lang === 'en' ? '/partner/' : `/${lang}/partner/`;
const landing = lang === 'en' ? '/partners/' : `/${lang}/partners/`;
const byId = (id: string) => PROMPTS.find((p) => p.id === id)!;
const title = (id: string) => c.titles[id] ?? byId(id).title;
// Prompt and offer texts in the interface language (English is the source in ai-toolkit.ts).
const ptext = (id: string) => (lang === 'en' ? byId(id).text : PROMPT_TEXT[lang][id] ?? byId(id).text);
const offersLocal = OFFERS.map((o) => ({ ...o, text: lang === 'en' ? o.text : OFFER_TEXT[lang][o.id] ?? o.text }));
const labels = c.card;
const tabs: [string, string][] = [['home', '🏠'], ['deals', '🤝'], ['links', '🔗'], ['academy', '🎓'], ['prompts', '🤖'], ['team', '👥'], ['rules', '💸']];
const offerSelect = OFFERS.map((o) => ({ id: o.id, name: c.offers[o.id] }));
// Vax's road: 6 levels × 4 missions (data/roadmap.ts). Levels are just for fun — rates are the same for everyone.
const ROAD = {
  en: { title: 'Vax’s road', level: 'Level', of: 'of', go: 'Do it →', locked: 'Finish the previous level to unlock', note: 'Levels are just for fun — your rates are the same from day one. Missions with numbers tick themselves.', done: 'All levels done. You are a legend.' },
  ru: { title: 'Дорога Vax', level: 'Уровень', of: 'из', go: 'Сделать →', locked: 'Пройдите предыдущий уровень, чтобы открыть', note: 'Уровни — для удовольствия, ставки одинаковые с первого дня. Задания с цифрами отмечаются сами.', done: 'Все уровни пройдены. Вы — легенда.' },
  ua: { title: 'Дорога Vax', level: 'Рівень', of: 'з', go: 'Зробити →', locked: 'Пройдіть попередній рівень, щоб відкрити', note: 'Рівні — для задоволення, ставки однакові з першого дня. Завдання з цифрами відмічаються самі.', done: 'Усі рівні пройдено. Ви — легенда.' },
}[lang];
const levelsJs = LEVELS.map((l) => ({ face: l.face, name: l.name[lang], say: l.say[lang], missions: l.missions.map((mi) => ({ id: mi.id, auto: mi.auto, tab: mi.tab, lesson: mi.lesson, text: mi.text[lang] })) }));
// Income map on top of the academy: every direction a partner earns from (rates from data/partners.ts).
const r = RATES;
const MAP = {
  en: { h: 'Your income map — earn from every direction', p: 'One person you talk to can bring money in several ways at once. Think about all four.',
        rows: [['🛠', 'Agency services', `${r.agencyOwn}% of your client · ${r.agencyGiven}% of our lead you close · +${r.agencyRenewal}% of every renewal for life`],
               ['📦', 'Our templates', `${r.products}% of every sale`], ['🤝', 'Partner offers', `${r.offers}% of the payout we receive (soon)`], ['👥', 'Your team', `+${r.team}% on top of your partners’ earnings`]] },
  ru: { h: 'Карта вашего дохода — зарабатывайте со всех направлений', p: 'Один человек, с которым вы поговорили, может принести деньги сразу несколькими способами. Думайте обо всех четырёх.',
        rows: [['🛠', 'Услуги агентства', `${r.agencyOwn}% с вашего клиента · ${r.agencyGiven}% с нашей заявки, которую вы закрыли · +${r.agencyRenewal}% с каждого продления навсегда`],
               ['📦', 'Наши шаблоны', `${r.products}% с каждой продажи`], ['🤝', 'Офферы партнёров', `${r.offers}% от выплаты, которую получаем мы (скоро)`], ['👥', 'Ваша команда', `+${r.team}% сверху от заработка ваших партнёров`]] },
  ua: { h: 'Карта вашого доходу — заробляйте з усіх напрямів', p: 'Одна людина, з якою ви поговорили, може принести гроші одразу кількома способами. Думайте про всі чотири.',
        rows: [['🛠', 'Послуги агентства', `${r.agencyOwn}% з вашого клієнта · ${r.agencyGiven}% з нашої заявки, яку ви закрили · +${r.agencyRenewal}% з кожного продовження назавжди`],
               ['📦', 'Наші шаблони', `${r.products}% з кожного продажу`], ['🤝', 'Офери партнерів', `${r.offers}% від виплати, яку отримуємо ми (скоро)`], ['👥', 'Ваша команда', `+${r.team}% зверху від заробітку ваших партнерів`]] },
}[lang];
const js = { ...c.js, of: c.home.of, allDone: c.home.allDone, road: ROAD, levels: levelsJs };
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path={base} noindex>
  <main class="wrap" data-offers={JSON.stringify(offersLocal)} data-t={JSON.stringify(js)}>
    <div class="topbar">
      <a href={landing} class="logo">VAXO<span>.</span> <small>Partners</small></a>
      <div class="row tight">
        <div class="langs">{LANGS.map((l) => <a href={l === 'en' ? '/partner/' : `/${l}/partner/`} data-keep-hash aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}</div>
        <button class="theme-btn" type="button" title="Theme" aria-label="Toggle theme" data-theme-toggle><span class="icon-light">☾</span><span class="icon-dark">☀</span></button>
        <span class="mut small" data-view="cabinet" data-email hidden></span>
        <button type="button" class="ghost" data-view="cabinet" data-logout hidden>{c.logout}</button>
      </div>
    </div>

    <section data-view="auth" hidden>
      <div class="auth">
        <div>
          <h1>{c.auth.h1}</h1>
          <p class="mut">{c.auth.p}</p>
          <ul class="ticks">{c.auth.ticks.map((x) => <li>{x}</li>)}</ul>
          <a href={landing} class="mut small">{c.auth.how}</a>
        </div>
        <div>
          <div class="tabs">
            <button type="button" data-tab="register" aria-pressed="true">{c.auth.create}</button>
            <button type="button" data-tab="login" aria-pressed="false">{c.auth.login}</button>
          </div>
          <form data-form="register" class="card">
            <label>{c.auth.name}<input name="name" required maxlength="80" autocomplete="name" /></label>
            <label>{c.auth.email}<input name="email" type="email" required autocomplete="email" /></label>
            <label>{c.auth.pass}<input name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
            <label class="check"><input type="checkbox" name="adult" required /> {c.auth.adult}</label>
            <label class="check"><input type="checkbox" name="rules" required /> {c.auth.rules1} <a href="#rules">{c.auth.rules2}</a></label>
            <button type="submit" class="cta">{c.auth.create}</button>
            <p class="err" data-err hidden></p>
          </form>
          <form data-form="login" class="card" hidden>
            <label>{c.auth.email}<input name="email" type="email" required autocomplete="email" /></label>
            <label>{c.auth.passLogin}<input name="password" type="password" required autocomplete="current-password" /></label>
            <button type="submit" class="cta">{c.auth.login}</button>
            <p class="err" data-err hidden></p>
          </form>
        </div>
      </div>
    </section>

    <section data-view="cabinet" hidden>
      <nav class="tabbar" aria-label="Cabinet">
        {tabs.map(([id, icon]) => <button type="button" data-go={id}><span>{icon}</span>{c.tabs[id as keyof typeof c.tabs]}</button>)}
      </nav>

      <!-- HOME -->
      <div data-panel="home">
        <div class="hello">
          <h1>{c.home.hi}, <span data-name></span> 👋</h1>
          <p class="mut">{c.home.today}</p>
        </div>

        <div class="next card">
          <span class="eyebrow-s">{c.home.next}</span>
          <h2 data-next-text>…</h2>
          <button type="button" class="cta" data-next-go>{c.home.doIt}</button>
        </div>

        <div class="plan card">
          <span class="eyebrow-s">{PLAN.h}</span>
          <p set:html={PLAN.top} />
          <div class="plan-opts" data-plan>
            {PLAN.opts.map(([k, t]) => <label><input type="radio" name="plan" value={k} /> <span>{t}</span></label>)}
          </div>
          <small class="mut" data-plan-ok hidden>{PLAN.ok}</small>
          <a class="mut small" href={lang === 'en' ? '/partner-terms/' : `/${lang}/partner-terms/`} target="_blank">{lang === 'ru' ? 'Условия партнёрской программы →' : lang === 'ua' ? 'Умови партнерської програми →' : 'Partner terms →'}</a>
        </div>

        <div class="mylink card">
          <div><span class="eyebrow-s">{c.home.mainLink}</span><code data-main-link></code></div>
          <div class="row tight"><button type="button" class="cta" data-copy-main>{c.home.copy}</button><button type="button" class="ghost" data-share-main>{c.home.share}</button></div>
        </div>

        <div class="road card" data-road>
          <div class="road-head">
            <img src="/mascot/vax-front.webp" alt="Vax" width="120" height="120" data-road-img data-vax-poke />
            <div class="road-who">
              <span class="eyebrow-s">{ROAD.title} · <span data-road-count></span></span>
              <h2 data-road-name>{LEVELS[0].name[lang]}</h2>
              <p class="road-say" data-road-say>{LEVELS[0].say[lang]}</p>
            </div>
          </div>
          <ol class="road-path">
            {LEVELS.map((l, i) => (
              <li data-road-node={i}><button type="button" data-road-show={i}><span class="dot">{i + 1}</span><small>{l.name[lang]}</small></button></li>
            ))}
          </ol>
          {LEVELS.map((l, i) => (
            <div class="road-level" data-road-level={i} hidden>
              <p class="mut small road-locked" data-road-locked hidden>🔒 {ROAD.locked}</p>
              <ul class="missions">
                {l.missions.map((mi) => (
                  <li data-mission={mi.id}>
                    <label><input type="checkbox" disabled={!!mi.auto} /> <span>{mi.text[lang]}{mi.auto && <em data-progress></em>}</span></label>
                    <p class="hint">💡 {mi.hint[lang]}</p>
                    <button type="button" class="ghost sm" data-go={mi.tab} data-lesson={mi.lesson}>{ROAD.go}</button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="mut small">{ROAD.note}</p>
        </div>

        <div class="stats">
          {['clicks', 'leads', 'sales', 'team'].map((k, i) => <div class="card"><b data-total={k}>0</b><span>{c.home.stats[i]}</span></div>)}
        </div>

        <div class="grid2">
          <div class="card">
            <h2>{c.home.rates}</h2>
            <p class="mut small">{c.home.ratesSub}</p>
            <div class="rates">
              {c.home.rateRows.map(([n, h, x]) => <div><b>{n}</b><span><strong>{h}</strong> {x}</span></div>)}
            </div>
          </div>
        </div>

        <h2>{c.home.achievements}</h2>
        <div class="badges" data-badges></div>

        <div class="soon card">
          <span class="pill">{c.home.soon}</span>
          <span class="gift">🎁</span>
          <div><h3>{c.home.soonH}</h3><p class="mut small">{c.home.soonP}</p></div>
        </div>
      </div>

      <!-- LINKS -->
      <div data-panel="deals" hidden><Deals lang={lang} /></div>

      <div data-panel="links" hidden>
        <h1>{c.links.h1}</h1>
        <p class="mut">{c.links.p}</p>
        <form data-form="link" class="card linkform">
          <label>{c.links.where}<input name="name" placeholder={c.links.wherePh} maxlength="60" /></label>
          <label>{c.links.to}
            <select name="target">
              {OFFERS.map((o) => <option value={lang === 'en' || o.target === '/start/' || o.target === '/shop/' ? o.target : `/${lang}${o.target}`}>{c.offers[o.id]}</option>)}
              <option value={lang === 'en' ? '/' : `/${lang}/`}>{c.links.main}</option>
            </select>
          </label>
          <label class="friendopt" data-friend-opt hidden><input type="checkbox" name="friend" /> <span>{lang === 'ru' ? 'Для своих: клиент сам предлагает цену (без предоплаты за небольшие проекты)' : lang === 'ua' ? 'Для своїх: клієнт сам пропонує ціну (без передоплати за невеликі проєкти)' : 'For friends: the client names the price (no prepayment for small projects)'}</span></label>
          <button type="submit" class="cta">{c.links.create}</button>
        </form>
        <div class="table"><table>
          <thead><tr>{c.links.cols.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody data-links></tbody>
        </table></div>
        <p class="mut small">{c.links.tip}</p>
      </div>

      <!-- ACADEMY -->
      <div data-panel="academy" hidden>
        <h1>{c.academy.h1}</h1>
        <p class="mut">{c.academy.p}</p>
        <div class="incmap card">
          <h2>{MAP.h}</h2>
          <p class="mut">{MAP.p}</p>
          <div class="incrows">{MAP.rows.map(([ic, name, how]) => <div class="incrow"><span class="lic">{ic}</span><div><b>{name}</b><small>{how}</small></div></div>)}</div>
        </div>
        <div class="offerpick card"><label>{c.academy.promote}<select data-offer>{offerSelect.map((o) => <option value={o.id}>{o.name}</option>)}</select></label></div>
        <div class="lessons">
          {LESSONS[lang].map((l, i) => (
            <details class="lesson card" data-lesson-box={l.id} open={i === 0}>
              <summary>
                <span class="lic">{l.icon}</span>
                <span class="lt"><b>{i}. {l.title}</b><small>{l.time} · {l.goal}</small></span>
                <span class="tog"><span class="t-show">{labels.show} ▾</span><span class="t-hide">{labels.hide} ▴</span></span>
              </summary>
              <ol class="lsteps">{l.steps.map((s) => <li>{s}</li>)}</ol>
              {l.tip && <p class="tip">⚠️ {l.tip}</p>}
              <div class="ways">
                <div class="way"><b>{c.academy.free}</b><p>{l.free}</p></div>
                <div class="way max"><b>{c.academy.max}</b><p>{l.max}</p></div>
              </div>
              {l.prompts.length > 0 && (
                <div class="lprompts">
                  <b class="small">{c.academy.prompts}</b>
                  {l.prompts.map((id) => <PromptCard prompt={byId(id)} title={title(id)} text={ptext(id)} labels={labels} />)}
                </div>
              )}
            </details>
          ))}
        </div>
      </div>

      <!-- PROMPTS -->
      <div data-panel="prompts" hidden>
        <Coach lang={lang} />
        <h1>{c.prompts.h1}</h1>
        <p class="mut">{c.prompts.p}</p>
        {c.prompts.lang && <p class="tip">🌍 {c.prompts.lang}</p>}
        <div class="offerpick card"><label>{c.academy.promote}<select data-offer>{offerSelect.map((o) => <option value={o.id}>{o.name}</option>)}</select></label></div>
        <div class="chips">
          <button type="button" data-cat="all" aria-pressed="true">{c.prompts.all}</button>
          {Object.entries(c.cats).map(([id, name]) => <button type="button" data-cat={id} aria-pressed="false">{name}</button>)}
        </div>
        <div class="plist">{PROMPTS.map((p) => <PromptCard prompt={p} title={title(p.id)} text={ptext(p.id)} labels={labels} />)}</div>
        <h2>{c.prompts.tools}</h2>
        <div class="table"><table class="tools">
          <thead><tr>{c.prompts.toolCols.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{c.tools.map(([a, b, d]) => <tr><td><b>{a}</b></td><td>{b}</td><td>{d}</td></tr>)}</tbody>
        </table></div>
        <p class="mut small">{c.prompts.gemini}</p>
      </div>

      <!-- TEAM -->
      <div data-panel="team" hidden>
        <h1>{c.team.h1}</h1>
        <div class="grid2">
          <div class="card">
            <div class="teamnum"><b data-total="team2">0</b><span>{c.team.count}</span></div>
            <p class="mut">{c.team.p}</p>
            <code data-invite></code>
            <div class="row tight"><button type="button" class="cta" data-copy-invite>{c.team.copy}</button><button type="button" class="ghost" data-share-invite>{c.home.share}</button></div>
          </div>
          <div class="card">
            <h2>{c.team.how}</h2>
            <ol class="lsteps">{c.team.steps.map((s) => <li>{s}</li>)}</ol>
          </div>
        </div>
        <PromptCard prompt={byId('invite')} title={title('invite')} text={ptext('invite')} labels={labels} open />
      </div>

      <!-- RULES -->
      <div data-panel="rules" hidden>
        <h1>{c.pay.h1}</h1>
        <div class="grid2">
          <div class="card"><h3>{c.pay.payH}</h3><p class="mut">{c.pay.payP}</p></div>
          <div class="card"><h3>{c.pay.clientsH}</h3><p class="mut">{c.pay.clientsP}</p></div>
        </div>
      </div>
    </section>

    <section id="rules" class="rules">
      <h2>{c.pay.rulesH}</h2>
      <ol>{c.pay.rules.map((x) => <li>{x}</li>)}</ol>
    </section>
  </main>
</Base>

<script>
  type Link = { id: number; slug: string; name: string; target: string; active: number; clicks: number; leads: number; friend?: number };
  type Offer = { id: string; target: string; text: string };
  type Check = { id: string; text: string; tab: string; lesson?: string };
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const $$ = <T extends Element = HTMLElement>(sel: string) => [...document.querySelectorAll<T>(sel)];
  const root = $('main.wrap');
  const offers = JSON.parse(root.dataset.offers!) as Offer[];
  const T = JSON.parse(root.dataset.t!) as { road: { level: string; of: string; done: string }; levels: unknown; copied: string; off: string; on: string; wrong: string; exists: string; check: string; done: string; of: string; allDone: string; badges: [string, string][] };
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
  };
  const api = (path: string, body?: unknown) =>
    fetch(`/api/partner/${path}`, body === undefined ? {} : { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

  let view: 'auth' | 'cabinet' = 'auth';
  const show = (v: 'auth' | 'cabinet') => {
    view = v;
    $$('[data-view]').forEach((el) => (el.hidden = el.dataset.view !== v));
    if (v === 'cabinet') go((location.hash.slice(1) || 'home') as string, undefined, false);
    else $('#rules').hidden = false;
  };

  // ---- tabs ----
  const PANELS = ['home', 'deals', 'links', 'academy', 'prompts', 'team', 'rules'];
  function go(tab: string, lesson?: string, scroll = true) {
    if (!PANELS.includes(tab)) tab = 'home';
    $$('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== tab));
    $$('.tabbar [data-go]').forEach((b) => b.setAttribute('aria-current', String(b.dataset.go === tab)));
    $('.tabbar [aria-current="true"]').scrollIntoView({ block: 'nearest', inline: 'center' });
    $('#rules').hidden = tab !== 'rules';
    history.replaceState(null, '', tab === 'home' ? location.pathname + location.search : `#${tab}`);
    if (lesson) {
      const box = $<HTMLDetailsElement>(`[data-lesson-box="${lesson}"]`);
      box.open = true;
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  $$<HTMLAnchorElement>('[data-keep-hash]').forEach((a) => a.addEventListener('click', () => (a.href = a.getAttribute('href')! + location.hash)));
  addEventListener('hashchange', () => view === 'cabinet' && go(location.hash.slice(1)));
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-go]');
    if (b) go(b.dataset.go!, b.dataset.lesson || undefined);
  });

  // ---- prompts ----
  let mainLink = location.origin;
  let inviteLink = location.origin + '/partners/';
  let offerId = store.get('vaxo_offer') ?? 'all';
  const OPEN: Record<string, (q: string) => string> = {
    claude: (q) => `https://claude.ai/new?q=${encodeURIComponent(q)}`,
    chatgpt: (q) => `https://chatgpt.com/?q=${encodeURIComponent(q)}`,
    gemini: () => 'https://gemini.google.com/app',
  };
  function renderPrompts() {
    const offer = offers.find((o) => o.id === offerId) ?? offers[0];
    $$<HTMLSelectElement>('[data-offer]').forEach((s) => (s.value = offer.id));
    $$('[data-prompt]').forEach((box) => {
      const pre = box.querySelector<HTMLElement>('pre')!;
      const link = box.dataset.cat === 'team' ? inviteLink : mainLink;
      const offerText = box.dataset.cat === 'team' ? offers.find((o) => o.id === 'partners')!.text : offer.text;
      pre.textContent = pre.dataset.tpl!.replaceAll('{offer}', offerText).replaceAll('{link}', link);
      box.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) => (a.href = OPEN[a.dataset.open!](pre.textContent!)));
    });
  }
  $$<HTMLSelectElement>('[data-offer]').forEach((s) =>
    s.addEventListener('change', () => {
      offerId = s.value;
      store.set('vaxo_offer', offerId);
      renderPrompts();
    }),
  );
  $$('[data-prompt]').forEach((box) => {
    const text = () => box.querySelector('pre')!.textContent ?? '';
    box.querySelector('[data-open="gemini"]')!.addEventListener('click', () => navigator.clipboard?.writeText(text()));
    const copy = box.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.addEventListener('click', () => navigator.clipboard?.writeText(text()).then(() => flash(copy, T.copied)));
  });
  $$<HTMLButtonElement>('[data-cat]').forEach((b) =>
    b.addEventListener('click', () => {
      $$('[data-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      $$('.plist [data-prompt]').forEach((p) => (p.hidden = b.dataset.cat !== 'all' && p.dataset.cat !== b.dataset.cat));
    }),
  );

  // ---- helpers ----
  function flash(el: HTMLElement, text: string) {
    const old = el.textContent;
    el.textContent = text;
    setTimeout(() => (el.textContent = old), 1500);
  }
  function share(url: string, btn: HTMLElement) {
    if (navigator.share) navigator.share({ url }).catch(() => {});
    else navigator.clipboard?.writeText(url).then(() => flash(btn, T.copied));
  }
  function cell(text: string): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    return td;
  }

  // ---- Vax's road: current level = first level with an unfinished mission ----
  type Mission = { id: string; auto?: [string, number]; tab: string; lesson?: string; text: string };
  type RoadLevel = { face: string; name: string; say: string; missions: Mission[] };
  const levels = T.levels as RoadLevel[];
  let code = '';
  let metrics: Record<string, number> = {};
  let viewing = -1;
  const checkKey = () => `vaxo_check_${code}`;
  const doneSet = () => new Set<string>(JSON.parse(store.get(checkKey()) ?? '[]'));
  const isDone = (mi: Mission, done: Set<string>) => (mi.auto ? (metrics[mi.auto[0]] ?? 0) >= mi.auto[1] : done.has(mi.id));
  function renderRoad() {
    const done = doneSet();
    const finished = levels.map((l) => l.missions.every((mi) => isDone(mi, done)));
    let cur = finished.indexOf(false);
    const all = cur === -1;
    if (all) cur = levels.length - 1;
    if (viewing < 0) viewing = cur;
    const L = levels[cur];
    $<HTMLImageElement>('[data-road-img]').src = `/mascot/vax-${L.face}.webp`;
    $('[data-road-name]').textContent = L.name;
    $('[data-road-say]').textContent = all ? T.road.done : L.say;
    $('[data-road-count]').textContent = `${T.road.level} ${cur + 1} ${T.road.of} ${levels.length}`;
    $$('[data-road-node]').forEach((li) => {
      const i = Number(li.dataset.roadNode);
      li.className = finished[i] ? 'done' : i === cur ? 'cur' : i > cur ? 'locked' : '';
      li.querySelector('button')!.setAttribute('aria-pressed', String(i === viewing));
    });
    $$('[data-road-level]').forEach((box) => {
      const i = Number(box.dataset.roadLevel);
      box.hidden = i !== viewing;
      box.querySelector<HTMLElement>('[data-road-locked]')!.hidden = !(i > cur);
      levels[i].missions.forEach((mi) => {
        const li = box.querySelector<HTMLElement>(`[data-mission="${mi.id}"]`)!;
        const on = isDone(mi, done);
        li.classList.toggle('done', on);
        const input = li.querySelector('input')!;
        input.checked = on;
        if (!mi.auto) input.disabled = i > cur;
        const pr = li.querySelector('[data-progress]');
        if (pr && mi.auto) pr.textContent = ` · ${Math.min(metrics[mi.auto[0]] ?? 0, mi.auto[1])}/${mi.auto[1]}`;
      });
    });
    // "Your next step" banner = first unfinished mission of the current level.
    const next = L.missions.find((mi) => !isDone(mi, done));
    const btn = $('[data-next-go]');
    if (next) {
      $('[data-next-text]').textContent = next.text;
      btn.dataset.go = next.tab;
      if (next.lesson) btn.dataset.lesson = next.lesson;
      else delete btn.dataset.lesson;
    } else {
      $('[data-next-text]').textContent = T.allDone;
      btn.dataset.go = 'academy';
      delete btn.dataset.lesson;
    }
  }
  $$<HTMLButtonElement>('[data-road-show]').forEach((b) =>
    b.addEventListener('click', () => {
      viewing = Number(b.dataset.roadShow);
      renderRoad();
    }),
  );
  $$('[data-mission]').forEach((li) =>
    li.querySelector('input')!.addEventListener('change', (e) => {
      const done = doneSet();
      if ((e.target as HTMLInputElement).checked) done.add(li.dataset.mission!);
      else done.delete(li.dataset.mission!);
      store.set(checkKey(), JSON.stringify([...done]));
      viewing = -1;
      renderRoad();
    }),
  );

  function renderBadges(list: [string, string, string, number, number][]) {
    $('[data-badges]').replaceChildren(
      ...list.map(([icon, name, hint, have, goal]) => {
        const done = have >= goal;
        const d = document.createElement('div');
        d.className = `badge${done ? ' done' : ''}`;
        const i = document.createElement('span');
        i.className = 'icon';
        i.textContent = icon;
        const b = document.createElement('b');
        b.textContent = name;
        const s = document.createElement('small');
        s.textContent = done ? T.done : goal > 1 ? `${hint} · ${Math.max(0, have)}/${goal}` : hint;
        d.append(i, b, s);
        return d;
      }),
    );
  }

  // ---- data ----
  document.querySelector('[data-plan]')?.addEventListener('change', async (e) => {
    const v = (e.target as HTMLInputElement).value;
    const r = await api('plan', { plan: v });
    if (r.ok) { const ok = document.querySelector<HTMLElement>('[data-plan-ok]'); if (ok) { ok.hidden = false; setTimeout(() => (ok.hidden = true), 2000); } }
  });
  async function load() {
    const res = await api('me');
    if (!res.ok) return show('auth');
    const data = (await res.json()) as { partner: { name: string; code: string; email?: string }; links: Link[]; team: number; sales?: number };
    code = data.partner.code;
    $('[data-name]').textContent = data.partner.name;
    $('[data-email]').textContent = data.partner.email ?? '';
    const planIn = document.querySelector<HTMLInputElement>(`[data-plan] input[value="${(data as any).plan || 'classic'}"]`);
    if (planIn) planIn.checked = true;
    const clicks = data.links.reduce((n, l) => n + l.clicks, 0);
    const leads = data.links.reduce((n, l) => n + l.leads, 0);
    const sales = data.sales ?? 0;
    $('[data-total="clicks"]').textContent = String(clicks);
    $('[data-total="leads"]').textContent = String(leads);
    $('[data-total="sales"]').textContent = String(sales);
    $('[data-total="team"]').textContent = String(data.team);
    $('[data-total="team2"]').textContent = String(data.team);
    inviteLink = `${location.origin}${location.pathname}?invite=${data.partner.code}`;
    $('[data-invite]').textContent = inviteLink;
    const active = data.links.find((l) => l.active);
    mainLink = active ? `${location.origin}/r/${active.slug}` : location.origin;
    $('[data-main-link]').textContent = mainLink.replace(/^https?:\/\//, '');

    metrics = { links: data.links.length - 1, clicks, leads, sales, team: data.team, channels: data.links.filter((l) => l.leads > 0).length };
    renderRoad();
    const have: [string, number, number][] = [
      ['🔗', data.links.length - 1, 1],
      ['👆', clicks, 1],
      ['🔥', clicks, 100],
      ['📩', leads, 1],
      ['🚀', leads, 10],
      ['💰', sales, 1],
      ['👥', data.team, 1],
      ['🏆', data.team, 5],
    ];
    renderBadges(have.map(([icon, n, goal], i) => [icon, T.badges[i][0], T.badges[i][1], n, goal]));
    renderPrompts();

    const fo = document.querySelector<HTMLElement>('[data-friend-opt]'); if (fo) fo.hidden = !(data as any).friend;
    $('[data-links]').replaceChildren(
      ...data.links.map((l) => {
        const tr = document.createElement('tr');
        if (!l.active) tr.className = 'off';
        const url = `${location.origin}/r/${l.slug}`;
        const linkTd = document.createElement('td');
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'ghost';
        copy.textContent = url.replace(/^https?:\/\//, '');
        copy.title = 'Copy';
        copy.onclick = () => navigator.clipboard?.writeText(url).then(() => flash(copy, T.copied));
        linkTd.append(copy);
        const actTd = document.createElement('td');
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'ghost';
        toggle.textContent = l.active ? T.off : T.on;
        toggle.onclick = async () => {
          await api(`links/${l.id}/toggle`, {});
          load();
        };
        actTd.append(toggle);
        tr.append(cell(l.friend ? `🤝 ${l.name}` : l.name), linkTd, cell(String(l.clicks)), cell(String(l.leads)), actTd);
        return tr;
      }),
    );
    if (view !== 'cabinet') show('cabinet');
  }

  // ---- auth ----
  $$<HTMLButtonElement>('[data-tab]').forEach((b) =>
    b.addEventListener('click', () => {
      $$('[data-tab]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      $('[data-form="register"]').hidden = b.dataset.tab !== 'register';
      $('[data-form="login"]').hidden = b.dataset.tab !== 'login';
    }),
  );
  const params = new URLSearchParams(location.search);
  const invite = params.get('invite') ?? '';
  if (params.get('tab') === 'login') $<HTMLButtonElement>('[data-tab="login"]').click();

  for (const kind of ['register', 'login'] as const) {
    const form = $<HTMLFormElement>(`[data-form="${kind}"]`);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const body: Record<string, unknown> = Object.fromEntries(fd.entries());
      if (kind === 'register') Object.assign(body, { adult: fd.has('adult'), rules: fd.has('rules'), invite, code: (() => { try { return localStorage.getItem('vaxo_code') || ''; } catch { return ''; } })() });
      const err = form.querySelector<HTMLElement>('[data-err]')!;
      const res = await api(kind, body);
      if (res.ok) return load();
      const out = (await res.json().catch(() => ({}))) as { reason?: string };
      err.textContent =
        kind === 'login' ? T.wrong : out.reason === 'exists' ? T.exists : T.check;
      err.hidden = false;
    });
  }

  $<HTMLFormElement>('[data-form="link"]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const fd = Object.fromEntries(new FormData(form).entries());
    await api('links', { ...fd, friend: fd.friend === 'on' });
    form.reset();
    load();
  });

  $('[data-logout]').addEventListener('click', async () => {
    await api('logout', {});
    show('auth');
  });
  $('[data-copy-main]').addEventListener('click', (e) => navigator.clipboard?.writeText(mainLink).then(() => flash(e.currentTarget as HTMLElement, T.copied)));
  $('[data-share-main]').addEventListener('click', (e) => share(mainLink, e.currentTarget as HTMLElement));
  $('[data-copy-invite]').addEventListener('click', (e) => navigator.clipboard?.writeText(inviteLink).then(() => flash(e.currentTarget as HTMLElement, T.copied)));
  $('[data-share-invite]').addEventListener('click', (e) => share(inviteLink, e.currentTarget as HTMLElement));

  renderPrompts();
  load();
</script>

<style>
  .wrap { max-width: 1040px; margin: 0 auto; padding: 16px 16px 80px; }
  .topbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 0 16px; }
  .logo { font-weight: 800; font-size: 22px; text-decoration: none; color: var(--ink); }
  .logo span { color: var(--acc); }
  .langs { display: flex; gap: 2px; padding: 3px; background: var(--surf2); border-radius: 999px; }
  .langs a { font-size: 12px; padding: 5px 9px; border-radius: 999px; text-decoration: none; color: var(--mut); }
  .langs a[aria-current='true'] { background: var(--ink); color: var(--bg); }
  .theme-btn { width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--line); background: var(--surf); color: var(--ink); cursor: pointer; font-size: 15px; }
  .icon-dark { display: none; }
  :global([data-theme='dark']) .icon-light { display: none; }
  :global([data-theme='dark']) .icon-dark { display: inline; }
  .logo small { font-weight: 500; color: var(--mut); font-size: 14px; }
  h1 { font-size: clamp(28px, 5vw, 42px); margin: 16px 0 8px; letter-spacing: -0.02em; }
  h2 { margin: 36px 0 10px; font-size: 22px; }
  h3 { margin: 0 0 6px; }
  .card h2 { margin-top: 0; }
  .mut { color: var(--mut); max-width: 66ch; }
  .small { font-size: 14px; }
  .card { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px; }
  label { display: grid; gap: 4px; font-size: 14px; color: var(--mut); }
  label.check { display: flex; gap: 8px; align-items: center; color: var(--ink); }
  input, select { font: inherit; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); min-width: 0; }
  .cta { display: inline-block; text-decoration: none; background: var(--acc); color: var(--dark-ink); font: inherit; font-weight: 600; border: 0; border-radius: 999px; padding: 12px 18px; cursor: pointer; transition: transform 0.15s; }
  .cta:hover { transform: translateY(-1px); }
  .ghost, .table :global(button) { font: inherit; font-size: 14px; background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
  .ghost.sm { padding: 5px 12px; font-size: 13px; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 12px 0; }
  .row.tight { margin: 0; }
  .err { color: var(--error); margin: 0; }
  .eyebrow-s { font-family: var(--mono); font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accText); }

  /* auth */
  .auth { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; padding-top: 24px; }
  .ticks { list-style: none; padding: 0; display: grid; gap: 10px; margin: 20px 0; }
  .ticks li { padding-left: 26px; position: relative; }
  .ticks li::before { content: '✓'; position: absolute; left: 0; color: var(--accText); font-weight: 700; }
  form.card { display: grid; gap: 12px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 12px; }
  .tabs button { font: inherit; background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 999px; padding: 8px 16px; cursor: pointer; }
  .tabs button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }

  /* tab bar */
  .tabbar { position: sticky; top: 0; z-index: 10; display: flex; gap: 4px; overflow-x: auto; padding: 8px; margin: 0 -8px; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); scrollbar-width: none; }
  .tabbar button { font: inherit; font-size: 15px; font-weight: 500; white-space: nowrap; border: 0; background: none; color: var(--mut); padding: 9px 14px; border-radius: 999px; cursor: pointer; }
  .tabbar button span { margin-right: 4px; }
  .tabbar button:hover { background: var(--surf2); color: var(--ink); }
  .tabbar button[aria-current='true'] { background: var(--ink); color: var(--bg); }

  /* home */
  .next { margin-top: 8px; background: var(--deep); border-color: var(--deepLine); color: var(--deepInk); display: grid; gap: 10px; justify-items: start; position: relative; overflow: hidden; }
  .next::after { content: ''; position: absolute; right: -80px; top: -80px; width: 240px; height: 240px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--acc) 35%, transparent), transparent 70%); animation: pulse 4s ease-in-out infinite; }
  @keyframes pulse { 50% { transform: scale(1.2); opacity: 0.6; } }
  .next .eyebrow-s { color: var(--acc); }
  .next h2 { margin: 0; font-size: clamp(20px, 3vw, 26px); }
  .mylink { margin-top: 12px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .mylink code, [data-invite] { display: block; font: 600 16px var(--mono); margin-top: 4px; word-break: break-all; }
  [data-invite] { background: var(--bg); padding: 12px; border-radius: 10px; margin: 12px 0; font-size: 14px; }
  .road { margin-top: 12px; }
  .road-head { display: flex; gap: 16px; align-items: center; }
  .road-head img { width: 88px; height: auto; flex: none; }
  .road-who h2 { margin: 2px 0 4px; }
  .road-say { margin: 0; font-style: italic; color: var(--mut); }
  .road-path { list-style: none; padding: 0; margin: 18px 0 12px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; position: relative; }
  .road-path::before { content: ''; position: absolute; left: 8%; right: 8%; top: 17px; height: 3px; background: var(--surf2); border-radius: 3px; }
  .road-path li { position: relative; text-align: center; }
  .road-path button { background: none; border: 0; padding: 0; cursor: pointer; color: var(--mut); font: inherit; display: grid; justify-items: center; gap: 4px; width: 100%; }
  .road-path .dot { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: var(--surf2); border: 2px solid var(--line); position: relative; z-index: 1; }
  .road-path small { font-size: 11px; line-height: 1.2; }
  .road-path li.done .dot { background: var(--acc); border-color: var(--acc); color: var(--dark-ink); }
  .road-path li.done .dot::after { content: '✓'; position: absolute; font-size: 12px; right: -4px; top: -4px; background: var(--ink); color: var(--bg); width: 16px; height: 16px; border-radius: 50%; display: grid; place-items: center; }
  .road-path li.cur .dot { border-color: var(--acc); color: var(--accText); box-shadow: 0 0 0 5px color-mix(in srgb, var(--acc) 25%, transparent); animation: road-pulse 2s ease-in-out infinite; }
  .road-path li.cur small { color: var(--ink); font-weight: 700; }
  .road-path li.locked .dot { opacity: 0.55; }
  .road-path button[aria-pressed='true'] small { text-decoration: underline; text-underline-offset: 3px; }
  @keyframes road-pulse { 50% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--acc) 10%, transparent); } }
  @media (prefers-reduced-motion: reduce) { .road-path li.cur .dot { animation: none; } }
  .missions { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 8px; }
  .missions li { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; background: var(--surf2); border-radius: 12px; padding: 12px 14px; }
  .missions label { display: flex; gap: 10px; align-items: center; font-weight: 600; cursor: pointer; }
  .missions input { width: 18px; height: 18px; accent-color: var(--acc); flex: none; }
  .missions em { font-style: normal; color: var(--accText); font-weight: 700; }
  .missions .hint { grid-column: 1 / -1; margin: 0; color: var(--mut); font-size: 13px; }
  .missions button { grid-row: 1; grid-column: 2; }
  .missions li.done label span { text-decoration: line-through; color: var(--mut); }
  @media (max-width: 560px) { .road-path small { display: none; } .missions li { grid-template-columns: 1fr; } .missions button { grid-row: auto; grid-column: 1; justify-self: start; } }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 12px; }
  .stats b { display: block; font-size: 34px; letter-spacing: -0.02em; }
  .stats span { color: var(--mut); font-size: 14px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; margin-top: 12px; }
  .ch-head { display: flex; justify-content: space-between; align-items: baseline; }
  .bar { height: 8px; background: var(--surf2); border-radius: 99px; overflow: hidden; margin: 8px 0 12px; }
  .bar i { display: block; height: 100%; background: var(--acc); border-radius: 99px; transition: width 0.5s; }
  .checklist { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .checklist li { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .checklist label { display: flex; gap: 10px; align-items: center; color: var(--ink); font-size: 15px; cursor: pointer; }
  .checklist input { width: 18px; height: 18px; accent-color: var(--acc); flex: none; }
  .checklist li.done span { text-decoration: line-through; color: var(--mut); }
  .rates { display: grid; gap: 8px; }
  .rates div { display: flex; gap: 14px; align-items: center; background: var(--bg); border-radius: 12px; padding: 10px 14px; }
  .rates b { font-size: 22px; color: var(--accText); min-width: 64px; }
  .rates span { font-size: 14px; color: var(--mut); }
  .rates strong { color: var(--ink); display: block; }
  .badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  .badges :global(.badge) { background: var(--surf); border: 1px solid var(--line); border-radius: 16px; display: grid; gap: 4px; padding: 14px; opacity: 0.5; filter: grayscale(1); }
  .badges :global(.badge.done) { opacity: 1; filter: none; border-color: var(--acc); }
