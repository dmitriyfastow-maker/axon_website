---
// Cabinet tab "Agency leads": verified partner-closers take warm agency leads, work them under SLA and log every step.
// Server rules live in worker/deals.ts. Clients always pay Vaxo; closers earn the warm-lead rate.
import type { Lang } from '../i18n';
import { RATES } from '../data/partners';
interface Props { lang: Lang }
const { lang } = Astro.props;
const r = RATES.agencyGiven;

const T = {
  en: {
    h: 'Close agency deals', lead: `We bring warm leads who asked for a website, app, ads or AI. You talk to them in English, close the deal and earn ${r}% of what the client pays. Vaxo delivers the work.`,
    req: 'Who can take leads', reqs: ['Fluent English (C1+), calls and writing', 'Sales or client-facing experience', 'First reply to a client within 24 hours', 'You follow the rules below — every step is logged'],
    rules: 'Rules (protect the client and the brand)', ruleList: [
      'Quote only from official price ranges on vaxogroup.com. Discounts — only with the owner’s approval.',
      'Never take money. Contract and invoice come from Vaxo; the client pays Vaxo only.',
      'Never promise dates, results or features that are not agreed with the team.',
      'Update the lead after every contact with a short note. Deadlines: first contact 24 h, then 72 h, 5 days, 10 days.',
      'Missed deadline — the lead returns to the pool. Two misses in 30 days — access is paused.',
      'Client data is used only for this deal. No copying, no reselling, no spam.',
      'Polite, honest, on time. The owner rates every deal; better rating — more leads at once (2 → 3 → 5).'],
    apply: 'Apply to become a closer', english: 'English level', exp: 'Your sales experience (what, where, results)', profile: 'LinkedIn or another profile link', tz: 'Time zone', hours: 'Hours you can take calls',
    pitchQ: 'Test: a restaurant owner from Texas writes “Why should I pay you $1,500 for a website if my nephew can do it for $300?”. Write your answer as you would send it (in English).',
    agree: 'I agree to the rules above', send: 'Send application', sent: 'Application sent. The owner will review it and you will see the leads here.',
    applied: 'Your application is under review. We will open the leads for you after the check.', paused: 'Access is paused. Contact the owner to discuss it.',
    stats: (a: number, l: number, rt: string) => `In work: ${a} of ${l} · rating: ${rt}`,
    open: 'Open leads', openNone: 'No open leads right now. New ones appear here — check daily.', take: 'Take this lead', taken: 'Someone took it first.', limit: 'You already hold the maximum number of leads. Close or release one first.',
    mine: 'My leads', mineNone: 'You have no leads yet.', client: 'Client', contact: 'Contact', msg: 'Request / chat with Vax', brief: 'Client profile', links: 'Useful links', log: 'History',
    due: 'Next step due', overdue: 'overdue', next: 'Move to', note: 'What happened (required, 10+ characters)', value: 'Deal value, $', save: 'Save step', release: 'Give back',
    stage: { claimed: 'Taken', contacted: 'Contacted', meeting: 'Meeting', proposal: 'Proposal', won: 'Won', lost: 'Lost', open: 'Open', new: 'New', archived: 'Archived' } as Record<string, string>,
    noteErr: 'Write a note (10+ characters). For “Won” add the deal value.',
    book: 'Sales playbook', playbook: [
      ['First message (within 24 h)', '“Hi {name}, this is {you} from Vaxo. Thanks for reaching out about {need}. I have a couple of quick questions so we can suggest the right plan — is a 15-minute call today or tomorrow OK?”'],
      ['Discovery questions', 'What does the business do and for whom? What should happen in 3 months (leads, sales, launch)? What exists now (site, ads, CRM)? Who decides and by when? Budget range they have in mind.'],
      ['How to quote', 'Pick the tier or service that solves the goal, give the official range, explain what is included, offer the strategy session as the first step. Then tell the owner the details — Vaxo sends the proposal and invoice.'],
      ['Objections', '“Too expensive” → compare with the cost of lost clients and show the starter step from $149. “Need to think” → agree a date for the follow-up. “Nephew can do it” → we build a system: design, tracking, ads, AI, support.'],
      ['Follow-up', 'Day 1, day 3, day 7 — short, helpful, with one question. After 3 tries with no reply — mark Lost with the reason.']],
    useful: [['All services and prices', '/#services'], ['Growth tiers', '/#pricing'], ['Cases', '/#cases'], ['Starter packages', '/start/'], ['Website examples', '/examples/'], ['Templates shop', '/shop/']],
  },
  ru: {
    h: 'Закрывайте сделки агентства', lead: `Мы приводим тёплых клиентов, которые сами попросили сайт, приложение, рекламу или ИИ. Вы общаетесь с ними на английском, закрываете сделку и получаете ${r}% от оплаты клиента. Работу делает Vaxo.`,
    req: 'Кто может брать заявки', reqs: ['Свободный английский (C1+): звонки и переписка', 'Опыт продаж или работы с клиентами', 'Первый ответ клиенту — в течение 24 часов', 'Соблюдение правил ниже — каждый шаг записывается'],
    rules: 'Правила (защищают клиента и бренд)', ruleList: [
      'Называйте цены только из официальных вилок на vaxogroup.com. Скидки — только с одобрения владельца.',
      'Никогда не берите деньги. Договор и счёт выставляет Vaxo, клиент платит только Vaxo.',
      'Не обещайте сроков, результатов и функций, не согласованных с командой.',
      'После каждого контакта обновляйте заявку коротким комментарием. Сроки: первый контакт — 24 ч, дальше 72 ч, 5 дней, 10 дней.',
      'Пропустили срок — заявка возвращается в общий список. Два пропуска за 30 дней — доступ на паузе.',
      'Данные клиента — только для этой сделки. Не копировать, не перепродавать, не спамить.',
      'Вежливо, честно, вовремя. Владелец оценивает каждую сделку; выше рейтинг — больше заявок одновременно (2 → 3 → 5).'],
    apply: 'Анкета закрывающего', english: 'Уровень английского', exp: 'Ваш опыт продаж (что, где, результаты)', profile: 'Ссылка на LinkedIn или другой профиль', tz: 'Часовой пояс', hours: 'Часы, когда можете созваниваться',
    pitchQ: 'Тест: владелец ресторана из Техаса пишет «Why should I pay you $1,500 for a website if my nephew can do it for $300?». Напишите ответ так, как отправили бы его клиенту (на английском).',
    agree: 'Согласен с правилами выше', send: 'Отправить анкету', sent: 'Анкета отправлена. Владелец проверит её, и заявки появятся здесь.',
    applied: 'Ваша анкета на проверке. После проверки откроем вам заявки.', paused: 'Доступ на паузе. Свяжитесь с владельцем, чтобы обсудить.',
    stats: (a: number, l: number, rt: string) => `В работе: ${a} из ${l} · рейтинг: ${rt}`,
    open: 'Открытые заявки', openNone: 'Сейчас открытых заявок нет. Новые появятся здесь — заглядывайте каждый день.', take: 'Взять заявку', taken: 'Кто-то взял её раньше.', limit: 'У вас уже максимум заявок. Закройте или верните одну.',
    mine: 'Мои заявки', mineNone: 'У вас пока нет заявок.', client: 'Клиент', contact: 'Контакт', msg: 'Запрос / диалог с Vax', brief: 'Профиль клиента', links: 'Полезные ссылки', log: 'История',
    due: 'Следующий шаг до', overdue: 'просрочено', next: 'Перевести в', note: 'Что произошло (обязательно, от 10 символов)', value: 'Сумма сделки, $', save: 'Сохранить шаг', release: 'Вернуть заявку',
    stage: { claimed: 'Взята', contacted: 'Контакт', meeting: 'Встреча', proposal: 'Предложение', won: 'Выиграна', lost: 'Проиграна', open: 'Открыта', new: 'Новая', archived: 'Архив' } as Record<string, string>,
    noteErr: 'Напишите комментарий (от 10 символов). Для «Выиграна» укажите сумму.',
    book: 'Памятка продаж', playbook: [
      ['Первое сообщение (в течение 24 ч)', '«Hi {name}, this is {you} from Vaxo. Thanks for reaching out about {need}. I have a couple of quick questions so we can suggest the right plan — is a 15-minute call today or tomorrow OK?»'],
      ['Вопросы на звонке', 'Чем занимается бизнес и для кого? Что должно случиться через 3 месяца (заявки, продажи, запуск)? Что уже есть (сайт, реклама, CRM)? Кто принимает решение и когда? Какой бюджет держат в голове?'],
      ['Как называть цену', 'Выберите тариф или услугу под цель, назовите официальную вилку, объясните, что входит, предложите стратегическую сессию первым шагом. Детали передайте владельцу — предложение и счёт отправляет Vaxo.'],
      ['Возражения', '«Дорого» → сравните со стоимостью потерянных клиентов и покажите стартовый шаг от $149. «Подумаю» → договоритесь о дате следующего контакта. «Племянник сделает» → мы строим систему: дизайн, аналитика, реклама, ИИ, поддержка.'],
      ['Догоняющие сообщения', 'День 1, 3, 7 — коротко, с пользой и одним вопросом. После 3 попыток без ответа — «Проиграна» с причиной.']],
    useful: [['Все услуги и цены', '/ru/#services'], ['Тарифы роста', '/ru/#pricing'], ['Кейсы', '/ru/#cases'], ['Стартовые пакеты', '/ru/start/'], ['Примеры сайтов', '/ru/examples/'], ['Магазин шаблонов', '/ru/shop/']],
  },
  ua: {
    h: 'Закривайте угоди агенції', lead: `Ми приводимо теплих клієнтів, які самі попросили сайт, застосунок, рекламу чи ШІ. Ви спілкуєтеся з ними англійською, закриваєте угоду й отримуєте ${r}% від оплати клієнта. Роботу робить Vaxo.`,
    req: 'Хто може брати заявки', reqs: ['Вільна англійська (C1+): дзвінки й листування', 'Досвід продажів або роботи з клієнтами', 'Перша відповідь клієнту — протягом 24 годин', 'Дотримання правил нижче — кожен крок записується'],
    rules: 'Правила (захищають клієнта і бренд)', ruleList: [
      'Називайте ціни лише з офіційних діапазонів на vaxogroup.com. Знижки — тільки зі схвалення власника.',
      'Ніколи не беріть гроші. Договір і рахунок виставляє Vaxo, клієнт платить лише Vaxo.',
      'Не обіцяйте строків, результатів і функцій, не погоджених з командою.',
      'Після кожного контакту оновлюйте заявку коротким коментарем. Строки: перший контакт — 24 год, далі 72 год, 5 днів, 10 днів.',
      'Пропустили строк — заявка повертається в загальний список. Два пропуски за 30 днів — доступ на паузі.',
      'Дані клієнта — лише для цієї угоди. Не копіювати, не перепродавати, не спамити.',
      'Ввічливо, чесно, вчасно. Власник оцінює кожну угоду; вищий рейтинг — більше заявок одночасно (2 → 3 → 5).'],
    apply: 'Анкета того, хто закриває угоди', english: 'Рівень англійської', exp: 'Ваш досвід продажів (що, де, результати)', profile: 'Посилання на LinkedIn або інший профіль', tz: 'Часовий пояс', hours: 'Години, коли можете дзвонити',
    pitchQ: 'Тест: власник ресторану з Техасу пише «Why should I pay you $1,500 for a website if my nephew can do it for $300?». Напишіть відповідь так, як надіслали б її клієнту (англійською).',
    agree: 'Погоджуюся з правилами вище', send: 'Надіслати анкету', sent: 'Анкету надіслано. Власник перевірить її, і заявки з’являться тут.',
    applied: 'Ваша анкета на перевірці. Після перевірки відкриємо вам заявки.', paused: 'Доступ на паузі. Зв’яжіться з власником, щоб обговорити.',
    stats: (a: number, l: number, rt: string) => `У роботі: ${a} з ${l} · рейтинг: ${rt}`,
    open: 'Відкриті заявки', openNone: 'Зараз відкритих заявок немає. Нові з’являться тут — заглядайте щодня.', take: 'Взяти заявку', taken: 'Хтось узяв її раніше.', limit: 'У вас уже максимум заявок. Закрийте або поверніть одну.',
    mine: 'Мої заявки', mineNone: 'У вас поки немає заявок.', client: 'Клієнт', contact: 'Контакт', msg: 'Запит / діалог з Vax', brief: 'Профіль клієнта', links: 'Корисні посилання', log: 'Історія',
    due: 'Наступний крок до', overdue: 'прострочено', next: 'Перевести в', note: 'Що сталося (обов’язково, від 10 символів)', value: 'Сума угоди, $', save: 'Зберегти крок', release: 'Повернути заявку',
    stage: { claimed: 'Взята', contacted: 'Контакт', meeting: 'Зустріч', proposal: 'Пропозиція', won: 'Виграна', lost: 'Програна', open: 'Відкрита', new: 'Нова', archived: 'Архів' } as Record<string, string>,
    noteErr: 'Напишіть коментар (від 10 символів). Для «Виграна» вкажіть суму.',
    book: 'Пам’ятка продажів', playbook: [
      ['Перше повідомлення (протягом 24 год)', '«Hi {name}, this is {you} from Vaxo. Thanks for reaching out about {need}. I have a couple of quick questions so we can suggest the right plan — is a 15-minute call today or tomorrow OK?»'],
      ['Питання на дзвінку', 'Чим займається бізнес і для кого? Що має статися за 3 місяці (заявки, продажі, запуск)? Що вже є (сайт, реклама, CRM)? Хто ухвалює рішення і коли? Який бюджет мають на увазі?'],
      ['Як називати ціну', 'Оберіть тариф або послугу під мету, назвіть офіційний діапазон, поясніть, що входить, запропонуйте стратегічну сесію першим кроком. Деталі передайте власнику — пропозицію і рахунок надсилає Vaxo.'],
      ['Заперечення', '«Дорого» → порівняйте з вартістю втрачених клієнтів і покажіть стартовий крок від $149. «Подумаю» → домовтеся про дату наступного контакту. «Племінник зробить» → ми будуємо систему: дизайн, аналітика, реклама, ШІ, підтримка.'],
      ['Повторні повідомлення', 'День 1, 3, 7 — коротко, з користю й одним питанням. Після 3 спроб без відповіді — «Програна» з причиною.']],
    useful: [['Усі послуги та ціни', '/ua/#services'], ['Тарифи зростання', '/ua/#pricing'], ['Кейси', '/ua/#cases'], ['Стартові пакети', '/ua/start/'], ['Приклади сайтів', '/ua/examples/'], ['Магазин шаблонів', '/ua/shop/']],
  },
}[lang];
const { stats: _s, ...TJ } = T;
---

<div class="deals" data-deals>
  <script type="application/json" data-deals-t set:html={JSON.stringify(TJ)} />
  <h2>{T.h}</h2>
  <p class="lead">{T.lead}</p>

  <div data-d-state="intro">
    <div class="cols">
      <div><h3>{T.req}</h3><ul>{T.reqs.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3>{T.rules}</h3><ol>{T.ruleList.map((x) => <li>{x}</li>)}</ol></div>
    </div>
  </div>

  <form class="apply" data-d-apply hidden>
    <h3>{T.apply}</h3>
    <label>{T.english}<select name="english" required><option value="">—</option><option>B2</option><option>C1</option><option>C2</option><option>Native</option></select></label>
    <label>{T.exp}<textarea name="experience" rows="4" required minlength="30" maxlength="1500"></textarea></label>
    <label>{T.profile}<input name="profile" type="url" maxlength="300" placeholder="https://linkedin.com/in/…" /></label>
    <div class="two">
      <label>{T.tz}<input name="timezone" maxlength="60" placeholder="UTC+2" /></label>
      <label>{T.hours}<input name="hours" maxlength="60" placeholder="15:00–23:00" /></label>
    </div>
    <label>{T.pitchQ}<textarea name="pitch" rows="5" required minlength="80" maxlength="1500"></textarea></label>
    <label class="chk"><input type="checkbox" name="agreed" required /> {T.agree}</label>
    <button class="cta" type="submit">{T.send}</button>
    <p class="msg" data-d-msg hidden></p>
  </form>

  <p class="status" data-d-status hidden></p>

  <div data-d-work hidden>
    <p class="stats" data-d-stats></p>
    <h3>{T.open}</h3>
    <div class="grid" data-d-open></div>
    <h3>{T.mine}</h3>
    <div data-d-mine></div>
  </div>

  <details class="book">
    <summary>{T.book}</summary>
    {T.playbook.map(([h, d]) => <div><b>{h}</b><p>{d}</p></div>)}
  </details>
</div>

<script>
  type R = Record<string, any>;
  const root = document.querySelector<HTMLElement>('[data-deals]');
  if (root) {
    const T = JSON.parse(root.querySelector('[data-deals-t]')!.textContent || '{}');
    const q = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
    const el = (tag: string, attrs: R = {}, ...kids: (Node | string | null | undefined | false)[]) => {
      const e = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) { if (k.startsWith('on')) (e as any)[k] = v; else if (v != null) e.setAttribute(k, String(v)); }
      for (const k of kids) if (k) e.append(k);
      return e;
    };
    const when = (iso?: string) => (iso ? new Date(iso.replace(' ', 'T') + 'Z').toLocaleString(undefined, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '');
    const late = (iso?: string) => !!iso && Date.parse(iso.replace(' ', 'T') + 'Z') < Date.now();
    const contactLink = (c: string) => {
      const v = c.trim();
      if (/^@\w+$/.test(v)) return el('a', { href: `https://t.me/${v.slice(1)}`, target: '_blank', rel: 'noopener' }, v);
      if (v.includes('@')) return el('a', { href: `mailto:${v}` }, v);
      return el('a', { href: `tel:${v.replace(/[^\d+]/g, '')}` }, v);
    };
    const urls = (t: string) => Array.from(new Set((t.match(/\bhttps?:\/\/[^\s)<>"]+|\b[a-z0-9-]+\.(?:com|net|org|io|co|us|uk|de|ca|au|biz|shop|store)\b/gi) || []).filter((u) => !/vaxogroup\.com/i.test(u)))).slice(0, 6);
    const post = (path: string, b: unknown = {}) => fetch('/api/partner/' + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) });

    async function load() {
      const res = await fetch('/api/partner/deals');
      if (!res.ok) return;
      const d = await res.json();
      q('[data-d-apply]').hidden = !(d.closer === 'none');
      const st = q('[data-d-status]');
      st.hidden = !(d.closer === 'applied' || d.closer === 'paused');
      st.textContent = d.closer === 'applied' ? T.applied : d.closer === 'paused' ? T.paused : '';
      q('[data-d-work]').hidden = d.closer !== 'approved';
      q('[data-d-state="intro"]').hidden = d.closer === 'approved';
      if (d.closer !== 'approved') return;
      q('[data-d-stats]').textContent = `${T.mine}: ${d.active} / ${d.limit} · ★ ${d.rating ?? '—'}`;
      q('[data-d-open]').replaceChildren(...(d.open.length ? d.open.map((l: R) =>
        el('article', { class: 'card' },
          el('div', { class: 'meta' }, `#${l.id} · ${when(l.created_at)} · ${(l.lang || '').toUpperCase()} · ${l.country || ''}`),
          el('b', {}, l.service || l.interest || '—'), l.budget && el('div', {}, `$ ${l.budget}`),
          el('p', {}, l.teaser || ''),
          el('button', { class: 'cta', type: 'button', onclick: async (e: Event) => {
            const b = e.currentTarget as HTMLButtonElement; b.disabled = true;
            const r = await post(`deals/${l.id}/claim`);
            if (!r.ok) { const j = await r.json().catch(() => ({})); alert(j.error === 'limit' ? T.limit : T.taken); }
            load();
          } }, T.take))) : [el('p', { class: 'mut' }, T.openNone)]));
      q('[data-d-mine]').replaceChildren(...(d.mine.length ? d.mine.map((l: R) => card(l, d.events.filter((e: R) => e.lead_id === l.id))) : [el('p', { class: 'mut' }, T.mineNone)]));
    }

    function card(l: R, events: R[]) {
      const active = ['claimed', 'contacted', 'meeting', 'proposal'].includes(l.status);
      const order = ['contacted', 'meeting', 'proposal', 'won', 'lost'];
      const sel = el('select', { name: 'status' }, ...order.filter((s) => order.indexOf(s) > order.indexOf(l.status) || ['won', 'lost'].includes(s)).map((s) => el('option', { value: s }, T.stage[s])));
      const note = el('textarea', { rows: '3', placeholder: T.note, maxlength: '2000' });
      const value = el('input', { type: 'number', min: '0', placeholder: T.value });
      const err = el('p', { class: 'err', hidden: '' }, T.noteErr);
      const found = urls(`${l.message || ''}\n${l.brief || ''}\n${l.contact || ''}`);
      return el('article', { class: 'card big' },
        el('div', { class: 'meta' }, `#${l.id} · ${T.stage[l.status] ?? l.status}`, active && l.due_at ? el('span', { class: late(l.due_at) ? 'late' : '' }, ` · ${T.due} ${when(l.due_at)}${late(l.due_at) ? ' — ' + T.overdue : ''}`) : null),
        el('h4', {}, `${l.name} — ${l.service || l.interest || ''}`),
        el('dl', {}, el('dt', {}, T.contact), el('dd', {}, contactLink(l.contact || '')),
          el('dt', {}, '🌍'), el('dd', {}, `${(l.lang || '').toUpperCase()} · ${l.country || ''} · ${l.budget ? '$ ' + l.budget : ''}`)),
        l.brief && el('details', { open: '' }, el('summary', {}, T.brief), el('pre', {}, l.brief)),
        el('details', {}, el('summary', {}, T.msg), el('pre', {}, l.message || '—')),
        el('details', {}, el('summary', {}, T.links), el('ul', {},
          ...found.map((u) => el('li', {}, el('a', { href: /^https?:/.test(u) ? u : `https://${u}`, target: '_blank', rel: 'noopener' }, u))),
          ...T.useful.map(([t, h]: [string, string]) => el('li', {}, el('a', { href: h, target: '_blank' }, t))))),
        el('details', {}, el('summary', {}, T.log), el('ol', { class: 'log' }, ...events.map((e) => el('li', {}, el('small', {}, when(e.at)), ' ', e.text || e.kind)))),
        active && el('div', { class: 'step' },
          el('label', {}, T.next, sel), note, value, err,
          el('div', { class: 'btns' },
            el('button', { class: 'cta', type: 'button', onclick: async () => {
              const s = (sel as HTMLSelectElement).value;
              const n = (note as HTMLTextAreaElement).value.trim();
              const v = Number((value as HTMLInputElement).value);
              if (n.length < 10 || (s === 'won' && !v)) { err.hidden = false; return; }
              const r = await post(`deals/${l.id}/status`, { status: s, note: n, value: v });
              if (!r.ok) { err.hidden = false; return; }
              load();
            } }, T.save),
            el('button', { class: 'ghost', type: 'button', onclick: async () => {
              const n = prompt(T.note) || '';
              await post(`deals/${l.id}/release`, { note: n });
              load();
            } }, T.release))));
    }

    q<HTMLFormElement>('[data-d-apply]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const b: R = Object.fromEntries(new FormData(f).entries());
      b.agreed = (f.elements.namedItem('agreed') as HTMLInputElement).checked;
      const r = await post('deals/apply', b);
      const m = q('[data-d-msg]');
      m.hidden = false;
      m.textContent = r.ok ? T.sent : T.noteErr;
      if (r.ok) load();
    });
    document.querySelectorAll('[data-go="deals"]').forEach((b) => b.addEventListener('click', load));
    load();
  }
</script>

