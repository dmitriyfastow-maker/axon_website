      ['5. Після перемоги', 'Ви залишаєтеся менеджером: питання, дзвінки, оновлення, нові замовлення. Відповідь — протягом 24 годин.']],
    extra: {"asYou": "Клієнт бачить ваші повідомлення так: {name} · Account Manager, Vaxo", "earnH": "Мій заробіток", "earnDue": "до виплати", "earnPaid": "виплачено", "kindMgr": "вів клієнта", "kindRef": "привів клієнта", "earnNone": "Заробіток зʼявиться тут, коли ваш клієнт оплатить. Ведете клієнта — 20%. Привели клієнта своїм посиланням — 30%.", "how3": [["1. Анкета", "Заповніть коротку анкету нижче. Власник перевірить її за кілька днів."], ["2. Візьміть клієнта", "Нові заявки зʼявляться тут. Натисніть «Взяти клієнта» — отримаєте контакт і готове перше повідомлення."], ["3. Спілкуйтеся і заробляйте", "Пишіть клієнту в чат його проєкту, проходьте кроки й отримуйте 20%, коли він оплатить."]], "next": {"claimed": "Зараз: надішліть перше повідомлення (текст нижче) — протягом 24 годин", "contacted": "Зараз: домовтеся про коротку розмову або надішліть пропозицію", "meeting": "Зараз: надішліть пропозицію (деталі — власнику)", "proposal": "Зараз: нагадайте про себе, потім позначте «Клієнт» або «Програний»", "won": "Зараз: підтримуйте клієнта, відповідайте протягом 24 годин", "lost": "Закрито", "unread": "Зараз: дайте відповідь клієнту"}},
    aiT: { name: "Vax · ШІ-менеджер", on: "Vax (ШІ) відповідає цьому клієнту 24/7. Ви підключаєтеся на живі дзвінки.", paused: "ШІ на паузі — клієнта ведете ви.", pause: "Пауза ШІ (веду сам)", resume: "Увімкнути ШІ", human: "Клієнту потрібна жива розмова:" },
    guard: "Не надіслано: телефони, месенджери та реквізити для оплати заборонені. Усе спілкування — у цьому чаті, клієнт платить лише Vaxo. Це зараховано як попередження.",
    sumH: "ШІ-зведення листування",
    useful: [['Усі послуги та ціни', '/ua/#services'], ['Тарифи зростання', '/ua/#pricing'], ['Кейси', '/ua/#cases'], ['Стартові пакети', '/ua/start/'], ['Приклади сайтів', '/ua/examples/'], ['Магазин шаблонів', '/ua/shop/']],
  },
}[lang];
---

<div class="deals" data-deals>
  <script type="application/json" data-deals-t set:html={JSON.stringify(T)} />
  <h2>{T.h}</h2>
  <p class="lead">{T.lead}</p>

  <div data-d-intro>
    <ol class="how3">{T.extra.how3.map(([h, d]) => <li><b>{h}</b><span>{d}</span></li>)}</ol>
    <h3>{T.req}</h3>
    <ul>{T.reqs.map((x) => <li>{x}</li>)}</ul>
  </div>

  <form class="apply" data-d-apply hidden>
    <h3>{T.apply}</h3>
    <label>{T.english}<select name="english" required><option value="">—</option><option>B2</option><option>C1</option><option>C2</option><option>Native</option></select></label>
    <label>{T.exp}<textarea name="experience" rows="4" required minlength="30" maxlength="1500"></textarea></label>
    <label>{T.profile}<input name="profile" type="url" maxlength="300" placeholder="https://linkedin.com/in/…" /></label>
    <div class="two">
      <label>{T.tz}<input name="timezone" maxlength="60" placeholder="UTC+2" /></label>
      <label>{T.hours}<input name="hours" maxlength="60" placeholder="15:00–23:00" /></label>
    </div>
    <label>{T.pitchQ}<textarea name="pitch" rows="5" required minlength="80" maxlength="1500"></textarea></label>
    <label class="chk"><input type="checkbox" name="agreed" required /> {T.agree}</label>
    <button class="cta" type="submit">{T.send}</button>
    <p class="msg" data-d-msg hidden></p>
  </form>

  <p class="status" data-d-status hidden></p>

  <div data-d-work hidden>
    <p class="stats" data-d-stats></p>
    <div class="earn" data-d-earn></div>
    <h3>{T.mine}</h3>
    <div class="clients" data-d-mine></div>
    <h3>{T.open}</h3>
    <div class="grid" data-d-open></div>
  </div>

  <details class="book"><summary>{T.rules}</summary><ol>{T.ruleList.map((x) => <li>{x}</li>)}</ol></details>
  <details class="book"><summary>{T.book}</summary>{T.playbook.map(([h, d]) => <div><b>{h}</b><p>{d}</p></div>)}</details>
</div>

<script>
  type R = Record<string, any>;
  const root = document.querySelector<HTMLElement>('[data-deals]');
  if (root) {
    const T = JSON.parse(root.querySelector('[data-deals-t]')!.textContent || '{}');
    const q = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
    const el = (tag: string, attrs: R = {}, ...kids: (Node | string | null | undefined | false)[]) => {
      const e = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) { if (k.startsWith('on')) (e as any)[k] = v; else if (v != null && v !== false) e.setAttribute(k, String(v)); }
      for (const k of kids) if (k) e.append(k);
      return e;
    };
    const when = (iso?: string) => (iso ? new Date(iso.replace(' ', 'T') + 'Z').toLocaleString(undefined, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '');
    const late = (iso?: string) => !!iso && Date.parse(iso.replace(' ', 'T') + 'Z') < Date.now();
    const contactLink = (c: string) => {
      const v = c.trim();
      if (/^@\w+$/.test(v)) return el('a', { href: `https://t.me/${v.slice(1)}`, target: '_blank', rel: 'noopener' }, v);
      if (v.includes('@')) return el('a', { href: `mailto:${v}` }, v);
      return el('a', { href: `tel:${v.replace(/[^\d+]/g, '')}` }, v);
    };
    const urls = (t: string) => Array.from(new Set((t.match(/\bhttps?:\/\/[^\s)<>"]+|\b[a-z0-9-]+\.(?:com|net|org|io|co|us|uk|de|ca|au|biz|shop|store)\b/gi) || []).filter((u) => !/vaxogroup\.com|gmail|yahoo|outlook|icloud|hotmail/i.test(u)))).slice(0, 6);
    const post = (path: string, b: unknown = {}) => fetch('/api/partner/' + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) });
    let me = '';
    let openId: number | null = null;

    async function load() {
      const res = await fetch('/api/partner/deals');
      if (!res.ok) return;
      const d = await res.json();
      if (!me) { const m = await fetch('/api/partner/me').then((r) => r.json()).catch(() => ({})); me = m?.partner?.name || ''; }
      q('[data-d-apply]').hidden = d.closer !== 'none';
      const st = q('[data-d-status]');
      st.hidden = !(d.closer === 'applied' || d.closer === 'paused');
      st.textContent = d.closer === 'applied' ? T.applied : d.closer === 'paused' ? T.paused : '';
      q('[data-d-work]').hidden = d.closer !== 'approved';
      q('[data-d-intro]').hidden = d.closer === 'approved';
      if (d.closer !== 'approved') return;
      const P = (d.payouts || []) as R[];
      const sum = (st: string) => P.filter((x) => x.status === st).reduce((a, x) => a + x.amount_usd, 0);
      q('[data-d-earn]').replaceChildren(el('h3', {}, T.extra.earnH),
        P.length ? el('div', { class: 'earn-row' }, el('span', {}, el('b', {}, `$${sum('due')}`), ' ', T.extra.earnDue), el('span', {}, el('b', {}, `$${sum('paid')}`), ' ', T.extra.earnPaid)) : el('p', { class: 'mut' }, T.extra.earnNone),
        P.length ? el('ul', {}, ...P.map((x) => el('li', {}, `${x.client} · ${x.kind === 'manager' ? T.extra.kindMgr : T.extra.kindRef} · ${x.rate}% · $${x.amount_usd} · ${x.status === 'paid' ? T.extra.earnPaid : T.extra.earnDue}`))) : null);
      q("[data-d-stats]").textContent = `${T.mine}: ${d.active} / ${d.limit} · ★ ${d.rating ?? "—"}`;
      q('[data-d-open]').replaceChildren(...(d.open.length ? d.open.map((l: R) =>
        el('article', { class: 'card' },
          el('div', { class: 'meta' }, `#${l.id} · ${when(l.created_at)} · ${(l.lang || '').toUpperCase()} · ${l.country || ''}`),
          el('b', {}, l.service || l.interest || '—'), l.budget && el('div', {}, `$ ${l.budget}`),
          el('p', {}, l.teaser || ''),
          el('button', { class: 'cta', type: 'button', onclick: async (e: Event) => {
            (e.currentTarget as HTMLButtonElement).disabled = true;
            const r = await post(`deals/${l.id}/claim`);
            if (!r.ok) { const j = await r.json().catch(() => ({})); alert(j.error === 'limit' ? T.limit : T.taken); } else openId = l.id;
            load();
          } }, T.take))) : [el('p', { class: 'mut' }, T.openNone)]));
      q('[data-d-mine]').replaceChildren(...(d.mine.length ? d.mine.map((l: R) => client(l, d.events.filter((e: R) => e.lead_id === l.id), d.messages.filter((m: R) => m.lead_id === l.id))) : [el('p', { class: 'mut' }, T.mineNone)]));
    }

    function client(l: R, events: R[], msgs: R[]) {
      const active = ['claimed', 'contacted', 'meeting', 'proposal'].includes(l.status);
      const isOpen = openId === l.id;
      const roomUrl = `${location.origin}/room/?t=${l.room}`;
      const head = el('button', { type: 'button', class: 'row', 'aria-expanded': String(isOpen), onclick: () => { openId = isOpen ? null : l.id; if (!isOpen) post(`deals/${l.id}/seen`); load(); } },
        el('b', {}, l.name), el('span', { class: 'svc' }, l.service || l.interest || ''),
        el('span', { class: 'badge b-' + l.status }, T.stage[l.status] ?? l.status),
        l.unread > 0 && el('span', { class: 'unread' }, `${l.unread} ${T.unread}`),
        el('span', { class: 'next' }, l.unread > 0 && l.status !== 'lost' ? T.extra.next.unread : T.extra.next[l.status] || ''),
        active && l.due_at && el('span', { class: late(l.due_at) ? 'due late' : 'due' }, `${T.due} ${when(l.due_at)}${late(l.due_at) ? ' · ' + T.overdue : ''}`));
      if (!isOpen) return el('div', { class: 'client' }, head);

      // Chat with the client (notes are shaded and never reach the client).
      const thread = el('div', { class: 'thread' }, ...msgs.map((m) => el('div', { class: `m ${m.sender === 'client' ? 'them' : 'us'} k-${m.kind}` },
        el('small', {}, `${m.sender === 'client' ? l.name : m.sender === 'owner' ? 'Vaxo Team' : m.sender === 'ai' ? T.aiT.name : m.sender === 'system' ? 'Vaxo' : (m.partner_name || '').split(' ')[0] + ' · Account Manager'}${m.kind === 'note' ? ' · 🔒' : m.kind === 'call' ? ' · 📅' : ''} · ${when(m.at)}`),
        el('div', {}, m.text))));
      let mode = 'text';
      const ta = el('textarea', { rows: '3', maxlength: '3000', placeholder: T.phClient }) as HTMLTextAreaElement;
      const whenIn = el('input', { type: 'datetime-local', hidden: true }) as HTMLInputElement;
      const linkIn = el('input', { placeholder: T.link, hidden: true }) as HTMLInputElement;
      const tabs = el('div', { class: 'modes' }, ...[['text', T.toClient], ['note', T.toNote], ['call', T.toCall]].map(([k, t]) =>
        el('button', { type: 'button', 'aria-pressed': String(k === mode), onclick: (e: Event) => {
          mode = k;
          tabs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === e.currentTarget)));
          ta.placeholder = k === 'note' ? T.phNote : T.phClient;
          whenIn.hidden = linkIn.hidden = k !== 'call';
        } }, t)));
      const composer = el('div', { class: 'composer' }, el('small', { class: 'mut' }, T.extra.asYou.replace('{name}', (me || '').split(' ')[0])), tabs, whenIn, linkIn, ta,
        el('button', { class: 'cta', type: 'button', onclick: async () => {
          const r = await post(`deals/${l.id}/msg`, { kind: mode, text: ta.value, when: whenIn.value.replace('T', ' '), link: linkIn.value });
          if (r.ok) return load();
          const j = await r.json().catch(() => ({}));
          if (j.error === 'guard') alert(T.guard);
        } }, T.sendBtn));

      const first = T.firstText.replace('{name}', l.name).replace('{you}', me).replace('{need}', l.service || 'your project').replace('{link}', roomUrl);
      const copyBtn = (text: string) => el('button', { type: 'button', class: 'ghost', onclick: async (e: Event) => { try { await navigator.clipboard.writeText(text); (e.currentTarget as HTMLElement).textContent = T.copied; } catch {} } }, T.roomCopy);
      const order = ['contacted', 'meeting', 'proposal', 'won', 'lost'];
      const sel = el('select', {}, ...order.map((s) => el('option', { value: s, selected: s === order[order.indexOf(l.status) + 1] }, T.stage[s]))) as HTMLSelectElement;
      const note = el('input', { placeholder: T.note, maxlength: '2000' }) as HTMLInputElement;
      const value = el('input', { type: 'number', min: '0', placeholder: T.value }) as HTMLInputElement;
      const err = el('p', { class: 'err', hidden: true }, T.noteErr);
      const found = urls(`${l.message || ''}\n${l.brief || ''}\n${l.contact || ''}`);
      const side = el('aside', { class: 'side' },
        el('dl', {}, el('dt', {}, T.contact), el('dd', {}, contactLink(l.contact || '')),
          el('dt', {}, '🌍'), el('dd', {}, `${(l.lang || '').toUpperCase()} · ${l.country || ''}${l.budget ? ' · $ ' + l.budget : ''}`)),
        el('div', { class: 'roombox aibox' }, el('b', {}, l.ai === 'paused' ? T.aiT.paused : T.aiT.on),
          l.human && el('p', {}, el('b', {}, T.aiT.human), ' ', l.human),
          el('button', { type: 'button', class: 'ghost', onclick: async () => { await post(`deals/${l.id}/ai`, { ai: l.ai === 'paused' ? 'on' : 'paused' }); load(); } }, l.ai === 'paused' ? T.aiT.resume : T.aiT.pause)),
        el('div', { class: 'roombox' }, el('b', {}, T.roomH), el('a', { href: roomUrl, target: '_blank' }, roomUrl.replace(/^https?:\/\//, '')), copyBtn(roomUrl)),
        l.status === 'claimed' && el('details', { open: true }, el('summary', {}, T.first), el('pre', {}, first), copyBtn(first)),
        l.ai_summary && el('details', { open: true }, el('summary', {}, T.sumH), el('pre', {}, l.ai_summary)),
        l.brief && el('details', { open: l.status === 'claimed' }, el('summary', {}, T.brief), el('pre', {}, l.brief)),
        el('details', {}, el('summary', {}, T.msg), el('pre', {}, l.message || '—')),
        el('details', {}, el('summary', {}, T.links), el('ul', {},
          ...found.map((u) => el('li', {}, el('a', { href: /^https?:/.test(u) ? u : `https://${u}`, target: '_blank', rel: 'noopener' }, u))),
          ...T.useful.map(([t, h]: [string, string]) => el('li', {}, el('a', { href: h, target: '_blank' }, t))))),
        active && el('div', { class: 'step' }, el('b', {}, T.stepH), sel, note, value, err,
          el('div', { class: 'btns' },
            el('button', { class: 'cta', type: 'button', onclick: async () => {
              const s = sel.value, n = note.value.trim(), v = Number(value.value);
              if (n.length < 10 || (s === 'won' && !v)) { err.hidden = false; return; }
              const r = await post(`deals/${l.id}/status`, { status: s, note: n, value: v });
              if (!r.ok) { err.hidden = false; return; }
              load();
            } }, T.save),
            el('button', { class: 'ghost', type: 'button', onclick: async () => {
              const n = prompt(T.note) || '';
              await post(`deals/${l.id}/release`, { note: n });
              openId = null; load();
            } }, T.release))),
        el('details', {}, el('summary', {}, T.log), el('ol', { class: 'log' }, ...events.map((e) => el('li', {}, el('small', {}, when(e.at)), ' ', e.text || e.kind)))));
      const ws = el('div', { class: 'ws' }, el('div', { class: 'chat' }, thread, composer), side);
      requestAnimationFrame(() => (thread.scrollTop = thread.scrollHeight));
      return el('div', { class: 'client open' }, head, ws);
    }

    q<HTMLFormElement>('[data-d-apply]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const b: R = Object.fromEntries(new FormData(f).entries());
      b.agreed = (f.elements.namedItem('agreed') as HTMLInputElement).checked;
      const r = await post('deals/apply', b);
      const m = q('[data-d-msg]');
      m.hidden = false;
      m.textContent = r.ok ? T.sent : T.noteErr;
      if (r.ok) load();
    });
    document.querySelectorAll('[data-go="deals"]').forEach((b) => b.addEventListener('click', load));
    load();
    setInterval(() => { if (!document.hidden && !root.closest('[hidden]') && !document.activeElement?.closest('.composer, .step')) load(); }, 30000);
  }
</script>

<style is:global>
  .deals { display: flex; flex-direction: column; gap: 14px; }
  .deals h2, .deals h3 { margin: 0; }
  .deals .lead { margin: 0; color: var(--mut); max-width: 780px; }
  .deals ul, .deals ol { padding-left: 20px; line-height: 1.55; }
  .deals .apply { display: flex; flex-direction: column; gap: 10px; max-width: 680px; background: var(--surf); border: 1px solid var(--line); border-radius: 16px; padding: 16px; }
  .deals .apply[hidden] { display: none; }
  .deals label { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--mut); }
  .deals label.chk { flex-direction: row; align-items: center; gap: 8px; color: var(--ink); }
  .deals input, .deals select, .deals textarea { font: 15px var(--font); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px; box-sizing: border-box; width: 100%; }
  .deals input[type='checkbox'] { width: auto; }
  .deals .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .deals .cta { background: var(--acc); color: var(--dark-ink); border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer; align-self: flex-start; }
  .deals .ghost { background: transparent; border: 1px solid var(--line); color: var(--ink); border-radius: 10px; padding: 7px 12px; cursor: pointer; align-self: flex-start; }
  .deals .status, .deals .stats { background: var(--surf); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; margin: 0; }
  .deals .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 10px; }
  .deals .card { background: var(--surf); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 8px; }
  .deals .card p { margin: 0; }
  .deals .meta { font: 12px var(--mono); color: var(--mut); }
  .deals .mut { color: var(--mut); }
  .deals .clients { display: flex; flex-direction: column; gap: 8px; }
  .deals .client { background: var(--surf); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .deals .client.open { border-color: var(--acc); }
  .deals .row { all: unset; box-sizing: border-box; width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 12px 14px; cursor: pointer; }
  .deals .row .svc { color: var(--mut); flex: 1; min-width: 120px; }
  .deals .badge { font-size: 12px; font-weight: 700; border-radius: 999px; padding: 2px 9px; background: var(--surf2); }
  .deals .b-won { background: #d8f5e4; color: #146c3c; } .deals .b-lost { background: #ffe0dc; color: #a12a1b; } .deals .b-claimed { background: #dbe8ff; color: #1d4ea8; }
  .deals .unread { background: var(--error); color: #fff; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 2px 8px; }
  .deals .due { font-size: 12px; color: var(--mut); } .deals .due.late { color: var(--error); font-weight: 700; }
  .deals .ws { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); border-top: 1px solid var(--line); }
  @media (max-width: 860px) { .deals .ws { grid-template-columns: 1fr; } }
  .deals .chat { display: flex; flex-direction: column; border-right: 1px solid var(--line); min-height: 420px; }
  .deals .thread { flex: 1; max-height: 460px; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: var(--bg); }
  .deals .thread .m { max-width: 85%; padding: 8px 11px; border-radius: 14px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; display: flex; flex-direction: column; gap: 2px; }
  .deals .thread .m small { font-size: 11px; color: var(--mut); }
  .deals .thread .them { align-self: flex-start; background: var(--surf); border: 1px solid var(--line); }
  .deals .thread .us { align-self: flex-end; background: var(--acc); color: var(--dark-ink); }
  .deals .thread .us small { color: rgba(0, 0, 0, 0.55); }
  .deals .thread .k-note { background: repeating-linear-gradient(45deg, var(--surf2), var(--surf2) 8px, var(--surf) 8px, var(--surf) 16px); color: var(--ink); }
  .deals .thread .k-call { border: 2px solid var(--accText); }
  .deals .composer { display: flex; flex-direction: column; gap: 8px; padding: 10px; border-top: 1px solid var(--line); }
  .deals .modes { display: flex; gap: 6px; flex-wrap: wrap; }
  .deals .modes button { border: 1px solid var(--line); background: transparent; color: var(--ink); border-radius: 999px; padding: 5px 11px; cursor: pointer; font: 600 13px var(--font); }
  .deals .modes [aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .deals .side { padding: 12px; display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
