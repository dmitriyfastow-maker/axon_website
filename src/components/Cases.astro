---
import type { Dict } from '../i18n';
import { CASE_META } from '../data/cases';
import { TIER_NAMES } from '../data/tiers';
import CaseCard from './CaseCard.astro';

interface Props { t: Dict }
const { t } = Astro.props;
const filters = [{ label: t.all, v: -1 }, ...TIER_NAMES.map((n, i) => ({ label: n, v: i }))];
const all = CASE_META.map((m, i) => ({ m, i }));
const top = all.filter((x) => x.m.real);
// Only real projects are shown (29.10: the 6 sample cases from the old AXON site were removed — Dmitry's decision).
const rest: typeof all = [];
const L = Astro.url.pathname.startsWith('/ru/') ? 'ru' : Astro.url.pathname.startsWith('/ua/') ? 'ua' : 'en';
const more = { en: `Show ${rest.length} more cases`, ru: `Показать ещё ${rest.length} кейсов`, ua: `Показати ще ${rest.length} кейсів` }[L];
---

<section id="cases" class="cases">
  <div class="head">
    <div class="intro">
      <div class="eyebrow">◆ {t.casesEyebrow}</div>
      <h2 class="h2">{t.casesTitle}</h2>
      <p>{t.casesSub}</p>
    </div>
    {new Set(top.map((x) => x.m.tier)).size > 1 && (
    <div class="filters" role="group" aria-label={t.casesEyebrow}>
      {
        filters.map((f) => (
          <button type="button" class="pill" data-case-filter={f.v} aria-pressed={f.v === -1 ? 'true' : 'false'}>
            {f.label}
          </button>
        ))
      }
    </div>
    )}
  </div>
  <div class="grid" data-acc-group="cases">
    {top.map(({ m, i }) => <CaseCard meta={m} copy={t.cases[i]} labels={t.labels} index={i} />)}
  </div>
  {rest.length > 0 && <>
    <button type="button" class="more-btn" data-cases-more>{more} ↓</button>
    <div class="grid more" data-cases-rest data-acc-group="cases" hidden>
      {rest.map(({ m, i }) => <CaseCard meta={m} copy={t.cases[i]} labels={t.labels} index={i} />)}
    </div>
  </>}
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-cases-more]');
  const rest = document.querySelector<HTMLElement>('[data-cases-rest]');
  const open = () => { if (rest) rest.hidden = false; if (btn) btn.hidden = true; };
  btn?.addEventListener('click', open);
  // Picking a tier filter shows every matching case, including the folded ones.
  document.querySelectorAll('[data-case-filter]').forEach((b) => b.addEventListener('click', open));
</script>

<style>
  .filters { display: none; }
  .more-btn { display: block; margin: 20px auto 0; background: var(--surf); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 12px 22px; font: 600 15px var(--font); cursor: pointer; }
  .more-btn:hover { border-color: var(--acc); }
  .grid.more { margin-top: 20px; }
  .cases {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(80px, 9vw, 128px) clamp(20px, 4vw, 40px);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
  }
  .intro p {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--mut);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px;
    background: var(--surf2);
    border-radius: 999px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
