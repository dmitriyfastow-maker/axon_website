---
// INSIDERS Level (Decision 25, step 1): a daily-quest game for the INSIDERS Discord community.
// Step 1 keeps progress in the browser (localStorage); Discord login, AI-checked tasks and squads come next.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, langPath } from '../i18n';

const { lang } = Astro.props as { lang: 'en' | 'ru' | 'ua' };
const t = getDict(lang);
const home = langPath(lang);
const P = { en: '/level/', ru: '/ru/level/', ua: '/ua/level/' };
const alts = P;
const path = P[lang];
const L = {
  en: {
    title: 'INSIDERS Level — daily quests for builders',
    desc: 'Five spheres, small daily quests, streaks and a first win in 24 hours. The game layer of the INSIDERS community by Vaxo.',
    lead: 'Small daily quests in five spheres. Finish one in the next 24 hours to get your first win, then keep the streak going.',
    level: 'Level', streak: 'Day streak', next: 'What comes next',
    nextText: 'Sign-in with Discord, quests checked by AI, squads of four and the link to INSIDERS Lab. For now your progress lives in this browser.',
    lab: 'See INSIDERS Lab →', labHref: '/lab/',
    done: 'First win done. Keep going tomorrow.', left: (h: number | string) => `First win window: ${h} h left. Tick one quest.`, tick: 'Tick one quest to get your first win.',
    spheres: [
      ['AI skills', ['Write one prompt that solves a real task of yours', 'Rebuild a bad answer from AI into a good one and note what you changed', 'Make an AI helper for one boring chore']],
      ['Clients', ['Find 3 small businesses with a visible problem online', 'Write one honest, personal message to a business owner', 'Describe a client problem in two sentences']],
      ['Content', ['Post one useful short thing today', 'Write a hook in 10 versions, pick the best', 'Reply to 3 people in your niche with real value']],
      ['Money', ['Price one service you could sell, with your reasoning', 'List your 3 cheapest ways to get a first paid task', "Track today's time and what it was worth"]],
      ['Habits', ['Work 45 focused minutes without your phone', "Plan tomorrow's three tasks tonight", 'Share one thing you finished today']],
    ],
  },
  ru: {
    title: 'INSIDERS Level — ежедневные задания для тех, кто строит',
    desc: 'Пять сфер, маленькие задания на каждый день, серии и первая победа за 24 часа. Игровой слой сообщества INSIDERS от Vaxo.',
    lead: 'Маленькие задания на каждый день в пяти сферах. Выполни одно в ближайшие 24 часа — это твоя первая победа, дальше держи серию.',
    level: 'Уровень', streak: 'Дней подряд', next: 'Что дальше',
    nextText: 'Вход через Discord, проверка заданий ИИ, отряды по четыре и связь с INSIDERS Lab. Пока прогресс хранится в этом браузере.',
    lab: 'Смотреть INSIDERS Lab →', labHref: '/ru/lab/',
    done: 'Первая победа есть. Продолжай завтра.', left: (h: number | string) => `Окно первой победы: осталось ${h} ч. Отметь одно задание.`, tick: 'Отметь одно задание — это будет первая победа.',
    spheres: [
      ['ИИ-навыки', ['Напиши один промпт, который решает твою настоящую задачу', 'Перепиши плохой ответ ИИ в хороший и запиши, что изменил', 'Сделай ИИ-помощника для одного скучного дела']],
      ['Клиенты', ['Найди 3 небольших бизнеса с заметной проблемой в интернете', 'Напиши владельцу бизнеса одно честное личное сообщение', 'Опиши проблему клиента в двух предложениях']],
      ['Контент', ['Выложи сегодня одну полезную короткую вещь', 'Напиши зацепку в 10 вариантах и выбери лучшую', 'Ответь трём людям в своей нише с настоящей пользой']],
      ['Деньги', ['Оцени одну услугу, которую мог бы продавать, и объясни цену', 'Выпиши 3 самых дешёвых способа получить первый платный заказ', 'Засеки время за день и во сколько оно оценивается']],
      ['Привычки', ['45 минут сосредоточенной работы без телефона', 'Вечером спланируй три задачи на завтра', 'Расскажи об одном деле, которое сегодня довёл до конца']],
    ],
  },
  ua: {
    title: 'INSIDERS Level — щоденні завдання для тих, хто будує',
    desc: "П'ять сфер, маленькі завдання на кожен день, серії та перша перемога за 24 години. Ігровий шар спільноти INSIDERS від Vaxo.",
    lead: "Маленькі завдання на кожен день у п'яти сферах. Виконай одне найближчими 24 годинами — це твоя перша перемога, далі тримай серію.",
    level: 'Рівень', streak: 'Днів поспіль', next: 'Що далі',
    nextText: "Вхід через Discord, перевірка завдань ШІ, загони по четверо та зв'язок з INSIDERS Lab. Поки прогрес зберігається в цьому браузері.",
    lab: 'Дивитись INSIDERS Lab →', labHref: '/ua/lab/',
    done: 'Перша перемога є. Продовжуй завтра.', left: (h: number | string) => `Вікно першої перемоги: лишилось ${h} год. Познач одне завдання.`, tick: 'Познач одне завдання — це буде перша перемога.',
    spheres: [
      ['ШІ-навички', ['Напиши один промпт, що розв’язує твоє справжнє завдання', 'Перепиши погану відповідь ШІ на добру й записати, що змінив', 'Зроби ШІ-помічника для однієї нудної справи']],
      ['Клієнти', ['Знайди 3 невеликих бізнеси з помітною проблемою в інтернеті', 'Напиши власнику бізнесу одне чесне особисте повідомлення', 'Опиши проблему клієнта у двох реченнях']],
      ['Контент', ['Виклади сьогодні одну корисну коротку річ', 'Напиши зачіпку у 10 варіантах і обери найкращу', 'Дай трьом людям у своїй ніші відповідь зі справжньою користю']],
      ['Гроші', ['Оціни одну послугу, яку міг би продавати, і поясни ціну', 'Випиши 3 найдешевші способи отримати перше платне замовлення', 'Засічи свій час за день і скільки він коштує']],
      ['Звички', ['45 хвилин зосередженої роботи без телефона', 'Ввечері сплануй три завдання на завтра', 'Розкажи про одну справу, яку сьогодні довів до кінця']],
    ],
  },
}[lang];
const icons = ['✦', '◎', '▶', '$', '↻'];
const ids = ['ai', 'clients', 'content', 'money', 'habits'];
const spheres = L.spheres.map((s, i) => ({ id: ids[i], icon: icons[i], name: s[0] as string, quests: s[1] as string[] }));
---

<Base lang={lang} title={L.title} description={L.desc} path={path} alts={alts}>
  <Header lang={lang} t={t} home={home} alts={alts} />
  <main class="lv">
    <section class="lv-top">
      <span class="lv-badge">INSIDERS × Vaxo</span>
      <h1>INSIDERS Level</h1>
      <p>{L.lead}</p>
      <div class="lv-stats">
        <div><b id="xp">0</b><span>XP</span></div>
        <div><b id="lvl">1</b><span>{L.level}</span></div>
        <div><b id="streak">0</b><span>{L.streak}</span></div>
      </div>
      <div class="lv-bar"><i id="bar"></i></div>
      <p class="lv-first" id="first" data-done={L.done} data-tick={L.tick} data-left={L.left('{h}')}></p>
      <div class="lv-sync" id="sync" data-lang={lang}>
        <p id="sync-msg"></p>
        <form id="sync-form" hidden>
          <input id="sync-in" type="text" inputmode="email" autocomplete="email" />
          <button class="lv-btn" type="submit" id="sync-go"></button>
        </form>
      </div>
    </section>

    <section class="lv-grid">
      {spheres.map((s) => (
        <article class="lv-card" data-sphere={s.id}>
          <h2><span>{s.icon}</span> {s.name}</h2>
          <ul>
            {s.quests.map((q, i) => (
              <li>
                <label>
                  <input type="checkbox" data-q={`${s.id}-${i}`} />
                  <span>{q}</span>
                </label>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="lv-note">
      <h2>{L.next}</h2>
      <p>{L.nextText}</p>
      <a class="lv-btn" href={L.labHref}>{L.lab}</a>
    </section>
  </main>
  <Footer t={t} home={home} lang={lang} />
</Base>

<script>
  const KEY = 'insiders-level-v1';
  type S = { done: Record<string, string>; days: string[]; start: number };
  const today = () => new Date().toISOString().slice(0, 10);
  let state: S = { done: {}, days: [], start: Date.now() };
  try { const raw = localStorage.getItem(KEY); if (raw) state = JSON.parse(raw); } catch {}
  const SK = 'insiders-level-session';
  let session = '';
  try { session = localStorage.getItem(SK) || ''; } catch {}
  let timer: number | undefined;
  const push = () => {
    if (!session) return;
    clearTimeout(timer);
    timer = window.setTimeout(() => { fetch('/api/level', { method: 'POST', body: JSON.stringify({ action: 'save', session, state }) }).catch(() => {}); }, 600);
  };
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} push(); };

  const streak = () => {
    let n = 0;
    const d = new Date();
    for (;;) {
      const k = d.toISOString().slice(0, 10);
      if (state.days.includes(k)) { n++; d.setDate(d.getDate() - 1); }
      else if (n === 0 && k === today()) d.setDate(d.getDate() - 1);
      else break;
    }
    return n;
  };

  const render = () => {
    const xp = Object.keys(state.done).length * 20;
    const lvl = Math.floor(xp / 100) + 1;
    (document.getElementById('xp') as HTMLElement).textContent = String(xp);
    (document.getElementById('lvl') as HTMLElement).textContent = String(lvl);
    (document.getElementById('streak') as HTMLElement).textContent = String(streak());
    (document.getElementById('bar') as HTMLElement).style.width = `${xp % 100}%`;
    const first = document.getElementById('first') as HTMLElement;
    const left = state.start + 864e5 - Date.now();
    const d = first.dataset;
    first.textContent = xp > 0 ? d.done!
      : left > 0 ? d.left!.replace('{h}', String(Math.ceil(left / 36e5))) : d.tick!;
    document.querySelectorAll<HTMLInputElement>('input[data-q]').forEach((c) => { c.checked = !!state.done[c.dataset.q!]; });
  };

  document.querySelectorAll<HTMLInputElement>('input[data-q]').forEach((c) => {
    c.addEventListener('change', () => {
      const k = c.dataset.q!;
      if (c.checked) { state.done[k] = today(); if (!state.days.includes(today())) state.days.push(today()); }
      else delete state.done[k];
      save(); render();
    });
  });
  render();

  const T: Record<string, Record<string, string>> = {
    en: { off: 'Save your progress across devices — sign in with your email.', on: 'Progress is saved to {e}.', ph: 'your@email.com', go: 'Send code', code: '6-digit code from the email', ok: 'Sign in', bad: 'Wrong or expired code.', err: 'Could not send. Try again in a minute.', out: 'Sign out' },
    ru: { off: 'Сохрани прогресс на всех устройствах — войди по почте.', on: 'Прогресс сохраняется для {e}.', ph: 'твоя@почта.com', go: 'Отправить код', code: '6 цифр из письма', ok: 'Войти', bad: 'Код неверный или устарел.', err: 'Не вышло отправить. Попробуй через минуту.', out: 'Выйти' },
    ua: { off: 'Збережи прогрес на всіх пристроях — увійди через пошту.', on: 'Прогрес зберігається для {e}.', ph: 'твоя@пошта.com', go: 'Надіслати код', code: '6 цифр з листа', ok: 'Увійти', bad: 'Код хибний або застарів.', err: 'Не вдалося надіслати. Спробуй за хвилину.', out: 'Вийти' },
  };
  const box = document.getElementById('sync')!;
  const t = T[box.dataset.lang || 'en'] || T.en;
  const msg = document.getElementById('sync-msg')!;
  const form = document.getElementById('sync-form') as HTMLFormElement;
  const inp = document.getElementById('sync-in') as HTMLInputElement;
  const go = document.getElementById('sync-go') as HTMLButtonElement;
  let email = '', step: 'mail' | 'code' = 'mail';
  const setMail = () => { step = 'mail'; inp.value = ''; inp.placeholder = t.ph; go.textContent = t.go; };
  const show = (who?: string) => {
    if (who) { msg.textContent = t.on.replace('{e}', who); form.hidden = true; return; }
    msg.textContent = t.off; form.hidden = false; setMail();
  };
  const adopt = (s: any) => { state = s; try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} render(); };
  if (session) {
    fetch('/api/level?session=' + encodeURIComponent(session)).then((r) => r.json()).then((d) => {
      if (d.ok) { adopt(d.state && d.state.done ? { ...state, ...d.state, done: { ...state.done, ...d.state.done } } : state); show(d.email); push(); }
      else { session = ''; try { localStorage.removeItem(SK); } catch {} show(); }
    }).catch(() => show());
  } else show();
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = inp.value.trim();
    if (!v) return;
    go.disabled = true;
    try {
      if (step === 'mail') {
        const r = await fetch('/api/level', { method: 'POST', body: JSON.stringify({ action: 'code', email: v }) });
        if (r.ok) { email = v; step = 'code'; inp.value = ''; inp.placeholder = t.code; go.textContent = t.ok; msg.textContent = t.code; } else msg.textContent = t.err;
      } else {
        const r = await fetch('/api/level', { method: 'POST', body: JSON.stringify({ action: 'verify', email, code: v, state }) });
        const d = await r.json();
        if (d.ok) { session = d.session; try { localStorage.setItem(SK, session); } catch {} adopt(d.state); show(email.toLowerCase()); } else msg.textContent = t.bad;
      }
    } catch { msg.textContent = t.err; }
    go.disabled = false;
  });
</script>

<style>
  .lv { max-width: 1040px; margin: 0 auto; padding: 48px 16px 72px; }
  .lv-top { text-align: center; margin-bottom: 40px; }
  .lv-badge { display: inline-block; font-size: 13px; padding: 4px 12px; border-radius: 999px; border: 1px solid currentColor; opacity: .7; }
  .lv h1 { font-size: clamp(32px, 6vw, 52px); margin: 14px 0 8px; }
  .lv-top p { max-width: 560px; margin: 0 auto; opacity: .8; }
  .lv-stats { display: flex; justify-content: center; gap: 32px; margin: 28px 0 14px; }
  .lv-stats div { display: flex; flex-direction: column; }
  .lv-stats b { font-size: 32px; }
  .lv-stats span { font-size: 13px; opacity: .65; }
  .lv-bar { height: 8px; max-width: 360px; margin: 0 auto; border-radius: 8px; background: rgba(127,127,127,.25); overflow: hidden; }
  .lv-bar i { display: block; height: 100%; width: 0; background: currentColor; transition: width .3s; }
  .lv-first { margin-top: 14px; font-size: 14px; }
  .lv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .lv-card { border: 1px solid rgba(127,127,127,.3); border-radius: 16px; padding: 20px; }
  .lv-card h2 { font-size: 20px; margin: 0 0 12px; }
  .lv-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lv-card label { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; font-size: 15px; }
  .lv-card input { margin-top: 4px; }
  .lv-sync { margin-top: 18px; font-size: 14px; }
  .lv-sync form { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }
  .lv-sync input { padding: 8px 12px; border-radius: 999px; border: 1px solid rgba(127,127,127,.4); background: transparent; color: inherit; min-width: 220px; }
  .lv-sync .lv-btn { margin-top: 0; padding: 8px 16px; background: transparent; color: inherit; cursor: pointer; }
  .lv-note { margin-top: 40px; text-align: center; }
  .lv-btn { display: inline-block; margin-top: 8px; padding: 10px 20px; border-radius: 999px; border: 1px solid currentColor; text-decoration: none; }
</style>
