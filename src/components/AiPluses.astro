---
// Короткая полоска «плюсы ИИ» для внутренних страниц (полная версия — Why.astro на главной)
import type { Dict } from '../i18n';

interface Props { t: Dict }
const { t } = Astro.props;
---

<section class="aip">
  <div class="inner">
    <h2>{t.whyTitle}</h2>
    <p class="sub">{t.whySub}</p>
    <ul>
      {t.why.map((w) => (
        <li><b>{w.t}</b><span>{w.d}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .aip {
    background: var(--surf);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) clamp(16px, 4vw, 40px);
  }
  h2 {
    margin: 0 0 8px;
    font-size: clamp(24px, 3vw, 34px);
  }
  .sub {
    margin: 0 0 24px;
    color: var(--mut);
    font-size: 17px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
  }
  li b { font-size: 16px; }
  li span { color: var(--mut); font-size: 14px; line-height: 1.45; }
</style>
