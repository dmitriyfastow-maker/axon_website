  .wsp .card { display: grid; gap: 2px; margin-top: 10px; width: min(100%, 360px); text-align: left; background: var(--surf); border: 1px solid var(--line); border-radius: 12px; padding: 11px 13px; cursor: pointer; }
  .wsp .card:hover { border-color: var(--ink); }
  .wsp .card small { color: var(--accText); font-size: 13px; }
  .wsp .pic { display: block; max-width: min(100%, 440px); margin-top: 10px; border-radius: 12px; }
  .wsp .in { display: flex; align-items: flex-end; gap: 6px; margin: 0 max(16px, calc((100% - 760px) / 2)) 16px; padding: 8px; border: 1px solid var(--line); border-radius: 16px; background: var(--surf); }
  .wsp .att-tray { margin: 0 max(16px, calc((100% - 760px) / 2)) 6px; }
  .wsp .in textarea { flex: 1; min-width: 0; resize: none; border: 0; outline: 0; background: none; color: var(--ink); font: 16px/1.4 var(--font); padding: 9px 6px; max-height: 160px; }
  .wsp .ib, .wsp .go { flex: none; width: 40px; height: 40px; border: 0; border-radius: 10px; background: none; cursor: pointer; display: grid; place-items: center; }
  .wsp .go { background: var(--ink); color: var(--bg); font-size: 16px; }
  .wsp .ib.rec { background: var(--error, #e5484d); color: #fff; }
  .wsp .cv { border-left: 1px solid var(--line); background: var(--surf); display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .wsp .cv[hidden] { display: none; }
