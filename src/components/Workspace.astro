    const D = (window as any).docx;
    const runs = (t: string, bold = false) => t.split(/(\*\*[^*]+\*\*)/).filter(Boolean).map((x) => new D.TextRun({ text: x.replace(/\*\*/g, ''), bold: bold || /^\*\*/.test(x) }));
    const kids: any[] = [new D.Paragraph({ heading: D.HeadingLevel.TITLE, children: [new D.TextRun(title)] })];
    const lines = body.split('\n');
    for (let i = 0; i < lines.length; i++) {
      const l = lines[i];
      if (/^\s*\|/.test(l)) {
        const rows: string[][] = [];
        while (i < lines.length && /^\s*\|/.test(lines[i])) { const c = lines[i].trim().replace(/^\||\|$/g, '').split('|').map((x) => x.trim()); if (!c.every((x) => /^:?-{2,}:?$/.test(x))) rows.push(c); i++; }
        i--;
        const w = Math.max(...rows.map((r) => r.length));
        kids.push(new D.Table({ width: { size: 100, type: D.WidthType.PERCENTAGE }, rows: rows.map((r, ri) => new D.TableRow({ children: Array.from({ length: w }, (_, ci) => new D.TableCell({ children: [new D.Paragraph({ children: runs(r[ci] || '', ri === 0) })] })) })) }));
