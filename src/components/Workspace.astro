---
// Workspace (Decision 40): the one screen a person works in. Projects, memory and modules on the left, the chat with Vax
// in the middle, the Canvas with tools and documents on the right. Works for guests too, in this browser.
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pre = lang === 'en' ? '' : `/${lang}`;

const T = {
  en: {
    title: 'Vaxo Workspace', desc: 'Your workspace with Vax: chat, memory, tools and modules on one screen.',
    new: 'New chat', chats: 'Projects', noChats: 'Your chats will appear here.', mods: 'Modules', crm: 'CRM', partner: 'Partner links', site: 'Site', you: 'You', memory: 'Memory', earn: 'Earn with Vaxo', profile: 'Profile and billing',
    signin: 'Sign in', out: 'Sign out', guest: 'Guest: saved in this browser', short: 'Short', deep: 'Deep project', canvas: 'Canvas', menu: 'Menu', close: 'Close',
