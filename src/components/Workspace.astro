      const b = l.match(/^\s*[-*•]\s+(.*)/);
      if (b) { kids.push(new D.Paragraph({ bullet: { level: 0 }, children: runs(b[1]) })); continue; }
      if (l.trim()) kids.push(new D.Paragraph({ children: runs(l.trim()), spacing: { after: 120 } }));
    }
    saveBlob(await D.Packer.toBlob(new D.Document({ sections: [{ children: kids }] })), fileName(title) + '.docx');
    return true;
  }
