    for (const q of m.content.matchAll(/\[\[REPLY:([^\]]*)\]\]/g)) d.append(el('div', 'quote', q[1]));
    const t = el('div', 'tx'); const pc = plain(m.content);
    // Vax's tables and [text](link) read as a table and links, not as raw | and brackets.
    if (m.role === 'assistant' && /^\s*\|.*\|\s*$|\]\(https?:/m.test(pc) && !/📎 /.test(pc)) { t.classList.add('mdx'); t.innerHTML = chatMd(pc); } else t.innerHTML = linkify(pc); d.append(t);
