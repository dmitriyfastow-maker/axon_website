  function panel(k: string) {
    if (k === 'memory') { openProf('memory'); return; }
    if (k === 'earn') { partnerPanel(); return; }
    // 19.11: only the CURRENT chat's project — never another business's site beside an unrelated chat.
    const pid = S.proj?.id;
    if (pid && PTABS.includes(k)) { openProject(pid, k); return; }
    if (k === 'partner') { partnerPanel(); return; }
    sitePanel();
  }

  /* ---------- A project is a business (Decision 46): its site, requests, site chat, partners, domain ---------- */
  async function useProject(pid?: number | null) {
    const p = pid ? S.projects.find((x) => x.id === pid) : undefined;
    S.proj = p ? { id: p.id, name: p.name, biz: p.biz ?? null } : null;
    S.mods = null;
    if (p && S.signed) {
      const d = await fetch(`/api/ws/project/${p.id}/state`).then((r) => r.json()).catch(() => null);
      if (d?.ok) { S.mods = d.modules; S.access = !!d.access; if (d.project?.biz) { p.biz = d.project.biz; S.proj!.biz = d.project.biz; } }
    }
  }
  const PTABS = ['home', 'site', 'book', 'pay', 'crm', 'team', 'bot', 'partner', 'rev', 'domain'];
  let ptab = 'home';
  async function openProject(pid: number, tab = ptab, show?: () => void) {
    if (S.proj?.id !== pid || !S.mods) await useProject(pid);
    ptab = tab;
    if (show) show(); else ({ home: homePanel, site: sitePanel, book: bookPanel, crm: crmPanel, team: teamPanel, bot: botPanel, partner: projPartners, rev: revPanel, domain: domainPanel, pay: payPanel } as Record<string, () => void>)[tab]?.();
    // The same canvas, with the project's tabs on top and its name as the title.
    const bar = el('div', 'ptabs2');
    for (const k of PTABS) { const b = btn(k === tab ? 'on' : '', T.ptabs[k], () => openProject(pid, k)); b.prepend(Object.assign(el('span'), { innerHTML: ico(({ home: 'cal', site: 'site', book: 'cal', crm: 'doc', team: 'user', bot: 'reply', partner: 'link', rev: 'pin', domain: 'fwd', pay: 'doc' } as R)[k], 14) })); bar.append(b); }
    cvBody.prepend(bar);
    cvTitle.textContent = S.proj?.name || T.canvas;
  }

