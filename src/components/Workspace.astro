  .wsp .cvb { flex: 1; overflow-y: auto; padding: 16px; display: grid; gap: 12px; align-content: start; }
  .wsp .cvb .none { color: var(--mut); }
  .wsp .bar { display: flex; flex-wrap: wrap; gap: 6px; }
  .wsp .src { width: 100%; min-height: 60vh; font: 14px/1.5 ui-monospace, monospace; background: var(--bg); color: var(--ink); border: 1px solid var(--line); border-radius: 10px; padding: 12px; }
  .wsp .src[hidden], .wsp .doc[hidden] { display: none; }
  .wsp .doc { line-height: 1.55; font-size: 15px; overflow-wrap: anywhere; }
  .wsp .doc h1, .wsp .doc h2, .wsp .doc h3 { line-height: 1.25; margin: 18px 0 8px; }
  .wsp .doc h1 { font-size: 22px; } .wsp .doc h2 { font-size: 18px; } .wsp .doc h3 { font-size: 16px; }
  .wsp .doc > :first-child { margin-top: 0; }
  .wsp .doc p, .wsp .doc ul, .wsp .doc ol { margin: 0 0 10px; }
