---
<Base lang={lang} title={T.title} description={T.desc} noindex noChat>
  <div class="wsp" data-ws data-lang={lang} data-pre={pre}>
    <script type="application/json" data-t set:html={JSON.stringify(T)} />
    <script type="application/json" data-ct set:html={JSON.stringify(CT)} />
    <aside class="side" data-side>
      <a class="logo" href={`${pre}/`}>VAXO<span>.</span></a>
      <button class="newc" type="button" data-new>+ {T.new}</button>
      <button class="nav mapbtn" type="button" data-map><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{T.map}</button>
      <div class="lblrow"><p class="lbl">{T.chats}</p><button class="addp" type="button" data-newproj title={T.newProj} aria-label={T.newProj}>+</button></div>
      <nav class="chats" data-chats></nav>
      <p class="lbl">{T.you}</p>
      <button class="nav" type="button" data-prof="memory"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={ico.memory} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{T.memory}</button>
      <button class="nav" type="button" data-earn><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M12 3v18M17 7H9.5a3 3 0 0 0 0 6h5a3 3 0 0 1 0 6H6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{T.earn}</button>
      <button class="nav" type="button" data-prof="plan"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={ico.user} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{T.profile}</button>
      <div class="foot">
        <button class="usage" type="button" data-usage data-prof="plan" hidden></button>
        <div class="who" data-who></div>
        <div class="langs">
          <button class="mini" type="button" data-theme-toggle aria-label="Theme">◐</button>
          <a class="mini" href="/app/">EN</a><a class="mini" href="/ua/app/">UA</a><a class="mini" href="/ru/app/">RU</a>
        </div>
      </div>
    </aside>
    <div class="veil" data-veil hidden></div>
    <div class="rz rz-s" data-rz="s" role="separator" aria-orientation="vertical" title={T.rz}></div>
    <div class="rz rz-c" data-rz="c" role="separator" aria-orientation="vertical" title={T.rz}></div>

    <main class="mid">
      <header class="top">
        <button class="ic only-m" type="button" data-menu aria-label={T.menu}>☰</button>
        <b class="ttl" data-title></b>
        <button class="ic only-m nm" type="button" data-new-m aria-label={T.new} title={T.new}>+</button>
        <div class="modes" hidden style="display:none" role="group" aria-label={T.modeL} title={T.modeTip}>
          <span class="mlab">{T.modeL}:</span>
          <button type="button" data-mode="short" title={T.modeTip}>{T.short}</button>
          <button type="button" data-mode="deep" title={T.modeTip}>{T.deep}</button>
        </div>
        <button class="ic" type="button" data-del aria-label={T.del} title={T.del} hidden style="display:none"></button>
        <button class="tb" type="button" data-mat hidden><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg><span>{T.mat}</span></button>
        <button class="tb" type="button" data-cv><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 4h18v16H3zM14 4v16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg><span data-cv-label>{T.showCv}</span></button>
      </header>
      <button class="pins" type="button" data-pins hidden></button>
      <div class="log" data-log aria-live="polite"></div>
      <div class="replybar" data-replybar hidden><span></span><button type="button" class="ic" data-reply-x aria-label={T.close}>×</button></div>
      <form class="in" data-form>
        <button type="button" class="ib" data-clip aria-label={T.attach} title={T.attach}></button>
        <textarea name="q" rows="1" maxlength="4000" placeholder={T.ph} aria-label={T.ph}></textarea>
        <button type="button" class="ib" data-mic aria-label={T.mic}></button>
        <button type="submit" class="go" aria-label={T.send}>➤</button>
      </form>
    </main>

    <aside class="cv" data-canvas hidden>
      <header><b data-cv-title>{T.canvas}</b><div class="cvact"><button class="tb" type="button" data-cv-full><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg><span data-cv-full-label>{T.full}</span></button><button class="tb" type="button" data-cv-x><span>{T.hideCv}</span> ×</button></div></header>
      <div class="cvb" data-cv-body></div>
    </aside>

    <div class="bizbox" data-bizbox hidden><BizApp lang={lang} /></div>

    <dialog class="wsign" data-sign>
      <button class="ic x" type="button" data-sign-x aria-label={T.close}>×</button>
      <h2>{T.sH}</h2>
      <p data-sign-p>{T.sP}</p>
      <form data-sign-mail>
        <input type="email" name="email" required maxlength="254" autocomplete="email" placeholder={T.sEmail} aria-label={T.sEmail} />
        <button class="pri" type="submit">{T.sGo}</button>
      </form>
      <form data-sign-code hidden>
        <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder={T.sCode} aria-label={T.sCode} />
        <button class="pri" type="submit">{T.sIn}</button>
      </form>
      <a class="gbtn" href="/api/me/google" data-sign-g hidden><svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>{CT.google}</a>
      <small class="bad" data-sign-err role="status"></small>
      <small>{T.sAgree} <a href={`${pre}/terms/`}>{T.terms}</a> {T.and} <a href={`${pre}/privacy/`}>{T.privacy}</a>.</small>
    </dialog>

    <dialog class="wmap" data-mapdlg aria-labelledby="wmap-h">
      <header><b id="wmap-h">{T.map}</b><button class="ic" type="button" data-map-x aria-label={T.close}>×</button></header>
      <div class="mapb" data-mapbody></div>
    </dialog>
    <dialog class="wpick" data-pick>
      <header><b data-pick-h></b><button class="ic" type="button" data-pick-x aria-label={T.close}>×</button></header>
      <div class="pickb" data-pick-body></div>
    </dialog>

    <dialog class="wprof" data-profile aria-labelledby="wprof-h">
      <header><b id="wprof-h">{T.profile}</b><button class="ic" type="button" data-prof-x aria-label={T.close}>×</button></header>
      <div class="ptabs" role="tablist" data-ptabs></div>
      <div class="pbody" data-pbody></div>
    </dialog>
  </div>
</Base>

<script>
  import { attachMic, MIC_SVG } from '../scripts/voice';
  import { attachFiles, linkify } from '../scripts/attach';
  import { composer } from '../scripts/compose';
  import { renderTool } from '../scripts/tool';
  import { initTheme } from '../scripts/theme';
  import { md } from '../scripts/md';
  import type { ToolSpec } from '../../worker/toolcore';

  type R = Record<string, any>;
  type Doc = { title: string; body: string };
  type Site = { lang?: string; tone: string; style?: string; kicker?: string; details?: string[]; steps?: string[]; faq?: { q: string; a: string }[]; imgs?: string[]; img?: string; promise?: string; title: string; sub: string; about: string; services: string[]; cta: string; ask?: string; url?: string; slug?: string };
  type Msg = { id?: number; role: 'user' | 'assistant'; content: string; tool?: ToolSpec; doc?: Doc; image?: string; deploy?: string; site?: Site; pub?: string; pinned?: boolean };
  type Chat = { id: number; title: string; msgs?: Msg[]; project?: number };
  type Proj = { id: number; name: string; biz?: number | null };
  type Mem = { niche: string; goals: string; project: string; limits: string };

  const root = document.querySelector<HTMLElement>('[data-ws]')!;
  const T = JSON.parse(root.querySelector('[data-t]')!.textContent || '{}');
  const CT = JSON.parse(root.querySelector('[data-ct]')!.textContent || '{}');
  const lang = root.dataset.lang || 'en', pre = root.dataset.pre || '';
  const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; };
  const btn = (cls: string, text: string, go: () => void) => { const b = el('button', cls, text); b.type = 'button'; b.onclick = go; return b; };
  const KEY = 'vaxo_ws', PEND = 'vaxo_ws_open', SITE_PEND = 'vaxo_ws_site';
  const local = { get() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } }, set(v: unknown) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} }, drop() { try { localStorage.removeItem(KEY); } catch {} } };
  const post = (p: string, b: unknown) => fetch(p, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) });
  const postJ = async (p: string, b: unknown) => { const r = await post(p, b).catch(() => null); return { r, d: (r ? await r.json().catch(() => ({})) : {}) as R }; };
  const money = (n: number) => '$' + (Math.round(n * 100) / 100).toLocaleString('en-US');
  const flash = (b: HTMLElement, text: string, back: string) => { b.textContent = text; setTimeout(() => (b.textContent = back), 1500); };
  const copyText = async (v: string) => { try { await navigator.clipboard.writeText(v); } catch {} };
  const params = new URLSearchParams(location.search);
  const room = params.get('t') || '';

  const blank: Mem = { niche: '', goals: '', project: '', limits: '' };
  const S = { signed: false, email: '', verified: false, chats: [] as Chat[], cur: 0, msgs: [] as Msg[], memory: { ...blank }, mode: 'short', mods: null as R | null, access: false, busy: false, plan: 'start', projects: [] as Proj[], objects: [] as any[], reply: null as null | { text: string }, pendingProject: 0, proj: null as null | { id: number; name: string; biz: number | null }, usage: null as null | { day: { pct: number; reset: string }; week: { pct: number; reset: string } } };
  let ME: R = {};

  const log = $('[data-log]'), form = $<HTMLFormElement>('[data-form]'), input = form.querySelector('textarea')!;
  const cv = $('[data-canvas]'), cvBody = $('[data-cv-body]'), cvTitle = $('[data-cv-title]');
  const sign = $<HTMLDialogElement>('[data-sign]'), prof = $<HTMLDialogElement>('[data-profile]');
  const bizbox = $('[data-bizbox]');

  const saveGuest = () => { if (!S.signed) local.set({ chats: S.chats, memory: S.memory, mode: S.mode, projects: S.projects }); };

  /* ---------- Sidebar ---------- */
  function side(yes: boolean) { $('[data-side]').classList.toggle('open', yes); $('[data-veil]').hidden = !yes; }
  const PLAN_NAMES: R = { en: { start: 'Free', personal: 'Plus', care: 'Pro', growth: 'Max', pro: 'Ultra' }, ru: { start: 'Бесплатный', personal: 'Плюс', care: 'Про', growth: 'Макс', pro: 'Ультра' }, ua: { start: 'Безкоштовний', personal: 'Плюс', care: 'Про', growth: 'Макс', pro: 'Ультра' } };
  const planName = () => (PLAN_NAMES[lang] || PLAN_NAMES.en)[S.plan] || S.plan;
  // Like Claude: a bar of work used, and when it renews. Never message counts.
  const when = (iso: string) => {
    const d = new Date(iso), now = new Date(), loc = lang === 'ua' ? 'uk-UA' : lang === 'ru' ? 'ru-RU' : 'en-GB';
    const h = d.toLocaleTimeString(loc, { hour: '2-digit', minute: '2-digit' });
    const days = Math.round((new Date(d.toDateString()).getTime() - new Date(now.toDateString()).getTime()) / 864e5);
    return days <= 0 ? T.lim.today.replace('{h}', h) : days === 1 ? T.lim.tomorrow.replace('{h}', h) : T.lim.on.replace('{d}', d.toLocaleDateString(loc, { weekday: 'short', day: 'numeric', month: 'short' })).replace('{h}', h);
  };
  function meter(label: string, x: { pct: number; reset: string }) {
    const box = el('div', 'lim'), top = el('div', 'lim-top'), bar = el('div', 'lim-bar'), fill = el('i');
    top.append(el('span', '', label), el('b', '', T.lim.used.replace('{p}', String(x.pct))));
    fill.style.width = Math.max(x.pct, x.pct > 0 ? 2 : 0) + '%'; if (x.pct >= 90) fill.className = 'hot';
    bar.setAttribute('role', 'progressbar'); bar.setAttribute('aria-valuenow', String(x.pct)); bar.setAttribute('aria-valuemin', '0'); bar.setAttribute('aria-valuemax', '100'); bar.setAttribute('aria-label', label);
    bar.append(fill);
    box.append(top, bar, el('small', '', T.lim.reset.replace('{t}', when(x.reset))));
    return box;
  }
  function drawUsage() {
    const u = $<HTMLButtonElement>('[data-usage]');
    u.hidden = false;
    if (!S.signed || !S.usage) { u.replaceChildren(el('small', '', T.usageGuest)); u.disabled = true; return; }
    u.disabled = false;
    const worst = S.usage.week.pct > S.usage.day.pct ? meter(T.lim.week, S.usage.week) : meter(T.lim.day, S.usage.day);
    u.replaceChildren(el('b', '', planName()), worst);
  }
  const refreshUsage = async () => { if (!S.signed) return; const d = await fetch('/api/ws/limits').then((r) => r.json()).catch(() => null); if (d?.usage) { S.usage = d.usage; drawUsage(); } };
  function drawWho() {
    const w = $('[data-who]');
    if (S.signed) w.replaceChildren(el('small', '', S.email));
    else w.replaceChildren(btn('pri', T.signin, () => openSign()), el('small', '', T.guest));
    drawUsage();
  }
  function drawMode() { root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.classList.toggle('on', b.dataset.mode === S.mode)); }

  /* ---------- The tree: projects → chats → what each chat made (Decision 45) ---------- */
  type Obj = { id: number | string; chat: number; kind: string; title: string; url?: string; ref?: Msg };
  const KIND: Record<string, string> = { user: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0', cal: 'M4 6h16v14H4zM4 10h16M8 3v5M16 3v5', know: 'M5 4h11l3 3v13H5zM9 9h6M9 13h6M9 17h4', site: 'M3 5h18v14H3zM3 9h18', tool: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z', doc: 'M7 3h7l5 5v13H7zM14 3v5h5', image: 'M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6', link: 'M10 13a4 4 0 0 0 6 .5l3-3a4 4 0 0 0-5.7-5.7L12 6m2 5a4 4 0 0 0-6-.5l-3 3a4 4 0 0 0 5.7 5.7L12 18', file: 'M6 3h9l4 4v14H6zM15 3v4h4', pin: 'M12 17v5M8 3h8l-1 6 4 4H5l4-4z', reply: 'M9 14 4 9l5-5M4 9h10a6 6 0 0 1 6 6v3', fwd: 'M15 4l5 5-5 5M20 9H10a6 6 0 0 0-6 6v3', copy: 'M9 9h11v11H9zM5 15H4V4h11v1' };
  const ico = (k: string, n = 14) => `<svg viewBox="0 0 24 24" width="${n}" height="${n}" aria-hidden="true"><path d="${KIND[k] || ''}" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  const icoBtn = (cls: string, k: string, label: string, go: (e: MouseEvent) => void) => { const b = el('button', cls); b.type = 'button'; b.innerHTML = ico(k, 15); b.title = label; b.setAttribute('aria-label', label); b.onclick = (e) => { e.stopPropagation(); go(e); }; return b; };
  const artKind = (m: Msg) => (m.site ? 'site' : m.tool ? 'tool' : m.doc ? 'doc' : m.image ? 'image' : '');
  const artTitle = (m: Msg) => m.site?.title || m.tool?.title || m.doc?.title || '';
  function objectsOf(): Obj[] {
    if (S.signed) return S.objects;
    return S.chats.flatMap((c) => (c.msgs || []).flatMap((m, i) => (artKind(m) ? [{ id: `g${c.id}-${i}`, chat: c.id, kind: artKind(m), title: artTitle(m), url: m.site?.url, ref: m }] : [])));
  }
  let closed = new Set<number>(); try { closed = new Set(JSON.parse(localStorage.getItem('vaxo_ws_closed') || '[]')); } catch {}
  const keepClosed = () => { try { localStorage.setItem('vaxo_ws_closed', JSON.stringify([...closed])); } catch {} };

  // A small menu next to a button: a list of actions, closes on any outside click.
  let menuEl: HTMLElement | null = null;
  function menu(anchor: HTMLElement, items: [string, () => void][]) {
    menuEl?.remove();
    const m = el('div', 'pop'), r = anchor.getBoundingClientRect();
    for (const [label, go] of items) m.append(btn('', label, () => { m.remove(); menuEl = null; go(); }));
    m.style.top = Math.min(r.bottom + 4, innerHeight - 40 * items.length - 12) + 'px'; m.style.left = Math.max(8, Math.min(r.left, innerWidth - 220)) + 'px';
    document.body.append(m); menuEl = m;
    setTimeout(() => addEventListener('click', function off(e) { if (!m.contains(e.target as Node)) { m.remove(); if (menuEl === m) menuEl = null; removeEventListener('click', off); } }), 0);
  }

  function drawChats() {
    const nav = $('[data-chats]'); nav.replaceChildren();
    const objs = objectsOf();
    const chatNode = (c: Chat) => {
      const box = el('div', 'cnode'), row = el('div', 'crow');
      const b = btn('chat' + (c.id === S.cur ? ' on' : ''), c.title, () => { side(false); openChat(c.id); });
      const n = objs.filter((o) => o.chat === c.id).length; if (n) b.append(el('i', 'cnt', String(n)));
      const more = btn('dots', '⋯', () => chatMenu(c, more)); more.title = T.chatMenu;
      row.append(b, more); box.append(row);
      b.draggable = true; b.ondragstart = (e) => { e.dataTransfer?.setData('text/vx-chat', String(c.id)); nav.classList.add('dnd'); }; b.ondragend = () => nav.classList.remove('dnd');
      if (c.id === S.cur) for (const o of objs.filter((x) => x.chat === c.id).slice(0, 10)) { const ob = btn('obj', '', () => openObject(o)); ob.innerHTML = ico(o.kind, 13); ob.append(el('span', '', o.title || T.matTabs[o.kind])); box.append(ob); }
      return box;
    };
    const known = new Set(S.projects.map((p) => p.id));
    const groups: { p: Proj | null; chats: Chat[] }[] = [...S.projects.map((p) => ({ p, chats: S.chats.filter((c) => c.project === p.id) })), { p: null, chats: S.chats.filter((c) => !c.project || !known.has(c.project)) }];
    for (const g of groups) {
      if (!g.p && !g.chats.length) continue;
      const sec = el('div', 'proj');
      if (g.p) {
        const p = g.p, open = !closed.has(p.id), head = el('div', 'phead');
        const car = btn('car2', open ? '▾' : '▸', () => { if (open) closed.add(p.id); else closed.delete(p.id); keepClosed(); drawChats(); }); car.setAttribute('aria-label', open ? T.fold : T.unfold);
        const t = btn('ptitle' + (S.proj?.id === p.id ? ' on' : ''), '', () => { side(false); openProject(p.id, 'site'); });
        t.append(el('span', 'pn', p.name), el('i', 'cnt', String(g.chats.length)));
        head.append(car);
        const more = btn('dots', '⋯', () => projMenu(p, more));
        head.append(t, more); sec.append(head);
        if (open) for (const c of g.chats) sec.append(chatNode(c));
        if (open && !g.chats.length) sec.append(el('small', 'pempty', T.projEmpty));
      } else {
        if (S.projects.length) sec.append(el('div', 'phead plain', T.noProj));
        for (const c of g.chats) sec.append(chatNode(c));
      }
      // Drop a chat on a project (or on «Without a project») to move it there.
      const target = g.p ? g.p.id : null;
      sec.ondragover = (e) => { if (e.dataTransfer?.types.includes('text/vx-chat')) { e.preventDefault(); sec.classList.add('drop'); } };
      sec.ondragleave = () => sec.classList.remove('drop');
      sec.ondrop = async (e) => { e.preventDefault(); sec.classList.remove('drop'); nav.classList.remove('dnd'); const c = S.chats.find((x) => String(x.id) === e.dataTransfer?.getData('text/vx-chat')); if (c && (c.project ?? null) !== target) { if (target) closed.delete(target); await moveChat(c, target); drawChats(); } };
      nav.append(sec);
    }
    if (S.projects.length && !groups[groups.length - 1].chats.length) { const z = el('div', 'proj nodrop'); z.append(el('div', 'phead plain', T.noProj)); z.ondragover = (e) => { e.preventDefault(); z.classList.add('drop'); }; z.ondragleave = () => z.classList.remove('drop'); z.ondrop = async (e) => { e.preventDefault(); z.classList.remove('drop'); const c = S.chats.find((x) => String(x.id) === e.dataTransfer?.getData('text/vx-chat')); if (c?.project) { await moveChat(c, null); drawChats(); } }; nav.append(z); }
    if (!S.chats.length && !S.projects.length) nav.append(el('small', '', T.noChats));
    $('[data-title]').textContent = S.chats.find((c) => c.id === S.cur)?.title || '';
    $('[data-del]').hidden = !S.cur;
    $('[data-mat]').hidden = !S.cur;
    drawPins();
  }

  async function newProject(name?: string) {
    name = (name ?? prompt(T.projName) ?? '').trim().slice(0, 60);
    if (!name) return null;
    let p: Proj;
    if (S.signed) { const { d } = await postJ('/api/ws/project', { name }); if (!d.ok) return null; p = { id: d.id, name }; } else { p = { id: Date.now(), name }; }
    S.projects.push(p); saveGuest(); drawChats();
    return p;
  }
  async function moveChat(c: Chat, proj: number | null) {
    c.project = proj ?? undefined;
    if (S.signed) await post(`/api/ws/chat/${c.id}/move`, { project: proj ?? 0 }); else saveGuest();
    if (proj) { closed.delete(proj); keepClosed(); }
    drawChats();
  }
  function chatMenu(c: Chat, at: HTMLElement) {
    menu(at, [
      [T.rename, async () => { const t = (prompt(T.rename, c.title) || '').trim().slice(0, 60); if (!t) return; c.title = t; if (S.signed) await post(`/api/ws/chat/${c.id}/rename`, { title: t }); else saveGuest(); drawChats(); }],
      [T.moveTo + '…', () => menu(at, [...S.projects.filter((p) => p.id !== c.project).map((p) => [p.name, () => moveChat(c, p.id)] as [string, () => void]), ...(c.project ? [[T.noProj, () => moveChat(c, null)] as [string, () => void]] : []), [T.newProj, async () => { const p = await newProject(); if (p) moveChat(c, p.id); }]])],
      [T.del, async () => { if (!confirm(T.delQ)) return; if (S.signed) await post('/api/ws/chat/' + c.id, {}); S.chats = S.chats.filter((x) => x.id !== c.id); S.objects = S.objects.filter((o) => o.chat !== c.id); saveGuest(); if (S.cur === c.id) fresh(); else drawChats(); }],
    ]);
  }
  function projMenu(p: Proj, at: HTMLElement) {
    menu(at, [
      [T.newChatIn, () => { S.pendingProject = p.id; fresh(); }],
      [T.rename, async () => { const n = (prompt(T.rename, p.name) || '').trim().slice(0, 60); if (!n) return; p.name = n; if (S.signed) await post(`/api/ws/project/${p.id}`, { name: n }); else saveGuest(); drawChats(); }],
      [T.del, async () => { if (!confirm(T.delProjQ)) return; if (S.signed) await post(`/api/ws/project/${p.id}`, { delete: true }); S.projects = S.projects.filter((x) => x.id !== p.id); S.chats.forEach((c) => { if (c.project === p.id) c.project = undefined; }); saveGuest(); drawChats(); }],
    ]);
  }
  async function openObject(o: Obj) {
    if (o.chat !== S.cur) await openChat(o.chat);
    const m = o.ref && S.msgs.includes(o.ref) ? o.ref : S.msgs.find((x) => x.id === o.id) || (o.ref ? S.msgs.find((x) => artTitle(x) === o.title && artKind(x) === o.kind) : undefined);
    if (m) { if (m.image && !m.site && !m.tool && !m.doc) openCv(T.matTabs.image, Object.assign(el('img', 'pic'), { src: m.image, alt: '' })); else showArt(m); }
  }

  /* ---------- Message actions, like Telegram: reply, pin, forward, copy ---------- */
  const nodes = new WeakMap<Msg, HTMLElement>();
  const plain = (t: string) => t.replace(/\[\[(REPLY|FWD):[^\]]*\]\]/g, '').trim();
  function startReply(m: Msg) {
    S.reply = { text: plain(m.content).replace(/\s+/g, ' ').slice(0, 160) || artTitle(m) };
    const bar = $('[data-replybar]'); bar.hidden = false;
    bar.querySelector('span')!.textContent = `${T.replyTo}: ${S.reply.text}`;
    input.focus();
  }
  $('[data-reply-x]').onclick = () => { S.reply = null; $('[data-replybar]').hidden = true; };
  async function pinMsg(m: Msg, on: boolean) {
    if (S.signed && !m.id) return;
    m.pinned = on;
    if (S.signed) await post(`/api/ws/msg/${m.id}/pin`, { on }); else saveGuest();
    const d = nodes.get(m); if (d) { d.classList.toggle('pinned', on); d.querySelector('.mbar')?.replaceWith(msgBar(m)); }
    drawPins();
  }
  let pinAt = 0;
  function drawPins() {
    const bar = $('[data-pins]'), list = S.msgs.filter((m) => m.pinned);
    bar.hidden = !list.length;
    if (!list.length) return;
    pinAt %= list.length;
    const m = list[list.length - 1 - pinAt];
    bar.innerHTML = ico('pin', 14);
    bar.append(el('b', '', `${T.pinned}${list.length > 1 ? ` ${pinAt + 1}/${list.length}` : ''}`), el('span', '', plain(m.content).replace(/\s+/g, ' ').slice(0, 90) || artTitle(m)));
    bar.onclick = () => { nodes.get(m)?.scrollIntoView({ behavior: 'smooth', block: 'center' }); nodes.get(m)?.classList.add('flash'); setTimeout(() => nodes.get(m)?.classList.remove('flash'), 1200); pinAt++; drawPins(); };
  }
  function openForward(m: Msg) {
    const dlg = $<HTMLDialogElement>('[data-pick]'), body = $('[data-pick-body]');
    $('[data-pick-h]').textContent = T.fwdTo;
    body.replaceChildren();
    const go = async (chat: number) => {
      dlg.close();
      const here = S.chats.find((c) => c.id === S.cur)?.title || '';
      let to = chat;
      if (S.signed) {
        const { d } = await postJ('/api/ws/forward', { id: m.id, chat, title: artTitle(m) || here, project: S.chats.find((c) => c.id === S.cur)?.project || 0 });
        if (!d.ok) return; to = d.chat;
        if (!chat) S.chats.unshift({ id: to, title: (artTitle(m) || here).slice(0, 60), project: S.chats.find((c) => c.id === S.cur)?.project });
        if (artKind(m)) S.objects.unshift({ id: d.id, chat: to, kind: artKind(m), title: artTitle(m), url: m.site?.url });
      } else {
        let c = S.chats.find((x) => x.id === chat);
        if (!c) { c = { id: Date.now(), title: (artTitle(m) || here).slice(0, 60), msgs: [], project: S.chats.find((x) => x.id === S.cur)?.project }; S.chats.unshift(c); }
        c.msgs = [...(c.msgs || []), { ...m, id: undefined, pinned: false, content: `[[FWD:${here.slice(0, 60)}]]${m.content}` }];
        to = c.id; saveGuest();
      }
      drawChats();
      toast(T.fwdDone, T.fwdOpen, () => openChat(to));
    };
    body.append(btn('pick new', '+ ' + T.fwdNew, () => go(0)));
    const groups = [...S.projects.map((p) => [p.name, S.chats.filter((c) => c.project === p.id)] as [string, Chat[]]), [T.noProj, S.chats.filter((c) => !c.project || !S.projects.some((p) => p.id === c.project))] as [string, Chat[]]];
    for (const [name, chats] of groups) {
      const list = chats.filter((c) => c.id !== S.cur); if (!list.length) continue;
      body.append(el('small', 'pickh', name));
      for (const c of list) body.append(btn('pick', c.title, () => go(c.id)));
    }
    dlg.showModal();
  }
  $('[data-pick-x]').onclick = () => $<HTMLDialogElement>('[data-pick]').close();
  function toast(text: string, act?: string, go?: () => void) {
    const t = el('div', 'toast', text);
    if (act && go) t.append(btn('lnk', act, () => { t.remove(); go(); }));
    root.append(t); setTimeout(() => t.remove(), 4000);
  }
  function msgBar(m: Msg) {
    const bar = el('div', 'mbar');
    bar.append(
      icoBtn('mb', 'reply', T.reply, () => startReply(m)),
      ...(!S.signed || m.id ? [icoBtn('mb' + (m.pinned ? ' on' : ''), 'pin', m.pinned ? T.unpin : T.pin, () => pinMsg(m, !m.pinned)), icoBtn('mb', 'fwd', T.fwd, () => openForward(m))] : []),
      icoBtn('mb', 'copy', T.copyMsg, async () => { await copyText(plain(m.content)); toast(T.copied); }),
    );
    return bar;
  }

  /* ---------- Materials of a chat, sorted like Telegram's shared media ---------- */
  function materials(tab = 'site') {
    const tabs = ['site', 'tool', 'doc', 'image', 'link', 'file', 'pin'];
    const head = el('div', 'mtabs');
    const count = (k: string) => items(k).length;
    function items(k: string): [string, () => void, string?][] {
      if (['site', 'tool', 'doc', 'image'].includes(k)) return S.msgs.filter((m) => artKind(m) === k || (k === 'image' && m.image)).map((m) => [artTitle(m) || T.matTabs[k], () => (k === 'image' ? openCv(T.matTabs.image, Object.assign(el('img', 'pic'), { src: m.image!, alt: '' })) : showArt(m)), m.site?.url]);
      if (k === 'link') return [...new Set(S.msgs.flatMap((m) => plain(m.content).match(/https?:\/\/[^\s)<>"']+/g) || []))].map((u) => [u.replace(/^https?:\/\//, ''), () => open(u, '_blank', 'noopener'), u]);
      if (k === 'file') return S.msgs.flatMap((m) => (m.content.match(/^📎 (\S+)/gmu) || []).map((f) => [f.slice(2).trim(), () => { nodes.get(m)?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }] as [string, () => void]));
      return S.msgs.filter((m) => m.pinned).map((m) => [plain(m.content).slice(0, 80) || artTitle(m), () => { nodes.get(m)?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }]);
    }
    for (const k of tabs) { const n = count(k); const b = btn(k === tab ? 'on' : '', `${T.matTabs[k]}${n ? ' ' + n : ''}`, () => materials(k)); b.prepend(Object.assign(el('span'), { innerHTML: ico(k, 13) })); head.append(b); }
    const list = el('div', 'mlist'), rows = items(tab);
    if (!rows.length) list.append(el('p', 'none', T.matNone));
    for (const [label, go, url] of rows) { const r = btn('mrow', '', go); r.innerHTML = ico(tab, 16); r.append(el('span', '', label)); if (url && tab === 'site') r.append(el('small', 'livedot', '●')); list.append(r); }
    openCv(T.mat, head, list);
  }

  /* ---------- The map: everything at a glance ---------- */
  function openMap() {
    const dlg = $<HTMLDialogElement>('[data-mapdlg]'), body = $('[data-mapbody]');
    const objs = objectsOf();
    // A forwarded copy is the same thing: count sites by their address, the rest by title.
    const n = (k: string) => new Set(objs.filter((o) => o.kind === k).map((o) => o.url || o.title || o.id)).size;
    body.replaceChildren();
    const stats = el('div', 'mstats');
    for (const [k, v, go] of [['site', n('site'), () => { dlg.close(); panel('site'); }], ['crm', S.mods?.requests ?? 0, () => { dlg.close(); panel('crm'); }], ['tool', n('tool')], ['doc', n('doc')], ['image', n('image')]] as [string, number, (() => void)?][]) {
      const c = btn('stat', '', go || (() => {})); c.append(el('b', '', String(v)), el('small', '', T.mapK[k])); stats.append(c);
    }
    body.append(stats);
    if (!S.chats.length) { body.append(el('p', 'none', T.mapEmpty)); dlg.showModal(); return; }
    const cols = el('div', 'mcols');
    const known = new Set(S.projects.map((p) => p.id));
    const groups = [...S.projects.map((p) => [p.name, S.chats.filter((c) => c.project === p.id)] as [string, Chat[]]), [T.noProj, S.chats.filter((c) => !c.project || !known.has(c.project))] as [string, Chat[]]];
    for (const [name, chats] of groups) {
      if (!chats.length && name === T.noProj) continue;
      const col = el('div', 'mcol'); col.append(el('h3', '', name), el('small', '', `${chats.length} · ${objs.filter((o) => chats.some((c) => c.id === o.chat)).length}`));
      for (const c of chats) {
        const card = el('div', 'mcard');
        card.append(btn('mct', c.title, () => { dlg.close(); openChat(c.id); }));
        const chips = el('div', 'chips2');
        for (const o of objs.filter((x) => x.chat === c.id).slice(0, 8)) {
          const ch = btn('chip ' + o.kind, '', () => { dlg.close(); openObject(o); }); ch.innerHTML = ico(o.kind, 12); ch.append(el('span', '', o.title || T.matTabs[o.kind]));
          chips.append(ch);
          if (o.url) { const a = el('a', 'chip go', '↗') as HTMLAnchorElement; a.href = o.url; a.target = '_blank'; a.rel = 'noopener'; a.title = o.url; chips.append(a); }
        }
        if (chips.childElementCount) card.append(chips);
        col.append(card);
      }
      cols.append(col);
    }
    body.append(cols);
    dlg.showModal();
  }
  $('[data-map-x]').onclick = () => $<HTMLDialogElement>('[data-mapdlg]').close();

  /* ---------- Chat ---------- */
  const TILE_ICO: R = { site: 'M3 5h18v14H3zM3 9h18', crm: 'M4 5h16v3H4zm0 5.5h10v3H4zM4 16h7v3H4z', partner: 'M10 13a4 4 0 0 0 6 .5l3-3a4 4 0 0 0-5.7-5.7L12 6m2 5a4 4 0 0 0-6-.5l-3 3a4 4 0 0 0 5.7 5.7L12 18' };
  function drawEmpty() {
    const box = el('div', 'hi');
    box.append(el('small', 'tag3', T.tag3), el('h1', '', T.hello3), el('p', '', T.sub3));
    const why = el('div', 'why3');
