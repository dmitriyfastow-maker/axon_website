  .wsp .ic { background: none; border: 0; font-size: 18px; width: 36px; height: 36px; border-radius: 8px; cursor: pointer; flex: none; }
  .wsp .ic:hover { background: var(--surf2, var(--surf)); }
  .wsp .ic[hidden] { display: none; }
  .wsp .only-m { display: none; }
  .wsp .seg { display: flex; border: 1px solid var(--line); border-radius: 9px; padding: 2px; flex: none; }
  .wsp .seg button { border: 0; background: none; border-radius: 7px; padding: 6px 10px; font-size: 13px; cursor: pointer; color: var(--mut); white-space: nowrap; }
  .wsp .seg button.on { background: var(--ink); color: var(--bg); font-weight: 600; }
  .wsp .log { flex: 1; overflow-y: auto; min-height: 0; padding: 24px max(16px, calc((100% - 760px) / 2)); display: flex; flex-direction: column; gap: 14px; }
  .wsp .hi { margin: auto 0; display: grid; gap: 10px; }
  .wsp .hi h1 { margin: 0; font-size: clamp(30px, 4vw, 42px); letter-spacing: -.02em; }
