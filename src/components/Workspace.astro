  /* ---------- Online booking (Decision 47): free windows on the site instead of "we will call you back" ---------- */
  function bookPanel() {
    const box = el('div', 'pf'), main = S.mods?.site as R | null;
    if (!main) { box.append(el('p', 'hint', T.botNoSite)); openCv(T.ptabs.book, box); return; }
    const tz = (() => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || 'Europe/Kyiv'; } catch { return 'Europe/Kyiv'; } })();
    const bk: R = { on: false, days: [1, 2, 3, 4, 5, 6], from: '10:00', to: '20:00', step: 60, cap: 1, qs: [], bonus: '', tz, ...(main.book || {}) };
    bk.qs = (bk.qs || []).map((q: R) => ({ q: q.q, o: [...q.o] }));
    const dirty = () => { save.classList.add('hot'); };
    const onL = el('label', 'cb'), on = el('input') as HTMLInputElement; on.type = 'checkbox'; on.checked = !!main.book?.on; on.onchange = () => { bk.on = on.checked; dirty(); };
    onL.append(on, el('b', '', T.bkOn));
    box.append(el('p', 'hint', T.bkP), onL);
    // Working days and hours
    const sch = el('section', 'blk'); sch.append(el('h3', '', T.bkWhen));
    const days = el('div', 'chips');
    (T.bkWd as string[]).forEach((d, i) => { const b = btn(bk.days.includes(i + 1) ? 'chip on' : 'chip', d, () => { const n = i + 1; bk.days = bk.days.includes(n) ? bk.days.filter((x: number) => x !== n) : [...bk.days, n].sort(); b.classList.toggle('on'); dirty(); }); days.append(b); });
    const t1 = el('input') as HTMLInputElement, t2 = el('input') as HTMLInputElement; t1.type = t2.type = 'time'; t1.value = bk.from; t2.value = bk.to; t1.step = t2.step = '900';
    t1.onchange = () => { bk.from = t1.value; dirty(); }; t2.onchange = () => { bk.to = t2.value; dirty(); };
    const stp = el('select') as HTMLSelectElement; for (const n of [15, 20, 30, 45, 60, 90, 120, 180, 240]) { const o = el('option', '', `${n} ${T.bkMin}`); o.value = String(n); o.selected = bk.step === n; stp.append(o); }
    stp.onchange = () => { bk.step = +stp.value; dirty(); };
    const cap = el('input') as HTMLInputElement; cap.type = 'number'; cap.min = '1'; cap.max = '20'; cap.value = String(bk.cap); cap.onchange = () => { bk.cap = Math.max(1, Math.min(20, +cap.value || 1)); dirty(); };
    const grid = el('div', 'bkgrid');
    const lab = (t: string, i: HTMLElement) => { const l = el('label', 'f', t); l.append(i); return l; };
    grid.append(lab(T.bkFrom, t1), lab(T.bkTo, t2), lab(T.bkStep, stp), lab(T.bkCap, cap));
    sch.append(days, grid);
    // Short questions: one tap each, so nobody has to type
    const qa = el('section', 'blk'), ql = el('div', 'qlist');
    const drawQ = () => {
      ql.replaceChildren();
      bk.qs.forEach((q: R, i: number) => {
        const r = el('div', 'qrow'), qi = el('input') as HTMLInputElement, oi = el('input') as HTMLInputElement;
        qi.value = q.q; qi.maxLength = 80; qi.placeholder = T.bkQ; oi.value = q.o.join(', '); oi.placeholder = T.bkO;
        qi.oninput = () => { q.q = qi.value; dirty(); }; oi.oninput = () => { q.o = oi.value.split(',').map((x) => x.trim()).filter(Boolean).slice(0, 4); dirty(); };
        r.append(qi, oi, btn('sec sm', '✕ ' + T.bkDel, () => { bk.qs.splice(i, 1); drawQ(); dirty(); }));
        ql.append(r);
      });
      if (bk.qs.length < 3) ql.append(btn('sec sm', '＋ ' + T.bkAddQ, () => { bk.qs.push({ q: '', o: [] }); drawQ(); }));
    };
    drawQ();
    qa.append(el('h3', '', T.bkQH), el('p', 'hint', T.bkQP), ql);
    // First-visit gift: the owner's choice, off until they turn it on
    const gift = el('section', 'blk'), gl = el('label', 'cb'), gc = el('input') as HTMLInputElement, gt = el('input') as HTMLInputElement;
    gc.type = 'checkbox'; gc.checked = !!bk.bonus; gt.value = bk.bonus || bk.idea || ''; gt.maxLength = 120; gt.placeholder = T.bkGiftPh; gt.disabled = !gc.checked;
    gc.onchange = () => { gt.disabled = !gc.checked; bk.bonus = gc.checked ? gt.value.trim() : ''; dirty(); }; gt.oninput = () => { if (gc.checked) { bk.bonus = gt.value.trim(); dirty(); } };
    gl.append(gc, el('b', '', T.bkGift));
    gift.append(el('h3', '', T.bkGiftH), el('p', 'hint', T.bkGiftP), gl, gt);
    const err = el('small', 'bad');
    const save = btn('pri', T.bkSave, async () => {
      if (bk.on && !bk.days.length) { err.textContent = T.bkNoDays; return; }
      save.disabled = true; err.textContent = '';
      const book = { ...bk, qs: bk.qs.filter((q: R) => q.q.trim() && q.o.length >= 2) };
      const { d } = await postJ('/api/ws/site/publish', { site: { ...main, book }, lang, slug: main.slug, biz: S.proj?.biz });
      save.disabled = false;
      if (!d.ok) { err.textContent = T.depFail; return; }
      S.mods = d.modules; save.classList.remove('hot'); toast(T.bkSaved);
    });
    const open = el('a', 'sec', T.openLive + ' ↗') as HTMLAnchorElement; open.href = main.url + '#form'; open.target = '_blank'; open.rel = 'noopener';
    const top = el('div', 'tbar'); top.append(save, open);
    // Upcoming bookings
    const list = el('section', 'blk'); list.append(el('h3', '', T.bkList));
    const drawList = (rows: R[]) => {
      list.replaceChildren(el('h3', '', T.bkList));
      const live = rows.filter((r) => r.status === 'booked');
      if (!live.length) list.append(el('p', 'hint', T.bkNone));
      for (const r of live) {
        const row = el('div', 'lead'), who = el('div');
        const day = new Date(r.day + 'T12:00:00Z').toLocaleDateString(lang === 'ua' ? 'uk-UA' : lang === 'ru' ? 'ru-RU' : 'en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
        who.append(el('b', '', `${day}, ${r.time}${r.service ? ' · ' + r.service : ''}`), el('small', '', [r.name, r.contact].filter(Boolean).join(' · ')));
        if (r.message) who.append(el('small', 'from', String(r.message).split('\n').slice(1).join(' · ').slice(0, 160)));
        // Reminder: a ready text opens in WhatsApp, Viber or SMS on the owner's own phone; the owner sends it.
        const ph = String(r.contact || '').replace(/[^\d+]/g, ''), rem = el('div', 'tbar');
        if (ph.replace(/\D/g, '').length >= 9) {
          const txt = T.bkRemT.replace('{n}', r.name ? ', ' + r.name : '').replace('{d}', day).replace('{t}', r.time).replace('{s}', r.service ? ' (' + r.service + ')' : '');
          const q = encodeURIComponent(txt), num = ph.replace(/\D/g, '');
          for (const [l, h] of [['WhatsApp', `https://wa.me/${num}?text=${q}`], ['Viber', `viber://forward?text=${q}`], ['SMS', `sms:${ph}?&body=${q}`]]) {
            const a = el('a', 'sec sm', l) as HTMLAnchorElement; a.href = h; a.target = '_blank'; a.rel = 'noopener'; a.title = T.bkRem; rem.append(a);
          }
          who.append(rem);
        }
        row.append(who, btn('sec sm', T.bkCancel, async () => { if (!confirm(T.bkCancelQ)) return; const { d } = await postJ(`/api/ws/bookings/${r.id}/cancel`, { biz: S.proj?.biz }); if (d.ok) drawList(d.list); }));
        list.append(row);
      }
    };
    // Calendar subscription: one private link, then every booking shows up in the owner's own calendar by itself.
    const cal = el('section', 'blk');
    const drawFeed = (u: string | null) => {
      cal.replaceChildren();
      if (!u) return;
      const web = u.replace(/^https:/, 'webcal:'), r = el('div', 'tbar');
      const g = el('a', 'sec sm', T.bkFeedG) as HTMLAnchorElement; g.href = 'https://calendar.google.com/calendar/r?cid=' + encodeURIComponent(web); g.target = '_blank'; g.rel = 'noopener';
      const i = el('a', 'sec sm', T.bkFeedI) as HTMLAnchorElement; i.href = web;
      r.append(g, i, btn('sec sm', T.bkFeedC, () => { navigator.clipboard?.writeText(u).then(() => toast(T.bkFeedOk)).catch(() => prompt(T.bkFeedC, u)); }));
      cal.append(el('h3', '', T.bkFeedH), el('p', 'hint', T.bkFeedP), r);
    };
    fetch(`/api/ws/bookings?biz=${S.proj?.biz || ''}`).then((r) => r.json()).then((d) => { drawList(d?.list || []); drawFeed(d?.feed || null); }).catch(() => drawList([]));
    box.append(top, err, sch, qa, gift, list, cal);
    openCv(T.ptabs.book, box);
  }
