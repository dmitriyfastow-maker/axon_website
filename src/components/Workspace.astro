    const mark = (x: string, q: string) => { const i = x.toLowerCase().indexOf(q.toLowerCase()); return i < 0 ? esc2(x) : esc2(x.slice(0, i)) + '<mark>' + esc2(x.slice(i, i + q.length)) + '</mark>' + esc2(x.slice(i + q.length)); };
