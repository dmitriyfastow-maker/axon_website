  function showArt(m: Msg) {
    // A site of the current business opens inside its project, with the project's tabs on top.
    if (m.site) { if (S.proj?.biz && m.site.url) openProject(S.proj.id, 'site', () => siteView(m.site!, m)); else siteView(m.site, m); return; }
    const parts: Node[] = [];
    if (m.tool) parts.push(toolView(m.tool));
    if (m.doc) parts.push(docView(m));
    if (parts.length) openCv((m.tool || m.doc)!.title, ...parts);
  }

  /* ---------- Site: a live preview, every line editable, one Publish ---------- */
  const field = (label: string, name: string, value: string, long = false) => {
    const l = el('label', 'f', label), i = long ? el('textarea') : el('input');
    i.name = name; i.value = value; l.append(i);
    return l;
  };
  // A fresh frame that already holds the page before it goes on screen: filling a frame just inserted can lose its content.
  function previewFrame(html: string, title: string, edit = false) {
    // Editable preview: scripts run inside, but the frame has no access to our page; it only sends messages.
    const f = el('iframe', 'prev'); f.setAttribute('sandbox', edit ? 'allow-scripts' : ''); f.title = title; f.srcdoc = html;
    return f;
  }
  let siteMsg: ((e: MessageEvent) => void) | null = null;
  function siteView(src: Site, m?: Msg, opts: { studio?: boolean } = {}) {
    const site: Site = { ...src, services: [...(src.services || [])] };
    const frame = el('div', 'prevbox');
    let timer = 0;
    const paint = async () => { const { d } = await postJ('/api/ws/site/preview', { site, lang: site.lang || lang, edit: true, ui: lang }); if (d.html) frame.replaceChildren(previewFrame(d.html, T.siteCard, true)); };
    // Editing in place: a text typed on the page, "change with Vax", "replace photo" — all arrive as messages from the frame.
    const S2 = site as R;
    const setField = (k: string, v: string) => {
      const [f, i, sub] = k.split('.');
      if (f === 'faq') { const a = [...(S2.faq || [])]; a[+i] = { ...(a[+i] || {}), [sub]: v }; S2.faq = a; }
      else if (i !== undefined) { const a = [...(S2[f] || [])]; a[+i] = v; S2[f] = a; }
      else S2[f] = v;
      const field = (edits.querySelector(`[name="${f}"]`) as HTMLInputElement | null);
      if (field && i === undefined) field.value = v;
      if (field && (f === 'services' || f === 'details')) field.value = (S2.services || []).map((t: string, n: number) => (S2.details?.[n] ? `${t} — ${S2.details[n]}` : t)).join('\n');
      dirty();
    };
    const dirty = () => { if (site.url) { save.textContent = T.pubChanges; save.classList.add('hot'); } };
    if (siteMsg) removeEventListener('message', siteMsg);
    siteMsg = async (e: MessageEvent) => {
      const ifr = frame.querySelector('iframe'); if (!ifr || e.source !== ifr.contentWindow || !e.data?.vx) return;
      const d = e.data as R;
      if (d.t === 'edit') setField(String(d.k), String(d.v || ''));
      if (d.t === 'ai') {
        const wish = (prompt(T.aiAsk) || '').trim(); if (!wish) return;
        toast(T.aiBusy);
        const { d: r } = await postJ('/api/ws/site/edit', { site, k: d.k, v: d.v, wish, lang: site.lang || lang });
        if (r.v) { setField(String(d.k), r.v); paint(); } else toast(T.depFail);
      }
      if (d.t === 'img') {
        const wish = prompt(T.photoAsk, ''); if (wish === null) return;
        toast(T.photoBusy);
        const { d: r } = await postJ('/api/ws/site/photo', { site, wish, lang: site.lang || lang });
        if (r.id) { const a = [...(S2.imgs || [])]; a[+d.i] = r.id; S2.imgs = a; S2.img = a[0]; paint(); dirty(); } else toast(T.photoFail);
      }
    };
    addEventListener('message', siteMsg);
    const f = el('form', 'pf');
    const lines = site.services.map((t, i) => (site.details?.[i] ? `${t} — ${site.details[i]}` : t)).join('\n');
    f.append(field(T.fT, 'title', site.title), field(T.fK, 'kicker', site.kicker || ''), field(T.fS, 'sub', site.sub), field(T.fA, 'about', site.about, true), field(T.fL, 'services', lines, true), field(T.fC, 'cta', site.cta), field(T.fAsk, 'ask', site.ask || ''));
    const l = el('label', 'f', T.fTone), tone = el('select'); tone.name = 'style';
    for (const k of ['editorial', 'clinic', 'bold', 'soft', 'nature']) { const o = el('option', '', T.styles[k]); o.value = k; o.selected = (site.style || '') === k; tone.append(o); }
    l.append(tone); f.append(l);
    const edits = el('details', 'edits'); edits.append(el('summary', '', T.editText), f);
    edits.open = !site.url;
    f.onsubmit = (e) => e.preventDefault();
    const top = el('div', 'livebar'), err = el('small', 'bad');
    // Live: the public address on top, open it from any phone, requests land in the CRM. Draft: one Publish.
    const drawTop = () => {
      if (site.url) {
        const open = el('a', 'pri', T.openLive + ' ↗') as HTMLAnchorElement; open.href = site.url; open.target = '_blank'; open.rel = 'noopener';
        const leads = btn('sec', `${T.crmTotal}: ${S.mods?.requests ?? 0} →`, () => panel('crm'));
        const row = el('div', 'tbar'); row.append(open, save, leads);
        top.replaceChildren(el('small', 'livedot', T.liveNow), linkRow(site.url), row, el('p', 'hint', T.tryPhone));
      } else { const row = el('div', 'tbar'); row.append(pub); top.replaceChildren(row); }
    };
    const save = btn('sec', T.saveSite, async () => {
      save.disabled = true; save.textContent = T.pubBusy;
      const { d } = await postJ('/api/ws/site/publish', { site, lang, id: m?.id, slug: site.slug, biz: S.proj?.biz });
      save.disabled = false;
      if (!d.ok) { save.textContent = T.saveSite; err.textContent = T.depFail; return; }
      S.mods = d.modules; save.classList.remove('hot'); save.textContent = T.pubDone; setTimeout(() => (save.textContent = T.saveSite), 1800);
      if (m) m.site = { ...site };
    });
    const pub = btn('pri', T.pub, async () => {
      // A guest: the draft waits in this browser, and goes live by itself right after they sign in (even from the email link).
      if (!S.signed) { try { localStorage.setItem(SITE_PEND, JSON.stringify({ site, at: Date.now() })); } catch {} openSign(T.needSite); return; }
      if (!S.verified) { err.textContent = T.needMail; return; }
      pub.disabled = true; pub.textContent = T.pubBusy; err.textContent = '';
      const { d } = await postJ('/api/ws/site/publish', { site, lang, id: m?.id, project: S.proj?.id });
      pub.disabled = false; pub.textContent = T.pub;
      if (!d.ok) { err.textContent = d.error === 'verify' ? T.needMail : T.depFail; return; }
      Object.assign(site, { url: d.url, slug: d.slug });
      S.mods = d.modules; if (d.project) { if (!S.projects.some((x) => x.id === d.project.id)) S.projects.push(d.project); S.proj = d.project; drawChats(); } drawWho(); drawTop(); edits.open = false;
      if (m) { m.site = { ...site }; saveGuest(); }
    });
    f.oninput = () => {
      const x = Object.fromEntries(new FormData(f)) as R;
      const rows = String(x.services || '').split('\n').map((s) => s.trim()).filter(Boolean).map((r) => r.split(/\s+[—–-]\s+/));
      Object.assign(site, { ...x, services: rows.map((r) => r[0]), details: rows.map((r) => r.slice(1).join(' — ')) });
      clearTimeout(timer); timer = window.setTimeout(paint, 350);
    };
    const parts: Node[] = [top, err, frame, edits];
    if (site.url && !S.access) parts.push(el('p', 'hint', T.siteFree.replace('{n}', String(S.mods?.requests ?? 0))));
    const others = (S.mods?.pages || []).filter((p: R) => p.slug !== site.slug);
    if (site.url && others.length) {
      const list = el('section', 'blk'); list.append(el('h3', '', T.myPages));
      for (const p of others) list.append(btn('exb', `${p.title || p.slug} →`, () => siteView(p)));
      parts.push(list);
    }
    if (site.url && site.slug === S.mods?.site?.slug) parts.push(domainBox());
    openCv(opts.studio ? T.studio : site.title || T.siteCard, ...parts);
    drawTop(); paint();
  }

