---
<Base lang={lang} title={T.title} description={T.desc} noindex noChat>
  <div class="wsp" data-ws data-lang={lang} data-pre={pre}>
    <script type="application/json" data-t set:html={JSON.stringify(T)} />
    <script type="application/json" data-ct set:html={JSON.stringify(CT)} />
    <aside class="side" data-side>
      <a class="logo" href={`${pre}/`}>VAXO<span>.</span></a>
      <button class="newc" type="button" data-new>+ {T.new}</button>
      <p class="lbl">{T.chats}</p>
      <nav class="chats" data-chats></nav>
      <p class="lbl">{T.mods}</p>
      {(['site', 'crm', 'partner'] as const).map((k) => <button class="nav" type="button" data-panel={k}><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={ico[k]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{k === 'partner' ? T.parCab : T[k]}<i data-dot={k} hidden></i></button>)}
      <p class="lbl">{T.you}</p>
      <button class="nav" type="button" data-prof="memory"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={ico.memory} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{T.memory}</button>
      <button class="nav" type="button" data-prof="plan"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={ico.user} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>{T.profile}</button>
      <div class="foot">
        <button class="usage" type="button" data-usage data-prof="plan" hidden></button>
        <div class="who" data-who></div>
        <div class="langs">
          <button class="mini" type="button" data-theme-toggle aria-label="Theme">◐</button>
          <a class="mini" href="/app/">EN</a><a class="mini" href="/ua/app/">UA</a><a class="mini" href="/ru/app/">RU</a>
        </div>
      </div>
    </aside>
    <div class="veil" data-veil hidden></div>

    <main class="mid">
      <header class="top">
        <button class="ic only-m" type="button" data-menu aria-label={T.menu}>☰</button>
        <b class="ttl" data-title></b>
        <div class="modes" role="group">
          <button type="button" data-mode="short">{T.short}</button>
          <button type="button" data-mode="deep">{T.deep}</button>
        </div>
        <button class="ic" type="button" data-del aria-label={T.del} title={T.del} hidden>🗑</button>
        <button class="ic" type="button" data-cv aria-label={T.canvas} title={T.canvas}>▣</button>
      </header>
      <div class="log" data-log aria-live="polite"></div>
      <form class="in" data-form>
        <button type="button" class="ib" data-clip aria-label={T.attach} title={T.attach}></button>
        <textarea name="q" rows="1" maxlength="4000" placeholder={T.ph} aria-label={T.ph}></textarea>
        <button type="button" class="ib" data-mic aria-label={T.mic}></button>
        <button type="submit" class="go" aria-label={T.send}>➤</button>
      </form>
    </main>

    <aside class="cv" data-canvas hidden>
      <header><b data-cv-title>{T.canvas}</b><button class="ic" type="button" data-cv-x aria-label={T.close}>×</button></header>
      <div class="cvb" data-cv-body></div>
    </aside>

    <div class="bizbox" data-bizbox hidden><BizApp lang={lang} /></div>

    <dialog class="wsign" data-sign>
      <button class="ic x" type="button" data-sign-x aria-label={T.close}>×</button>
      <h2>{T.sH}</h2>
      <p data-sign-p>{T.sP}</p>
      <form data-sign-mail>
        <input type="email" name="email" required maxlength="254" autocomplete="email" placeholder={T.sEmail} aria-label={T.sEmail} />
        <button class="pri" type="submit">{T.sGo}</button>
      </form>
      <form data-sign-code hidden>
        <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder={T.sCode} aria-label={T.sCode} />
        <button class="pri" type="submit">{T.sIn}</button>
      </form>
      <a class="gbtn" href="/api/me/google" data-sign-g hidden><svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>{CT.google}</a>
      <small class="bad" data-sign-err role="status"></small>
      <small>{T.sAgree} <a href={`${pre}/terms/`}>{T.terms}</a> {T.and} <a href={`${pre}/privacy/`}>{T.privacy}</a>.</small>
    </dialog>

    <dialog class="wprof" data-profile aria-labelledby="wprof-h">
      <header><b id="wprof-h">{T.profile}</b><button class="ic" type="button" data-prof-x aria-label={T.close}>×</button></header>
      <div class="ptabs" role="tablist" data-ptabs></div>
      <div class="pbody" data-pbody></div>
    </dialog>
  </div>
</Base>

<script>
  import { attachMic, MIC_SVG } from '../scripts/voice';
  import { attachFiles, linkify } from '../scripts/attach';
  import { composer } from '../scripts/compose';
  import { renderTool } from '../scripts/tool';
  import { initTheme } from '../scripts/theme';
  import { md } from '../scripts/md';
  import type { ToolSpec } from '../../worker/toolcore';

  type R = Record<string, any>;
  type Doc = { title: string; body: string };
  type Site = { lang?: string; tone: string; title: string; sub: string; about: string; services: string[]; cta: string; ask?: string };
  type Msg = { id?: number; role: 'user' | 'assistant'; content: string; tool?: ToolSpec; doc?: Doc; image?: string; deploy?: string; site?: Site; pub?: string };
  type Chat = { id: number; title: string; msgs?: Msg[] };
  type Mem = { niche: string; goals: string; project: string; limits: string };

  const root = document.querySelector<HTMLElement>('[data-ws]')!;
  const T = JSON.parse(root.querySelector('[data-t]')!.textContent || '{}');
  const CT = JSON.parse(root.querySelector('[data-ct]')!.textContent || '{}');
  const lang = root.dataset.lang || 'en', pre = root.dataset.pre || '';
  const $ = <E extends Element = HTMLElement>(s: string) => root.querySelector<E>(s)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; };
  const btn = (cls: string, text: string, go: () => void) => { const b = el('button', cls, text); b.type = 'button'; b.onclick = go; return b; };
  const KEY = 'vaxo_ws', PEND = 'vaxo_ws_open';
  const local = { get() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } }, set(v: unknown) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} }, drop() { try { localStorage.removeItem(KEY); } catch {} } };
  const post = (p: string, b: unknown) => fetch(p, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) });
  const postJ = async (p: string, b: unknown) => { const r = await post(p, b).catch(() => null); return { r, d: (r ? await r.json().catch(() => ({})) : {}) as R }; };
  const money = (n: number) => '$' + (Math.round(n * 100) / 100).toLocaleString('en-US');
  const flash = (b: HTMLElement, text: string, back: string) => { b.textContent = text; setTimeout(() => (b.textContent = back), 1500); };
  const copyText = async (v: string) => { try { await navigator.clipboard.writeText(v); } catch {} };
  const params = new URLSearchParams(location.search);
  const room = params.get('t') || '';

  const blank: Mem = { niche: '', goals: '', project: '', limits: '' };
  const S = { signed: false, email: '', verified: false, chats: [] as Chat[], cur: 0, msgs: [] as Msg[], memory: { ...blank }, mode: 'short', mods: null as R | null, access: false, busy: false, plan: 'start', usage: null as null | { used: number; cap: number } };
  let ME: R = {};

  const log = $('[data-log]'), form = $<HTMLFormElement>('[data-form]'), input = form.querySelector('textarea')!;
  const cv = $('[data-canvas]'), cvBody = $('[data-cv-body]'), cvTitle = $('[data-cv-title]');
  const sign = $<HTMLDialogElement>('[data-sign]'), prof = $<HTMLDialogElement>('[data-profile]');
  const bizbox = $('[data-bizbox]');

  const saveGuest = () => { if (!S.signed) local.set({ chats: S.chats, memory: S.memory, mode: S.mode }); };

  /* ---------- Sidebar ---------- */
  function side(yes: boolean) { $('[data-side]').classList.toggle('open', yes); $('[data-veil]').hidden = !yes; }
  function drawChats() {
    const nav = $('[data-chats]');
    nav.replaceChildren(...S.chats.map((c) => btn('chat' + (c.id === S.cur ? ' on' : ''), c.title, () => { side(false); openChat(c.id); })));
    if (!S.chats.length) nav.append(el('small', '', T.noChats));
    $('[data-title]').textContent = S.chats.find((c) => c.id === S.cur)?.title || '';
    $('[data-del]').hidden = !S.cur;
  }
  const planName = () => (S.plan === 'start' ? CT.levels.start : S.plan[0].toUpperCase() + S.plan.slice(1));
  function drawUsage() {
    const u = $<HTMLButtonElement>('[data-usage]');
    u.hidden = false;
    if (!S.signed || !S.usage) { u.replaceChildren(el('small', '', T.usageGuest)); u.disabled = true; return; }
    u.disabled = false;
    u.replaceChildren(el('b', '', planName()), el('small', '', T.usage.replace('{u}', String(S.usage.used)).replace('{c}', String(S.usage.cap))));
  }
  function drawWho() {
    const w = $('[data-who]');
    if (S.signed) w.replaceChildren(el('small', '', S.email));
    else w.replaceChildren(btn('pri', T.signin, () => openSign()), el('small', '', T.guest));
    for (const k of ['crm', 'partner', 'site']) $(`[data-dot=${k}]`).hidden = !S.mods?.[k];
    drawUsage();
  }
  function drawMode() { root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.classList.toggle('on', b.dataset.mode === S.mode)); }

  /* ---------- Chat ---------- */
  const TILE_ICO: R = { site: 'M3 5h18v14H3zM3 9h18', crm: 'M4 5h16v3H4zm0 5.5h10v3H4zM4 16h7v3H4z', partner: 'M10 13a4 4 0 0 0 6 .5l3-3a4 4 0 0 0-5.7-5.7L12 6m2 5a4 4 0 0 0-6-.5l-3 3a4 4 0 0 0 5.7 5.7L12 18' };
  function drawEmpty() {
    const box = el('div', 'hi');
    box.append(el('h1', '', T.hello2), el('p', '', T.sub2));
    const g = el('div', 'tiles');
    for (const k of ['site', 'crm', 'partner']) {
      const b = btn('tile', '', () => panel(k));
      b.innerHTML = `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="${TILE_ICO[k]}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      b.append(el('b', '', T.tiles[k][0]), el('small', '', T.tiles[k][1]));
      g.append(b);
    }
    const ex = el('div', 'ex');
    ex.append(el('p', '', T.exL));
    for (const q of T.ex as string[]) ex.append(btn('exb', q + ' →', () => ask(q)));
    box.append(g, ex);
    log.replaceChildren(box);
  }
  function acard(label: string, title: string, go: () => void) {
    const b = btn('acard', '', go);
    b.append(el('b', '', title), el('small', '', label));
    return b;
  }
  function drawMsg(m: Msg) {
    const d = el('div', 'm ' + (m.role === 'user' ? 'me' : 'vax'));
    const t = el('div', 'tx'); t.innerHTML = linkify(m.content); d.append(t);
    if (m.site) d.append(acard(T.open, m.site.title || T.siteCard, () => showArt(m)));
    if (m.tool) d.append(acard(T.open, m.tool.title, () => showArt(m)));
    else if (m.doc) d.append(acard(T.open, m.doc.title, () => showArt(m)));
    if (m.image) { const i = el('img', 'pic'); i.src = m.image; i.alt = ''; d.append(i); }
    if (m.deploy) d.append(btn('pri sm', `${T.dep}: ${m.deploy === 'partner' ? T.parCab : T[m.deploy]}`, () => panel(m.deploy!)));
    log.append(d);
    log.scrollTop = log.scrollHeight;
    return d;
  }
  function drawAll() {
    if (!S.msgs.length) { drawEmpty(); return; }
    log.replaceChildren();
    S.msgs.forEach(drawMsg);
  }
  const hasArt = (m: Msg) => !!(m.tool || m.doc || m.site);
  async function openChat(id: number) {
    S.cur = id;
    const c = S.chats.find((x) => x.id === id);
    if (S.signed) {
      const d = await (await fetch('/api/ws/chat/' + id)).json().catch(() => null);
      S.msgs = d?.msgs || [];
    } else S.msgs = c?.msgs || [];
    drawChats(); drawAll();
    const last = [...S.msgs].reverse().find(hasArt);
    if (last && matchMedia('(min-width: 1100px)').matches) showArt(last); else closeCv();
  }
  function fresh() { S.cur = 0; S.msgs = []; drawChats(); drawEmpty(); closeCv(); input.focus(); }

  async function ask(q: string) {
    q = q.trim();
    if (!q || S.busy) return;
    S.busy = true;
    if (!S.msgs.length) log.replaceChildren();
    const mine: Msg = { role: 'user', content: q };
    S.msgs.push(mine); drawMsg(mine);
    const wait = el('div', 'm vax wait', T.think); log.append(wait); log.scrollTop = log.scrollHeight;
    const history = S.msgs.slice(-15, -1).map(({ role, content }) => ({ role, content }));
    let say: Msg = { role: 'assistant', content: T.err };
    try {
      const r = await post('/api/ws/ask', { q, lang, mode: S.mode, chat: S.signed ? S.cur : 0, ...(S.signed ? {} : { history, memory: S.memory }) });
      const d = await r.json();
      if (r.status === 429) say.content = d.error === 'guest' ? T.guestLimit : T.limit;
      else if (d.ok) {
        say = { id: d.id ?? undefined, role: 'assistant', content: d.reply, tool: d.tool || undefined, doc: d.doc || undefined, image: d.image, deploy: d.deploy || undefined, site: d.site || undefined };
        if (S.signed && d.chat && d.chat !== S.cur) { S.cur = d.chat; S.chats.unshift({ id: d.chat, title: q.slice(0, 60) }); }
        if (S.usage) { S.usage.used++; drawUsage(); }
      }
    } catch { /* the message above says so */ }
    wait.remove();
    S.msgs.push(say); drawMsg(say);
    if (!S.signed) {
      if (!S.cur) { S.cur = Date.now(); S.chats.unshift({ id: S.cur, title: q.slice(0, 60), msgs: S.msgs }); }
      const c = S.chats.find((x) => x.id === S.cur); if (c) c.msgs = S.msgs.map((m) => ({ ...m, image: undefined }));
      saveGuest();
    }
    drawChats();
    if (hasArt(say)) showArt(say);
    S.busy = false;
  }

  /* ---------- Canvas ---------- */
  function openCv(title: string, ...body: Node[]) { cvTitle.textContent = title; parkBiz(); cvBody.replaceChildren(...body); cv.hidden = false; root.classList.add('wide'); side(false); }
  function closeCv() { parkBiz(); cv.hidden = true; root.classList.remove('wide'); }
  function parkBiz() { if (bizbox.parentElement !== root) { bizbox.hidden = true; root.append(bizbox); } }
  const needSign = (kind?: string) => { if (kind) { try { sessionStorage.setItem(PEND, kind); } catch {} } openSign(T.needIn); };

  function linkRow(url: string) {
    const r = el('div', 'lk'), a = el('a', '', url.replace(/^https?:\/\//, '')), c = btn('sec', T.copy, async () => { await copyText(url); flash(c, T.copied, T.copy); });
    a.href = url; a.target = '_blank'; a.rel = 'noopener';
    r.append(a, c);
    return r;
  }
  const download = (name: string, body: string, type: string) => { const a = el('a'); a.href = URL.createObjectURL(new Blob([body], { type })); a.download = name.replace(/[^\p{L}\p{N} -]+/gu, '').slice(0, 60) + type.replace(/^.*\/(csv|markdown).*$/, (_, x) => (x === 'csv' ? '.csv' : '.md')); a.click(); URL.revokeObjectURL(a.href); };

  // A tool as rows of what is on screen now, with the person's own numbers: pastes into a spreadsheet as a table.
  function toolRows(box: HTMLElement, t: ToolSpec): string[][] {
    const rows: string[][] = [[t.title]];
    box.querySelectorAll<HTMLLabelElement>('.g label').forEach((l) => rows.push([l.firstChild?.textContent || '', l.querySelector('input')?.value || '']));
    box.querySelectorAll('.o div').forEach((d) => rows.push([d.querySelector('small')?.textContent || '', d.querySelector('b')?.textContent || '']));
    box.querySelectorAll('li').forEach((li) => rows.push([(li.querySelector('input') as HTMLInputElement)?.checked ? '✓' : '☐', li.textContent || '']));
    return rows;
  }
  function toolView(t: ToolSpec) {
    const box = renderTool(t), bar = el('div', 'tbar');
    const cp = btn('sec', T.copyT, async () => { await copyText(toolRows(box, t).map((r) => r.join('\t')).join('\n')); flash(cp, T.copied, T.copyT); });
    const dl = btn('sec', T.csv, () => download(t.title, '﻿' + toolRows(box, t).map((r) => r.map((c) => `"${c.replace(/"/g, '""')}"`).join(';')).join('\n'), 'text/csv'));
    bar.append(cp, dl);
    const wrap = el('div', 'art'); wrap.append(bar, box);
    if (t.kind === 'calc') wrap.append(el('small', 'hint', T.toolMore));
    return wrap;
  }
  function docView(m: Msg) {
    const view = el('div', 'doc'), area = el('textarea', 'src'), bar = el('div', 'tbar'), pubBox = el('div');
    const paint = () => { view.innerHTML = md(m.doc!.body); };
    paint(); area.value = m.doc!.body; area.hidden = true;
    const edit = btn('sec', T.edit, async () => {
      if (area.hidden) { area.hidden = false; view.hidden = true; edit.textContent = T.done; area.focus(); return; }
      m.doc!.body = area.value; area.hidden = true; view.hidden = false; edit.textContent = T.edit; paint();
      if (S.signed && m.id) { await post('/api/ws/doc', { id: m.id, ...m.doc }); if (m.pub) await post('/api/ws/publish', { id: m.id }); } else saveGuest();
    });
    const copy = btn('sec', T.copy, async () => { await copyText(area.hidden ? m.doc!.body : area.value); flash(copy, T.copied, T.copy); });
    const dl = btn('sec', T.dl, () => download(m.doc!.title, m.doc!.body, 'text/markdown'));
    const drawPub = () => {
      if (!m.pub) { pubBox.replaceChildren(); return; }
      const off = btn('lnk', T.pubOff, async () => { const { d } = await postJ('/api/ws/publish', { id: m.id, off: true }); if (d.ok) { m.pub = undefined; pub.textContent = T.pub; drawPub(); } });
      pubBox.replaceChildren(el('small', '', T.pubLink), linkRow(m.pub), off);
    };
    const pub = btn('pri sm', m.pub ? T.pubDone : T.pub, async () => {
      if (!S.signed || !m.id) { needSign(); return; }
      pub.textContent = T.pubBusy;
      const { d } = await postJ('/api/ws/publish', { id: m.id });
      pub.textContent = d.ok ? T.pubDone : T.pub;
      if (d.url) { m.pub = d.url; drawPub(); }
    });
    bar.append(pub, edit, copy, dl);
    drawPub();
    const wrap = el('div', 'art'); wrap.append(bar, pubBox, view, area);
    return wrap;
  }

  function showArt(m: Msg) {
    if (m.site) { siteView(m.site, m); return; }
    const parts: Node[] = [];
    if (m.tool) parts.push(toolView(m.tool));
    if (m.doc) parts.push(docView(m));
    if (parts.length) openCv((m.tool || m.doc)!.title, ...parts);
  }

  /* ---------- Site: a live preview, every line editable, one Publish ---------- */
  const field = (label: string, name: string, value: string, long = false) => {
    const l = el('label', 'f', label), i = long ? el('textarea') : el('input');
    i.name = name; i.value = value; l.append(i);
    return l;
  };
  function siteView(src: Site, m?: Msg) {
    const site: Site = { ...src, services: [...(src.services || [])] };
    const frame = el('iframe', 'prev'); frame.setAttribute('sandbox', ''); frame.title = T.siteCard;
    let timer = 0;
    const paint = async () => { const { d } = await postJ('/api/ws/site/preview', { site, lang }); if (!d.html) return; frame.srcdoc = ''; requestAnimationFrame(() => requestAnimationFrame(() => { frame.srcdoc = d.html; })); };
    const f = el('form', 'pf');
    f.append(field(T.fT, 'title', site.title), field(T.fS, 'sub', site.sub), field(T.fA, 'about', site.about, true), field(T.fL, 'services', site.services.join('\n'), true), field(T.fC, 'cta', site.cta), field(T.fAsk, 'ask', site.ask || ''));
    const l = el('label', 'f', T.fTone), tone = el('select'); tone.name = 'tone';
    for (const k of ['clean', 'dark', 'warm']) { const o = el('option', '', T.tones[k]); o.value = k; o.selected = site.tone === k; tone.append(o); }
    l.append(tone); f.append(l);
    f.oninput = () => {
      const x = Object.fromEntries(new FormData(f)) as R;
      Object.assign(site, { ...x, services: String(x.services || '').split('\n').map((s) => s.trim()).filter(Boolean) });
      clearTimeout(timer); timer = window.setTimeout(paint, 350);
      pub.textContent = S.mods?.site ? T.pubAgain : T.pub;
    };
    f.onsubmit = (e) => e.preventDefault();
    const liveBox = el('div', 'live'), err = el('small', 'bad');
    const drawLive = () => {
      const s = S.mods?.site;
      liveBox.replaceChildren(...(s ? [el('b', '', T.live), linkRow(s.url)] : []));
      if (s && !S.access) liveBox.append(el('p', 'hint', T.siteFree.replace('{n}', String(S.mods?.requests ?? 0))));
    };
    const live = !m; // opened from the module: this is the live site itself
    const pub = btn('pri', live ? T.pubAgain : T.pub, async () => {
      if (!S.signed) { needSign('site'); return; }
      if (!S.verified) { err.textContent = T.needMail; return; }
      if (!live && S.mods?.site && !confirm(T.replaceQ)) return;
      pub.disabled = true; pub.textContent = T.pubBusy; err.textContent = '';
      const { d } = await postJ('/api/ws/site/publish', { site, lang, id: m?.id });
      pub.disabled = false;
      if (!d.ok) { pub.textContent = T.pub; err.textContent = d.error === 'verify' ? T.needMail : T.depFail; return; }
      S.mods = d.modules; drawWho(); drawLive(); pub.textContent = T.pubDone;
      if (m) { m.site = { ...site }; saveGuest(); }
    });
    const bar = el('div', 'tbar'); bar.append(pub);
    const parts: Node[] = [bar, err, liveBox, frame, f];
    if (live) parts.push(domainBox());
    openCv(site.title || T.siteCard, ...parts);
    drawLive(); paint();
  }

  /* ---------- Own domain (Decision 42) ---------- */
  let domTimer = 0;
  function domainBox() {
    const box = el('section', 'dom'), body = el('div'), msg = el('small', 'bad');
    box.append(el('h3', '', T.domH), body, msg);
    const copyBtn = (v: string) => { const b = btn('sec', CT.domCopy, async () => { await copyText(v); flash(b, CT.domCopied, CT.domCopy); }); return b; };
    const draw = (x: R) => {
      clearTimeout(domTimer);
      const d: R | null = x.domain;
      if (!d) {
        if (!S.access) { body.replaceChildren(el('p', 'hint', CT.domP), el('p', 'hint', CT.domLock), btn('sec', CT.tryBtn, () => openProf('plan'))); return; }
        if (!x.ready) { body.replaceChildren(el('p', 'hint', CT.domP), el('p', 'hint', CT.domSoon)); return; }
        const f = el('form', 'add'), i = el('input'); i.name = 'host'; i.required = true; i.maxLength = 253; i.placeholder = CT.domPh; i.setAttribute('aria-label', CT.domS1); i.autocomplete = 'off';
        const go = el('button', 'pri sm', CT.domGo); f.append(i, go);
        f.onsubmit = async (e) => { e.preventDefault(); msg.textContent = ''; go.disabled = true; const { d: j } = await postJ('/api/ws/domain', { host: i.value }); go.disabled = false; if (j.ok) draw(j); else msg.textContent = ({ bad: CT.domBad, taken: CT.domTaken, plan: CT.domLock, soon: CT.domSoon } as R)[j.error] || CT.domFail; };
        body.replaceChildren(el('p', 'hint', CT.domP), el('small', '', CT.domS1), f); return;
      }
      const on = d.status === 'active';
      const head = el('p', on ? 'ok' : 'hint', on ? '✓ ' + CT.domOn : CT.domWait);
      const off = btn('lnk', CT.domOff, async () => { const { d: j } = await postJ('/api/ws/domain/delete', {}); if (j.ok) draw(j); });
      if (on) { body.replaceChildren(head, linkRow(`https://${d.host}`), off); return; }
      const rec = d.record;
      const table = el('div', 'dns');
      for (const [k, v] of [[CT.domType, rec.type], [CT.domName, rec.name], [CT.domValue, rec.value]]) { const r = el('div', 'lk'); r.append(el('small', '', k), el('code', '', v), copyBtn(v)); table.append(r); }
      body.replaceChildren(el('b', '', d.host), el('small', '', CT.domS2), table, el('p', 'hint', CT.domWhere), ...(d.apex ? [el('p', 'hint', CT.domApex)] : []), ...(d.error ? [el('p', 'hint', /CNAME/i.test(d.error) ? CT.domNoCname : CT.domErr + d.error)] : []), head, btn('sec', CT.domCheck, load), off);
      domTimer = window.setTimeout(() => { if (box.isConnected) load(); }, 30000);
    };
    const load = async () => { const j = await fetch('/api/ws/domain').then((r) => r.json()).catch(() => null); if (j?.ok) draw(j); };
    load();
    return box;
  }

  // The CRM comes with Care: one click starts the free month, then the module deploys as usual.
  function trialCard(kind: string, text: string) {
    const box = el('div', 'pf'), err = el('small', 'bad');
    box.append(el('p', '', text), el('p', 'hint', T.lockP));
    const b = btn('pri', T.trialGo, async () => {
      if (!S.signed) { needSign(kind); return; }
      b.disabled = true; b.textContent = T.trialBusy;
      let ref = ''; try { ref = localStorage.getItem('vaxo_ref') || ''; } catch {}
      const { d } = await postJ('/api/ws/trial', { lang, ref });
      b.disabled = false; b.textContent = T.trialGo;
      if (d?.ok) { S.access = true; S.mods = d.modules; ME = {}; panel(kind); return; }
      err.textContent = d?.error === 'used' ? T.trialUsed : d?.error === 'verify' ? T.needMail : T.depFail;
      if (d?.error) box.append(btn('lnk', T.openPlan, () => openProf('plan')));
    });
    box.append(b, err);
    return box;
  }

  function deployCard(kind: string, text: string) {
    if (kind === 'crm' && !S.access) return trialCard(kind, text);
    const box = el('div', 'pf'), err = el('small', 'bad');
    box.append(el('p', '', text));
    const name = el('input'); name.placeholder = T.bizName; name.setAttribute('aria-label', T.bizName); name.value = S.mods?.biz?.name || S.memory.project.slice(0, 60);
    if (S.signed && !S.mods?.biz) box.append(name);
    const b = btn('pri', T.dep, async () => {
      if (!S.signed) { needSign(kind); return; }
      b.disabled = true; b.textContent = T.depBusy;
      const { d } = await postJ('/api/ws/module', { kind, name: name.value, lang });
      b.disabled = false; b.textContent = T.dep;
      if (d?.ok) { S.mods = d.modules; drawWho(); panel(kind); } else err.textContent = d?.error === 'verify' ? T.needMail : T.depFail;
    });
    box.append(b, err);
    return box;
  }

  function crmPanel() {
    const c = S.mods?.crm;
    if (!c) { openCv(T.crmH, deployCard('crm', T.crmP)); return; }
    const box = el('div', 'pf');
    box.append(el('b', '', T.crmLink), linkRow(c.url), el('b', '', `${T.crmTotal}: ${c.total}`));
    if (!c.leads.length) box.append(el('small', '', T.crmNone));
    for (const l of c.leads) {
      const r = el('div', 'lead'), s = el('select');
      for (const k of ['new', 'work', 'won', 'lost']) { const o = el('option', '', T.st[k]); o.value = k; o.selected = l.status === k; s.append(o); }
      s.setAttribute('aria-label', 'Status');
      s.onchange = () => post(`/api/biz/${S.mods!.biz!.id}/leads/${l.id}`, { status: s.value });
      const who = el('div'); who.append(el('b', '', l.name || l.contact || '—'), el('small', '', [l.contact, l.message].filter(Boolean).join(' · ').slice(0, 160)));
      r.append(who, s); box.append(r);
    }
    const full = btn('sec', T.crmFullBtn + ' ↓', () => { full.remove(); bizbox.hidden = false; cvBody.append(bizbox); window.dispatchEvent(new CustomEvent('vx:signed-in')); bizbox.scrollIntoView({ behavior: 'smooth' }); });
    box.append(full);
    openCv(T.crmH, box);
  }

  async function partnerPanel() {
    if (S.signed && !ME.signedIn) await loadMe();
    const box = el('div', 'pf');
    // 1) Inviting friends to Vaxo: a free month for them, +1 month for you.
    const inv: R = ME.invite || {};
    const link = inv.slug ? `${location.origin}/r/${inv.slug}` : '';
    const sec1 = el('section', 'blk');
    sec1.append(el('h3', '', CT.invH), el('p', 'hint', CT.invP));
    if (link) sec1.append(linkRow(link), el('small', '', CT.invStats.replace('{i}', inv.invited || 0).replace('{p}', inv.pending || 0).replace('{c}', inv.credited || 0)));
    else if (!S.signed) sec1.append(btn('pri sm', T.signin, () => openSign()));
    if (S.signed) sec1.append(el('p', 'bal', `${CT.bonus}: ${money(ME.bonus || 0)}`));
    // 2) The money program: its own cabinet at /partner/.
    const sec2 = el('section', 'blk');
    const go = el('a', 'pri sm', T.parGo) as HTMLAnchorElement; go.href = `${pre}/partners/`;
    sec2.append(el('p', 'hint', T.parVaxo), go);
    // 3) Their own partners: a link per partner with visits and requests.
    const sec3 = el('section', 'blk');
    sec3.append(el('h3', '', T.parMine));
    const p = S.mods?.partner;
    if (!p) sec3.append(deployCard('partner', T.parP));
    else {
      for (const l of p.links) { const r = el('div', 'lead col'); r.append(el('b', '', l.name), linkRow(l.url), el('small', '', `${T.visits}: ${l.visits} · ${T.leads}: ${l.leads}`)); sec3.append(r); }
      const f = el('form', 'add'), i = el('input'), b = el('button', 'sec', T.parAdd);
      i.placeholder = T.parName; i.maxLength = 80; i.required = true; i.setAttribute('aria-label', T.parName);
      f.append(i, b);
      f.onsubmit = async (e) => { e.preventDefault(); const { d } = await postJ('/api/ws/module/ref', { name: i.value }); if (d?.modules) { S.mods = d.modules; partnerPanel(); } };
      sec3.append(f);
    }
    box.append(sec1, sec2, sec3);
    openCv(T.parCab, box);
  }

  function sitePanel() {
    const s = S.mods?.site;
    if (s) { siteView(s); return; }
    // No site yet: one line about the business, and Vax builds the draft from it (and from what it remembers).
    const box = el('form', 'pf'), i = el('input');
    i.required = true; i.maxLength = 200; i.placeholder = T.siteNew; i.setAttribute('aria-label', T.siteNew);
    i.value = [S.memory.project, S.memory.niche].filter(Boolean).join(', ').slice(0, 200);
    box.append(el('p', '', T.siteP), i, el('button', 'pri', T.siteNewGo));
    box.onsubmit = (e) => { e.preventDefault(); ask(T.siteAsk + i.value); };
    openCv(T.siteH, box);
  }

  function panel(k: string) {
    if (k === 'memory') { openProf('memory'); return; }
    ({ crm: crmPanel, partner: partnerPanel, site: sitePanel } as Record<string, () => void>)[k]?.();
  }

  /* ---------- Profile window: plan, memory, projects, account ---------- */
  async function loadMe() { ME = (await fetch(`/api/me${room ? `?t=${room}` : ''}`).then((r) => r.json()).catch(() => ({}))) || {}; return ME; }
  async function openProf(tab = 'plan') {
    if (!S.signed) { openSign(); return; }
    if (!prof.open) prof.showModal();
    if (!ME.signedIn) await loadMe();
    const tabs = ['plan', 'memory', ...((ME.projects || []).length ? ['projects'] : []), 'account'];
    if (!tabs.includes(tab)) tab = 'plan';
    $('[data-ptabs]').replaceChildren(...tabs.map((k) => { const b = btn(k === tab ? 'on' : '', T.pTabs[k], () => openProf(k)); b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', String(k === tab)); return b; }));
    $('[data-pbody]').replaceChildren(({ plan: planTab, memory: memoryTab, projects: projectsTab, account: accountTab } as Record<string, () => Node>)[tab]());
  }

  function planTab() {
    const box = el('div', 'pf'), msg = el('small', 'bad');
    const free = S.plan === 'start', trial = !!ME.allowance?.trial;
    const head = el('div', 'plan');
    const txt = el('div'); txt.append(el('small', '', CT.planH), el('h2', '', planName()), el('p', '', free ? CT.planFree : trial ? CT.planTrial : CT.planOn));
    head.append(txt);
    if (ME.payUrl) { const a = el('a', 'pri', CT.payBtn) as HTMLAnchorElement; a.href = ME.payUrl; head.append(a); }
    else if (free) head.append(btn('pri', CT.tryBtn, async () => {
      const { d } = await postJ('/api/ws/trial', { lang, ref: (() => { try { return localStorage.getItem('vaxo_ref') || ''; } catch { return ''; } })() });
      if (d.ok) { S.access = true; S.plan = 'care'; S.mods = d.modules; ME = {}; drawWho(); openProf('plan'); return; }
      msg.textContent = d.error === 'verify' ? CT.confirmFirst : d.error === 'used' ? CT.trialUsed : CT.errNet;
    }));
    else { const a = el('a', 'sec', CT.chgBtn) as HTMLAnchorElement; a.href = `${pre}/#pricing`; head.append(a); }
    box.append(head, msg);
    if (S.usage) box.append(el('p', 'count', T.usage.replace('{u}', String(S.usage.used)).replace('{c}', String(S.usage.cap))));
    if (!ME.me?.verified) box.append(verifyBox());
    const bal = el('section', 'blk');
    bal.append(el('h3', '', `${CT.bonus}: ${money(ME.bonus || 0)}`), el('p', 'hint', CT.bonusRule));
    box.append(bal);
    return box;
  }
  function verifyBox() {
    const sec = el('section', 'blk'), p = el('p', 'hint', CT.sEmailP), f = el('form', 'add'), i = el('input');
    i.inputMode = 'numeric'; i.maxLength = 6; i.placeholder = T.sCode; i.setAttribute('aria-label', T.sCode);
    f.append(i, el('button', 'pri sm', CT.confirm)); f.hidden = true;
    const go = btn('sec', CT.sEmailDo, async () => { const { r, d } = await postJ('/api/me/code', { email: S.email, lang }); p.textContent = r?.ok || d.error === 'wait' ? CT.codeSentInline.replace('{email}', S.email) : d.error === 'mail_off' ? CT.off : CT.errNet; f.hidden = false; i.focus(); });
    f.onsubmit = async (e) => { e.preventDefault(); const { r, d } = await postJ('/api/me/verify', { email: S.email, code: i.value, lang }); if (r?.ok) { S.verified = true; ME = {}; openProf('plan'); } else p.textContent = d.error === 'expired' ? CT.errExpired : CT.errCode; };
    sec.append(el('h3', '', CT.sEmail), p, go, f);
    return sec;
  }
  function memoryTab() {
    const f = el('form', 'pf');
    f.append(el('p', '', T.memP));
    for (const k of ['niche', 'goals', 'project', 'limits'] as const) f.append(field(T.mem[k], k, S.memory[k], true));
    const b = el('button', 'pri', T.save); f.append(b);
    f.onsubmit = async (e) => {
      e.preventDefault();
      S.memory = Object.fromEntries(new FormData(f)) as unknown as Mem;
      await post('/api/ws/memory', { ...S.memory, mode: S.mode });
      flash(b, T.saved, T.save);
    };
    return f;
  }
  function projectsTab() {
    const box = el('div', 'pf');
    for (const p of ME.projects as R[]) {
      const won = p.status === 'won', key = won ? (p.stage || 'work') : p.status, pct = won ? (p.stage === 'delivered' ? 100 : (p.progress ?? 0)) : 0;
      const c = el('section', 'blk');
      c.append(el('small', '', `#${p.id}`), el('h3', '', p.what || p.name || `#${p.id}`), el('p', 'hint', [CT.next[key] && `${CT.nextStep}: ${CT.next[key]}`, `${CT.progress} ${pct}%`].filter(Boolean).join(' · ')));
      const bar = el('div', 'meter'); const fill = el('i'); fill.style.width = pct + '%'; bar.append(fill); c.append(bar);
      if (p.room) { const a = el('a', 'sec', CT.chat + ' →') as HTMLAnchorElement; a.href = `/room/?t=${p.room}`; c.append(a); }
      box.append(c);
    }
    return box;
  }
  function accountTab() {
    const box = el('div', 'pf');
    const news = el('label', 'chk'), cb = el('input'); cb.type = 'checkbox'; cb.checked = !!ME.me?.marketing;
    cb.onchange = () => post('/api/me/marketing', { on: cb.checked });
    news.append(cb, el('span', '', CT.newsOn));
    const exp = el('a', 'sec', CT.export) as HTMLAnchorElement; exp.href = '/api/me/export'; exp.download = '';
    const out = btn('sec', CT.out, async () => { await fetch('/api/me/logout', { method: 'POST' }); location.href = location.pathname; });
    const del = btn('lnk danger', CT.del, async () => { if (!confirm(CT.delQ)) return; await fetch('/api/me/delete', { method: 'POST' }); location.href = location.pathname; });
    const row = el('div', 'tbar'); row.append(exp, out);
    box.append(el('b', '', S.email), news, row, del);
    return box;
  }
  $('[data-prof-x]').onclick = () => prof.close();
  prof.addEventListener('click', (e) => { if (e.target === prof) prof.close(); });

  /* ---------- Sign-in ---------- */
  let mail = '';
  function openSign(note?: string) { $('[data-sign-p]').textContent = note || T.sP; $('[data-sign-err]').textContent = ''; if (!sign.open) sign.showModal(); }
  async function enter(email: string, code: string) {
    const r = await post('/api/me/verify', { email, code, lang, room }).catch(() => null);
    return !!r?.ok;
  }
  $<HTMLFormElement>('[data-sign-mail]').onsubmit = async (e) => {
    e.preventDefault();
    mail = String(new FormData(e.target as HTMLFormElement).get('email') || '').trim();
    const { r, d } = await postJ('/api/me/code', { email: mail, lang, room });
    if (r?.ok || d.error === 'wait') { $('[data-sign-p]').textContent = T.sSent; $('[data-sign-mail]').hidden = true; $('[data-sign-code]').hidden = false; $('[data-sign-err]').textContent = d.error === 'wait' ? T.sWait : ''; }
    else $('[data-sign-err]').textContent = T.sBad;
  };
  $<HTMLFormElement>('[data-sign-code]').onsubmit = async (e) => {
    e.preventDefault();
    const code = String(new FormData(e.target as HTMLFormElement).get('code') || '').replace(/\D/g, '');
    if (await enter(mail, code)) location.href = location.pathname; else $('[data-sign-err]').textContent = T.sWrong;
  };
  $('[data-sign-x]').onclick = () => sign.close();

  /* ---------- Wiring ---------- */
  $('[data-new]').onclick = () => { side(false); fresh(); };
  $('[data-menu]').onclick = () => side(true);
  $('[data-veil]').onclick = () => side(false);
  $('[data-cv-x]').onclick = closeCv;
  $('[data-cv]').onclick = () => { if (!cv.hidden) { closeCv(); return; } const last = [...S.msgs].reverse().find(hasArt); if (last) showArt(last); else openCv(T.canvas, el('p', 'none', T.empty)); };
  $('[data-del]').onclick = async () => {
    if (!confirm(T.delQ)) return;
    if (S.signed) await post('/api/ws/chat/' + S.cur, {});
    S.chats = S.chats.filter((c) => c.id !== S.cur); saveGuest(); fresh();
  };
  root.querySelectorAll<HTMLButtonElement>('[data-panel]').forEach((b) => (b.onclick = () => panel(b.dataset.panel!)));
  root.querySelectorAll<HTMLButtonElement>('[data-prof]').forEach((b) => (b.onclick = () => { side(false); openProf(b.dataset.prof!); }));
  root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => (b.onclick = () => {
    S.mode = b.dataset.mode!; drawMode();
    if (S.signed) post('/api/ws/memory', { ...S.memory, mode: S.mode }); else saveGuest();
  }));
  form.onsubmit = (e) => { e.preventDefault(); const q = input.value; input.value = ''; ask(q); };
  composer(input, () => form.requestSubmit());
  const mic = $<HTMLButtonElement>('[data-mic]'); mic.innerHTML = MIC_SVG; attachMic(mic, input, () => lang);
  attachFiles($<HTMLButtonElement>('[data-clip]'), input, () => lang, form);
  initTheme();

  (async () => {
    const h = location.hash;
    const link = h.match(/^#in=([^.]+)\.(\d{6})$/);
    if (link) { history.replaceState(null, '', location.pathname + location.search); try { await enter(atob(link[1]), link[2]); } catch {} }
    const [d] = await Promise.all([fetch('/api/ws').then((r) => r.json()).catch(() => null), loadMe()]);
    if (d?.signedIn) {
      // Signed in any way (link, Google, password): what the guest did in this browser joins the account.
      const g = local.get();
      if (g) { await post('/api/ws/import', g).catch(() => null); local.drop(); location.reload(); return; }
      Object.assign(S, { signed: true, email: d.me.email || '', verified: !!d.me.verified, chats: d.chats, memory: d.memory, mode: d.mode, mods: d.modules, access: !!d.access, plan: d.plan || 'start', usage: d.usage || null });
    } else {
      const g = local.get();
      if (g) Object.assign(S, { chats: g.chats || [], memory: { ...blank, ...g.memory }, mode: g.mode === 'deep' ? 'deep' : 'short' });
      const gb = $<HTMLAnchorElement>('[data-sign-g]'); gb.hidden = !ME.ways?.google; if (room) gb.href = `/api/me/google?back=${room}`;
    }
    drawWho(); drawMode(); drawChats(); drawEmpty();
    // Old cabinet addresses (/me/#plan, #invite…) land here: open the same thing in its new place.
    const q = h.match(/^#q=(.+)$/), dep = h.match(/^#deploy=(crm|partner|site)$/);
    const go: R = { '#plan': () => openProf('plan'), '#profile': () => openProf('plan'), '#memory': () => openProf('memory'), '#account': () => openProf('account'), '#projects': () => openProf('projects'), '#modules': () => panel('site'), '#site': () => panel('site'), '#biz': () => panel('crm'), '#crm': () => panel('crm'), '#invite': () => panel('partner'), '#partner': () => panel('partner') };
    if (q || dep || go[h] || h === '#signin') history.replaceState(null, '', location.pathname + (room ? location.search : ''));
    let pend = ''; try { pend = sessionStorage.getItem(PEND) || ''; sessionStorage.removeItem(PEND); } catch {}
    const err = params.get('err');
    if (err && !S.signed) openSign(err === 'google_off' ? CT.off : CT.errGoogle);
    else if (room && !S.signed) openSign((ME.projects || []).length ? CT.saveP : T.sP);
    else if (room && S.signed && (ME.projects || []).length) openProf('projects');
    else if (q) ask(decodeURIComponent(q[1]));
    else if (dep) panel(dep[1]);
    else if (go[h]) S.signed || !/^#(plan|profile|memory|account|projects)$/.test(h) ? go[h]() : openSign();
    else if (pend) panel(pend);
    else if (h === '#signin' && !S.signed) openSign();
    else if (matchMedia('(min-width: 761px)').matches) input.focus();
  })();
</script>

<style is:global>
  html, body { height: 100%; }
  body:has(.wsp) { overflow: hidden; background: var(--bg); }
  .wsp { display: grid; grid-template-columns: 264px minmax(0, 1fr); height: 100dvh; color: var(--ink); font-family: var(--font); }
  .wsp.wide { grid-template-columns: 264px minmax(0, 1fr) minmax(360px, 44vw); }
  .wsp button { font-family: inherit; color: inherit; }
  .wsp .side { background: var(--surf); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; padding: 16px 12px; overflow-y: auto; min-height: 0; }
  .wsp .logo { font-weight: 800; font-size: 20px; letter-spacing: .02em; padding: 2px 8px 12px; color: var(--ink); text-decoration: none; }
  .wsp .logo span { color: var(--accText); }
  .wsp .newc { border: 1px solid var(--line2, var(--line)); background: var(--bg); border-radius: 10px; padding: 10px 12px; font-weight: 600; font-size: 14px; text-align: left; cursor: pointer; }
  .wsp .lbl { margin: 14px 8px 4px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); }
  .wsp .chats { display: grid; grid-auto-rows: max-content; gap: 2px; max-height: 32vh; overflow-y: auto; flex: none; }
  .wsp .chat { flex: none; min-height: 34px; }
  .wsp .chats small { padding: 4px 8px; color: var(--mut); font-size: 13px; }
  .wsp .chat, .wsp .nav { display: flex; align-items: center; gap: 9px; width: 100%; background: none; border: 0; border-radius: 8px; padding: 8px; font-size: 14px; text-align: left; cursor: pointer; text-decoration: none; color: var(--ink); }
  .wsp .chat { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--mut); }
  .wsp .chat.on { background: var(--surf2, var(--bg)); color: var(--ink); }
  .wsp .chat:hover, .wsp .nav:hover { background: var(--surf2, var(--bg)); }
  .wsp .nav i { margin-left: auto; width: 7px; height: 7px; border-radius: 50%; background: #2fbf71; }
  .wsp .nav i[hidden] { display: none; }
  .wsp .foot { margin-top: auto; padding-top: 14px; display: grid; gap: 10px; }
  .wsp .who { display: grid; gap: 6px; }
