  const PCURS: R = { mono: ['UAH'], wfp: ['UAH', 'USD', 'EUR'], liqpay: ['UAH', 'USD', 'EUR'], stripe: ['USD', 'EUR', 'GBP', 'PLN', 'UAH'] };
  function payPanel() {
    const Y = PY[lang] || PY.en, box = el('div', 'pf'), biz = S.proj?.biz;
    if (!S.mods?.biz || !biz) { box.append(el('p', 'hint', Y.noSite)); openCv(T.ptabs.pay, box); return; }
    box.append(el('p', 'hint', Y.p));
    const conn = el('section', 'blk'), link = el('section', 'blk'), list = el('section', 'blk');
    box.append(conn, link, list);
    openCv(T.ptabs.pay, box);
    const field = (ph: string, type = 'text') => { const i = el('input') as HTMLInputElement; i.placeholder = ph; i.type = type; i.autocomplete = 'off'; i.spellcheck = false; return i; };
    const curSel = (prov: string, sel?: string) => { const c = el('select') as HTMLSelectElement; for (const x of PCURS[prov]) { const o = el('option', '', x) as HTMLOptionElement; o.value = x; o.selected = x === sel; c.append(o); } return c; };
    const depRow = (dep: HTMLInputElement, cur: HTMLSelectElement) => { const w = el('div', 'pyd'); w.append(el('span', 'hint', Y.dep), dep, cur); return w; };
    const drawList = (rows: R[]) => {
      list.replaceChildren(el('h3', '', Y.listH));
      if (!rows.length) { list.append(el('p', 'hint', Y.none)); return; }
      for (const r of rows) {
        const row = el('div', 'pyr');
        row.append(el('span', '', `${r.amt} ${r.cur} · ${r.desc}${r.who ? ' · ' + r.who : ''}`), el('small', r.st === 'paid' ? 'livedot' : 'livedot off', r.st === 'paid' ? `● ${Y.paid}` : Y.wait));
        list.append(row);
      }
    };
    const drawLink = (cfg: R | null) => {
      link.replaceChildren(el('h3', '', Y.linkH), el('p', 'hint', cfg ? Y.linkP : Y.need));
      if (!cfg) return;
      const a = field(`${Y.amt}, ${cfg.cur}`, 'number'), w = field(Y.what), who = field(Y.who), res = el('div', 'tbar');
      a.min = '1'; a.step = '0.01';
      const mk = btn('pri', Y.mk, async () => {
        mk.disabled = true;
        const { d } = await postJ('/api/ws/pay/link', { biz, amt: a.value, desc: w.value, who: who.value });
        mk.disabled = false;
        if (!d.ok) { toast(d.error === 'amt' ? Y.amt + '?' : Y.need); return; }
        res.replaceChildren(el('code', '', d.url), btn('sec sm', T.copy, () => { copyText(d.url).then(() => toast(Y.copied)); }));
        copyText(d.url).then(() => toast(Y.copied));
        drawList(d.list || []);
      });
      link.append(a, w, who, mk, res);
    };
    const drawConn = (cfg: R | null) => {
      conn.replaceChildren(el('h3', '', Y.pick));
      if (cfg) {
        const P = Y.P[cfg.prov];
        const dep = field('0', 'number'), cur = curSel(cfg.prov, cfg.cur);
        dep.value = String(cfg.dep || 0); dep.min = '0';
        const bar = el('div', 'tbar');
        bar.append(
          btn('pri', Y.depSave, async () => { const { d } = await postJ('/api/ws/pay', { biz, dep: dep.value, cur: cur.value }); if (d.ok) { toast(Y.depOk); drawConn(d.cfg); drawLink(d.cfg); } }),
          btn('sec', Y.off, async () => { if (!confirm(Y.offQ)) return; await fetch(`/api/ws/pay?biz=${biz}`, { method: 'DELETE' }); drawConn(null); drawLink(null); }),
        );
        conn.append(el('p', 'livedot pyon', `● ${Y.on}: ${P[0]} · ${cfg.key}`), depRow(dep, cur), bar);
        return;
      }
      let prov = 'mono';
      const cards = el('div', 'pyc'), form = el('div', 'pf2');
      const drawForm = () => {
        const P = Y.P[prov], msg = el('small', 'bad');
        const k1 = field(P[2], prov === 'wfp' || prov === 'liqpay' ? 'text' : 'password'), k2 = field(P[3] || '', 'password'), dep = field('0', 'number'), cur = curSel(prov);
        dep.value = '0'; dep.min = '0';
        const how = el('p', 'hint'); how.append(el('b', '', Y.how + ': '), document.createTextNode(P[4] + ' '));
        const go = el('a', '', Y.site + ' →') as HTMLAnchorElement; go.href = P[5]; go.target = '_blank'; go.rel = 'noopener'; how.append(go);
        const save = btn('pri', Y.save, async () => {
          msg.textContent = '';
          if (!k1.value.trim() || (P[3] && !k2.value.trim())) { msg.textContent = Y.badKeys; return; }
          save.disabled = true; save.textContent = Y.saving;
          const { d } = await postJ('/api/ws/pay', { biz, prov, k1: k1.value.trim(), k2: k2.value.trim(), dep: dep.value, cur: cur.value });
          save.disabled = false; save.textContent = Y.save;
          if (!d.ok) { msg.textContent = d.error === 'keys' ? Y.badKeys : Y.bad; return; }
          toast(Y.ok); drawConn(d.cfg); drawLink(d.cfg);
        });
        form.replaceChildren(how, k1, ...(P[3] ? [k2] : []), depRow(dep, cur), msg, save);
      };
      for (const k of ['mono', 'wfp', 'liqpay', 'stripe']) {
        const P = Y.P[k], c = btn(k === prov ? 'pyi on' : 'pyi', '', () => { prov = k; [...cards.children].forEach((x) => x.classList.toggle('on', x === c)); drawForm(); });
        c.append(el('b', '', P[0]), el('small', '', P[1])); cards.append(c);
      }
      conn.append(cards, form); drawForm();
    };
    fetch(`/api/ws/pay?biz=${biz}`).then((r) => r.json()).then((d) => { drawConn(d?.cfg || null); drawLink(d?.cfg || null); drawList(d?.list || []); }).catch(() => { drawConn(null); drawLink(null); drawList([]); });
  }
  function projPartners() {
