    open: 'Open on Canvas', del: 'Delete chat', delQ: 'Delete this chat?', empty: 'Tools and documents from the chat open here.',
    edit: 'Edit', done: 'Done', copy: 'Copy', copied: 'Copied', dl: 'Download',
    memH: 'What Vax remembers', memP: 'Vax takes this into every new chat, so you never retell it. It also fills in by itself, and you can change it at any time.', mem: { niche: 'Niche or field', goals: 'Goals', project: 'Current project', limits: 'Limits: money, time, tools' }, save: 'Save', saved: 'Saved', memGuest: 'Kept in this browser. Sign in to have it on every device.',
    dep: 'Deploy', depBusy: 'Deploying…', bizName: 'Name of your business or project', needIn: 'Sign in first: the module is created in your own account.', depFail: 'Did not deploy. Try again.',
    crmH: 'CRM', crmP: 'A public request form and a board in your account. Every request lands here, and you get an email.', crmLink: 'Your form', crmTotal: 'Requests', crmNone: 'No requests yet. Share the form link.', crmFull: 'Full CRM and analytics', st: { new: 'New', work: 'In work', won: 'Won', lost: 'Lost' },
    parH: 'Partner links', parP: 'A personal link for each partner. Visits and requests are counted automatically.', parName: 'Partner name', parAdd: 'Add', visits: 'Visits', leads: 'Requests',
    siteH: 'Site', siteP: 'A one-page site with your request form, written from what Vax knows about you. It works at once on a vaxogroup.com address.', siteOpen: 'Open the site', fT: 'Headline', fS: 'One line under it', fA: 'About', fL: 'Services, one per line', fC: 'Form title', fTone: 'Style', tones: { clean: 'Clean', dark: 'Dark', warm: 'Warm' },
    sH: 'Sign in to Vaxo', sP: 'Enter your email. We send a link: one tap and you are in. No password.', sEmail: 'Your email', sGo: 'Send the link', sSent: 'Check your email and tap the link. Or enter the code from the letter:', sCode: 'Six-digit code', sIn: 'Sign in', sBad: 'Check the email address.', sWrong: 'Wrong or expired code.', sWait: 'Wait a minute and try again.', sPw: 'Sign in with a password', sAgree: 'By continuing you accept the', terms: 'Terms', and: 'and', privacy: 'Privacy Policy',
  },
  ru: {
    title: 'Vaxo Workspace', desc: 'Ваше рабочее пространство с Vax: чат, память, инструменты и модули на одном экране.',
    new: 'Новый разговор', chats: 'Проекты', noChats: 'Здесь появятся ваши разговоры.', mods: 'Модули', crm: 'CRM', partner: 'Партнёрские ссылки', site: 'Сайт', you: 'Вы', memory: 'Память', earn: 'Заработать с Vaxo', profile: 'Профиль и оплата',
    signin: 'Войти', out: 'Выйти', guest: 'Гость: сохраняется в этом браузере', short: 'Коротко в суть', deep: 'Развёрнутый проект', canvas: 'Холст', menu: 'Меню', close: 'Закрыть',
    ph: 'Напишите задачу…', send: 'Отправить', mic: 'Голосовой ввод', attach: 'Прикрепить файл', think: 'Vax работает…', err: 'Не получилось. Попробуйте ещё раз через мгновение.', limit: 'На сегодня по тарифу всё. Завтра запас обновится, всё сохранено.', guestLimit: 'Для гостя на сегодня всё. Войдите бесплатно, чтобы продолжить.',
    hello: 'Что делаем?', sub: 'Напишите своими словами. Vax разложит задачу и сделает.', chips: ['Посчитай мою юнит-экономику', 'Разложи запуск онлайн-курса', 'Сделай трекер привычки', 'Нарисуй идею логотипа для кофейни'],
    open: 'Открыть на холсте', del: 'Удалить разговор', delQ: 'Удалить этот разговор?', empty: 'Здесь открываются инструменты и документы из чата.',
