  /* ---------- A project is a business (Decision 46): its site, requests, site chat, partners, domain ---------- */
  async function useProject(pid?: number | null) {
    const p = pid ? S.projects.find((x) => x.id === pid) : undefined;
    S.proj = p ? { id: p.id, name: p.name, biz: p.biz ?? null } : null;
    S.mods = null;
    if (p && S.signed) {
      const d = await fetch(`/api/ws/project/${p.id}/state`).then((r) => r.json()).catch(() => null);
      if (d?.ok) { S.mods = d.modules; S.access = !!d.access; if (d.project?.biz) { p.biz = d.project.biz; S.proj!.biz = d.project.biz; } }
    }
  }
  const PTABS = ['site', 'book', 'pay', 'crm', 'team', 'bot', 'partner', 'domain'];
  let ptab = 'site';
  async function openProject(pid: number, tab = ptab, show?: () => void) {
    if (S.proj?.id !== pid || !S.mods) await useProject(pid);
    ptab = tab;
    if (show) show(); else ({ site: sitePanel, book: bookPanel, crm: crmPanel, team: teamPanel, bot: botPanel, partner: projPartners, domain: domainPanel, pay: payPanel } as Record<string, () => void>)[tab]?.();
    // The same canvas, with the project's tabs on top and its name as the title.
    const bar = el('div', 'ptabs2');
    for (const k of PTABS) { const b = btn(k === tab ? 'on' : '', T.ptabs[k], () => openProject(pid, k)); b.prepend(Object.assign(el('span'), { innerHTML: ico(({ site: 'site', book: 'cal', crm: 'doc', team: 'user', bot: 'reply', partner: 'link', domain: 'fwd', pay: 'doc' } as R)[k], 14) })); bar.append(b); }
    cvBody.prepend(bar);
    cvTitle.textContent = S.proj?.name || T.canvas;
  }
  function botPanel() {
    // The AI consultant on the site and what it knows: the site's own text plus the owner's facts and files (prices, hours, rules).
    const box = el('div', 'pf'), bot = S.mods?.bot, main = (S.mods?.pages || []).find((x: R) => x.main) || (S.mods?.pages || [])[0];
    if (!S.mods?.biz) { box.append(el('p', 'hint', T.botNoSite)); openCv(T.ptabs.bot, box); return; }
    if (!bot?.on) box.append(trialCard('bot', T.botP));
    else box.append(el('p', 'ok', '● ' + T.botOn), el('p', 'hint', T.botP));
    const kn = el('section', 'blk'), ta = el('textarea') as HTMLTextAreaElement, msg = el('small', 'hint');
    ta.rows = 9; ta.maxLength = 30000; ta.placeholder = T.knPh; ta.setAttribute('aria-label', T.knH);
    const file = el('input') as HTMLInputElement; file.type = 'file'; file.hidden = true; file.multiple = true;
    file.accept = '.txt,.md,.csv,.json,.pdf,.docx,.xlsx,.xls,.odt,.ods,.html,image/*';
    const up = btn('sec', '＋ ' + T.knUp, () => file.click());
    const save = btn('pri', T.knSave, async () => {
      save.disabled = true; const { d } = await postJ('/api/ws/knowledge', { biz: S.proj?.biz, text: ta.value }); save.disabled = false;
      msg.textContent = d.ok ? T.knSaved : T.depFail;
    });
    file.onchange = async () => {
      for (const f of Array.from(file.files || [])) {
        if (f.size > 5_000_000) { msg.textContent = T.knBig.replace('{f}', f.name); continue; }
        msg.textContent = T.knReading.replace('{f}', f.name);
        const buf = new Uint8Array(await f.arrayBuffer()); let bin = ''; for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode(...buf.subarray(i, i + 0x8000));
        const { d } = await postJ('/api/ws/knowledge', { biz: S.proj?.biz, text: ta.value, name: f.name, type: f.type, data: btoa(bin) });
        if (d.ok) { ta.value = d.text; msg.textContent = T.knAdded.replace('{f}', f.name); } else msg.textContent = T.knUnread.replace('{f}', f.name);
      }
      file.value = '';
    };
    const row = el('div', 'tbar'); row.append(up, save);
    kn.append(el('h3', '', T.knH), el('p', 'hint', T.knP), ta, row, msg, file);
    box.append(kn);
    const k = el('details', 'edits'); k.append(el('summary', '', T.botKnows), el('p', 'hint', (bot?.about || '').slice(0, 1200)));
    box.append(k);
    if (main?.url) { const a = el('a', 'sec', T.botTry + ' ↗') as HTMLAnchorElement; a.href = main.url; a.target = '_blank'; a.rel = 'noopener'; box.append(a); }
    openCv(T.ptabs.bot, box);
    fetch(`/api/ws/knowledge?biz=${S.proj?.biz || ''}`).then((r) => r.json()).then((d) => { if (d?.ok && !ta.value) ta.value = d.text; }).catch(() => {});
  }
