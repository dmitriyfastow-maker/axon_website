  /** Decision 64: text edited right on the canvas goes back to Markdown (headings, lists, tables, bold). */
  function htmlToMd(root: HTMLElement): string {
    const inl = (n: Node): string => [...n.childNodes].map((c) => c.nodeType === 3 ? (c.textContent || '') : (c as HTMLElement).tagName === 'STRONG' || (c as HTMLElement).tagName === 'B' ? `**${inl(c)}**` : (c as HTMLElement).tagName === 'EM' || (c as HTMLElement).tagName === 'I' ? `*${inl(c)}*` : (c as HTMLElement).tagName === 'BR' ? '\n' : inl(c)).join('');
    // Lists keep their nesting: the item's own text, then its inner lists indented.
    const list = (ul: Element, d: number): string => [...ul.children].filter((x) => x.tagName === 'LI').map((li, i) => {
      const own = [...li.childNodes].filter((c) => !(c.nodeType === 1 && /^(UL|OL)$/.test((c as HTMLElement).tagName)));
      const box = document.createElement('div'); own.forEach((c) => box.append(c.cloneNode(true)));
      const kids = [...li.children].filter((c) => /^(UL|OL)$/.test(c.tagName)).map((c) => list(c, d + 1)).join('\n');
      return '  '.repeat(d) + (ul.tagName === 'OL' ? `${i + 1}. ` : '- ') + inl(box).trim() + (kids ? '\n' + kids : '');
    }).join('\n');
    const out: string[] = [];
    for (const n of [...root.children] as HTMLElement[]) {
      const t = n.tagName;
      if (/^H[1-6]$/.test(t)) out.push('#'.repeat(Math.min(3, +t[1])) + ' ' + inl(n).trim());
      else if (t === 'UL' || t === 'OL') out.push(list(n, 0));
      else if (t === 'TABLE') { const rows = [...n.querySelectorAll('tr')].map((tr) => '| ' + [...tr.children].map((c) => inl(c).trim().replace(/\|/g, '/')).join(' | ') + ' |'); if (rows.length) { const w = (rows[0].match(/\|/g)!.length - 1); rows.splice(1, 0, '|' + ' --- |'.repeat(w)); } out.push(rows.join('\n')); }
      else if (t === 'BLOCKQUOTE') out.push(inl(n).trim().split('\n').map((l) => '> ' + l).join('\n'));
      else if (t === 'PRE') out.push('```\n' + (n.textContent || '') + '\n```');
      else if (t === 'HR') out.push('---');
      else { const x = inl(n).trim(); if (x) out.push(x); }
