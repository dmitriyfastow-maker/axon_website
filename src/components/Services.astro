---
import type { Dict } from '../i18n';
import VaxSays from './VaxSays.astro';
import { SVC_PRICES } from '../data/services';

interface Props { t: Dict }
const { t } = Astro.props;
const c = t.cat;
const DEFAULT_OPEN = 2;
// "See it live" links: real things a visitor can open and try for a category (index in t.cat.items).
const L = Astro.url.pathname.startsWith('/ru/') ? 'ru' : Astro.url.pathname.startsWith('/ua/') ? 'ua' : 'en';
const pre = L === 'en' ? '' : `/${L}`;
const DEMO_TXT = { en: { web: 'See website examples', chat: 'Try an AI chat: talk to Vax', video: 'Watch our cartoon clips', design: 'See design examples' }, ru: { web: 'Посмотреть примеры сайтов', chat: 'Попробовать ИИ-чат: напишите Vax', video: 'Посмотреть наши мультики', design: 'Посмотреть примеры дизайна' }, ua: { web: 'Переглянути приклади сайтів', chat: 'Спробувати ШІ-чат: напишіть Vax', video: 'Переглянути наші мультики', design: 'Переглянути приклади дизайну' } }[L];
const DEMOS: Record<number, [string, string][]> = {
  2: [[`${pre}/examples/`, DEMO_TXT.web], ['#vax-chat', DEMO_TXT.chat]],
  3: [['#vax-chat', DEMO_TXT.chat]],
  5: [[`${pre}/examples/`, DEMO_TXT.design]],
  7: [[`${pre}/gifts/`, DEMO_TXT.video]],
};
---

<section id="services" class="services">
  <div class="inner">
    <div class="copy">
      <div class="eyebrow">◆ {c.eyebrow}</div>
      <h2>{c.title}</h2>
      <p>{c.body}</p>
      <p>{c.sub}</p>
      <p class="note">◆ {c.note}</p>
      <VaxSays text={t.vax.services} face="happy" big />
    </div>
    <div class="list" data-acc-group="services">
      {
        c.items.map((it, i) => {
          const open = i === DEFAULT_OPEN;
          const rows = it.rows as { l: string; d?: string }[];
          return (
            <div class="box" data-acc-item>
              <button type="button" class="head" aria-expanded={open ? 'true' : 'false'} aria-controls={`svc-panel-${i}`} data-acc-btn>
                <span class="n">/ {`0${i + 1}`}</span>
                <span class="name">{it.name}</span>
                <span class="sign svc-sign"><span class="sign-closed">+</span><span class="sign-open">−</span></span>
              </button>
              <div class="rows" id={`svc-panel-${i}`} data-acc-panel data-closed={open ? undefined : ''}>
                {rows.map((r, k) => (
                  <div class="row">
                    <div class="row-l">
                      <span class="l">{r.l}</span>
                      {r.d && <span class="d">{r.d}</span>}
                    </div>
                    <span class="p">{SVC_PRICES[i][k] || c.custom}</span>
                  </div>
                ))}
                {DEMOS[i] && <div class="demos">{DEMOS[i].map(([h, l]) => <a href={h} data-demo={h === '#vax-chat' ? 'chat' : undefined}>{l} →</a>)}</div>}
              </div>
            </div>
          );
        })
      }
    </div>
    <a href="#" class="ask-vax" data-vax-chat>{t.vax.askVax}</a>
  </div>
</section>

<script>
  // "Try an AI chat" opens Vax right here instead of jumping.
  document.querySelectorAll<HTMLAnchorElement>('[data-demo="chat"]').forEach((a) => a.addEventListener('click', (e) => {
    const open = document.querySelector<HTMLElement>('[data-vc-open], .vchat .vc-btn, .vchat button');
    if (open) { e.preventDefault(); open.click(); }
  }));
</script>

<style>
  .demos { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 12px; }
  .demos a { font-size: 14px; font-weight: 600; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 8px 12px; text-decoration: none; }
  .demos a:hover { border-color: var(--acc); }
  .services {
    background: var(--surf);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(80px, 9vw, 128px) clamp(20px, 4vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  /* Sticky copy only when it sits beside the list; stacked on phones it would slide over the accordion. */
  @media (min-width: 900px) {
    .copy { position: sticky; top: 100px; }
  }
  h2 {
    margin: 0;
    font-size: clamp(36px, 4.4vw, 56px);
    letter-spacing: -0.04em;
    font-weight: 700;
    line-height: 1.02;
    text-wrap: balance;
  }
  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mut);
  }
  .note {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--accText);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .box {
    border-radius: 18px;
    background: var(--bg);
    border: 1px solid var(--line);
    transition: background 0.2s;
  }
  .box:has([aria-expanded='true']) {
    background: var(--surf2);
  }
  .head {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    background: transparent;
    border: 0;
    padding: 20px 22px;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
  }
  .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accText);
    min-width: 30px;
  }
  .name {
    flex: 1;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .svc-sign {
    background: var(--surf);
  }
  .rows {
    display: flex;
    flex-direction: column;
    padding: 0 22px 14px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  .row-l {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 220px;
  }
  .l {
    font-size: 15px;
    font-weight: 500;
  }
  .d {
    font-size: 13px;
    line-height: 1.5;
    color: var(--mut);
  }
  .p {
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
