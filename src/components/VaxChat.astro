---
// Vax on every page: one button into the workspace (Decision 40). There is no corner chat any more: any "ask Vax" link
// (<a data-vax-chat data-vax-ask="…">) opens the workspace with that question.
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const href = lang === 'en' ? '/app/' : `/${lang}/app/`;
const open = { en: 'Open the workspace with Vax', ru: 'Открыть рабочее пространство с Vax', ua: 'Відкрити робочий простір з Vax' }[lang];
const L = {
  en: { tip: 'Questions? Ask Vax', h: 'Vax · online', hi: 'Hi! I am Vax. Ask me anything about Vaxo: what it can do, plans, payment, partners.', ph: 'Your question…', send: 'Send', open: 'Do it in the workspace →', err: 'No connection. Try again in a moment.', close: 'Close', sug: ['What can Vax do?', 'Which plan do I need?', 'How does the partner programme work?'] },
  ru: { tip: 'Есть вопрос? Спросите Vax', h: 'Vax · на связи', hi: 'Привет! Я Vax. Спросите что угодно о Vaxo: что умею, тарифы, оплата, партнёрам.', ph: 'Ваш вопрос…', send: 'Отправить', open: 'Сделать это в рабочем окне →', err: 'Нет связи. Попробуйте через минуту.', close: 'Закрыть', sug: ['Что умеет Vax?', 'Какой тариф мне нужен?', 'Как работает партнёрская программа?'] },
  ua: { tip: 'Є питання? Запитайте Vax', h: 'Vax · на звʼязку', hi: 'Привіт! Я Vax. Запитайте що завгодно про Vaxo: що вмію, тарифи, оплата, партнерам.', ph: 'Ваше питання…', send: 'Надіслати', open: 'Зробити це в робочому вікні →', err: 'Немає звʼязку. Спробуйте за хвилину.', close: 'Закрити', sug: ['Що вміє Vax?', 'Який тариф мені потрібен?', 'Як працює партнерська програма?'] },
}[lang];
---

<div class="vc" data-vc data-lang={lang} data-app={href}>
  <div class="vc-panel" data-vc-panel hidden role="dialog" aria-label={L.h}>
    <header><img src="/mascot/vax-avatar.webp" alt="" width="34" height="34" /><b>{L.h}</b><button type="button" data-vc-x aria-label={L.close}>×</button></header>
    <div class="vc-log" data-vc-log aria-live="polite"><p class="vc-m a">{L.hi}</p><div class="vc-sug">{L.sug.map((q) => <button type="button" data-vc-q>{q}</button>)}</div></div>
    <a class="vc-open" href={href} data-vc-open>{L.open}</a>
    <form data-vc-form><input data-vc-in maxlength="500" placeholder={L.ph} aria-label={L.ph} /><button aria-label={L.send}>➤</button></form>
  </div>
  <button type="button" class="vc-tip" data-vc-tip>{L.tip}</button>
  <button type="button" class="vc-fab" data-vc-fab aria-label={L.tip} title={L.tip}><img src="/mascot/vax-avatar.webp" alt="" width="64" height="64" /></button>
  <a hidden data-vc-app href={href}></a>
</div>
<script type="application/json" data-vc-t set:html={JSON.stringify({ err: L.err })} />

<script>
  const root = document.querySelector<HTMLElement>('[data-vc]');
  if (root) {
    const lang = root.dataset.lang || 'en', app = root.dataset.app || '/app/';
    const T = JSON.parse(document.querySelector('[data-vc-t]')?.textContent || '{}');
    const $ = <E extends HTMLElement>(s: string) => root.querySelector<E>(s)!;
    const panel = $('[data-vc-panel]'), log = $('[data-vc-log]'), tip = $('[data-vc-tip]'), inp = $<HTMLInputElement>('[data-vc-in]');
    const go = (q = '') => { location.href = app + (q ? '#q=' + encodeURIComponent(q) : ''); };
    let msgs: { role: string; content: string }[] = [];
    try { msgs = JSON.parse(sessionStorage.getItem('vc_msgs') || '[]'); } catch { /* */ }
    const add = (role: string, text: string) => { const p = document.createElement('p'); p.className = 'vc-m ' + (role === 'user' ? 'u' : 'a'); p.textContent = text; log.append(p); log.scrollTop = log.scrollHeight; return p; };
    msgs.forEach((m) => add(m.role, m.content));
    const open = (on: boolean) => { panel.hidden = !on; tip.hidden = true; if (on) { inp.focus(); try { sessionStorage.setItem('vc_tip', '1'); } catch { /* */ } } };
    $('[data-vc-fab]').onclick = () => open(panel.hidden);
    tip.onclick = () => open(true);
    $('[data-vc-x]').onclick = () => open(false);
    // The hint shows once per visit, a few seconds after the page opens.
    let seen = false; try { seen = sessionStorage.getItem('vc_tip') === '1'; } catch { /* */ }
    tip.hidden = true; if (!seen) setTimeout(() => { if (panel.hidden) tip.hidden = false; }, 2500);
    const ask = async (q: string) => {
      q = q.trim(); if (!q) return;
      root.querySelector('.vc-sug')?.remove();
      add('user', q); msgs.push({ role: 'user', content: q });
      const wait = add('assistant', '…');
      const $open = $<HTMLAnchorElement>('[data-vc-open]'); $open.href = app + '#q=' + encodeURIComponent(q);
      try {
        const r = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: 'help', lang, messages: msgs.slice(-10) }) });
        const d = await r.json();
        wait.textContent = d.reply || T.err; if (d.reply) msgs.push({ role: 'assistant', content: d.reply });
      } catch { wait.textContent = T.err; }
      try { sessionStorage.setItem('vc_msgs', JSON.stringify(msgs.slice(-20))); } catch { /* */ }
    };
    $<HTMLFormElement>('[data-vc-form]').onsubmit = (e) => { e.preventDefault(); const q = inp.value; inp.value = ''; ask(q); };
    root.querySelectorAll<HTMLButtonElement>('[data-vc-q]').forEach((b) => (b.onclick = () => ask(b.textContent || '')));
    // Links that ask Vax to do something (<a data-vax-chat data-vax-ask="…">) still open the workspace with that task.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('[data-vax-chat]') as HTMLElement | null;
      if (a) { e.preventDefault(); go(a.dataset.vaxAsk); }
    });
    // Came from a demo's "Get one for my business" (?vax=demo-…): start the talk with what they just saw.
    const DEMO: Record<string, [string, string, string]> = {
      'demo-os': ['the owner command center (Vaxo OS)', '«Пульт владельца» (Vaxo OS)', '«Пульт власника» (Vaxo OS)'],
      'demo-clinic': ['the aesthetic clinic (Aurelia)', 'клиники эстетики Aurelia', 'клініки естетики Aurelia'],
      'demo-shop': ['the online store (Ostra)', 'интернет-магазина Ostra', 'інтернет-магазину Ostra'],
      'demo-partners': ['the partner program (Orbit Partners)', 'партнёрской программы Orbit Partners', 'партнерської програми Orbit Partners'],
    };
    const from = new URLSearchParams(location.search).get('vax') || '';
    if (DEMO[from]) {
      const name = DEMO[from][lang === 'ru' ? 1 : lang === 'ua' ? 2 : 0];
      go(lang === 'ru' ? `Я посмотрел ваш пример ${name} и хочу такую же систему для своего бизнеса. С чего начнём?`
        : lang === 'ua' ? `Я подивився ваш приклад ${name} і хочу таку саму систему для свого бізнесу. З чого почнемо?`
        : `I just tried your demo of ${name} and I want a system like that for my business. Where do we start?`);
    }
  }
</script>

<style is:global>
  .vc { position: fixed; right: 18px; bottom: max(18px, env(safe-area-inset-bottom)); z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .vc-fab { width: 60px; height: 60px; padding: 0; border: 0; border-radius: 50%; overflow: hidden; background: var(--acc); box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25); cursor: pointer; transition: transform .2s; }
  .vc-fab:hover { transform: translateY(-2px) scale(1.04); }
  .vc-fab img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .vc-tip { position: absolute; right: 70px; bottom: 12px; white-space: nowrap; border: 0; cursor: pointer; background: var(--ink); color: var(--bg); font: 600 14px/1 var(--font, system-ui); padding: 11px 14px; border-radius: 999px 999px 4px 999px; box-shadow: 0 10px 28px rgba(0,0,0,.25); animation: vcIn .4s ease; }
  .vc-tip[hidden] { display: none; }
  @keyframes vcIn { from { opacity: 0; transform: translateX(8px); } to { opacity: 1; transform: none; } }
  .vc-panel { width: min(360px, calc(100vw - 24px)); height: min(480px, calc(100vh - 120px)); display: flex; flex-direction: column; border-radius: 20px; overflow: hidden; background: var(--surf, #fff); color: var(--ink); border: 1px solid var(--line); box-shadow: 0 24px 60px rgba(0,0,0,.3); animation: vcIn .25s ease; }
  .vc-panel[hidden] { display: none; }
  .vc-panel header { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--acc); color: #111; }
  .vc-panel header img { border-radius: 50%; } .vc-panel header b { flex: 1; font-size: 15px; }
  .vc-panel header button { border: 0; background: rgba(0,0,0,.12); width: 30px; height: 30px; border-radius: 50%; font-size: 18px; cursor: pointer; color: #111; }
  .vc-log { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .vc-m { margin: 0; max-width: 85%; padding: 9px 12px; border-radius: 14px; font-size: 14.5px; line-height: 1.45; }
  .vc-m.a { background: var(--surf2, #f2f2f2); border-bottom-left-radius: 4px; }
  .vc-m.u { align-self: flex-end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 4px; }
  .vc-sug { display: flex; flex-wrap: wrap; gap: 6px; }
  .vc-sug button { border: 1px solid var(--line); background: none; color: var(--ink); border-radius: 999px; padding: 7px 11px; font-size: 13px; cursor: pointer; }
  .vc-open { margin: 0 12px 6px; font-size: 13.5px; font-weight: 600; color: var(--accText, #9a6b12); text-decoration: none; }
  .vc-panel form { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--line); }
  .vc-panel input { flex: 1; min-width: 0; border: 1px solid var(--line); border-radius: 999px; padding: 10px 14px; font: inherit; font-size: 14.5px; background: transparent; color: var(--ink); outline: 0; }
  .vc-panel form button { width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--ink); color: var(--bg); cursor: pointer; }
  @media (max-width: 760px) { .vc { right: 12px; bottom: calc(max(10px, env(safe-area-inset-bottom)) + 66px); } .vc-fab { width: 52px; height: 52px; } .vc-tip { right: 60px; bottom: 8px; } }
  @media (prefers-reduced-motion: reduce) { .vc-fab, .vc-tip, .vc-panel { transition: none; animation: none; } }
</style>
