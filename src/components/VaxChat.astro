---
// Vax on every page: one button into the workspace (Decision 40). There is no corner chat any more: any "ask Vax" link
// (<a data-vax-chat data-vax-ask="…">) opens the workspace with that question.
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const href = lang === 'en' ? '/app/' : `/${lang}/app/`;
const open = { en: 'Open the workspace with Vax', ru: 'Открыть рабочее пространство с Vax', ua: 'Відкрити робочий простір з Vax' }[lang];
---

<a class="vc-fab" href={href} data-vc-app aria-label={open} title={open} data-lang={lang}>
  <img src="/mascot/vax-avatar.webp" alt="" width="64" height="64" />
</a>

<script>
  const fab = document.querySelector<HTMLAnchorElement>('[data-vc-app]');
  if (fab) {
    const lang = fab.dataset.lang || 'en';
    const go = (q = '') => { location.href = fab.href + (q ? '#q=' + encodeURIComponent(q) : ''); };
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('[data-vax-chat]') as HTMLElement | null;
      if (a) { e.preventDefault(); go(a.dataset.vaxAsk); }
    });
    // Came from a demo's "Get one for my business" (?vax=demo-…): start the talk with what they just saw.
    const DEMO: Record<string, [string, string, string]> = {
      'demo-os': ['the owner command center (Vaxo OS)', '«Пульт владельца» (Vaxo OS)', '«Пульт власника» (Vaxo OS)'],
      'demo-clinic': ['the aesthetic clinic (Aurelia)', 'клиники эстетики Aurelia', 'клініки естетики Aurelia'],
      'demo-shop': ['the online store (Ostra)', 'интернет-магазина Ostra', 'інтернет-магазину Ostra'],
      'demo-partners': ['the partner program (Orbit Partners)', 'партнёрской программы Orbit Partners', 'партнерської програми Orbit Partners'],
    };
    const from = new URLSearchParams(location.search).get('vax') || '';
    if (DEMO[from]) {
      const name = DEMO[from][lang === 'ru' ? 1 : lang === 'ua' ? 2 : 0];
      go(lang === 'ru' ? `Я посмотрел ваш пример ${name} и хочу такую же систему для своего бизнеса. С чего начнём?`
        : lang === 'ua' ? `Я подивився ваш приклад ${name} і хочу таку саму систему для свого бізнесу. З чого почнемо?`
        : `I just tried your demo of ${name} and I want a system like that for my business. Where do we start?`);
    }
  }
</script>

<style is:global>
  .vc-fab { position: fixed; right: 18px; bottom: max(18px, env(safe-area-inset-bottom)); z-index: 60; width: 60px; height: 60px; border-radius: 50%; overflow: hidden; background: var(--acc); box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25); transition: transform 0.2s; }
  .vc-fab:hover { transform: translateY(-2px); }
  .vc-fab img { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 760px) { .vc-fab { right: 12px; width: 52px; height: 52px; bottom: calc(max(10px, env(safe-area-inset-bottom)) + 66px); } }
  @media (prefers-reduced-motion: reduce) { .vc-fab { transition: none; } }
</style>
